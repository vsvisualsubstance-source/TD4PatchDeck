          - name: reorder1
            type: reorderTOP
            parameters:
              outputgreen: input2
              outputblue: input3
              outputalpha: input4
              outputalphachan: one
              resolutionw: 64
              resolutionh: 64
              outputaspect: custom
              inputfiltertype: nearest
              filtertype: nearest
              format: rgba32float
            flags:
            - viewer
            position: [1725, 200]
            size: [130, 105]
            inputs:
            - hi
            - mid
            - low
          - name: delayExec
            type: textDAT
            parameters:
              defaultreadencoding: cp1252
              language: python
            flags:
            - viewer
            position: [400, 600]
            size: [130, 90]
            dat_content: "resx = op('hi').width\nresy = op('hi').height\n\nresOps = ['fit1', 'res1', 'feedback1', 'reorder1']\n\t\nfor operator in resOps:\n\top(operator).par.resolutionw = resx\n\top(operator).par.resolutionh = resy\n\t\n\tif operator == 'fit1':\t\t\n\t\toffset = -(resy * 0.5 - 1)\n\t\t\n\t\tif op('par2')['Samplingquality'].eval() == 5:\n\t\t\toffset -= 1\n\t\top(operator).par.ty = offset\n\t\t\n\tif operator == 'res1':\n\t\top(operator).par.resolutionh = 1\n\t\t\n\tif operator == 'reorder1':\n\t\top(operator).par.resolutionh = resx"
            dat_content_format: text
          - name: audiodyna1
            type: audiodynamicsCHOP
            parameters:
              inputgain: ~op.Sndviz.par.Inputgain
              ratiocompressor: 0.7
            flags:
            - viewer
            position: [200, 200]
            inputs:
            - in1
          - name: transform1
            type: transformTOP
            parameters:
              sx: 2.3
            flags:
            - viewer
            position: [2600, 25]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fit1
          - name: audiospect1
            type: audiospectrumCHOP
            parameters:
              frequencylog: 0.5
              highfreqboost: 1
              outputmenu: setmanually
              outlength: 8192
            flags:
            - viewer
            position: [800, 400]
            inputs:
            - audiofilter1
          - name: audiospect2
            type: audiospectrumCHOP
            parameters:
              frequencylog: 0.75
              highfreqboost: 1
              outputmenu: setmanually
              outlength: 8192
            flags:
            - viewer
            position: [800, 200]
            inputs:
            - audiofilter5
          - name: audiospect3
            type: audiospectrumCHOP
            parameters:
              highfreqboost: 1
              outputmenu: setmanually
              outlength: 8192
            flags:
            - viewer
            position: [800, 0]
            inputs:
            - audiofilter6
          - name: audiofilter1
            type: audiofilterCHOP
            parameters:
              filter: highpass
              units: frequency
              cutofflog: 3.30103
              cutofffrequency: 2000
            flags:
            - viewer
            position: [600, 400]
            inputs:
            - audiodyna1
          - name: audiofilter5
            type: audiofilterCHOP
            parameters:
              filter: bandpass
              units: frequency
              cutofflog: 3
              cutofffrequency: 1000
            flags:
            - viewer
            position: [600, 200]
            inputs:
            - audiodyna1
          - name: audiofilter6
            type: audiofilterCHOP
            parameters:
              units: frequency
              cutofflog: 2.30103
              cutofffrequency: 200
            flags:
            - viewer
            position: [600, 0]
            inputs:
            - audiodyna1
          - name: pixelFormatExec
            type: chopexecuteDAT
            parameters:
              fromop: =parent()
              chop: par1
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [200, 700]
            size: [130, 90]
            dat_content: "# me - this DAT\n# \n# channel - the Channel object which has changed\n# sampleIndex - the index of the changed sample\n# val - the numeric value of the changed sample\n# prev - the previous sample value\n# \n# Make sure the corresponding toggle is enabled in the CHOP Execute DAT.\n\ndef onOffToOn(channel, sampleIndex, val, prev):\n\treturn\n\ndef whileOn(channel, sampleIndex, val, prev):\n\treturn\n\ndef onOnToOff(channel, sampleIndex, val, prev):\n\treturn\n\ndef whileOff(channel, sampleIndex, val, prev):\n\treturn\n\ndef onValueChange(channel, sampleIndex, val, prev):\n\n\tfloatOps = ['hi', 'mid', 'low', 'all']\n\t\n\tfor operator in floatOps:\n\t\tif val == 0:\n\t\t\top(operator).par.format = 11 # 8-bit float mono\n\t\telif val == 1:\n\t\t\top(operator).par.format = 13 # 16-bit float mono\n\t\telif val == 2:\n\t\t\top(operator).par.format = 14 # 32-bit float mono\n\t\t\t\n\tvec4Ops = ['reorder1']\n\t\n\tfor operator in vec4Ops:\n\t\tif val == 0:\n\t\t\top(operator).par.format = 2 # 8-bit fixed rgba\n\t\telif val == 1:\n\t\t\top(operator).par.format = 3 # 16-bit float rgba\n\t\telif val == 2:\n\t\t\top(operator).par.format = 4 # 32-bit float rgba\n\t\n\treturn\n\t"
            dat_content_format: text
          - name: sampleQualityExec
            type: chopexecuteDAT
            parameters:
              fromop: =parent()
              chop: par2
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [200, 600]
            size: [130, 90]
            dat_content: "# me - this DAT\n# \n# channel - the Channel object which has changed\n# sampleIndex - the index of the changed sample\n# val - the numeric value of the changed sample\n# prev - the previous sample value\n# \n# Make sure the corresponding toggle is enabled in the CHOP Execute DAT.\n\ndef onOffToOn(channel, sampleIndex, val, prev):\n\treturn\n\ndef whileOn(channel, sampleIndex, val, prev):\n\treturn\n\ndef onOnToOff(channel, sampleIndex, val, prev):\n\treturn\n\ndef whileOff(channel, sampleIndex, val, prev):\n\treturn\n\ndef onValueChange(channel, sampleIndex, val, prev):\n\n\tsamplingOps = ['audiospect1', 'audiospect2', 'audiospect3']\n\t\n\tfor operator in samplingOps:\n\t\tif val == 0:\n\t\t\top(operator).par.fftsize = 3 #512\n\t\t\top(operator).par.outlength = 512\n\t\telif val == 1:\n\t\t\top(operator).par.fftsize = 4 #1024\n\t\t\top(operator).par.outlength = 1024\n\t\telif val == 2:\n\t\t\top(operator).par.fftsize = 5 #2048\n\t\t\top(operator).par.outlength = 2048\n\t\telif val == 3:\n\t\t\top(operator).par.fftsize = 6 #4096\n\t\t\top(operator).par.outlength = 4096\n\t\telif val == 4:\n\t\t\top(operator).par.fftsize = 7 #8192\n\t\t\top(operator).par.outlength = 8192\n\t\telif val == 5:\n\t\t\top(operator).par.fftsize = 8 #16384\n\t\t\top(operator).par.outlength = 16384\n\n\top('delayExec').run(delayFrames = 15)\n\t\t\t\n\treturn\n\t"
            dat_content_format: text
