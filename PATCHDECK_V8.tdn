  - name: PERFORM
    type: windowCOMP
    parameters:
      winop: /PATCHDECK/UI/MAIN_INTERFACE/
      title: =me
      ignoretaskbar: false
      display: ~op('UI').par.Uimonitor
      justifyv: top
      size: fill
      winw: 1920
      winh: 1080
      borders: false
      bordersinsize: true
      interact: true
      vsyncmode: disabled
    position: [475, 475]
    size: [160, 130]
  - name: gaia_agent
    type: baseCOMP
    parameters:
      parentshortcut: Gaia
      opshortcut: Gaia
    custom_pars:
      Config:
      - name: Brokerhost
        style: Str
        label: Broker Host
        startSection: true
        default: 192.168.1.142
        help: MQTT broker IP address for Gaia's LAN broker (mosquitto). Not localhost -- Gaia runs its broker on this host.
      - name: Brokerport
        style: Int
        label: Broker Port
        default: 1883
        help: MQTT broker TCP port. Standard unencrypted MQTT port is 1883.
      - name: Deviceid
        style: Str
        label: Device ID
        startSection: true
        default: '"td-" + __import__(''socket'').gethostname()'
        help: Gaia device registry identity, published as gaia/device/{id}/status. Deliberately matches TD-Gaia's 'td-{hostname}' convention (not a 'patchdeck'-suffixed id) because Gaia's mocap OSC redirect keys off an exact td-{hostname} match; PatchDeck and TD-Gaia never run at once on the same Mac, so sharing this convention is safe. Use the Name par below for a human-readable 'PatchDeck' label in Gaia's UI instead.
        value: ="td-" + __import__('socket').gethostname()
      - name: Stanza
        style: Str
        help: Room/zone this TD instance claims in Gaia's roomGraph (room_claim on announce). Leave blank if PatchDeck isn't tied to a specific physical room.
      - name: Name
        style: Str
        default: PatchDeck
        help: Human-readable display name shown in Gaia's Pi Manager/device list -- carries the 'PatchDeck' disambiguation so it reads unambiguously regardless of which machine it runs on.
      Status:
      - name: Connectionstatus
        style: Str
        label: Connection Status
        startSection: true
        default: not connected
        readOnly: true
        help: Live MQTT connection state, updated by mqtt1's onConnect/onConnectFailure/onConnectionLost callbacks.
        value: connected
      - name: Lastmessage
        style: Str
        label: Last Message
        readOnly: true
        help: Topic and local time of the most recently received Gaia MQTT message, set by mqtt1's onMessage callback.
        value: gaia/td/canvas @ 14:35:10
      - name: Deviceagentstatus
        style: Str
        label: Device Agent Status
        default: not connected
        readOnly: true
        help: Live MQTT connection state of the device-agent's own client (mqtt_agent), updated by mqtt_agent_callbacks' onConnect/onConnectFailure/onConnectionLost. Separate from Connectionstatus above, which tracks the ingest client (mqtt1).
        value: connected
      Mocap:
      - name: Opsdevice
        style: Str
        label: OPS Device ID
        startSection: true
        default: ops-silvermini2
        help: Device id of the Gaia OPS node whose mediapipe_node.py sends direct mocap OSC (/gaia/mocap/{Opsdevice}/pose|hand|face/{person}). Change if pointing this project at a different OPS node.
    position: [725, 300]
    size: [160, 130]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
    children:
    - name: mqtt1
      type: mqttclientDAT
      parameters:
        netaddress: ="tcp://" + parent.Gaia.par.Brokerhost.eval() + ":" + str(int(parent.Gaia.par.Brokerport.eval()))
        callbacks: mqtt1_callbacks
      dat_read_only: true
    - name: lag_soul
      type: lagCHOP
      parameters:
        lag1: 1.5
        lag2: 1.5
      position: [800, -400]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      inputs:
      - script_soul
    - name: out_soul
      type: nullCHOP
      parameters:
        autoexportroot: =parent()
      position: [1200, -400]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      inputs:
      - lag_soul
    - name: chop_face
      type: scriptCHOP
      parameters:
        callbacks: chop_face_callbacks
      custom_pars:
        Custom:
          $t: custom_2
      position: [-70, 378]
    - name: chop_hand
