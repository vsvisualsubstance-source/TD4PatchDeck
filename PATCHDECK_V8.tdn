                aligny: =parent.Widget.par.Foldertabaligny.eval()
                alignymode: =parent.Widget.par.Foldertabalignymode.eval()
                w: 75
                h: 26
                hmode: fill
                vmode: fill
                display: =not op('off').par.display
                clickthrough: true
                bgcolorr: =parent.Widget.par.Foldertabonfacecolorr.eval()
                bgcolorg: =parent.Widget.par.Foldertabonfacecolorg.eval()
                bgcolorb: =parent.Widget.par.Foldertabonfacecolorb.eval()
                bgalpha: =parent.Widget.par.Foldertabonfacecolora.eval()
                borderar: =parent.Widget.par.Foldertabonbordercolorr.eval()
                borderag: =parent.Widget.par.Foldertabonbordercolorg.eval()
                borderab: =parent.Widget.par.Foldertabonbordercolorb.eval()
                borderaalpha: =parent.Widget.par.Foldertabonbordercolora.eval()
                borderbalpha: 0
                leftborder: =parent.Widget.par.Foldertabonborderleft
                rightborder: =parent.Widget.par.Foldertabonborderright
                bottomborder: =parent.Widget.par.Foldertabonborderbottom
                topborder: =parent.Widget.par.Foldertabonbordertop
                borderover: false
              flags:
              - viewer
              position: [0, -25]
              size: [160, 130]
            - name: 'off'
              type: textCOMP
              parameters:
                text: =op('../menuOptions')[parent().digits + 1,'label']
                callbacks: off_textCOMP_callbacks
                legacyfontselection: true
