            children:
            - name: tab0
              type: buttonCOMP
              parameters:
                y: =1-(me.digits == parent.Widget.par.Value0.eval())
                w: =parent().TabWidths[me.digits] if parent().extensionsReady and parent().TabWidths else 0
                h: 50
                vmode: anchors
                topoffset: =- (0 if me.par.Selected else parent.Widget.par.Foldertabopenmargin) if parent.Widget.extensionsReady else 0
                display: =op('menuOptions').numRows > 1 and me.digits in parent().VisibleTabs if parent().extensionsReady else False
                clickthrough: =parent.Widget.par.clickthrough
