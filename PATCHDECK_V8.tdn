        colorb: 0.2
        h: 28
        hmode: fill
        alignorder: 1
        topsmoothness: mipmap
        clone: =op.TDTox.op('defaultCOMPs/button')
        reloadbuiltin: false
        relpath: inherit
      position: [275, -451]
      size: [160, 76]
      storage:
        _tdn_palette_handling: blackbox
      children:
      - name: out1
        type: outCHOP
        parameters:
          label: =me.name
          autoexportroot: =parent()
        flags:
        - viewer
        position: [275, 175]
        inputs:
        - par1
      - name: par1
        type: parameterCHOP
        parameters:
          parameters: value0
