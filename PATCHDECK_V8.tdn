        - name: blob_audio_pulse
          type: parameterexecuteDAT
          parameters:
            fromop: =parent()
            op: blob_audio
            valuechange: false
          position: [450, 140]
          size: [130, 90]
          dat_content: |2

            def onPulse(par):
                comp = par.owner
                if par.name == 'Panic':
                    mod(comp.path + '/vst_send').all_off(int(comp.par.Midichannel.eval()))
                    comp.store('slots', {})
                    comp.store('vst_dead', False)
                    for k in ('on', 'off', 'cc'):
                        comp.store('vst_m_' + k, None)
                    print('blob_audio: note spente, invio riabilitato')
                elif par.name == 'Testnote':
                    mod(comp.path + '/vst_send').note_on(int(comp.par.Midichannel.eval()), 60, 100)
                    run("mod('%s/vst_send').note_off(%d, 60)"
                        % (comp.path, int(comp.par.Midichannel.eval())), delayFrames=45)
                    print('blob_audio: nota di prova inviata (Do centrale)')
                elif par.name == 'Diagnose':
                    diagnose(comp)
                elif par.name == 'Openvst':
                    vst = comp.op('surge')
                    for m in ('openPluginUI', 'openViewer', 'showPluginUI'):
                        fn = getattr(vst, m, None)
                        if fn is not None:
                            try:
                                fn()
                                print('blob_audio: UI aperta con', m)
                                return
                            except Exception as e:
                                print('blob_audio:', m, 'fallito:', e)
                    print('metodi:', [m for m in dir(vst) if not m.startswith('_')])
                return


            def diagnose(comp):
                print('=' * 66)
                print('blob_audio - diagnostica')
                print('-' * 66)
                src = comp.op('blobs_in')
                if src is None:
                    print('ingresso: ASSENTE')
                elif src.numRows < 1:
                    print('ingresso: VUOTO -> guarda il blob_tracker')
                else:
                    print('ingresso: %d righe' % src.numRows)
                    print('          colonne:', [str(c.val) for c in src.row(0)])
                    if src.numRows > 1:
                        print('          prima riga:', [str(c.val) for c in src.row(1)])

                v = comp.op('blob_voices')
                if v is not None:
                    nv = int(comp.par.Voices.eval())
                    try:
                        print('voci    : gate', [int(v['gate%d' % (i + 1)][0]) for i in range(nv)])
                        print('          note', [int(v['note%d' % (i + 1)][0]) for i in range(nv)])
                        print('          id  ', [int(v['id%d' % (i + 1)][0]) for i in range(nv)])
                        print('          count %d, grezzi %d'
                              % (int(v['count'][0]), int(v['blobs_raw'][0])))
                    except Exception as e:
                        print('voci    : errore lettura (%s)' % e)

                vst = comp.op('surge')
                if vst is None:
                    print('vst     : ASSENTE')
                else:
                    print('vst     :', vst.type, '|', vst.par.file.eval())
                    print('          invio disattivato:', comp.fetch('vst_dead', False))
                    print('          metodi in cache:', comp.fetch('vst_m_on', None),
                          comp.fetch('vst_m_off', None), comp.fetch('vst_m_cc', None))
                out = comp.op('audioout')
                if out is not None:
                    print('uscita  : active =', out.par.active.eval())
                print('=' * 66)
          dat_content_format: text
        - name: blob_audio_pulse1
          type: parameterexecuteDAT
          parameters:
            fromop: =parent()
            op: blob_audio1
            valuechange: false
          position: [1075, 125]
          size: [130, 90]
          dat_content: |2

            def onPulse(par):
                comp = par.owner
                if par.name == 'Panic':
                    mod(comp.path + '/vst_send').all_off(int(comp.par.Midichannel.eval()))
                    comp.store('slots', {})
                    comp.store('vst_dead', False)
                    for k in ('on', 'off', 'cc'):
                        comp.store('vst_m_' + k, None)
                    print('blob_audio: note spente, invio riabilitato')
                elif par.name == 'Testnote':
                    mod(comp.path + '/vst_send').note_on(int(comp.par.Midichannel.eval()), 60, 100)
                    run("mod('%s/vst_send').note_off(%d, 60)"
                        % (comp.path, int(comp.par.Midichannel.eval())), delayFrames=45)
                elif par.name == 'Flatmix':
                    for p in ('Gainlow', 'Gainmid', 'Gainhigh'):
                        getattr(comp.par, p).val = 1.0
                    print('blob_audio: mixer azzerato a guadagno unitario')
                elif par.name == 'Diagnose':
                    diagnose(comp)
                elif par.name == 'Openvst':
                    vst = comp.op('surge')
                    for m in ('openViewer', 'openPluginUI'):
                        fn = getattr(vst, m, None)
                        if fn is not None:
                            try:
                                fn()
                                return
                            except Exception:
                                pass
                    print('apri la UI dal parametro Display Plugin GUI del nodo surge')
                return


            def diagnose(comp):
                print('=' * 66)
                print('blob_audio')
                print('-' * 66)
                v = comp.op('blob_voices')
                if v is not None:
                    nv = int(comp.par.Voices.eval())
                    try:
                        print('blob totali %d, selezionati %d, in voce %d'
                              % (int(v['blobs_raw'][0]), int(v['selected'][0]),
                                 int(v['count'][0])))
                        print('gate  ', [int(v['gate%d' % (i + 1)][0]) for i in range(nv)])
                        print('note  ', [int(v['note%d' % (i + 1)][0]) for i in range(nv)])
                        print('id    ', [int(v['id%d' % (i + 1)][0]) for i in range(nv)])
                        print('legati', [int(v['linked%d' % (i + 1)][0]) for i in range(nv)])
                    except Exception as e:
                        print('voci non leggibili:', e)
                print('selezione: %s%s' % (comp.par.Selectmode.eval(),
                                           ' (invertita)' if comp.par.Invertsel.eval() else ''))
                print('correlazione:', bool(comp.par.Uselinks.eval()), comp.par.Harmony.eval())
                for n in ('surge', 'main_pick', 'mix', 'limiter', 'audioout'):
                    o = comp.op(n)
                    if o is None:
                        print('%-10s ASSENTE' % n)
                    else:
                        print('%-10s %s | %d canali' % (n, o.type, o.numChans))
                        err = o.errors()
                        if err:
                            print('           ERRORI:', err[:300])
                print('=' * 66)
          dat_content_format: text
        - name: ndiin1_grouptable
          type: tableDAT
          flags:
          - viewer
          - -showDocked
          position: [-500, 55]
          size: [130, 90]
          dock: ndiin1
          dat_content:
          - - groups
          dat_content_format: table
        - name: blob_tracker_pulse
          type: parameterexecuteDAT
          parameters:
            fromop: =parent()
            op: blob_tracker
            valuechange: false
          position: [0, 140]
          size: [130, 90]
          dat_content: |2

            def onPulse(par):
                comp = par.owner
                if par.name != 'Diagnose':
                    return
                s = comp.op('script1')
                t = comp.op('blob_table')
                print('=' * 66)
                print('blob_tracker - diagnostica')
                print('-' * 66)
                src = comp.op('source')
                if src is not None:
                    print('sorgente :', src.par.file.eval())
                    print('           %d x %d' % (src.width, src.height))
                    if src.width == 0:
                        print('           -> filmato NON caricato, controlla il percorso')
                det = comp.op('detect_res')
                if det is not None:
                    print('detect   : %d x %d | ridotto: %s'
                          % (det.width, det.height, bool(comp.par.Downscale.eval())))
                if s is not None:
                    print('script1  : %d x %d' % (s.width, s.height))
                    print('           Outputdat =', s.par.Outputdat.eval())
                    print('           Linksdat  =', s.par.Linksdat.eval())
                    for p in ('Active', 'Blurw', 'Blocksize', 'Morph', 'Maxblobs', 'Minage'):
                        try:
                            print('           %-10s = %s' % (p, getattr(s.par, p).eval()))
                        except Exception:
                            print('           %-10s = (parametro assente)' % p)
                    err = s.errors()
                    if err:
                        print('           ERRORI:', err[:500])
                if t is not None:
                    print('tabella  : %d righe' % t.numRows)
                    if t.numRows:
                        print('           colonne:', [str(c.val) for c in t.row(0)])
                print('=' * 66)
                return
          dat_content_format: text
