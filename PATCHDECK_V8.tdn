              relpath: inherit
            sequences:
              ext:
              - object: op('./RockerExt').module.RockerExt(me)
            custom_pars:
              Rocker:
                $t: rocker
                Rockerlabels: Off On
                Rockerfontsize: 9
                Rockerfontbold: true
                Rockeroffbgcolor: [0.05, 0.05, 0.05, 1]
                Rockeronbgcolor: [0.65, 0.65, 0.65, 1]
                Rockeroffbuttoncolor: [0.35, 0.35, 0.35, 1]
                Rockeronbuttoncolor: [0.45, 0.45, 0.45, 1]
                Rockerofffontcolor: [0.6, 0.6, 0.6, 1]
                Rockeronfontcolor: [0.2, 0.2, 0.2, 1]
                Rockerverticalmode: fill
            position: [400, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: =tdu.split(parent.Widget.par.Rockerlabels.eval())[me.par.Value.eval()]
                callbacks: text1_callbacks
                legacyfontselection: true
                font: =parent.Widget.par.Font
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Rockerfontbold
                italic: =parent.Widget.par.Rockeritalic
                scaletofit: =parent.Widget.par.Rockerscaletofit
                fontsize: =parent.Widget.par.Rockerfontsize.eval() if parent.Widget.par.Rockerfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Rockerfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Rockerfontsizemode.eval()
                fontcolorr: =me.par.Fontcolor.eval()[0]
                fontcolorg: =me.par.Fontcolor.eval()[1]
                fontcolorb: =me.par.Fontcolor.eval()[2]
                fontalpha: =me.par.Fontcolor.eval()[3]
                dropshadow: =parent.Widget.par.Rockerdropshadow
                hmode: anchors
                leftanchor: =0.5 if parent.Widget.par.Value0 else 0
                rightanchor: =1 if parent.Widget.par.Value0 else 0.5
                vmode: fill
                clickthrough: true
                bgcolorr: =me.par.Bgcolor.eval()[0]
                bgcolorg: =me.par.Bgcolor.eval()[1]
                bgcolorb: =me.par.Bgcolor.eval()[2]
                bgalpha: =me.par.Bgcolor.eval()[3]
                top: '=me.par.Mapon.eval() if me.par.Value else me.par.Mapoff.eval() '
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                borderover: false
              custom_pars:
