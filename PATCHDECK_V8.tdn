            - name: operatorPath
              type: containerCOMP
              parameters:
                w: 329
                h: 30
                hmode: fill
                vmode: fill
                alignorder: 1
                sizefromwindow: true
                resizecomp: =me
                bgcolorr: 1
                bgcolorg: 1
                bgcolorb: 1
                borderaalpha: 0
                borderover: false
                align: horizlr
                crop: 'on'
                parentshortcut: ContextPath
                clone: =op.TDTox.op('operatorPath')
                dropscript: /sys/drop
