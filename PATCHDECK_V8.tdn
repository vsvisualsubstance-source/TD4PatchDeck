                $t: docs_helper
                Palettecomp: =parent(2)
                Helpcommand: =ext.DocsHelper.HelpCommand
                Mode: Wiki
                Palettename: widgetsExtractor
                Wikipage: Widgets
                Experimental: =app.experimental
              About:
                $t: about
                Version: '1.3'
            position: [600, -200]
            size: [160, 130]
            comment: Clone master for wiki connection helper in palette comps
            palette_clone: true
          - name: panelexec1
            type: panelexecuteDAT
            parameters:
              active: =parent.Widget.par.Rightclickmenu
              fromop: =parent()
              panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
              panelvalue: rselect
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [200, -200]
            size: [130, 90]
            dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
            dat_content_format: text
