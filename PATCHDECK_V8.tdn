          - name: docsHelper
            type: containerCOMP
            parameters:
              w: 32
              h: 32
              layer: 1
              display: false
              resizecomp: =me
              borderover: false
              parentshortcut: DocsHelper
              clone: =op.TDResources.op('docsHelper')
              reloadbuiltin: true
