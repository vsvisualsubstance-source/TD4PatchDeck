                value: Toggle Up
              - name: Buttongroupdat
                style: DAT
                label: Button Group DAT
              - name: Buttonfont
                style: Menu
                label: Font
                startSection: true
                default: Verdana
                menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              - name: Buttonfontfile
                style: File
                label: Font File
              - name: Buttonfontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
              - name: Buttonfontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
