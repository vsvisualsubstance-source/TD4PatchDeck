              w: =parent.Widget.par.Radiowidth.eval()
              h: =parent.Widget.par.Radioheight.eval()
              hmode: =parent.Widget.par.Radiohorizontalmode.eval()
              hfillweight: =parent.Widget.par.Radiohfillweight.eval()
              vmode: =parent.Widget.par.Radioverticalmode.eval()
              vfillweight: =parent.Widget.par.Radiovfillweight.eval()
              alignorder: 1
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              borderover: false
              align: =parent.Widget.par.Radioalign
              spacing: =parent().par.Radiomargin
              alignmax: =parent.Widget.par.Radiomaxperline
              justifyh: left
              crop: 'on'
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./RadioExt').module.RadioExt(me)
            custom_pars:
              Radio:
                $t: radio
                Radiolabels: 0 1 2 3 4 5 6 7 8
                Radiofontsize: 9
                Radiofontbold: true
                Radioalignx: center
                Radioalignxmode: bbox
                Radioaligny: center
                Radioalignymode: bbox
                Radiobasecolor: [0.3, 0.3, 0.3, 1]
                Radioofffacecolor: [0.28, 0.28, 0.28, 1]
                Radioonfacecolor: [0.3276, 0.4719, 0.52, 1]
                Radioofffontcolor: [0.18182, 0.18182, 0.18182, 1]
                Radioonfontcolor: [0.629824, 0.781456, 0.832, 1]
                Radiobordera: false
                Radioborderacolor: [1, 1, 1, 1]
                Radioborderb: false
                Radioborderbcolor: [0, 0, 0, 1]
                Radiohorizontalmode: fill
                Radiowidth: 100
                Radioverticalmode: fill
            flags:
            - viewer
            position: [400, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: radio0
              type: containerCOMP
              parameters:
                w: 20
                h: =parent().par.h
                hmode: fill
                vmode: fill
                alignorder: =me.digits
                display: =0 if me.digits > op('replicator1').par.numreplicants else 1
                helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
                clickthrough: =parent.Widget.par.clickthrough
                resizecomp: =me
                top: ./bg
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderover: false
                align: horizlr
                justifyh: left
                justifyv: center
                crop: 'on'
                clone: radio0
              sequences:
                ext:
                - promote: true
              flags:
              - viewer
              position: [-1, 100]
              size: [161, 130]
              children:
              - name: text
                type: textCOMP
                parameters:
                  text: =tdu.split(parent.Widget.par.Radiolabels.eval())[parent().digits]
                  callbacks: text1_callbacks
                  legacyfontselection: true
                  font: =parent.Widget.par.Radiofont.eval()
                  fontfile: =parent.Widget.par.Radiofontfile
                  bold: =parent.Widget.par.Radiofontbold.eval()
                  italic: =parent.Widget.par.Radioitalic
                  scaletofit: =parent.Widget.par.Radioscaletofit
                  fontsize: =parent.Widget.par.Radiofontsize.eval() if parent.Widget.par.Radiofontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Radiofontfraction.eval()
                  fontsizeunits: =parent.Widget.par.Radiofontsizemode.eval()
                  fontcolorr: =me.par.Fontcolor.eval()[0]
                  fontcolorg: =me.par.Fontcolor.eval()[1]
                  fontcolorb: =me.par.Fontcolor.eval()[2]
                  fontalpha: =me.par.Fontcolor.eval()[3]
                  dropshadow: =parent.Widget.par.Radiodropshadow
                  textoffsetx: =parent.Widget.par.Radiooffsetx.eval()
                  textoffsety: =parent.Widget.par.Radiooffsety.eval()
                  alignx: =parent.Widget.par.Radioalignx.eval()
                  alignxmode: =parent.Widget.par.Radioalignxmode.eval()
                  aligny: =parent.Widget.par.Radioaligny.eval()
                  alignymode: =parent.Widget.par.Radioalignymode.eval()
                  hmode: fill
                  vmode: fill
                  clickthrough: true
                  bgcolorr: =me.par.Facecolor.eval()[0]
                  bgcolorg: =me.par.Facecolor.eval()[1]
                  bgcolorb: =me.par.Facecolor.eval()[2]
                  bgalpha: =me.par.Facecolor.eval()[3]
                  top: '=me.par.Mapon.eval() if me.par.Value else me.par.Mapoff.eval() '
