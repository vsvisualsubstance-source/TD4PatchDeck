            - source: menu
              out: 1
            dat_read_only: true
        - name: masterIconMenu
          type: widgetCOMP
          parameters:
            w: 450
            h: 32
            bottomanchor: 1
            vorigin: 1
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            bgcolorr: 0.2
            bgcolorg: 0.2
            bgcolorb: 0.2
            bgalpha: 1
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            borderover: false
            align: horizlr
            opviewer: ./menuOptionsOut
            clone: =op.TDBasicWidgets.op('masterIconMenu') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
              $t: values_11
              Value0: '3'
            Menu:
            - name: Menunames
              style: Str
              label: Menu Names
              startSection: true
              default: chr(0xFB0B)
              value: =[0,1,2,3]
            - name: Menulabels
              style: Str
              label: Menu Labels (optional)
              default: item1 item2 item3 item4 item5
              value: =' '.join([chr(0xF03A1), chr(0xF03A4), chr(0xF03A7), chr(0xF03AA)])
            - name: Menuoptiontable
              style: DAT
              label: Menu Option Table
              startSection: true
            - name: Tableformat
              style: Menu
              label: Table Format
              default: IncludeFirstRow_NumberedCols
              menuNames:
              - IncludeFirstRow_NumberedCols
              - ExcludeFirstRow_NumberedCols
              - ExcludeFirstRow_LabeledCols
              menuLabels:
              - 'No header. Column 0: names, Column 1: labels'
              - 'Row 0 is header. Column 0: names, Column 1: labels'
              - Row 0 is header. Use "name" and "label" columns
            - name: Menuautowidth
              style: Toggle
              label: Auto Width
              startSection: true
              default: true
            - name: Menupopupwidth
              style: Int
              label: Popup Width
              default: 120
              min: 1.0
              max: 100.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
              enable: false
            - name: Menuitemverticalpadding
              style: Int
              label: Item Vertical Padding
              default: 4
              max: 100.0
              clampMin: true
              normMax: 30.0
            - name: Menuitemhorizontalpadding
              style: Int
              label: Item Horizontal Padding
              default: 4
              clampMin: true
              normMax: 20.0
            - name: Menuautoclose
              style: Toggle
              label: Auto Close
              default: true
            - name: Menurunonclick
              style: Toggle
              label: Run On Click
              startSection: true
            - name: Menucommandonclick
              style: Str
              label: Command On Click
              default: debug(me, 'click')
              enable: false
            - name: Menucustomizeinteraction
              style: Pulse
              label: Customize Interaction
              startSection: true
            - name: Menupanelexec
              style: DAT
              label: Panel Exec
              readOnly: true
              enable: false
            - name: Menuhorizontalalign
              style: Menu
              label: Horizontal Align
              startSection: true
              default: Left
              menuNames:
              - Left
              - Center
              - Right
            - name: Menuverticalalign
              style: Menu
              label: Vertical Align
              default: Top
              menuNames:
              - Top
              - Center
              - Bottom
            - name: Menualignoffset
              style: Int
              label: Align Offset
              size: 2
              normMax: 50.0
            - name: Menucustomwidth
              style: Toggle
              label: Menu Custom Width
              startSection: true
              default: true
            - name: Menuwidth
              style: Int
              label: Menu Customize Width
              default: 375
              clampMin: true
              normMax: 1024.0
              enableExpr: me.par.Menucustomwidth
            Menu Look:
            - name: Menufontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - points
              - fract
              - panelunits
              menuLabels:
              - Points
              - Fraction
              - Panel Units
            - name: Menufontsize
              style: Int
              label: Font Size
              default: 12
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Menufontsizemode.eval() in ['points', 'panelunits']
            - name: Menufontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Menufontsizemode.eval() == 'fract'
              enable: false
            - name: Menuscaletoolarge
