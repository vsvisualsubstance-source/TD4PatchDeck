                Menufontbold: true
                Menubgcolor: [0.25, 0.25, 0.25, 1]
                Menurollcolor: [0.3185, 0.3185, 0.3185, 1]
                Menuselectcolor: [0.4419, 0.4419, 0.4419, 1]
                Menufontoffcolor: [0.65, 0.65, 0.65, 1]
                Menufontoncolor: [0.65, 0.65, 0.65, 1]
                Menubuttonofffacecolor: [0.45, 0.45, 0.45, 1]
                Menubuttononfacecolor: [0.45, 0.45, 0.45, 1]
                Menubuttonrollcolor: [0.18182, 0.18182, 0.18182, 1]
            flags:
            - viewer
            position: [200, -500]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: sizer
              type: containerCOMP
              parameters:
                w: =parent.Widget.par.Buttonwidth
                hmode: =parent.Widget.par.Buttonhorizontalmode
                hfillweight: =parent.Widget.par.Buttonhfillweight
                vmode: =parent.Widget.par.Buttonverticalmode
                vfillweight: =parent.Widget.par.Buttonvfillweight
                alignorder: 1
                clickthrough: =parent.Widget.par.clickthrough
                resizecomp: =me
                borderover: false
              flags:
              - viewer
              position: [700, 0]
              size: [160, 130]
            - name: config
              type: baseCOMP
              position: [200, -200]
              size: [160, 130]
              comment: Contains all user-configurable ops for lister
              children:
              - name: check
                type: textTOP
                parameters:
                  text: ='\u2714'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Segoe UI Symbol
                  fontsizex: 11
                  fontsizexunit: pixels
                  fontcolorr: 0.71
                  fontcolorg: 0.72
                  fontcolorb: 0.72
