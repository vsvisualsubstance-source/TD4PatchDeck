              Stringfield0: /PATCHDECK/UI/MAIN_INTERFACE/strobo_color_panel/strobo_color_dropdown/stringMenu0/stringField0
              Stringmenu0: /PATCHDECK/UI/MAIN_INTERFACE/strobo_color_panel/strobo_color_dropdown/stringMenu0
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -14600]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
