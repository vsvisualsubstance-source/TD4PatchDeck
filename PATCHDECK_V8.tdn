            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('masterSlider') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
              $t: values_14
              Value0: 0.598097
            Slider:
            - name: Sliderorient
              style: Menu
              label: Orientation
              default: horz
              menuNames:
              - horz
