          - name: valueOut
            type: outCHOP
            parameters:
              label: =me.name
              autoexportroot: =parent()
            position: [400, 0]
            inputs:
            - output
          - name: vertLayout
            type: containerCOMP
            parameters:
              h: 1021
              hmode: fill
              vmode: fill
