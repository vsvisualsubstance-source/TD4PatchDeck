                  fontcolorr: 0.5
                  fontcolorg: 0.5
                  fontcolorb: 0.5
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  bgalpha: 1
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -500]
                size: [130, 48]
              - name: buttonHighlighted
                type: textTOP
                parameters:
                  text: XXWWWWWWW
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =parent.Widget.par.Font
                  fontsizex: =op('master').par.fontsizex
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: 0.5
                  fontcolorg: 0.5
                  fontcolorb: 0.5
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  bgalpha: 1
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
