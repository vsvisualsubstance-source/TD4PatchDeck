              style: Str
              label: Widget Tox
              default: masterFolderTabsLegacy
            OPs:
              $t: ops_4
              Foldertabs: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/masterFolderTabsLegacy/folderTabs
            About:
