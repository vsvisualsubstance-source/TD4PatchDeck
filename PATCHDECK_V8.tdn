            - name: Amp
              style: Float
              label: amp
              value: 0.343
            - name: Gradient
              style: Header
            - name: Computegradient
              style: Toggle
              label: compute gradient
              value: true
            - name: Epsilon
              style: Float
              label: epsilon
              default: 0.001
              value: 0.133
            TRANSLATE:
            - name: Transform
              style: XYZW
              label: transform
              values:
              - 0
              - =absTime.seconds*0.2
              - 0
              - 0
            - name: Scale
              style: XYZW
              label: scale
              size: 3
              values: [1.4, 1.3, 1]
            - name: Rotate
              style: XYZW
