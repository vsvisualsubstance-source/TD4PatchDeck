                  borderar: =parent.Widget.par.Foldertabonbordercolorr.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffbordercolorr.eval()
                  borderag: =parent.Widget.par.Foldertabonbordercolorg.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffbordercolorg.eval()
                  borderab: =parent.Widget.par.Foldertabonbordercolorb.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffbordercolorb.eval()
                  borderaalpha: =parent.Widget.par.Foldertabonbordercolora.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffbordercolora.eval()
                  borderbalpha: 0
                  leftborder: =parent.Widget.par.Foldertabonborderleft.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffborderleft.eval()
                  leftborderi: =me.par.leftborder if parent.Widget.par.Folderdoubletabborders else 0
                  rightborder: =parent.Widget.par.Foldertabonborderright.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffborderright.eval()
                  rightborderi: =me.par.rightborder if parent.Widget.par.Folderdoubletabborders else 0
                  bottomborder: =parent.Widget.par.Foldertabonborderbottom.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffborderbottom.eval()
                  bottomborderi: =me.par.bottomborder if parent.Widget.par.Folderdoubletabborders else 0
                  topborder: =parent.Widget.par.Foldertabonbordertop.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffbordertop.eval()
                  topborderi: =me.par.topborder if parent.Widget.par.Folderdoubletabborders else 0
                  borderover: false
                  composite: under
                sequences:
                  ext:
                  - promote: true
                flags:
                - viewer
                position: [600, 175]
                size: [160, 130]
              - name: rollover
                type: containerCOMP
                parameters:
                  layer: 7
                  hmode: fill
                  vmode: fill
                  alignallow: ignore
                  display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                  clickthrough: true
                  resizecomp: =me
                  bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                  bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                  bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                  bgalpha: =parent.Widget.par.Rollovercolora.eval()
                  borderover: false
                  composite: =parent.Widget.par.Rollovercomposite.eval()
                flags:
                - viewer
                position: [500, 400]
                size: [160, 130]
              - name: ramp1_keys
                type: tableDAT
                flags:
                - viewer
                position: [325, -150]
                size: [130, 90]
                dock: ramp1
                dat_content:
                - - pos
                  - r
                  - g
                  - b
                  - a
                - - '0'
                  - '1'
                  - '1'
                  - '1'
                  - '1'
                - - '0.7687225'
                  - '1'
                  - '1'
                  - '1'
                  - '1'
                - - '0.93333334'
                  - '1'
                  - '1'
                  - '1'
                  - '0'
                - - '1'
                  - '1'
                  - '1'
                  - '1'
                  - '0'
                dat_content_format: table
              - name: deleteButton
                type: containerCOMP
                parameters:
                  x: -2
                  w: 317
                  h: =min(parent().height * 0.95, op('off').evalTextSize(op('off').par.value)[1] * 0.95) + (1 if min(parent().height * 0.95, op('off').evalTextSize(op('off').par.value)[1] * 0.95) % 2 else 0)
                  fixedaspect: vertical
                  layer: 10
                  hmode: anchors
                  leftanchor: 1
                  rightanchor: 0.95
                  horigin: 1
                  bottomanchor: 0.5
                  topanchor: 0.6
                  vorigin: 0.5
                  postoffsetx: -1
                  display: =parent.Widget.par.Folderdeletebuttons
                  resizecomp: =me
                  top: ./bg
                  topfill: native
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderover: false
                  opacity: =parent().panel.rollover or me.panel.rollover
                  align: horizlr
                  justifyh: left
                  justifyv: center
                  dragscript: ''
                sequences:
                  ext:
                  - promote: true
                flags:
                - viewer
                position: [600, -25]
                size: [160, 130]
                children:
                - name: bg
                  type: textCOMP
                  parameters:
                    text: =chr(0xF1398)
                    callbacks: bg_textCOMP_callbacks
                    legacyfontselection: true
                    font: Material Design Icons
                    fontsize: =parent.Widget.par.Foldertabfontsize.eval()
                    fontcolorr: =parent.Widget.par.Foldertabofffontcolorr
                    fontcolorg: =parent.Widget.par.Foldertabofffontcolorg
                    fontcolorb: =parent.Widget.par.Foldertabofffontcolorb
                    fontalpha: =parent.Widget.par.Foldertabofffontcolora
                    alignxmode: bbox
                    alignymode: bbox
                    w: 256
                    h: 256
                    hmode: fill
                    vmode: fill
                    clickthrough: true
                    borderaalpha: 0
                    borderover: false
                  flags:
                  - viewer
                  position: [-300, 200]
                  size: [160, 130]
                - name: bg_textCOMP_callbacks
                  type: textDAT
                  parameters:
                    language: input
                  flags:
                  - viewer
                  position: [0, -160]
                  size: [160, 130]
                  dock: bg
                  dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                  dat_content_format: text
              - name: insideParent
                type: tableDAT
                parameters:
                  defaultreadencoding: cp1252
                  rows: 2
                flags:
                - viewer
                position: [300, 400]
                size: [130, 90]
                dat_content:
                - - '''path'''
                  - '''parameter'''
                  - '''value'''
                  - '''enable'''
                - - '''rollover/panel'''
                  - '''component'''
                  - '''"'' + parent().path + ''"'''
                  - '1'
                dat_content_format: table
              - name: on_textCOMP_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                position: [0, 25]
                size: [160, 130]
                dock: 'on'
                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
              - name: off_textCOMP_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                position: [0, -275]
                size: [160, 130]
                dock: 'off'
                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: tab1
              type: buttonCOMP
              parameters:
                scaletofit: onlyshrink
                y: =1-(me.digits == parent.Widget.par.Value0.eval())
                w: =parent().TabWidths[me.digits] if parent().extensionsReady and parent().TabWidths else 0
