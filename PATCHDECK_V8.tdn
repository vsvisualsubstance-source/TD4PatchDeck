                  fixedaspect: vertical
                  layer: 10
                  hmode: anchors
                  leftanchor: 1
                  rightanchor: 0.95
                  horigin: 1
                  bottomanchor: 0.5
                  topanchor: 0.6
                  vorigin: 0.5
