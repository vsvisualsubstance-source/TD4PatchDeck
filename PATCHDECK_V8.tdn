        - name: math1
          type: mathCHOP
          parameters:
            torange1: ~parent().par.Min
            torange2: ~parent().par.Max
            autoexportroot: =parent()
          flags:
          - viewer
          position: [-900, 150]
          size: [130, 90]
          inputs:
          - constant2
        - name: null4
          type: nullCHOP
          parameters:
            autoexportroot: =parent()
          flags:
          - viewer
          position: [-600, 150]
          size: [130, 90]
          inputs:
