              clampMin: true
              normMax: 24.0
            - name: Menubuttonbgcolor
              style: RGBA
              label: Button Bg Color
              startSection: true
              default: [0.7, 0.7, 0.7, 1]
            - name: Menubuttononbgcolor
              style: RGBA
              label: Button On Bg Color
            - name: Menubuttonfontcolor
              style: RGBA
              label: Button Font Color
              default: [0.2, 0.2, 0.2, 1]
            - name: Menubuttononfontcolor
              style: RGBA
              label: Button On Font Color
              default: [0.3, 0.3, 0.3, 1]
            - name: Menubuttondisablecolor
              style: RGBA
              label: Button Disable Color
              default: [0.7, 0.7, 0.7, 1]
            - name: Menufontsize
              style: Int
              label: Menu Font Size
              startSection: true
              default: 10
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
            - name: Menufontbold
              style: Toggle
              label: Menu Font Bold
            - name: Menuitemverticalpadding
              style: Int
              label: Item Vertical Padding
              default: 7
