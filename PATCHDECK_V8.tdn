            fontcolorr: 0.62
            fontcolorg: 0.63
            fontcolorb: 0.62
            textoffsetx: 18
            alignx: left
            aligny: top
            h: 28
            hmode: fill
            alignorder: 1
            clickthrough: true
          size: [160, 130]
          color: [0.67, 0.67, 0.67]
        - name: out1
          type: outCHOP
          parameters:
            label: =me.name
            autoexportroot: =parent()
          flags:
          - viewer
          position: [275, 175]
          color: [0.67, 0.67, 0.67]
          inputs:
          - par1
        - name: par1
          type: parameterCHOP
          parameters:
            parameters: value0
            custom: false
            builtin: true
            renameto: v1
            autoexportroot: =parent()
          flags:
          - viewer
          position: [65, 175]
          size: [130, 90]
          color: [0.67, 0.67, 0.67]
        - name: text
          type: textCOMP
          parameters:
            text: Project folder
            type: multiline
            callbacks: text_callbacks
            legacyfontselection: true
            scaletofit: =parent().par[me.curPar.name] or me.curPar.val
            fontsize: 14
            linespacing: =parent().par[me.curPar.name] or me.curPar.val
            fontcolorr: 0.93
            fontcolorg: 0.93
            fontcolorb: 0.93
            textoffsetx: 16
            textpaddingl: =parent().par[me.curPar.name] or me.curPar.val
            textpaddingr: =parent().par[me.curPar.name] or me.curPar.val
            textpaddingb: =parent().par[me.curPar.name] or me.curPar.val
            textpaddingt: =parent().par[me.curPar.name] or me.curPar.val
            alignx: left
            aligny: bottom
