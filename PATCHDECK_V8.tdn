              - name: buttonDisabled
                type: textTOP
                parameters:
                  text: XXWWWWWWW
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('master').par.font
                  fontsizex: =op('master').par.fontsizex
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menudisablefontcolorr
                  fontcolorg: =parent.Widget.par.Menudisablefontcolorg
                  fontcolorb: =parent.Widget.par.Menudisablefontcolorb
                  fontalpha: =parent.Widget.par.Menudisablefontcolora
                  bgcolorr: =parent.Widget.par.Menudisablebgcolorr
                  bgcolorg: =parent.Widget.par.Menudisablebgcolorg
                  bgcolorb: =parent.Widget.par.Menudisablebgcolorb
                  bgalpha: =parent.Widget.par.Menudisablebgcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: 100
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -500]
                size: [130, 48]
              - name: buttonHighlighted
                type: textTOP
                parameters:
                  text: XX
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('master').par.font
                  fontsizex: =op('master').par.fontsizex
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menuhighlightfontcolorr
                  fontcolorg: =parent.Widget.par.Menuhighlightfontcolorg
                  fontcolorb: =parent.Widget.par.Menuhighlightfontcolorb
                  fontalpha: =parent.Widget.par.Menuhighlightfontcolora
                  bgcolorr: =parent.Widget.par.Menuhighlightbgcolorr
                  bgcolorg: =parent.Widget.par.Menuhighlightbgcolorg
                  bgcolorb: =parent.Widget.par.Menuhighlightbgcolorb
                  bgalpha: =parent.Widget.par.Menuhighlightbgcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: 100
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -600]
                size: [130, 48]
            - name: menuStatus
              type: constantCHOP
              parameters:
                autoexportroot: =parent()
              sequences:
                const:
                - name: openButton
                  value: -1
              flags:
              - viewer
              position: [300, -100]
              size: [130, 90]
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: menuButton*
                panelvalue: select rollover
                defaultreadencoding: cp1252
                language: input
              position: [300, 100]
              size: [130, 90]
              dat_content: "popMenu = op('popMenu')\n\ndef offToOn(panelValue):\n\text.TopMenuSubCompExt.onButton(panelValue)\n\treturn\n\n"
              dat_content_format: text
            - name: menuButton0
              type: containerCOMP
              parameters:
                w: =op('./bg').evalTextSize(op('./bg').par.value)[0] + parent.Widget.par.Menubuttonlabelmargin
                h: =parent().height
                vmode: fill
                alignorder: =100000 - me.nodeY
                enable: =ext.TopMenuSubCompExt.ButtonsEnable[me.digits] if ext.TopMenuSubCompExt.ButtonsEnable else True
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Menubuttononbgcolorr if int(op('menuStatus')['openButton']) == me.digits else parent.Widget.par.Menubuttonbgcolorr
                bgcolorg: =parent.Widget.par.Menubuttononbgcolorg if int(op('menuStatus')['openButton']) == me.digits else parent.Widget.par.Menubuttonbgcolorg
                bgcolorb: =parent.Widget.par.Menubuttononbgcolorb if int(op('menuStatus')['openButton']) == me.digits else parent.Widget.par.Menubuttonbgcolorb
                bgalpha: =parent.Widget.par.Menubuttononbgcolora if int(op('menuStatus')['openButton']) == me.digits else parent.Widget.par.Menubuttonbgcolora
                top: ./bg
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                leftborder: bordera
                rightborder: bordera
                bottomborder: bordera
                topborder: bordera
                borderover: false
                dodisablecolor: true
                disablecolorr: =parent.Widget.par.Menubuttondisablecolorr
                disablecolorg: =parent.Widget.par.Menubuttondisablecolorg
                disablecolorb: =parent.Widget.par.Menubuttondisablecolorb
                disablealpha: =parent.Widget.par.Menubuttondisablecolora
                align: horizlr
                justifyh: left
                justifyv: center
                enablecloning: false
              sequences:
                ext:
                - promote: true
              flags:
              - viewer
              position: [0, 100]
              size: [160, 130]
              children:
              - name: bg
                type: textCOMP
                parameters:
                  text: =parent(2).op('menuCategories')[parent().digits, 0]
                  callbacks: bg_textCOMP_callbacks
                  font: =parent.Widget.par.Font.eval()
                  bold: =parent.Widget.par.Menubuttonfontbold
                  fontsize: =parent.Widget.par.Menubuttonfontsize
                  fontsizeunits: points
                  fontcolorr: =parent.Widget.par.Menubuttononfontcolorr if int(op('../menuStatus')['openButton']) == parent().digits else (parent.Widget.par.Menudisablefontcolorr if not parent().par.enable else parent.Widget.par.Menubuttonfontcolorr)
                  fontcolorg: =parent.Widget.par.Menubuttononfontcolorg if int(op('../menuStatus')['openButton']) == parent().digits else (parent.Widget.par.Menudisablefontcolorg if not parent().par.enable else parent.Widget.par.Menubuttonfontcolorg)
                  fontcolorb: =parent.Widget.par.Menubuttononfontcolorb if int(op('../menuStatus')['openButton']) == parent().digits else (parent.Widget.par.Menudisablefontcolorb if not parent().par.enable else parent.Widget.par.Menubuttonfontcolorb)
                  fontalpha: =parent.Widget.par.Menubuttononfontcolora if int(op('../menuStatus')['openButton']) == parent().digits else (parent.Widget.par.Menudisablefontcolora if not parent().par.enable else parent.Widget.par.Menubuttonfontcolora)
                  w: 28
                  h: 28
                  hmode: fill
                  clickthrough: true
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  borderover: false
                position: [0, -200]
              - name: rollover
                type: containerCOMP
                parameters:
                  layer: 7
                  hmode: fill
                  vmode: fill
                  alignallow: ignore
                  display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                  clickthrough: true
                  resizecomp: =me
                  bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                  bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                  bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                  bgalpha: =parent.Widget.par.Rollovercolora.eval()
                  borderover: false
                  composite: =parent.Widget.par.Rollovercomposite.eval()
                flags:
                - viewer
                position: [0, 200]
                size: [160, 130]
              - name: bg_textCOMP_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                - -showDocked
                position: [0, -150]
                size: [160, 130]
                dock: bg
                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: menuButton1
              type: containerCOMP
