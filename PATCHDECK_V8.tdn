          color: [0.67, 0.67, 0.67]
        - name: Voxel_Grid_Init
          type: baseCOMP
          parameters:
            opviewer: ./voxels
          custom_pars:
            Voxels:
            - name: Popfluidsolvercomp
              style: OP
              label: POP Fluid Solver COMP
              value: POP_Fluid_Solver
            - name: Space2
              style: Header
              label: ' '
            - name: Init
              style: Pulse
            - name: Start
              style: Pulse
            - name: Space
              style: Header
              label: ' '
            - name: Resolution
              style: Int
              default: 32
              normMin: 8.0
              normMax: 64.0
            - name: Size
              style: XYZW
              size: 3
              default: 1
              normMin: 0.1
              values: [1.9, 1.1, 1.1]
            - name: Space3
              style: Header
              label: ' '
            - name: Copyright
              style: Str
              default: SARV
              readOnly: true
            - name: Version
              style: Str
              default: '1.0'
              readOnly: true
          flags:
          - viewer
          position: [-1000, -175]
          size: [160, 130]
          children:
          - name: grille
            type: glslPOP
            parameters:
              computedat: glsl_grille
              outputattrs: P Flag ijk BndN
            sequences:
              vec:
              - name: SimRes
                type: uint
                valuex: =parent().par.Resolution
              - name: SimSizex
                valuex: =parent().par.Sizex
              - name: SimSizey
                valuex: =parent().par.Sizey
              - name: SimSizez
                valuex: =parent().par.Sizez
            position: [-2350, -25]
            inputs:
            - attribute5
          - name: voxels
            type: outPOP
            position: [-1525, -25]
            inputs:
            - attribute1
          - name: feedback1
            type: feedbackPOP
            parameters:
              targetpop: =parent().par.Popfluidsolvercomp+'/end_fb'
            position: [-2050, -25]
            inputs:
            - attribute10
          - name: pointgen1
            type: pointgeneratorPOP
            parameters:
              createpointprim: false
              numpoints: =parent().par.Resolution**3
              normal: none
            position: [-2650, -25]
          - name: attribute1
            type: attributePOP
            parameters:
              deletepoint: BndN Div Flag ForcesIn Press Press_tmp Temp Temp_tmp U U_tmp ijk
            position: [-1750, -25]
            size: [130, 90]
            inputs:
            - attrib_select
          - name: attribute5
            type: attributePOP
            sequences:
              attr:
              - customname: BndN
                numcomps: '3'
              - customname: Flag
                type: uint
                value0: 1
              - customname: ijk
                numcomps: '3'
            position: [-2500, -25]
            size: [130, 90]
            inputs:
            - pointgen1
          - name: glsl2_info
            type: infoDAT
            parameters:
              op: grille
            flags:
            - -showDocked
            position: [-2200, -125]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dock: grille
            dat_read_only: true
          - name: attribute10
            type: attributePOP
            parameters:
              overrideifexists: false
            sequences:
              attr:
              - customname: U
                numcomps: '3'
              - customname: U_tmp
                numcomps: '3'
              - customname: Press
              - customname: Press_tmp
              - customname: Temp
              - customname: Temp_tmp
              - customname: Div
              - customname: ForcesIn
                numcomps: '3'
              - customname: Forces
                numcomps: '3'
            position: [-2200, -25]
            size: [130, 90]
            inputs:
            - grille
          - name: glsl_grille
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            - -showDocked
            position: [-2350, -125]
            size: [130, 90]
            dock: grille
            dat_content: |
              void main() {
                  const uint id = TDIndex();
                  if (id >= TDNumElements())
                      return;

                  uint R = max(SimRes, 1u);
                  uint N = R*R*R;

                  if (id < N) {
                      // 1D -> 3D indices (i,j,k) dans [0..R-1]
                      uint i =  id              % R;
                      uint j = (id / R)         % R;
                      uint k =  id / (R*R);

                      // Domaine centré
                      vec3 bmin = vec3(-0.5*SimSizex, -0.5*SimSizey, -0.5*SimSizez);
                      vec3 size = vec3( SimSizex,      SimSizey,      SimSizez );
                      vec3 h    = size / float(R); // taille cellule

                      // Centre de la cellule (i,j,k)
                      vec3 center = bmin + (vec3(i, j, k) + 0.5) * h;

                      // Écrit la position
                      P[id] = center;

                      // Normale discrète des bords (vers l'extérieur)
                      vec3 bnd = vec3(
                          (i==0u   ? -1.0 : (i==R-1u ?  1.0 : 0.0)),
                          (j==0u   ? -1.0 : (j==R-1u ?  1.0 : 0.0)),
                          (k==0u   ? -1.0 : (k==R-1u ?  1.0 : 0.0))
                      );
                      BndN[id] = bnd;

                      // Flag = 1 si cellule de bord, sinon 0 (cohérent avec BndN)
                      Flag[id] = any(notEqual(bnd, vec3(0.0))) ? 1u : 0u;

                      // Indices (pour les stencils)
                      ijk[id] = vec3(i, j, k);

                  } else {
                      // Points excédentaires: on les laisse tels quels
                      //P[id] = TDIn_P();
                  }
              }
            dat_content_format: text
          - name: attrib_select
            type: nullPOP
            position: [-1900, -25]
            inputs:
            - feedback1
          annotations:
          - name: annotate1
            mode: annotate
            title: Copyright
            text: The use of POP Fluid Solver tools is intended for your personal or professional creative projects, but must not be resold as-is (as .tox files, tool packs, templates, etc.). If you want to integrate these tools into a project or TouchDesigner file that will be sold to a client (installation, show pack, commercial template, client license, etc.), please contact me beforehand so we can agree on a proper license. Thanks for respecting this and supporting my work and future updates.
            position: [-2650, 150]
            size: [382, 288]
            color: [0.5, 0.05, 0.05]
        - name: POP_Fluid_Solver
          type: baseCOMP
          custom_pars:
            Custom:
            - name: Voxelgridinit
              style: OP
              label: Voxel Grid Init
              value: Voxel_Grid_Init
            - name: Space10
              style: Header
              label: ' '
            - name: Keeptopology
              style: Toggle
              label: Keep Topology
              default: true
            - name: Space7
              style: Header
              label: ' '
            - name: Dt
              style: Float
              label: dt
              default: 0.01667
              value: =op('null3')['r4']
            - name: Space
              style: Header
              label: ' '
            - name: Viscosity
              style: Float
              default: 0.0001
              normMin: 1.0e-05
              normMax: 0.0005
              value: 0.000271
            - name: Space2
              style: Header
              label: ' '
            - name: Vcstrengthx
              style: XYZW
              label: VC Strength
              size: 1
              default: 0.05
              normMax: 0.5
              value: 0.072
            - name: Curlminx
              style: XYZW
              label: Curl Min
              size: 1
              default: 0.3
              value: 0.321
            - name: Curlmaxx
              style: XYZW
              label: Curl Max
              size: 1
              default: 0.5
              value: 0.523
            - name: Space3
              style: Header
              label: ' '
            - name: Buoyancysigma
              style: Float
              label: Buoyancy Sigma
              default: 1
              normMax: 5.0
              value: 4.64
            - name: Referencetemperature
              style: Float
              label: Reference Temperature
              normMin: -3.0
              normMax: 3.0
              value: =op('null3')['r1']
            - name: Buoyancydirection
              style: XYZW
              label: Buoyancy Direction
              size: 3
              default: [0, 1, 0]
              values:
              - =op('null3')['r2']
              - =op('null3')['r3']
              - 1
            - name: Thermaldiffusivity
              style: Float
              label: Thermal Diffusivity
              default: 0.001
              normMin: 0.0001
              value: 0.506
            - name: Space4
              style: Header
