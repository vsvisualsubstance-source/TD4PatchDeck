    position: [725, 475]
    size: [160, 130]
    children:
    - name: add1
      type: addTOP
      position: [375, -75]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      inputs:
      - res1
      - res2
    - name: res1
      type: resolutionTOP
      parameters:
        outputresolution: custom
      flags:
      - viewer
      position: [150, 0]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      inputs:
      - cacheselect1
    - name: res2
      type: resolutionTOP
      parameters:
        outputresolution: custom
      position: [150, -125]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      inputs:
      - cacheselect2
    - name: comp1
      type: compositeTOP
      flags:
      - viewer
      position: [900, -450]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      inputs:
      - null3
      - null4
    - name: null1
      type: nullTOP
      flags:
      - viewer
      position: [1125, -450]
      size: [130, 105]
      color: [0.67, 0.67, 0.67]
      inputs:
      - comp1
    - name: null2
      type: nullTOP
      position: [575, -75]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      inputs:
      - add1
    - name: null3
      type: nullTOP
