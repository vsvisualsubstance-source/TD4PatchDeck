              borderar: 0
              borderag: 0
              borderab: 0
              borderaalpha: 0
              justifyv: center
            sequences:
              ext:
              - object: 'op(''./SliderExt'').module.SliderExt(me) '
                promote: true
            custom_pars:
              Slider:
                $t: slider_2
