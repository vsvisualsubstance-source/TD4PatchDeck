                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =parent.Widget.par.Font
                  dispmethod: bitmap
                  antialias: 'on'
                  fontsizex: =parent.Widget.par.Menufontsize
                  positionx: =parent.Widget.par.Menuitemhorizontalpadding1
                  alignx: left
                  fontcolorr: 0.71
                  fontcolorg: 0.72
                  fontcolorb: 0.72
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  bgalpha: 1
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionh: =op('textSizer').textHeight + parent.Widget.par.Menuitemverticalpadding * 2
                flags:
                - viewer
                position: [300, -200]
                size: [130, 48]
              - name: checkOn
                type: overTOP
                parameters:
                  legacyxform: true
                flags:
                - viewer
                position: [525, 150]
                size: [130, 49]
                inputs:
                - check
                - checkOff
              - name: subMenu
                type: textTOP
                parameters:
                  text: ='\uE102'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Segoe UI Symbol
                  fontsizex: 11
                  fontsizexunit: pixels
                  fontcolorr: 0.71
                  fontcolorg: 0.72
                  fontcolorb: 0.72
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('colDefine')['width','Check']
                  resolutionh: =op('master').par.resolutionh
                flags:
                - lock
                - viewer
                position: [525, 225]
                size: [130, 48]
              - name: checkOff
                type: rectangleTOP
