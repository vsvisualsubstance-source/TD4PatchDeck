            type: chopexecuteDAT
            parameters:
              fromop: =parent()
              chop: null1
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [925, 0]
            size: [130, 90]
            dat_content: "def onValueChange(channel, sampleIndex, val, prev):\n\n\tmax = op('table1')[1,1]\n\tmin = op('table1')[1,0]\n\n\tif val < min:\n\t\tmin = val\n\t\top('table1')[1,'MIN'] = round(min,3)\n\t\n\tif val > max:\n\t\tmax = val\n\t\top('table1')[1,'MAX'] = round(max,3)\n\n\n\top('table1')[1,'AVERAGE'] = round((max + min) /2, 3)\n\n\n\treturn\n\t"
            dat_content_format: text
