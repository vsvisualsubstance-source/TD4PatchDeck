          type: lagCHOP
          parameters:
            lag1: ~parent().par.Lag
            lag2: ~parent().par.Lag
            snap: false
          flags:
          - viewer
          position: [-1075, -75]
          size: [130, 90]
          inputs:
          - math1
        - name: out1
          type: outCHOP
          parameters:
            label: =me.name
