                Buttononfacecolor: [0.3276, 0.4719, 0.52, 1]
                Buttonofffontcolor: [0.6, 0.6, 0.6, 1]
                Buttonhorizontalmode: fixed
                Buttonwidth: 24
            flags:
            - viewer
            position: [700, -500]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
