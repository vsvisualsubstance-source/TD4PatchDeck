              label: Num Points
              default: 1000
              normMax: 10000.0
              value: 6438
            - name: Shape
              style: Menu
              default: sphere
              menuNames:
              - sphere
              - box
              - torus
              - spheresurf
              - boxsurf
              - torussurf
              - rectangle
              - circle
              - disc
              - line
              menuLabels:
              - Sphere
              - Box
              - Torus
              - Sphere Surface
              - Box Surface
              - Torus Surface
              - Rectangle
              - Circle
              - Disc
              - Line
              value: disc
            - name: Orientation
              style: Menu
              default: xy
              menuNames:
              - xy
              - yz
              - zx
              menuLabels:
              - XY Plane
              - YZ Plane
              - ZX Plane
              enableExpr: me.par.Shape in ['rectangle', 'circle', 'disc', 'torus', 'torussurf']
            - name: Shapesize
              style: XYZW
              label: Size
              size: 3
              default: 1
              enableExpr: me.par.Shape in ['box', 'boxsurf', 'rectangle']
              enable: false
            - name: Radius
              style: XYZW
              size: 3
              default: [1, 0.5, 0]
              enableExpr: me.par.Shape in ['sphere', 'spheresurf', 'circle', 'disc', 'torus', 'torussurf']
              values: [1, 1, 1]
            - name: Pa
              style: XYZW
              label: Point A
              size: 3
              default: [-1, 0, 0]
              enableExpr: me.par.Shape == 'line'
              enable: false
            - name: Pb
              style: XYZW
              label: Point B
              size: 3
              default: [1, 0, 0]
              enableExpr: me.par.Shape == 'line'
              enable: false
            - name: Randomseed
              style: Int
              label: Random Seed
              normMax: 10000.0
            - name: Randomdist
              style: Toggle
              label: Random Dist
              default: true
              enableExpr: me.par.Shape == 'spheresurf'
              enable: false
            - name: Transform
              style: Header
            - name: Xord
              style: Menu
              label: Transform Order
              startSection: true
              default: srt
              menuSource: op('./pointtransform1').par.xord
            - name: Rord
              style: Menu
              label: Rotate Order
              default: xyz
              menuSource: op('./pointtransform1').par.rord
            - name: T
              style: XYZW
              label: Translate
              size: 3
            - name: R
              style: XYZW
              label: Rotate
              size: 3
            - name: S
              style: XYZW
              label: Scale
              size: 3
              default: 1
            - name: P
              style: XYZW
              label: Pivot
              size: 3
            About:
              $t: about_2
              Version: 1.2.1
              Toxsavebuild: '2023.11454'
              Build: 1
              Date: 2026-08-24 10:42:26 UTC
              Touchbuild: '2025.33070'
          position: [-3200, 2525]
          size: [160, 130]
          children:
          - name: box
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            position: [-180, -380]
            size: [130, 90]
            dat_content: "uniform float uRandom;\nuniform float uNumPoints;\nuniform vec3 uSize;\n\n\nvoid createPoint(in vec2 vUV)\n{\n    int texRes = int(uTD2DInfos[0].res.w);\n\tint\tpointNum = int(vUV.s * texRes) + int(vUV.t * texRes) * texRes;\n    vec3 point = vec3(0.0);\n\tvec4 rnd = texture(sTD2DInputs[0], vUV);\n\tfloat side = (rnd.w + 2) * 3;\n\tint axis = int(side) % 3;\n\tvec3 norm = vec3(0.0);\n\tnorm[axis] = (fract(side) >= 0.5) ? 1 : -1;\n\tnorm[axis] = rnd[axis];\n\tpoint = (rnd.xyz * uSize * uRandom);\n\tgPoint.pos = point;\n\tgPoint.norm = norm;\n}\n"
            dat_content_format: text
          - name: disc
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            position: [-180, -710]
            size: [130, 90]
            dat_content: "uniform float uRandom;\nuniform float uNumPoints;\nuniform vec3 uRadius;\nuniform int uRandDist;\nuniform int uOrientation;\n\n#define PI 3.141592653589793;\n\nvoid createPoint(in vec2 vUV)\n{\n    int texRes = int(uTD2DInfos[0].res.w);\n\tint\tpointNum = int(vUV.s * texRes) + int(vUV.t * texRes) * texRes;\n    vec3 point = vec3(0.0);\n\tvec4 rnd = texture(sTD2DInputs[0], vUV);\n\t\n\tfloat twoPi = 2.0 * PI;\n\tfloat r = sqrt((rnd.x + 1.0)/2);\n\tfloat a = (rnd.y + 1.0)/2.0 * twoPi;\n\tpoint.x = r * uRadius.x * cos(a);\n\tpoint.y = r * uRadius.y * sin(a);\n\t\n\t// normals\n\tint axis = int(mod(uOrientation+2,3));\n\tvec3 norm = vec3(0.0);\n\tnorm[axis] = 1.0;\n\n\t// orientation\n\tif (uOrientation == 1)\n\t{\n\t\tpoint = point.zxy;\n\t}\n\telse if (uOrientation == 2)\n\t{\n\t\tpoint = point.xzy;\n\t}\n\n\tgPoint.pos = point;\n\tgPoint.norm = norm;\n}"
            dat_content_format: text
          - name: line
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            position: [-180, -1150]
            size: [130, 90]
            dat_content: "uniform float uRandom;\nuniform float uNumPoints;\nuniform vec3 uLinePtA;\nuniform vec3 uLinePtB;\n\n#define PI 3.141592653589793;\n\nvec3 createNormal(in vec3 normLine)\n{\n\tvec3 normVec = vec3(1.0,0.0,0.0);\n\tfloat angle = acos(dot(normLine, normVec));\n\tvec3 axis = cross(normLine, normVec);\n\n\tfloat c = cos(angle);\n\tfloat s = sin(angle);\n\tfloat t = 1-c;\n\n\t// rotate around vec3(0,0,1)\n\tmat4 rotMat;\n\trotMat[0] = vec4(c,-s,0,0);\n\trotMat[1] = vec4(s,c,0,0);\n\trotMat[2] = vec4(0,0,c+t,0);\n\trotMat[3] = vec4(0.0,0.0,0.0,1.0);\n\n\tvec4 newPer = vec4(0,1,0,1) * rotMat;\n\treturn newPer.xyz;\n}\n\nvoid createPoint(in vec2 vUV)\n{\n    int texRes = int(uTD2DInfos[0].res.w);\n\tint\tpointNum = int(vUV.s * texRes) + int(vUV.t * texRes) * texRes;\n    vec3 point = vec3(0.0);\n\tvec4 rnd = texture(sTD2DInputs[0], vUV);\n\trnd = (rnd + 1.0) / 2.0;\n\tvec3 lineVec = uLinePtB - uLinePtA;\n\tpoint = uLinePtA + lineVec * rnd.x;\n\n\tvec3 normLine = lineVec / length(lineVec);\n\tvec3 newPer = createNormal(normLine);\n\n\tgPoint.pos = point;\n\tgPoint.norm = newPer.xyz;\n}"
            dat_content_format: text
          - name: glsl2
            type: glslTOP
            parameters:
              pixeldat: glsl2_pixel
              computedat: glsl2_compute
              autodispatchsize: false
              numcolorbufs: 2
            sequences:
              vec:
              - name: uNumPoints
                valuex: ~parent.PointGenerator.par.Numpoints
              - name: uRandom
                valuex: 1
              - name: uOrientation
                valuex: ~parent.PointGenerator.par.Orientation
              - name: uRadius
                valuex: ~parent.PointGenerator.par.Radiusx
                valuey: ~parent.PointGenerator.par.Radiusy
                valuez: ~parent.PointGenerator.par.Radiusz
              - name: uSize
                valuex: ~parent.PointGenerator.par.Shapesizex
                valuey: ~parent.PointGenerator.par.Shapesizey
                valuez: ~parent.PointGenerator.par.Shapesizez
              - name: uLinePtA
                valuex: ~parent.PointGenerator.par.Pax
                valuey: ~parent.PointGenerator.par.Pay
                valuez: ~parent.PointGenerator.par.Paz
              - name: uLinePtB
                valuex: ~parent.PointGenerator.par.Pbx
                valuey: ~parent.PointGenerator.par.Pby
                valuez: ~parent.PointGenerator.par.Pbz
              - name: uRandDist
                valuex: ~parent.PointGenerator.par.Randomdist
            flags:
            - viewer
            position: [240, 140]
            size: [130, 90]
            inputs:
            - noise1
          - name: torus
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            position: [-180, -930]
            size: [130, 90]
            dat_content: "uniform float uRandom;\nuniform float uNumPoints;\nuniform int uOrientation;\nuniform vec2 uRadius;\n\n#define PI 3.141592653589793;\n\nvoid createPoint(in vec2 vUV)\n{\n    int texRes = int(uTD2DInfos[0].res.w);\n\tint\tpointNum = int(vUV.s * texRes) + int(vUV.t * texRes) * texRes;\n    vec3 point = vec3(0.0);\n\tvec4 rnd = abs(texture(sTD2DInputs[0], vUV));\n\tint axis = int(mod(uOrientation+2,3));\n\tfloat volume = uRadius.y * rnd.z;\n\tfloat twoPi = 2.0 * PI;\n\n\trnd.xy *= twoPi;\n\tpoint.x = (uRadius.x + volume * cos(rnd.s))*cos(rnd.t);\n\tpoint.y = (uRadius.x + volume * cos(rnd.s))*sin(rnd.t);\n\tpoint.z = (volume * sin(rnd.s));\n\t\n\tvec3 norm = vec3(0.0);\n\tvec3 refPoint = vec3(0.0);\n\trefPoint.x = uRadius.x * cos(rnd.t);\n\trefPoint.y = uRadius.x * sin(rnd.t);\n\tnorm = point - refPoint;\n\n\tif (uOrientation == 1)\n\t{\n\t\tpoint = point.zyx;\n\t\tnorm = norm.zyx;\n\t}\n\telse if (uOrientation == 2)\n\t{\n\t\tpoint = point.xzy;\n\t\tnorm = norm.xzy;\n\t}\n\n\tgPoint.pos = point;\n\tgPoint.norm = norm;\n}"
            dat_content_format: text
          - name: circle
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            position: [-180, -820]
            size: [130, 90]
            dat_content: "uniform float uRandom;\nuniform float uNumPoints;\nuniform vec2 uRadius;\nuniform int uOrientation;\n\nvoid createPoint(in vec2 vUV)\n{\n    int texRes = int(uTD2DInfos[0].res.w);\n\tint\tpointNum = int(vUV.s * texRes) + int(vUV.t * texRes) * texRes;\n    vec3 point = vec3(0.0);\n\tvec4 rnd = texture(sTD2DInputs[0], vUV);\n\tint axis = int(mod(uOrientation+2,3));\n\trnd[axis] = 0.0; \n\trnd.xyz = rnd.xyz / length( rnd.xyz );\n\tvec3 radius = vec3(uRadius, 0.0);\n\tif (uOrientation == 1)\n\t{\n\t\tradius = vec3(0.0, uRadius);\n\t}\n\telse if (uOrientation == 2)\n\t{\n\t\tradius = vec3(uRadius.x, 0.0, uRadius.y);\n\t}\n\tpoint = (rnd.xyz * radius * uRandom);\n\tgPoint.pos = point;\n\tgPoint.norm = point;\n}"
            dat_content_format: text
          - name: noise1
            type: noiseTOP
            parameters:
              type: random
              seed: ~parent.PointGenerator.par.Randomseed
              period: 2
              harmon: 1
              amp: 1
              offset: 0
              mono: false
              alpha: random
              outputresolution: custom
              resolutionw: =math.sqrt(parent.PointGenerator.par.Numpoints)
              resolutionh: =me.par.resolutionw
              filtertype: nearest
              format: rgba32float
            flags:
            - viewer
            position: [70, 140]
            size: [130, 90]
          - name: sphere
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            position: [-180, -160]
            size: [130, 90]
            dat_content: "uniform float uRandom;\nuniform float uNumPoints;\nuniform vec3 uRadius;\n\n#define PI 3.141592653589793;\n\nvoid createPoint(in vec2 vUV)\n{\n    int texRes = int(uTD2DInfos[0].res.w);\n\tint pointNum = int(vUV.s * texRes) + int(vUV.t * texRes) * texRes;\n    vec3 point = vec3(0.0);\n\tvec4 rnd = abs(texture(sTD2DInputs[0], vUV));\n\n\tfloat twoPi = 2.0 * PI;\n\tfloat theta = twoPi * rnd.s;\n\tfloat phi = acos(2*rnd.t - 1.0);\n\tfloat third = 1.0 / 3.0;\n\tvec3 radius = pow(vec3(rnd.p), vec3(third)) * uRadius;\n\tpoint.x = cos(theta) * sin(phi);\n\tpoint.y = sin(theta) * sin(phi);\n\tpoint.z = cos(phi);\n\tpoint *= radius;\n\tgPoint.pos = point;\n\tgPoint.norm = point;\n}\n"
            dat_content_format: text
          - name: boxsurf
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            position: [-180, -490]
            size: [130, 90]
            dat_content: "uniform float uRandom;\nuniform float uNumPoints;\nuniform vec3 uSize;\n\n\nvoid createPoint(in vec2 vUV)\n{\n    int texRes = int(uTD2DInfos[0].res.w);\n\tint\tpointNum = int(vUV.s * texRes) + int(vUV.t * texRes) * texRes;\n    vec3 point = vec3(0.0);\n\tvec4 rnd = texture(sTD2DInputs[0], vUV);\n\tfloat side = (rnd.w + 2) * 3;\n\tint axis = int(side) % 3;\n\trnd[axis] = (fract(side) >= 0.5) ? 1 : -1;\n\tvec3 norm = vec3(0.0);\n\tnorm[axis] = rnd[axis];\n\tpoint = (rnd.xyz * uSize * uRandom);\n\tgPoint.pos = point;\n\tgPoint.norm = norm;\n}\n"
            dat_content_format: text
          - name: normals
            type: outTOP
            parameters:
              label: =me.name
              connectorder: 1
            flags:
            - viewer
            position: [1010, -10]
            size: [130, 90]
            inputs:
            - pointtransform2
          - name: positions
            type: outTOP
            parameters:
              label: =me.name
            flags:
            - viewer
            position: [1010, 130]
            size: [130, 90]
            inputs:
            - pointtransform1
          - name: rectangle
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            position: [-180, -600]
            size: [130, 90]
            dat_content: "uniform float uRandom;\nuniform float uNumPoints;\nuniform int uOrientation;\nuniform vec3 uSize;\n\nvoid createPoint(in vec2 vUV)\n{\n    int texRes = int(uTD2DInfos[0].res.w);\n\tint\tpointNum = int(vUV.s * texRes) + int(vUV.t * texRes) * texRes;\n    vec3 point = vec3(0.0);\n\tvec4 rnd = texture(sTD2DInputs[0], vUV);\n\tint axis = int(mod(uOrientation+2,3));\n\trnd[axis] = 0.0;\n\tvec3 norm = vec3(0.0);\n\tnorm[axis] = 1.0;\n\tvec3 size = uSize;\n\tif (uOrientation == 1)\n\t{\n\t\tsize = vec3(0.0, size.x, size.y);\n\t} \n\telse if (uOrientation == 2)\n\t{\n\t\tsize = vec3(size.x, 0.0, size.y);\n\t}\n\tpoint = point + (rnd.xyz * size * uRandom);\n\tgPoint.pos = point;\n\tgPoint.norm = norm;\n}"
            dat_content_format: text
          - name: torussurf
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            position: [-180, -1040]
            size: [130, 90]
            dat_content: "uniform float uRandom;\nuniform float uNumPoints;\nuniform int uOrientation;\nuniform vec2 uRadius;\n\n#define PI 3.141592653589793;\n\nvoid createPoint(in vec2 vUV)\n{\n    int texRes = int(uTD2DInfos[0].res.w);\n\tint\tpointNum = int(vUV.s * texRes) + int(vUV.t * texRes) * texRes;\n    vec3 point = vec3(0.0);\n\tvec4 rnd = texture(sTD2DInputs[0], vUV);\n\tint axis = int(mod(uOrientation+2,3));\n\trnd.xy *= 2*PI;\n\tpoint.x = (uRadius.x + uRadius.y * cos(rnd.s))*cos(rnd.t);\n\tpoint.y = (uRadius.x + uRadius.y * cos(rnd.s))*sin(rnd.t);\n\tpoint.z = (uRadius.y * sin(rnd.s));\n\n\tvec3 norm = vec3(0.0);\n\tvec3 refPoint = vec3(0.0);\n\trefPoint.x = uRadius.x * cos(rnd.t);\n\trefPoint.y = uRadius.x * sin(rnd.t);\n\tnorm = point - refPoint;\n\n\tif (uOrientation == 1)\n\t{\n\t\tpoint = point.zyx;\n\t}\n\telse if (uOrientation == 2)\n\t{\n\t\tpoint = point.xzy;\n\t}\n\tgPoint.pos = point;\n\tgPoint.norm = norm;\n}"
            dat_content_format: text
          - name: docsHelper
