                label: Font File
              - name: Radiofontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
              - name: Radiofontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                enableExpr: me.par.Radiofontsizemode.eval() in ['points', 'panelunits']
                value: 9
              - name: Radiofontfraction
                style: Float
                label: Font Fraction
                default: 1
                enableExpr: me.par.Radiofontsizemode.eval() in ['fract', 'relfract']
                enable: false
              - name: Radioscaletofit
                style: Menu
                label: Scale Text to Fit
                default: never
                menuNames:
                - never
                - always
                - onlyshrink
                menuLabels:
                - Never
                - Always
                - Only when Too Large
              - name: Radiofontbold
                style: Toggle
                label: Font Bold
                value: true
              - name: Radioitalic
                style: Toggle
                label: Italic
              - name: Radiodropshadow
                style: Toggle
                label: Drop Shadow
              - name: Radioalignx
                style: Menu
                label: Align Horizontal
                startSection: true
                default: Center
                menuNames:
                - left
                - center
                - right
                menuLabels:
                - Left
                - Center
                - Right
                value: center
              - name: Radioalignxmode
                style: Menu
                label: Align Horizontal Mode
                default: metrics
                menuNames:
                - metrics
                - bbox
                menuLabels:
                - Use Font Metrics
                - Use Text Bounding Box
                value: bbox
              - name: Radioaligny
                style: Menu
                label: Align Vertical
                default: Center
                menuNames:
                - bottom
                - center
                - top
                menuLabels:
                - Bottom
                - Center
                - Top
                value: center
              - name: Radioalignymode
                style: Menu
                label: Align Vertical Mode
                default: metrics
                menuNames:
                - metrics
                - bbox
                menuLabels:
                - Use Font Metrics
                - Use Text Bounding Box
                value: bbox
              - name: Radiooffset
                style: XYZW
                label: Offset
                size: 2
                startSection: true
                min: -5.0
                max: 5.0
                normMin: -5.0
                normMax: 5.0
              - name: Radiopadding
                style: Float
                label: Padding
                size: 4
              - name: Radioofftop
                style: TOP
                label: Off TOP
                startSection: true
              - name: Radioontop
                style: TOP
                label: On TOP
              - name: Radiobasecolor
                style: RGBA
                label: Base Color
                startSection: true
                values: [0.3, 0.3, 0.3, 1]
              - name: Radioofffacecolor
                style: RGBA
                label: Off Face Color
                default: [0.4, 0.4, 0.4, 1]
                values: [0.28, 0.28, 0.28, 1]
              - name: Radioonfacecolor
                style: RGBA
                label: On Face Color
                default: [0.7, 0.7, 0.7, 1]
                values: [0.3276, 0.4719, 0.52, 1]
              - name: Radioofffontcolor
                style: RGBA
                label: Off Font Color
                default: [0.2, 0.2, 0.2, 1]
                values: [0.18182, 0.18182, 0.18182, 1]
              - name: Radioonfontcolor
                style: RGBA
                label: On Font Color
                default: [0, 0, 0, 1]
                values: [0.629824, 0.781456, 0.832, 1]
              - name: Radiobordera
                style: Toggle
                label: Border A
                default: true
                value: false
              - name: Radioborderacolor
                style: RGBA
                label: Border A Color
                default: [0.3, 0.3, 0.3, 1]
                values: [1, 1, 1, 1]
              - name: Radioborderb
                style: Toggle
                label: Border B
                default: true
                value: false
              - name: Radioborderbcolor
                style: RGBA
                label: Border B Color
                default: [0.3, 0.3, 0.3, 1]
                values: [0, 0, 0, 1]
              - name: Radiocustomizeinteraction
                style: Pulse
                label: Customize Interaction
                startSection: true
              - name: Radiopanelexec
                style: DAT
                label: Panel Exec
                readOnly: true
              - name: Radiohorizontalmode
                style: Menu
                label: Horizontal Mode
                startSection: true
                default: fixed
                menuNames:
                - fixed
                - fill
                menuLabels:
                - Fixed Width
                - Fill
                value: fill
              - name: Radiowidth
                style: Int
                label: Width
                default: 88
                min: 1.0
                max: 300.0
                clampMin: true
                normMin: 1.0
                normMax: 300.0
                value: 100
              - name: Radiohfillweight
                style: Float
                label: Horizontal Fill Weight
                default: 1
                clampMin: true
              - name: Radioverticalmode
                style: Menu
                label: Vertical Mode
                default: fixed
                menuNames:
                - fixed
                - fill
                menuLabels:
                - Fixed Height
                - Fill
                value: fill
              - name: Radioheight
                style: Int
                label: Height
                default: 88
                min: 1.0
                max: 300.0
                clampMin: true
                normMin: 1.0
                normMax: 300.0
              - name: Radiovfillweight
                style: Float
                label: Vertical Fill Weight
                default: 1
                clampMin: true
            flags:
            - viewer
            position: [400, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: radio0
              type: containerCOMP
              parameters:
                w: 20
                h: =parent().par.h
                hmode: fill
                vmode: fill
                alignorder: =me.digits
                display: =0 if me.digits > op('replicator1').par.numreplicants else 1
                helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
                clickthrough: =parent.Widget.par.clickthrough
                resizecomp: =me
                top: ./bg
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderover: false
                align: horizlr
                justifyh: left
                justifyv: center
                crop: 'on'
                clone: radio0
              sequences:
                ext:
                - promote: true
              flags:
              - viewer
              position: [-1, 100]
              size: [161, 130]
              children:
              - name: text
                type: textCOMP
                parameters:
                  text: =tdu.split(parent.Widget.par.Radiolabels.eval())[parent().digits]
                  callbacks: text1_callbacks
                  font: =parent.Widget.par.Radiofont.eval()
                  fontfile: =parent.Widget.par.Radiofontfile
                  bold: =parent.Widget.par.Radiofontbold.eval()
                  italic: =parent.Widget.par.Radioitalic
                  scaletofit: =parent.Widget.par.Radioscaletofit
                  fontsize: =parent.Widget.par.Radiofontsize.eval() if parent.Widget.par.Radiofontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Radiofontfraction.eval()
                  fontsizeunits: =parent.Widget.par.Radiofontsizemode.eval()
                  fontcolorr: =me.par.Fontcolor.eval()[0]
                  fontcolorg: =me.par.Fontcolor.eval()[1]
                  fontcolorb: =me.par.Fontcolor.eval()[2]
                  fontalpha: =me.par.Fontcolor.eval()[3]
                  dropshadow: =parent.Widget.par.Radiodropshadow
                  textoffsetx: =parent.Widget.par.Radiooffsetx.eval()
                  textoffsety: =parent.Widget.par.Radiooffsety.eval()
                  alignx: =parent.Widget.par.Radioalignx.eval()
                  alignxmode: =parent.Widget.par.Radioalignxmode.eval()
                  aligny: =parent.Widget.par.Radioaligny.eval()
                  alignymode: =parent.Widget.par.Radioalignymode.eval()
                  hmode: fill
                  clickthrough: true
                  bgcolorr: =me.par.Facecolor.eval()[0]
                  bgcolorg: =me.par.Facecolor.eval()[1]
                  bgcolorb: =me.par.Facecolor.eval()[2]
                  bgalpha: =me.par.Facecolor.eval()[3]
                  top: '=me.par.Mapon.eval() if me.par.Value else me.par.Mapoff.eval() '
                  borderar: =parent.Widget.par.Radioborderacolorr
                  borderag: =parent.Widget.par.Radioborderacolorg
                  borderab: =parent.Widget.par.Radioborderacolorb
                  borderaalpha: =parent.Widget.par.Radioborderacolora
                  borderbr: =parent.Widget.par.Radioborderbcolorr
                  borderbg: =parent.Widget.par.Radioborderbcolorg
                  borderbb: =parent.Widget.par.Radioborderbcolorb
                  borderbalpha: =parent.Widget.par.Radioborderbcolora
                  leftborder: =parent.Widget.par.Radiobordera
                  leftborderi: =parent.Widget.par.Radioborderb * 2
                  rightborder: =parent.Widget.par.Radiobordera
                  rightborderi: =parent.Widget.par.Radioborderb * 2
                  bottomborder: =parent.Widget.par.Radiobordera
                  bottomborderi: =parent.Widget.par.Radioborderb * 2
                  topborder: =parent.Widget.par.Radiobordera
                  topborderi: =parent.Widget.par.Radioborderb * 2
                custom_pars:
                  Expressions:
                    $t: expressions_2
                    Value: =getattr(parent.Widget.par, 'Value'+str(parent(2).digits)) == parent().digits
                    Mapoff: =parent.Widget.par.Radioofftop.eval()
                    Mapon: =parent.Widget.par.Radioontop.eval()
                    Fontcolor: =parent.Widget.parGroup.Radioonfontcolor if me.par.Value else parent.Widget.parGroup.Radioofffontcolor
                    Facecolor: =parent.Widget.parGroup.Radioonfacecolor if me.par.Value else parent.Widget.parGroup.Radioofffacecolor
              - name: rollover
                type: containerCOMP
                parameters:
                  layer: 7
                  hmode: fill
                  vmode: fill
                  alignallow: ignore
                  display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                  clickthrough: true
                  resizecomp: =me
                  bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                  bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                  bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                  bgalpha: =parent.Widget.par.Rollovercolora.eval()
                  borderover: false
                  composite: =parent.Widget.par.Rollovercomposite.eval()
                flags:
                - viewer
                position: [0, 225]
                size: [160, 130]
              - name: text1_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                - -showDocked
                position: [0, -150]
                size: [160, 130]
                dock: text
                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: radio1
              type: containerCOMP
              parameters:
                w: 20
