                startSection: true
                default: momentary
                menuNames:
                - Momentary
                - Momentary Up
                - Toggle Down
                - Toggle Up
                - Toggle Up Anywhere
                - Radio Down
                - Radio Up
                - Radio Up Anywhere
                - Exclusive Down
                - Exclusive Up
