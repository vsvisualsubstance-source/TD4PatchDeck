              - Only when Too Large
            - name: Labelfontbold
              style: Toggle
              label: Font Bold
            - name: Labelitalic
              style: Toggle
              label: Italic
            - name: Labeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Labelalignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: left
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Labelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
            - name: Labeloffset
              style: XYZW
              label: Offset
              size: 2
              startSection: true
              default: 6
              min: -5.0
              max: 5.0
              normMin: -5.0
              normMax: 5.0
            - name: Labelpadding
              style: Float
              label: Padding
              size: 4
            - name: Labelbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: 0.2
              clampMin: true
              clampMax: true
            - name: Labelfontcolor
              style: RGBA
              label: Font Color
              default: 0.65
              clampMin: true
              clampMax: true
            - name: Labelhorizontalmode
              style: Menu
              label: Horizontal Mode
              startSection: true
              default: fixed
              menuNames:
              - fixed
              - fill
              menuLabels:
              - Fixed Width
              - Fill
            - name: Labelwidth
              style: Int
              label: Width
              default: 120
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
            - name: Labelhfillweight
              style: Float
              label: Horizontal Fill Weight
              default: 0.5
              clampMin: true
            - name: Labelverticalmode
              style: Menu
              label: Vertical Mode
              default: fill
              menuNames:
              - fixed
