                  textpaddingb: =parent.Widget.par.Foldertabpadding3.eval()
                  textpaddingt: =parent.Widget.par.Foldertabpadding4.eval()
                  alignx: =parent.Widget.par.Foldertabalignx.eval()
                  alignxmode: =parent.Widget.par.Foldertabalignxmode.eval()
                  aligny: =parent.Widget.par.Foldertabaligny.eval()
                  alignymode: =parent.Widget.par.Foldertabalignymode.eval()
                  hmode: anchors
