            - name: Buttonpanelexec
              style: DAT
              label: Panel Exec
              readOnly: true
              enable: false
            - name: Buttonhorizontalmode
              style: Menu
              label: Horizontal Mode
              startSection: true
              default: fill
              menuNames:
              - fixed
              - fill
              menuLabels:
              - Fixed Width
              - Fill
            - name: Buttonwidth
              style: Int
              label: Width
              default: 27
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
              enableExpr: me.par.Buttonhorizontalmode =='fixed'
