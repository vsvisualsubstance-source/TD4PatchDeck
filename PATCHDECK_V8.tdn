              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: referOP0
            type: containerCOMP
            parameters:
              w: 30
              h: 30
              layer: 4
              hmode: fill
              vmode: fill
              alignorder: =-me.nodeY
              display: =parent.Widget.par.Referfielddisplay
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              top: ./bg
              borderover: false
              align: horizlr
              spacing: 1
              justifyv: center
              drop: legacy
              dropscript: ./drop
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./ReferExt').module.ReferExt(me)
            custom_pars:
              OP:
                $t: op
                Referfieldfontsize: 9
                Referfieldalignx: left
                Referfieldaligny: center
                Referfieldbgcolor: [0.45, 0.45, 0.45, 1]
                Referfieldfontcolor: [0.15, 0.15, 0.15, 1]
                Referfieldbordercolor: [0, 0, 0, 0]
                Referfieldborderleft: false
                Referfieldborderright: false
                Referfieldbordertop: false
                Referfieldborderbottom: false
            flags:
            - viewer
            position: [400, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: drop
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -195]
              size: [200, 85]
              dat_content: |+
                #debug('drop', args)
                name = args[0]
                dragType = eval(args[5])
                dragPath = args[6]
                #dropPath = args[7]
                #dropComp = op(dropToPath)

                dragOp = op(dragPath + '/' + name)

                #debug(TDF.getShortcutPath(dragOp, parent.Widget))

                #expr = "TDF.getShortcutPath(" + dragOp, parent.Widget)

                relpath = parent.Widget.relativePath(op(dragPath + '/' + name))

                parent.Widget.par.Value0.val = relpath

              dat_content_format: text
            - name: field
              type: textCOMP
              parameters:
                text: ~getattr(parent.Widget.par, 'Value'+str(parent().digits))
                customformatting: '{val.replace(" ","_")}'
                editmode: editable
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Referfieldfontbold.eval()
                italic: =parent.Widget.par.Referfielditalic
                scaletofit: =parent.Widget.par.Referfieldscaletofit
                fontsize: =parent.Widget.par.Referfieldfontsize.eval() if parent.Widget.par.Referfieldfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Referfieldfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Referfieldfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Referfieldfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Referfieldfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Referfieldfontcolorb.eval()
                fontalpha: =parent.Widget.par.Referfieldfontcolora.eval()
                dropshadow: =parent.Widget.par.Referfielddropshadow
                textoffsetx: =parent.Widget.par.Referfieldoffsetx.eval()
                textoffsety: =parent.Widget.par.Referfieldoffsety.eval()
                textpaddingl: =parent.Widget.par.Referfieldpadding1.eval()
                textpaddingr: =parent.Widget.par.Referfieldpadding2.eval()
                textpaddingb: =parent.Widget.par.Referfieldpadding3.eval()
                textpaddingt: =parent.Widget.par.Referfieldpadding4.eval()
                alignx: =parent.Widget.par.Referfieldalignx.eval()
                aligny: =parent.Widget.par.Referfieldaligny.eval()
                w: 30
                h: 30
                hmode: fill
                alignorder: =10000 - (me.nodeY)
                clickthrough: =parent.Widget.par.clickthrough
                bgcolorr: =parent.Widget.par.Referfieldbgcolorr
                bgcolorg: =parent.Widget.par.Referfieldbgcolorg
                bgcolorb: =parent.Widget.par.Referfieldbgcolorb
                bgalpha: =parent.Widget.par.Referfieldbgcolora
                top: ./bg
                borderover: false
            - name: ReferExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\n\nclass ReferExt(SubWidgetExt):\n\t\"\"\"\n\tReferExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Referfield'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef makePanelExecute(self):\n\t\toppath = parent.Widget.relativePath(self.ownerComp)[2:]\n\t\tSubWidgetExt.makePanelExecute(self, self.getDockExpressionToOwner()\n\t\t\t\t\t\t\t\t\t  + \".op('field')\")"
              dat_content_format: text
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =parent().panel.rollover or parent().panel.lselect or parent().panel.inside
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [0, 200]
              size: [160, 130]
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-500, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: panelexecValue
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: ..
                panelvalue: lselect
                ontooff: true
                defaultreadencoding: cp1252
                language: input
              position: [-300, 0]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-300, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: parexecSettings
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Referfieldcustomizeinteraction Referfieldhorizontalmode Referfieldverticalmode
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
          - name: valueOut
            type: outCHOP
            parameters:
              label: =me.name
              autoexportroot: =parent()
            position: [400, 0]
            inputs:
            - output
        - name: referenceTOP
          type: widgetCOMP
          parameters:
            w: 450
            h: 26
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            bgcolorr: 0.2
            bgcolorg: 0.2
            bgcolorb: 0.2
            bgalpha: 1
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            borderover: false
            align: horizlr
            spacing: 1
            marginl: 3
            marginr: 3
            marginb: 3
            margint: 3
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('referenceTOP') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
            - name: Value0
              style: TOP
              label: Value 0
              default: None
              value: ''
            - name: Valname0
              style: Str
              label: Name 0
              startSection: true
              default: Value
            - name: Onvaluechangescript0
              style: Str
              label: On Value Change Script 0
            - name: Ontooffscript0
              style: Str
              label: On To Off Script 0
            - name: Offtoonscript0
              style: Str
              label: Off To On Script 0
            - name: Createeditvalueparexec
              style: Pulse
              label: Create/Edit Value Par Exec
              startSection: true
            - name: Valueparexec
              style: DAT
              label: Value Par Exec
              readOnly: true
              enable: false
            Label:
            - name: Widgetlabel
              style: Str
              label: Widget Label
              default: TOP Reference
            - name: Labeltop
              style: TOP
              label: Label TOP
            - name: Labeldisplay
              style: Toggle
              label: Display
              startSection: true
              default: true
            - name: Labelwordwrap
              style: Toggle
              label: Word Wrap
              startSection: true
            - name: Labelfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Labelfontsize
              style: Int
              label: Font Size
              default: 10
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Labelfontsizemode.eval() in ['points', 'panelunits']
            - name: Labelfontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Labelfontsizemode.eval() in ['fract', 'relfract']
              enable: false
            - name: Labelscaletofit
              style: Menu
              label: Scale Text to Fit
              default: never
              menuNames:
              - never
              - always
              - onlyshrink
              menuLabels:
              - Never
              - Always
              - Only when Too Large
            - name: Labelfontbold
              style: Toggle
              label: Font Bold
            - name: Labelitalic
              style: Toggle
              label: Italic
            - name: Labeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Labelalignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: left
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Labelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
            - name: Labeloffset
              style: XYZW
              label: Offset
              size: 2
              startSection: true
              default: [6, 0]
              min: -5.0
              max: 5.0
              normMin: -5.0
              normMax: 5.0
            - name: Labelpadding
              style: Float
              label: Padding
              size: 4
            - name: Labelbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: [0.2, 0.2, 0.2, 1]
              clampMin: true
              clampMax: true
            - name: Labelfontcolor
              style: RGBA
              label: Font Color
              default: [0.65, 0.65, 0.65, 1]
              clampMin: true
              clampMax: true
            - name: Labelhorizontalmode
              style: Menu
              label: Horizontal Mode
              startSection: true
              default: fixed
              menuNames:
              - fixed
              - fill
              menuLabels:
              - Fixed Width
              - Fill
            - name: Labelwidth
              style: Int
              label: Width
              default: 120
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
            - name: Labelhfillweight
              style: Float
              label: Horizontal Fill Weight
              default: 0.5
              clampMin: true
              enable: false
            - name: Labelverticalmode
              style: Menu
              label: Vertical Mode
              default: fill
              menuNames:
              - fixed
              - fill
              menuLabels:
              - Fixed Height
              - Fill
            - name: Labelheight
              style: Int
              label: Height
              default: 34
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
              enable: false
            - name: Labelvfillweight
              style: Float
              label: Vertical Fill Weight
              default: 1
              clampMin: true
            OP:
              $t: op_2
            Widget:
            - name: Enablerollover
              style: Toggle
              label: Enable Rollover
              startSection: true
              default: true
            - name: Rollovercolor
              style: RGBA
              label: Rollover Color
              default: [0.9, 0.9, 0.9, 0.15]
              enableExpr: me.par.Enablerollover.eval()
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
              menuNames:
              - over
              - under
              - inside
              - outside
              - add
              - subtract
              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
              enableExpr: me.par.Enablerollover.eval()
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: [0.2, 0.2, 0.2, 0.65]
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              enableExpr: not me.par.Fontfile
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: referenceTOP
              enable: false
            OPs:
              $t: ops_15
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -14200]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: label
            type: containerCOMP
            parameters:
              w: =parent().par.Labelwidth
              h: =parent().par.Labelheight
              layer: 1
              hmode: =parent.Widget.par.Labelhorizontalmode
              hfillweight: =parent.Widget.par.Labelhfillweight
              vmode: =parent.Widget.par.Labelverticalmode
              vfillweight: =parent.Widget.par.Labelvfillweight
              display: =parent.Widget.par.Labeldisplay
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              uvbuttonsleft: false
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Labelbgcolorr
              bgcolorg: =parent.Widget.par.Labelbgcolorg
              bgcolorb: =parent.Widget.par.Labelbgcolorb
              bgalpha: =parent.Widget.par.Labelbgcolora
              borderover: false
              enablecloning: false
            custom_pars:
              Label:
                $t: label_6
                Widgetlabel: COMP reference
                Labelfontsize: 9
                Labelalignx: left
                Labelaligny: center
                Labeloffset: [6, 0]
                Labelbgcolor: [0.2, 0.2, 0.2, 1]
                Labelfontcolor: [0.65, 0.65, 0.65, 1]
                Labelwidth: 120
                Labelhfillweight: 0.5
                Labelverticalmode: fill
                Labelheight: 34
            flags:
            - viewer
            position: [200, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: =parent.Widget.par.Widgetlabel.eval()
                type: multiline
                wordwrap: =parent.Widget.par.Labelwordwrap.eval()
                callbacks: text1_callbacks
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Labelfontbold.eval()
                italic: =parent.Widget.par.Labelitalic
                scaletofit: =parent.Widget.par.Labelfontsizemode
                fontsize: =parent.Widget.par.Labelfontsize.eval() if parent.Widget.par.Labelfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Labelfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Labelfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Labelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Labelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Labelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Labelfontcolora.eval()
                dropshadow: =parent.Widget.par.Labeldropshadow
                textoffsetx: =parent.Widget.par.Labeloffsetx.eval()
                textoffsety: =parent.Widget.par.Labeloffsety.eval()
                textpaddingl: =parent.Widget.par.Labelpadding1.eval()
                textpaddingr: =parent.Widget.par.Labelpadding2.eval()
                textpaddingb: =parent.Widget.par.Labelpadding3.eval()
                textpaddingt: =parent.Widget.par.Labelpadding4.eval()
                alignx: =parent.Widget.par.Labelalignx.eval()
                aligny: =parent.Widget.par.Labelaligny.eval()
                hmode: fill
                bottomanchor: 0.039
                helpdat: =parent.Widget.op('code/help')
                clickthrough: =parent.Widget.par.clickthrough
                top: =parent.Widget.par.Labeltop.eval()
                borderover: false
              position: [0, -200]
            - name: parexecRunCommand
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: =parent.Widget
                pars: Labelhorizontalmode Labelverticalmode
                onpulse: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n#\n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef valueChange(par, val, prev):\n\tif par.name == 'Labelhorizontalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Labelhfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Labelwidth, 'enable', bool(1-val))\n\telif par.name == 'Labelverticalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Labelvfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Labelheight, 'enable', bool(1-val))\n\treturn\n\ndef onPulse(par):\n\treturn\n\ndef expressionChange(par, val, prev):\n\treturn\n\ndef exportChange(par, val, prev):\n\treturn\n\ndef enableChange(par, val, prev):\n\treturn\n\ndef modeChange(par, val, prev):\n\treturn\n"
              dat_content_format: text
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_13
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: referOP0
            type: containerCOMP
            parameters:
              w: 30
              h: 30
              layer: 4
              hmode: fill
              vmode: fill
              alignorder: =-me.nodeY
              display: =parent.Widget.par.Referfielddisplay
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              top: ./bg
              borderover: false
              align: horizlr
              spacing: 1
              justifyv: center
              drop: legacy
              dropscript: ./drop
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./ReferExt').module.ReferExt(me)
            custom_pars:
              OP:
                $t: op
                Referfieldfontsize: 9
                Referfieldalignx: left
                Referfieldaligny: center
                Referfieldbgcolor: [0.45, 0.45, 0.45, 1]
                Referfieldfontcolor: [0.15, 0.15, 0.15, 1]
                Referfieldbordercolor: [0, 0, 0, 0]
                Referfieldborderleft: false
                Referfieldborderright: false
                Referfieldbordertop: false
                Referfieldborderbottom: false
            flags:
            - viewer
            position: [400, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: drop
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -195]
              size: [200, 85]
              dat_content: |+
                #debug('drop', args)
                name = args[0]
                dragType = eval(args[5])
                dragPath = args[6]
                #dropPath = args[7]
                #dropComp = op(dropToPath)

                dragOp = op(dragPath + '/' + name)

                #debug(TDF.getShortcutPath(dragOp, parent.Widget))

                #expr = "TDF.getShortcutPath(" + dragOp, parent.Widget)

                relpath = parent.Widget.relativePath(op(dragPath + '/' + name))

                parent.Widget.par.Value0.val = relpath

              dat_content_format: text
            - name: field
              type: textCOMP
              parameters:
                text: ~getattr(parent.Widget.par, 'Value'+str(parent().digits))
                customformatting: '{val.replace(" ","_")}'
                editmode: editable
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Referfieldfontbold.eval()
                italic: =parent.Widget.par.Referfielditalic
                scaletofit: =parent.Widget.par.Referfieldscaletofit
                fontsize: =parent.Widget.par.Referfieldfontsize.eval() if parent.Widget.par.Referfieldfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Referfieldfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Referfieldfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Referfieldfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Referfieldfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Referfieldfontcolorb.eval()
                fontalpha: =parent.Widget.par.Referfieldfontcolora.eval()
                dropshadow: =parent.Widget.par.Referfielddropshadow
                textoffsetx: =parent.Widget.par.Referfieldoffsetx.eval()
                textoffsety: =parent.Widget.par.Referfieldoffsety.eval()
                textpaddingl: =parent.Widget.par.Referfieldpadding1.eval()
                textpaddingr: =parent.Widget.par.Referfieldpadding2.eval()
                textpaddingb: =parent.Widget.par.Referfieldpadding3.eval()
                textpaddingt: =parent.Widget.par.Referfieldpadding4.eval()
                alignx: =parent.Widget.par.Referfieldalignx.eval()
                aligny: =parent.Widget.par.Referfieldaligny.eval()
                w: 30
                h: 30
                hmode: fill
                alignorder: =10000 - (me.nodeY)
                clickthrough: =parent.Widget.par.clickthrough
                bgcolorr: =parent.Widget.par.Referfieldbgcolorr
                bgcolorg: =parent.Widget.par.Referfieldbgcolorg
                bgcolorb: =parent.Widget.par.Referfieldbgcolorb
                bgalpha: =parent.Widget.par.Referfieldbgcolora
                top: ./bg
                borderover: false
            - name: ReferExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\n\nclass ReferExt(SubWidgetExt):\n\t\"\"\"\n\tReferExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Referfield'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef makePanelExecute(self):\n\t\toppath = parent.Widget.relativePath(self.ownerComp)[2:]\n\t\tSubWidgetExt.makePanelExecute(self, self.getDockExpressionToOwner()\n\t\t\t\t\t\t\t\t\t  + \".op('field')\")"
              dat_content_format: text
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =parent().panel.rollover or parent().panel.lselect or parent().panel.inside
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [0, 200]
              size: [160, 130]
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-500, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: panelexecValue
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: ..
                panelvalue: lselect
                ontooff: true
                defaultreadencoding: cp1252
                language: input
              position: [-300, 0]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-300, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: parexecSettings
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Referfieldcustomizeinteraction Referfieldhorizontalmode Referfieldverticalmode
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
          - name: valueOut
            type: outCHOP
            parameters:
              label: =me.name
              autoexportroot: =parent()
            position: [400, 0]
            inputs:
            - output
        - name: windowHeader
          type: widgetCOMP
          parameters:
            w: 450
            h: 32
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            borderar: 0
            borderag: 0
            borderab: 0
            align: horizlr
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('windowHeader') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Header:
            - name: Headerlabel
              style: Str
              label: Label
              default: Application
            - name: Headerlabeldisplay
              style: Toggle
              label: Display
              startSection: true
              default: true
            - name: Headerlabelwordwrap
              style: Toggle
              label: Word Wrap
              startSection: true
            - name: Headerlabelfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Headerlabelfontsize
              style: Int
              label: Font Size
              default: 12
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Headerlabelfontsizemode.eval() in ['points', 'panelunits']
            - name: Headerlabelfontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Headerlabelfontsizemode.eval() in ['fract', 'relfract']
              enable: false
            - name: Headerlabelscaletofit
              style: Menu
              label: Scale Text to Fit
              default: never
              menuNames:
              - never
              - always
              - onlyshrink
              menuLabels:
              - Never
              - Always
              - Only when Too Large
            - name: Headerlabelfontbold
              style: Toggle
              label: Font Bold
              default: true
            - name: Headerlabelitalic
              style: Toggle
              label: Italic
            - name: Headerlabeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Headerlabelalignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: left
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Headerlabelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
            - name: Headerlabeloffset
              style: XYZW
              label: Offset
              size: 2
              startSection: true
              default: [6, 0]
              min: -5.0
              max: 5.0
              normMin: -5.0
              normMax: 5.0
            - name: Headerlabelpadding
              style: Float
              label: Padding
              size: 4
              enable: false
            - name: Headerlabelbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: [0.15, 0.15, 0.15, 1]
              clampMin: true
              clampMax: true
            - name: Headerlabelfontcolor
              style: RGBA
              label: Font Color
              default: [0.8, 0.8, 0.8, 0.6]
              clampMin: true
              clampMax: true
            - name: Headerclickthrough
              style: Toggle
              label: Header Click Through
              startSection: true
            - name: Headerrepositionwindow
              style: Toggle
              label: Reposition Window
              startSection: true
              default: true
            Controls:
            - name: Windowcomp
              style: COMP
              label: Window COMP
              default: parent(2)
              value: =parent(2).op('window')
            - name: Panelcomp
              style: COMP
              label: Panel COMP
            - name: Buttonfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - points
              - fract
              - panelunits
              menuLabels:
              - Points
              - Fraction
              - Panel Units
            - name: Buttonfontsize
              style: Int
              label: Font Size
              default: 12
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Buttonfontsizemode.eval() in ['points', 'panelunits']
            - name: Buttonfontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Buttonfontsizemode.eval() == 'fract'
              enable: false
            - name: Buttonscaletoolarge
              style: Toggle
              label: Scale when too Large
              enableExpr: me.par.Buttonfontsizemode.eval() != 'fract'
            - name: Buttonfontbold
              style: Toggle
              label: Font Bold
            - name: Buttonofffacecolor
              style: RGBA
              label: Off Face Color
              startSection: true
              default: [0.15, 0.15, 0.15, 1]
            - name: Buttononfacecolor
              style: RGBA
              label: On Face Color
              default: [0.5, 0.5, 0.5, 1]
            - name: Buttonofffontcolor
              style: RGBA
              label: Off Font Color
              default: [0.5, 0.5, 0.5, 1]
              min: [1.0, 0.772, 0.498, 0.0]
            - name: Buttononfontcolor
              style: RGBA
              label: On Font Color
              default: [0.382, 0.382, 0.382, 1]
            - name: Windowclose
              style: Pulse
              label: Window Close
              startSection: true
            - name: Windowmaximize
              style: Pulse
              label: Window Maximize
            - name: Windowminimize
              style: Pulse
              label: Window Minimize
            Widget:
            - name: Enablerollover
              style: Toggle
              label: Enable Rollover
              startSection: true
              default: true
            - name: Rollovercolor
              style: RGBA
              label: Rollover Color
              default: [0.9, 0.9, 0.9, 0.15]
              enableExpr: me.par.Enablerollover.eval()
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
              menuNames:
              - over
              - under
              - inside
              - outside
              - add
              - subtract
              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
              enableExpr: me.par.Enablerollover.eval()
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: [0, 0, 0, 0.5]
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              enableExpr: not me.par.Fontfile
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: windowHeader
              enable: false
            OPs:
            - name: Buttonclose
              style: COMP
              label: buttonClose
              default: ./minMaxClose/buttonClose
              readOnly: true
            - name: Buttonmax
              style: COMP
              label: buttonMax
              default: ./minMaxClose/buttonMax
              readOnly: true
            - name: Buttonmin
              style: COMP
              label: buttonMin
              default: ./minMaxClose/buttonMin
              readOnly: true
            - name: Header
              style: COMP
              label: header
              default: ./header
              readOnly: true
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -5600]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: header
            type: containerCOMP
            parameters:
              w: 30
              h: 30
              hmode: fill
              vmode: fill
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.Headerclickthrough
              resizecomp: =me
              reposition: =parent.Widget.par.Headerrepositionwindow
              bgcolorr: =parent.Widget.par.Headerlabelbgcolorr
              bgcolorg: =parent.Widget.par.Headerlabelbgcolorg
              bgcolorb: =parent.Widget.par.Headerlabelbgcolorb
              bgalpha: =parent.Widget.par.Headerlabelbgcolora
              top: ./bg
              borderover: false
              align: horizlr
              enablecloning: false
            custom_pars:
              Header:
                $t: header
                Headerlabel: Application
                Headerlabelfontsize: 12
                Headerlabelfontbold: true
                Headerlabelalignx: left
                Headerlabelaligny: center
                Headerlabelfontcolor: [0.8, 0.8, 0.8, 0.6]
                Headerrepositionwindow: true
            flags:
            - viewer
            position: [200, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: ~parent.Widget.par.Headerlabel
                type: multiline
                wordwrap: =parent.Widget.par.Headerlabelwordwrap
                callbacks: text1_callbacks
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Headerlabelfontbold.eval()
                italic: =parent.Widget.par.Headerlabelitalic
                scaletofit: =parent.Widget.par.Headerlabelscaletofit
                fontsize: =parent.Widget.par.Headerlabelfontsize.eval() if parent.Widget.par.Headerlabelfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Headerlabelfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Headerlabelfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Headerlabelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Headerlabelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Headerlabelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Headerlabelfontcolora.eval()
                dropshadow: =parent.Widget.par.Headerlabeldropshadow
                textoffsetx: =parent.Widget.par.Headerlabeloffsetx.eval()
                textoffsety: =parent.Widget.par.Headerlabeloffsety.eval()
                textpaddingl: =parent.Widget.par.Headerlabelpadding1.eval()
                textpaddingr: =parent.Widget.par.Headerlabelpadding2.eval()
                textpaddingb: =parent.Widget.par.Headerlabelpadding3.eval()
                textpaddingt: =parent.Widget.par.Headerlabelpadding4.eval()
                alignx: =parent.Widget.par.Headerlabelalignx.eval()
                aligny: =parent.Widget.par.Headerlabelaligny.eval()
                hmode: fill
                clickthrough: true
                borderover: false
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              - -showDocked
              position: [0, -150]
              size: [160, 130]
              dock: text
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: minMaxClose
            type: containerCOMP
            parameters:
              w: =3*parent().height
              vmode: fill
              resizecomp: =me
              borderover: false
              align: horizlr
              justifyh: right
              parentshortcut: minMaxClose
              enablecloning: false
            sequences:
              ext:
              - object: op('./MinMaxCloseExt').module.MinMaxCloseExt(me)
                promote: true
            custom_pars:
              Controls:
              - name: Windowcomp
                style: COMP
                label: Window COMP
                default: 'False'
                value: ''
              - name: Panelcomp
                style: COMP
                label: Panel COMP
              - name: Buttonfontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - points
                - fract
                - panelunits
                menuLabels:
                - Points
                - Fraction
                - Panel Units
              - name: Buttonfontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                enableExpr: me.par.Buttonfontsizemode.eval() in ['points', 'panelunits']
              - name: Buttonfontfraction
                style: Float
                label: Font Fraction
                default: 1
                enableExpr: me.par.Buttonfontsizemode.eval() == 'fract'
                enable: false
              - name: Buttonscaletoolarge
                style: Toggle
                label: Scale when too Large
                enableExpr: me.par.Buttonfontsizemode.eval() != 'fract'
              - name: Buttonfontbold
                style: Toggle
                label: Font Bold
              - name: Buttonofffacecolor
                style: RGBA
                label: Off Face Color
                startSection: true
                default: [0.382, 0.382, 0.382, 0.2]
              - name: Buttononfacecolor
                style: RGBA
                label: On Face Color
                default: [0.81818, 0.81818, 0.81818, 0.2]
              - name: Buttonofffontcolor
                style: RGBA
                label: Off Font Color
                default: [0.18182, 0.18182, 0.18182, 1]
                min: [1.0, 0.772, 0.498, 0.0]
              - name: Buttononfontcolor
                style: RGBA
                label: On Font Color
                default: [0.382, 0.382, 0.382, 1]
              - name: Windowclose
                style: Pulse
                label: Window Close
                startSection: true
              - name: Windowmaximize
                style: Pulse
                label: Window Maximize
              - name: Windowminimize
                style: Pulse
                label: Window Minimize
            flags:
            - viewer
            position: [500, -400]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDSubComp
            children:
            - name: buttonMax
              type: containerCOMP
              parameters:
                w: 32
                h: =parent.Widget.par.Buttonheight
                fixedaspect: vertical
                hfillweight: =parent.Widget.par.Buttonhfillweight
                vmode: fill
                alignorder: 2
                helpdat: =parent.Widget.op('code/help')
                resizecomp: =me
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                borderover: false
                align: horizlr
                justifyh: left
                justifyv: center
                crop: 'on'
                parentshortcut: Value
                clone: buttonMin
              sequences:
                ext:
                - object: op('./ButtonPushExt').module.ButtonPushExt(me)
                  promote: true
              custom_pars:
                Settings:
                  $t: settings
                  Symbol: =chr(0xF05AF)
              flags:
              - viewer
              position: [200, -100]
              size: [160, 130]
              color: [0.5, 0.35, 0.05]
              tags:
              - TDPub
            - name: buttonMin
              type: containerCOMP
              parameters:
                w: 32
                h: =parent.Widget.par.Buttonheight
                fixedaspect: vertical
                hfillweight: =parent.Widget.par.Buttonhfillweight
                vmode: fill
                alignorder: 1
                helpdat: =parent.Widget.op('code/help')
                resizecomp: =me
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                borderover: false
                align: horizlr
                justifyh: left
                justifyv: center
                crop: 'on'
                parentshortcut: Value
              sequences:
                ext:
                - object: op('./ButtonPushExt').module.ButtonPushExt(me)
                  promote: true
              custom_pars:
                Settings:
                  $t: settings
                  Symbol: =chr(0xF05B0)
              flags:
              - viewer
              size: [160, 130]
              color: [0.5, 0.35, 0.05]
              tags:
              - TDPub
              children:
              - name: text
                type: textCOMP
                parameters:
                  text: =parent.Value.par.Symbol
                  callbacks: text1_callbacks
                  font: Material Design Icons
                  scaletofit: =parent.Widget.par.Buttonfontsizemode.eval()
                  fontsize: =parent.Widget.par.Buttonfontsize.eval() if parent.Widget.par.Buttonfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Buttonfontfraction.eval()
                  fontsizeunits: =parent.Widget.par.Buttonfontsizemode.eval()
                  fontcolorr: =me.par.Fontcolor.eval()[0]
                  fontcolorg: =me.par.Fontcolor.eval()[1]
                  fontcolorb: =me.par.Fontcolor.eval()[2]
                  fontalpha: =me.par.Fontcolor.eval()[3]
                  textpaddingl: 11
                  textpaddingr: 11
                  textpaddingb: 11
                  textpaddingt: 11
                  alignxmode: bbox
                  alignymode: bbox
                  hmode: fill
                  clickthrough: true
                  bgcolorr: =me.par.Facecolor.eval()[0]
                  bgcolorg: =me.par.Facecolor.eval()[1]
                  bgcolorb: =me.par.Facecolor.eval()[2]
                  bgalpha: =me.par.Facecolor.eval()[3]
                  borderover: false
                custom_pars:
                  Expressions:
                  - name: Value
                    style: Python
                    defaultExpr: None
                    defaultMode: EXPRESSION
                    value: =parent.Value.panel.select
                  - name: Fontcolor
                    style: Python
                    defaultExpr: None
                    defaultMode: EXPRESSION
                    value: =parent.Widget.parGroup.Buttononfontcolor.eval() if me.par.Value.eval() else parent.Widget.parGroup.Buttonofffontcolor.eval()
                  - name: Facecolor
                    style: Python
                    defaultExpr: None
                    defaultMode: EXPRESSION
                    value: =parent.Widget.parGroup.Buttononfacecolor.eval() if me.par.Value.eval() else parent.Widget.parGroup.Buttonofffacecolor.eval()
                  - name: Fontratio
                    style: Python
                    label: Font Ratio
                    defaultExpr: None
                    defaultMode: EXPRESSION
                    value: =None
                position: [400, 200]
                children:
                - name: rollover
                  type: containerCOMP
                  parameters:
                    layer: 7
                    hmode: fill
                    vmode: fill
                    alignallow: ignore
                    display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                    clickthrough: true
                    resizecomp: =me
                    bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                    bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                    bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                    bgalpha: =parent.Widget.par.Rollovercolora.eval()
                    borderover: false
                    composite: =parent.Widget.par.Rollovercomposite.eval()
                    enablecloning: false
                  flags:
                  - viewer
                  size: [160, 130]
              - name: empty
                type: constantTOP
                parameters:
                  colorr: 0
                  colorg: 0
                  colorb: 0
                  alpha: 0
                  operand: over
                  resolutionw: 1
                  resolutionh: 1
                flags:
                - viewer
                size: [130, 90]
              - name: SubWidgetExt
                type: textDAT
                parameters:
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [-500, 400]
                size: [130, 90]
                tags:
                - TDExtension
                dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
                dat_content_format: text
              - name: ButtonPushExt
                type: textDAT
                parameters:
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [-300, 400]
                size: [130, 90]
                tags:
                - TDExtension
                dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass ButtonPushExt(SubWidgetExt):\n\t\"\"\"\n\tButtonPushExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\tself.parPrefix = 'Button'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tSelects correct funtion based on button widget\n\t\ttype\n\t\t\"\"\"\n\t\tval = panelValue != 0\n\t\trunCommand = self.parDict['runcommand']\n\t\tcommandOn = self.parDict['commandon']\n\t\tcommandOff = self.parDict['commandoff']\n\t\tif runCommand:\n\t\t\tif val and commandOn is not None:\n\t\t\t\tself.runCommand(commandOn)\n\t\t\telif not val and commandOff is not None:\n\t\t\t\tself.runCommand(commandOff)\n\n\n"
                dat_content_format: text
              - name: panelexecValue
                type: panelexecuteDAT
                parameters:
                  active: false
                  fromop: =me.parent()
                  panels: ..
                  panelvalue: lselect
                  ontooff: true
                  defaultreadencoding: cp1252
                  language: input
                position: [-300, 0]
                size: [130, 90]
                color: [0.05, 0.5, 0.05]
                dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
                dat_content_format: text
              - name: panelExecOPExec
                type: opexecuteDAT
                parameters:
                  active: false
                  op: pare
                flags:
                - bypass
                - viewer
                position: [-300, 100]
                color: [0.05, 0.5, 0.05]
                dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
                dat_content_format: text
              - name: parexecSettings
                type: parameterexecuteDAT
                parameters:
                  fromop: =me.parent()
                  op: '=parent.Widget '
                  pars: Buttonpanelexecute Buttoncustomizeinteraction
                  builtin: false
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [-300, 200]
                size: [130, 90]
                color: [0.05, 0.5, 0.05]
                comment: Execution for parameter changes
                dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
                dat_content_format: text
              - name: text1_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                - -showDocked
                position: [400, 50]
                size: [160, 130]
                dock: text
                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                fromop: =parent()
                panels: button*
                panelvalue: lselect
              position: [200, -425]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# prev - the previous value of the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onOffToOn(panelValue):\n\tif panelValue.owner.name == 'buttonClose':\n\t\tparent.Widget.par.Windowclose.pulse()\n\telif panelValue.owner.name == 'buttonMax':\n\t\tparent.Widget.par.Windowmaximize.pulse()\n\telif panelValue.owner.name == 'buttonMin':\n\t\tparent.Widget.par.Windowminimize.pulse()\n\n\treturn\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue, prev):\n\treturn\n\t"
              dat_content_format: text
            - name: buttonClose
              type: containerCOMP
              parameters:
                w: 32
                h: =parent.Widget.par.Buttonheight
                fixedaspect: vertical
                hfillweight: =parent.Widget.par.Buttonhfillweight
                vmode: fill
                alignorder: 3
                helpdat: =parent.Widget.op('code/help')
                resizecomp: =me
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                borderover: false
                align: horizlr
                justifyh: left
                justifyv: center
                crop: 'on'
                parentshortcut: Value
                clone: buttonMin
              sequences:
                ext:
                - object: op('./ButtonPushExt').module.ButtonPushExt(me)
                  promote: true
              custom_pars:
                Settings:
                  $t: settings
                  Symbol: =chr(0xF05AD)
              flags:
              - viewer
              position: [400, -200]
              size: [160, 130]
              color: [0.5, 0.35, 0.05]
              tags:
              - TDPub
            - name: MinMaxCloseExt
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              position: [-200, 100]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "class MinMaxCloseExt:\n\t\"\"\"\n\tMinMaxCloseExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tself.windowCompPar = self.ownerComp.parent.Widget.par.Windowcomp\n\t\tself.panelCompPar = self.ownerComp.parent.Widget.par.Panelcomp\n\n\n\tdef Windowclose(self, par):\n\t\t\"\"\"\n\t\tHandles Windowclose parameter callback\n\t\t\"\"\"\n\t\twindowComp = self.windowCompPar.eval()\n\t\tif isinstance(windowComp, windowCOMP):\n\t\t\twindowComp.par.winclose.pulse()\n\n\tdef Windowmaximize(self, par):\n\t\t\"\"\"\n\t\tHandles Windowmaximize parameter callback\n\t\t\"\"\"\n\t\tdebug('Windowmaximize is not implemented yet')\n\n\tdef Windowminimize(self, par):\n\t\t\"\"\"\n\t\tHandles Windowminimize parameter callback\n\t\t\"\"\"\n\t\tdebug('Windowminimize is not implemented yet')\n"
              dat_content_format: text
            - name: extensionParExec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent()
                pars: '*'
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, -200]
              size: [130, 90]
              dat_content: "# This is a callback system for parameters. \n# to use:\n#\t- create a function in ParCallbacksExt/ParCallbacks\n#\t  using the same name as the parameter.\n\t\ndef onValueChange(par, val, prev):\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par, val, prev)\n\ndef onPulse(par):\n\t#debug(par)\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par)\n\ndef onExpressionChange(par, val, prev):\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par, val, prev)\n\ndef onExportChange(par, val, prev):\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par, val, prev)\n\ndef onEnableChange(par, val, prev):\n\treturn\n\t"
              dat_content_format: text
        - name: fieldTextArea
          type: widgetCOMP
