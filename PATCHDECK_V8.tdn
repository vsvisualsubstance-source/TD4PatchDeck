            - name: Sliderlabeldisplay
              style: Toggle
              label: Label Display
              startSection: true
              default: true
            - name: Sliderfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Sliderfontsize
              style: Int
              label: Font Size
              default: 12
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Sliderfontsizemode.eval() in ['points', 'panelunits']
            - name: Sliderfontfraction
