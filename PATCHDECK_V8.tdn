                parameters:
                  legacyxform: true
                flags:
                - viewer
                position: [525, 150]
                size: [130, 49]
                inputs:
                - check
                - checkOff
              - name: subMenu
                type: textTOP
                parameters:
                  text: ='\uE102'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Segoe UI Symbol
                  fontsizex: 11
                  fontsizexunit: pixels
                  fontcolorr: 0.71
                  fontcolorg: 0.72
                  fontcolorb: 0.72
