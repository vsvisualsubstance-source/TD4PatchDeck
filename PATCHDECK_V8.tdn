              children:
              - name: check
                type: textTOP
                parameters:
                  text: ='\u2714'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Segoe UI Symbol
                  fontsizex: 11
                  fontsizexunit: pixels
                  fontcolorr: 0.71
                  fontcolorg: 0.72
                  fontcolorb: 0.72
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
