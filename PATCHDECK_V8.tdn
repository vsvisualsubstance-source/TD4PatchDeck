                Stringfieldfontcolor: [0.15, 0.15, 0.15, 1]
                Stringfieldbordercolor: [0, 0, 0, 0]
                Stringfieldborderleft: false
                Stringfieldborderright: false
                Stringfieldbordertop: false
                Stringfieldborderbottom: false
                Stringfieldhorizontalmode: fill
                Stringfieldwidth: 120
                Stringfieldverticalmode: fill
                Stringfieldheight: 25
            flags:
            - viewer
            position: [400, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
