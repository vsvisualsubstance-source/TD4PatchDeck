            Sliderlabelfontcolor: [0.73, 0.129554, 0.08395, 1]
            Sliderindicatorcolor: [0.468, 0.00514799, 0.00514799, 0.8]
            Cacheabletop: =op('./slider0/bg')
          Widget:
            $t: widget_10
