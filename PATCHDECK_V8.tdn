              alignorder: 1
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              borderover: false
              align: =parent.Widget.par.Radioalign
              spacing: =parent().par.Radiomargin
              alignmax: =parent.Widget.par.Radiomaxperline
              justifyh: left
              crop: 'on'
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./RadioExt').module.RadioExt(me)
            custom_pars:
              Radio:
              - name: Radiolabels
                style: Str
                label: Button Labels
                startSection: true
                default: 0 1 2 3 "Number 4" 5 6 7
                value: 0 1 2 3 4 5 6 7 8
              - name: Radioalign
                style: Menu
                label: Radio Align
                startSection: true
                default: none
                menuSource: me.par.align
              - name: Radiomaxperline
                style: Int
                label: Radio Max Per Line
                clampMin: true
                normMax: 8.0
              - name: Radiomargin
                style: Int
                label: Radio Margin
                default: 1
                clampMin: true
                normMax: 20.0
              - name: Radiofont
                style: Menu
                label: Font
                startSection: true
                default: Verdana
                menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              - name: Radiofontfile
