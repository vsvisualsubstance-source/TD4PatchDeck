                  Selected: =me.par.Index == parent.Widget.par.Value0.menuIndex
                  Shrunken: =parent().MinTextWidths[me.digits] > me.par.w if parent().extensionsReady and parent().MinTextWidths else 0
              position: [0, -130]
              size: [160, 130]
              children:
              - name: 'on'
                type: textCOMP
                parameters:
                  text: =op('off').par.value
                  callbacks: on_textCOMP_callbacks
                  legacyfontselection: true
                  font: =parent.Widget.par.Foldertabfont.eval()
                  fontfile: =parent.Widget.par.Foldertabfontfile
                  bold: =parent.Widget.par.Foldertabfontbold.eval()
                  italic: =parent.Widget.par.Foldertabitalic
                  scaletofit: =parent.Widget.par.Foldertabscaletofit
                  fontsize: =parent.Widget.par.Foldertabfontsize.eval() if parent.Widget.par.Foldertabfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Foldertabfontfraction.eval()
                  fontsizeunits: =parent.Widget.par.Foldertabfontsizemode.eval()
                  fontcolorr: =parent.Widget.par.Foldertabonfontcolorr.eval()
                  fontcolorg: =parent.Widget.par.Foldertabonfontcolorg.eval()
                  fontcolorb: =parent.Widget.par.Foldertabonfontcolorb.eval()
                  fontalpha: =parent.Widget.par.Foldertabonfontcolora.eval()
                  dropshadow: =parent.Widget.par.Foldertabdropshadow
                  textoffsetx: =parent.Widget.par.Foldertaboffsetx.eval()
                  textoffsety: =parent.Widget.par.Foldertaboffsety.eval()
                  alignx: =parent.Widget.par.Foldertabalignx.eval()
                  alignxmode: =parent.Widget.par.Foldertabalignxmode.eval()
                  aligny: =parent.Widget.par.Foldertabaligny.eval()
                  alignymode: =parent.Widget.par.Foldertabalignymode.eval()
                  w: 75
                  h: 26
                  hmode: fill
                  vmode: fill
                  display: =not op('off').par.display
                  clickthrough: true
