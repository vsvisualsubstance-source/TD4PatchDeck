            size: [130, 90]
            dat_content: "# me is this DAT.\n# \n# panelValue is the PanelValue object that changed.\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nimport os \n\ndef offToOn(panelValue):\n\treturn\n\ndef whileOn(panelValue):\n\treturn\n\ndef onToOff(panelValue):\n\n\tcurrentFolder = parent.Widget.GetValue(panelValue.owner.digits)\n\tif os.path.isdir(currentFolder):\n\t\tstartDir = currentFolder\n\telse:\n\t\tstartDir = project.folder \n\n\tfolder = ui.chooseFolder(start = startDir, title='Select A Folder',\\\n\t\t\t\t\t\t\t\t\t\tasExpression=parent.Widget.par.Relativepath.eval())\n\tif folder:\n\t\tparent.Widget.SetValue(folder, panelValue.owner.digits)\n\ndef whileOff(panelValue):\n\treturn\n\ndef valueChange(panelValue):\n\treturn\n\t"
            dat_content_format: text
