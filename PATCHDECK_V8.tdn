            margint: 3
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('knobFixed') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
              $t: values_7
              Value0: ~me.op('../../control_ui').par.Fx6
              Valname0: =me.name
            Label:
              $t: label_4
              Widgetlabel: =me.op('../../select_fx_lables')[1,5]
              Labelfontsizemode: fract
              Labelfontsize: 30
              Labelfontfraction: 0.2
              Labelscaletofit: onlyshrink
              Labelfontbold: true
              Labelalignx: center
              Labelaligny: center
              Labeloffset: [0, 0]
              Labelbgcolor: [0.125208, 0.125208, 0.188, 1]
              Labelhorizontalmode: fill
              Labelwidth: 134
              Labelvfillweight: 0.25
            Field:
              $t: field
