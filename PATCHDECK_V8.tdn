                - area
                - x
                - y
                - age
                menuLabels:
                - ID
                - Area
                - X
                - Y
                - Eta
              - name: Gridheader
                style: Str
                label: Intestazione
                default: ID   X     Y
              - name: Gridrow
                style: Str
                label: Riga
                default: '{id:03d} {x:.3f} {y:.3f}'
              - name: Gridfooter
                style: Str
                label: Piede
                default: N={count}
              - name: Gridmax
                style: Int
                label: Righe massime
                default: 24
                min: 1.0
                max: 200.0
                clampMin: true
              - name: Gridcols
                style: Int
                label: Colonne
                default: 1
                min: 1.0
                max: 6.0
                clampMin: true
              - name: Gridscale
                style: Float
                label: Corpo griglia
                default: 0.4
                normMin: 0.2
                normMax: 1.5
              - name: Gridthick
                style: Int
                label: Spessore griglia
                default: 1
                min: 1.0
                max: 4.0
              - name: Gridleading
                style: Int
                label: Interlinea
                default: 14
                min: 6.0
                max: 80.0
              - name: Gridmono
                style: Toggle
                label: Passo fisso
                default: true
              - name: Gridcolor
                style: RGBA
                label: Colore griglia
                size: 3
                default: [0.75, 0.95, 1]
              - name: Gridpanel
                style: Toggle
                label: Pannello di fondo
              - name: Gridshadow
                style: Toggle
                label: Contorno scuro
                default: true
              - name: Gridpanelalpha
                style: Float
                label: Opacita pannello
                default: 0.55
              - name: Gridmargin
                style: Int
                label: Margine dal bordo
                default: 24
                max: 300.0
