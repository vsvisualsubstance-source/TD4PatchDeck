                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [325, 75]
                size: [130, 48]
              - name: button
                type: textTOP
                parameters:
                  text: XXWWWWWWW
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
