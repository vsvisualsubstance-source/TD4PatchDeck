            dat_content: "# me is this DAT.\n# \n# panelValue is the PanelValue object that changed.\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nimport os \n\ndef offToOn(panelValue):\n\treturn\n\ndef whileOn(panelValue):\n\treturn\n\ndef onToOff(panelValue):\n\texecString = getattr(parent.Widget.par, 'Value'+str(panelValue.owner.digits))\n\t#eval(execString)\n\trun(execString, fromOP=parent.Widget)\n\ndef whileOff(panelValue):\n\treturn\n\ndef valueChange(panelValue):\n\treturn\n\t"
            dat_content_format: text
