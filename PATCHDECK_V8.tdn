              Slideralignx: center
              Slideraligny: center
              Sliderknobsize: 1
              Sliderbgcolor: [0.15, 0.15, 0.15, 1]
              Sliderknobcolor: [0.6, 0.6, 0.6, 1]
              Sliderlabelfontcolor: [0.075, 0.075, 0.075, 1]
              Sliderindicatorcolor: [0.325, 0.325, 0.325, 1]
              Cacheabletop: =op('./slider0/bg')
          position: [600, -500]
          children:
          - name: bg
            type: nullTOP
            flags:
            - viewer
            position: [1200, -600]
            size: [130, 90]
            inputs:
            - switch2
          - name: knob
            type: selectTOP
            parameters:
              top: =parent.Widget.par.Sliderknobtop.eval() or ''
            flags:
            - viewer
            position: [0, -100]
            size: [130, 90]
          - name: text
            type: textCOMP
            parameters:
              text: =tdu.split(parent.Widget.par.Sliderlabelnames.eval())[parent().digits] if len(tdu.split(parent.Widget.par.Sliderlabelnames.eval()))>parent().digits and parent.Widget.par.Sliderlabeldisplay.val else ''
              callbacks: text1_callbacks
              font: =parent.Widget.par.Font.eval()
              fontfile: =parent.Widget.par.Fontfile
              bold: =parent.Widget.par.Sliderfontbold.eval()
              italic: =parent.Widget.par.Slideritalic
              scaletofit: =parent.Widget.par.Sliderscaletofit
              fontsize: =parent.Widget.par.Sliderfontsize.eval() if parent.Widget.par.Sliderfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Sliderfontfraction.eval()
              fontsizeunits: =parent.Widget.par.Sliderfontsizemode.eval()
              fontcolorr: =parent.Widget.par.Sliderlabelfontcolorr.eval()
              fontcolorg: =parent.Widget.par.Sliderlabelfontcolorg.eval()
              fontcolorb: =parent.Widget.par.Sliderlabelfontcolorb.eval()
              fontalpha: =parent.Widget.par.Sliderlabelfontcolora.eval()
              dropshadow: =parent.Widget.par.Sliderdropshadow
              textoffsetx: =parent.Widget.par.Slideroffsetx.eval()
              textoffsety: =parent.Widget.par.Slideroffsety.eval()
              textpaddingl: =parent.Widget.par.Sliderpadding1.eval()
              textpaddingr: =parent.Widget.par.Sliderpadding2.eval()
              textpaddingb: =parent.Widget.par.Sliderpadding3.eval()
              textpaddingt: =parent.Widget.par.Sliderpadding4.eval()
              alignx: =parent.Widget.par.Slideralignx.eval()
              aligny: =parent.Widget.par.Slideraligny.eval()
              hmode: fill
              display: =parent.Widget.par.Sliderlabeldisplay
              clickthrough: true
              borderover: false
            position: [400, 0]
          - name: flip1
            type: flipTOP
            parameters:
              flipy: =parent.Widget.par.Sliderorient
              flop: =parent.Widget.par.Sliderorient
            flags:
            - viewer
            position: [400, -400]
            size: [130, 90]
            inputs:
            - slider
          - name: over1
            type: overTOP
            parameters:
              legacyxform: true
            flags:
            - viewer
            position: [600, -500]
            size: [130, 90]
            inputs:
            - flip1
            - level1
          - name: level1
            type: levelTOP
            parameters:
              clampinput: clamp
              highr: =parent.Widget.par.Cachefiltercolorr
              highg: =parent.Widget.par.Cachefiltercolorg
              highb: =parent.Widget.par.Cachefiltercolorb
              higha: =parent.Widget.par.Cachefiltercolora
            flags:
            - viewer
            position: [300, -600]
            size: [130, 90]
            inputs:
            - cacheselect1
          - name: slider
            type: glslmultiTOP
            parameters:
              pixeldat: glslSlider
              dispatchsizey: 1
              inputextenduv: repeat
              outputresolution: parpanel
              resolutionw: 2531
              resolutionh: 26
              format: rgba8fixed
            sequences:
              vec:
              - name: orient
                valuex: =parent.Widget.par.Sliderorient.menuIndex
              - name: bgColor
                valuex: =parent.Widget.par.Sliderbgcolorr.eval()
                valuey: =parent.Widget.par.Sliderbgcolorg.eval()
                valuez: =parent.Widget.par.Sliderbgcolorb.eval()
                valuew: =parent.Widget.par.Sliderbgcolora.eval()
              - name: indColor
                valuex: =parent.Widget.par.Sliderindicatorcolorr.eval()
                valuey: =parent.Widget.par.Sliderindicatorcolorg.eval()
                valuez: =parent.Widget.par.Sliderindicatorcolorb.eval()
                valuew: =parent.Widget.par.Sliderindicatorcolora.eval()
              - name: knobColor
                valuex: =parent.Widget.par.Sliderknobcolorr.eval()
                valuey: =parent.Widget.par.Sliderknobcolorg.eval()
                valuez: =parent.Widget.par.Sliderknobcolorb.eval()
                valuew: =parent.Widget.par.Sliderknobcolora.eval()
              - name: nrmValue
                valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).evalNorm()
                valuey: 1
                valuez: 1
                valuew: 1
              - name: defaultValue
                valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).default
                valuey: 1
                valuez: 1
                valuew: 1
              - name: minMax
                valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).normMin
                valuey: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).normMax
                valuez: 1
                valuew: 1
              - name: knobSize
                valuex: =parent.Widget.par.Sliderknobsize.eval()
                valuey: 1
                valuez: 1
                valuew: 1
              - valuex: 1
              - valuex: 1
              - name: offset
                valuex: =-me.par.value4x*((me.par.resolutionw-parent.Widget.par.Sliderknobsize.eval()) / parent.Widget.par.Sliderknobsize.eval())
                valuey: 1
                valuez: 1
                valuew: 1
              - name: scale
                valuex: =me.par.resolutionw / parent.Widget.par.Sliderknobsize.eval()
                valuey: =(parent.Widget.par.Sliderknobsize.eval() / me.par.resolutionw) * parent.Widget.par.Sliderknobsize.eval()
                valuez: 1
                valuew: 1
            flags:
            - viewer
            position: [200, -200]
            size: [130, 90]
            inputs:
            - knob
            - sliderBg
          - name: switch1
            type: switchTOP
            parameters:
              index: =parent.Widget.par.Cacheactive
            flags:
            - viewer
            position: [800, -300]
            size: [130, 90]
            inputs:
            - slider
            - over1
          - name: switch2
            type: switchTOP
            parameters:
              index: =parent.Widget.par.Cacheoptimized
            flags:
            - viewer
            position: [1000, -600]
            size: [130, 90]
            inputs:
            - switch1
            - cacheselect1
          - name: rollover
            type: containerCOMP
            parameters:
              layer: 7
              hmode: fill
              vmode: fill
              alignallow: ignore
              display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
              clickthrough: true
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
              bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
              bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
              bgalpha: =parent.Widget.par.Rollovercolora.eval()
              borderover: false
              composite: =parent.Widget.par.Rollovercomposite.eval()
            flags:
            - viewer
            position: [400, 200]
            size: [160, 130]
          - name: sliderBg
            type: selectTOP
            parameters:
              top: =parent.Widget.par.Sliderbgtop.eval() or ''
            flags:
            - viewer
            position: [0, -300]
            size: [130, 90]
          - name: SliderExt
            type: textDAT
            parameters:
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [-325, 400]
            size: [130, 90]
            tags:
            - TDExtension
            dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass SliderExt(SubWidgetExt):\n\t\"\"\"\n\tValueExt is an extension that controls multiple values for a value component.\n\tA value component is a widget sub component that visualizes and provides\n\tinteractivity for setting values.\n\t\"\"\"\n\tdef __init__(self, ownerComp, dimension=1):\n\t\t# The component to which this extension is attached\n\t\t\"\"\"\n\t\tThis extension inpterprets panel interactions and controls the\n\t\tmasterSlider widget values.\n\t\t\"\"\"\n\t\tself.parPrefix = 'Slider'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\t\tself.widgetComp = self.ownerComp.parent.Widget\n\t\t#Dimesion refers to the dimension of this sub-component.  A slider\n\t\t#found in an RGBA widget will have a dimension of 1, while a range\n\t\t#slider will have a dimension of 2 since it requires two values\n\t\t#for the single ui element\n\t\tself.dimension = dimension\n\t\t#The value group index allows for multiple range faders in the same\n\t\t#widget\n\t\tself.valueGroupIndex = 0 #math.floor(self.ownerComp.digits/self.dimension)\n\t\t#Slider variables\n\t\tself.LoadSliderAttribs(self.valueGroupIndex)\n\n\t\tself.select = False\n\t\tself.insideKnob = False\n\t\tself.lastClickPos = None\n\t\t#The current normalized values\n\n\t\tself.knobIndex = None\n\t\t#The function to use to process incoming ValueChange events\n\t\tself.valueProc = None\n\t\t#The current start values\n\t\tself.startValues = []\n\t\tself.curValues = []\n\t\tself.startDiffs = []\n\n\tdef LoadSliderAttribs(self, groupIndex):\n\t\t\"\"\"\n\t\tPreloads the slider values for the Value component.\n\t\t\"\"\"\n\t\t#debug('inside', groupIndex)\n\t\tself.index = groupIndex\n\t\tself.res = [getattr(self.ownerComp, i) for i in ['width', 'height']]\n\t\tself.knobWidth = self.ownerComp.parent.Widget.par.Sliderknobsize.eval()\n\t\tself.orient = self.ownerComp.parent.Widget.par.Sliderorient.menuIndex\n\t\t#Needs to avoid division by zero error\n\t\tself.normKnobWidth = (self.knobWidth / self.res[self.orient]) if self.res[self.orient] > 0 else 0\n\t\tself.knobMargin = self.normKnobWidth/2\n\t\tself.panelVar = self.ownerComp.panel.v if self.orient \\\n\t\t\t\t\t\t\t\t\t\t\t\t\telse self.ownerComp.panel.u\n\t\tself.normSliderMin = self.normKnobWidth/2\n\t\tself.normSliderMax = 1-(self.normKnobWidth/2)\n\t\tself.Pars = [getattr(self.ownerComp.parent.Widget.par, \\\n\t\t\t\t\t\t\t\t'Value'+str(i)) for i in range(self.dimension)]\n\t\tself.Values = [Value(self.widgetComp, par[1],\n\t\t\t\t\t\t\t\tself.valueGroupIndex+par[0]) \\\n\t\t\t\t\t\t\t\tfor par in enumerate(self.Pars)]\n\t\tself.relativeMode = self.ownerComp.parent.Widget.par.Sliderrelativemode.eval()\n\n\n\tdef ValueChange(self, panelValue):\n\t\t\"\"\"\n\t\tHandles a value change taking into consideration all the attributes\n\t\tof this slider sub-component.\n\t\t\"\"\"\n\t\t#debug('val chan')\n\t\tif self.select:\n\t\t\tself.valueProc(panelValue.val, self.knobIndex)\n\n\n\tdef SelectOn(self):\n\t\t\"\"\"\n\t\tGathers information when the panel is initially selected. The\n\t\tinformation is used when interaction with the widget sub-component\n\t\tpanel generates valueChange callback events. These events are\n\t\tsubsequently handled by the ValueChange() method of this class.\n\t\t\"\"\"\n\t\t#knobClickIndex will be None if not clicked or knob index if a knob\n\t\t#was clicked\n\t\tknobIndex = self.checkKnobClick()\n\t\t#debug('knob', knobIndex)\n\t\tif knobIndex is None:\n\t\t\tself.valueProc = self.valueChangeSlider\n\t\telse:\n\t\t\tself.valueProc = self.valueChangeKnob\n\t\tself.select = True\n\n\tdef SelectOff(self):\n\t\t\"\"\"\n\t\tTurns off select state for this value.\n\t\t\"\"\"\n\t\tself.select = False\n\t\tself.mode = None\n\t\tself.valueProc = None\n\t\tself.insideKnob = False\n\t\tself.lastClickPos = None\n\n\tdef reNormalizeWithKnobs(self, knobMargin):\n\t\t\"\"\"\n\t\tThis function allows for renormalizing the normalized values\n\t\ttaking into consideration the knob size.\n\t\t\"\"\"\n\t\treturn
              [remap(val, 0, 1, knobMargin, 1-(knobMargin)) \\\n\t\t\t\t\t\t\t\t\t\t\tfor val in self.getNormValues()]\n\t\t#return [remap(val, 0, 1, 0, 1) for val in self.getNormValues()]\n\n\tdef checkKnobClick(self):\n\t\t\"\"\"\n\t\tChecks if click was inside a knob or not.  Returns None if not or the\n\t\tknob index starting at 0 if a knob was clicked.\n\t\t\"\"\"\n\t\t#knobMargin = self.normKnobWidth/2\n\t\tnormValues = self.reNormalizeWithKnobs(self.knobMargin)\n\t\tpval = self.panelVar.val\n\t\tknobIndex = None\n\t\tfor i in range(self.dimension):\n\t\t\t#print('check', pval, normValues[i]-(self.knobMargin), normValues[i]+(self.knobMargin), self.knobMargin, self.knobWidth)\n\t\t\tif pval > normValues[i]-(self.knobMargin) and \\\n\t\t\t\t\t\t\t\t\t\tpval < (normValues[i]+(self.knobMargin))\\\n\t\t\t\t\t\t\t\t\t\tor self.relativeMode:\n\t\t\t\t#print('knobClick')\n\t\t\t\tself.startValues = self.getNormValues()\n\t\t\t\t#debug('startValues set', self.startValues)\n\t\t\t\tself.lastClickPos = pval\n\t\t\t\tself.insideKnob = True\n\t\t\t\tknobIndex = i\n\t\t\t\tself.knobIndex = knobIndex\n\t\t\t\tbreak\n\t\t\telse:\n\t\t\t\tself.startValues = self.getNormValues()\n\t\t\t\t#debug('startValues set', self.startValues)\n\t\t\t\tself.lastClickPos = pval\n\t\t\t\tself.insideKnob = False\n\t\t\t\tself.knobClickOffset = None\n\t\t\t\tself.startDiffs = sorted([(i[0], abs(pval - i[1])) for i \\\n\t\t\t\t\t\t\tin enumerate(normValues)], key=lambda tup: tup[1])\n\n\t\treturn knobIndex\n\n\tdef setValue(self, value, index):\n\t\t#self.widgetComp.SetValueNorm(value,\tindex)\n\t\t#protoEdit\n\t\tgetattr(parent.Widget.par, 'Value'+ str(parent().digits)).normVal = value\n\n\tdef getNormValues(self):\n\t\treturn [self.Values[v].normValue for v in range(self.dimension)]\n\n\tdef getNormMin(self, index):\n\t\treturn self.Values[index].normMin\n\n\tdef getNormMax(self, index):\n\t\treturn self.Values[index].normMax\n\n\tdef valueChangeKnob(self, pVal, valueIndex):\n\t\t\"\"\"\n\t\tChanges value using the knob.  This generates a value change only if\n\t\tthe knob is moved.  Clicking anywhere on the knob will not change\n\t\tthe value.\n\t\t\"\"\"\n\t\tvalueIndex = valueIndex+self.valueGroupIndex\n\t\t#debug(valueIndex, 'startvs', self.startValues)\n\t\toffset = (pVal-self.lastClickPos)*(1/(1-(self.normKnobWidth)))\n\t\tvalue = (offset + self.startValues[0])\n\t\t#value = max(0, min(value, 1))\n\t\t#debug('knob', value)\n\t\tvalue = self.Values[valueIndex].valueClampFunc(value)\n\t\tself.setValue(value, valueIndex)\n\n\tdef valueChangeSlider(self, pVal, valueIndex):\n\t\t\"\"\"\n\t\tChanges value not using the knob.  This generates a value change only\n\t\tif the slider area with no knob is selected.\n\t\t\"\"\"\n\t\t#print(pVal)\n\t\tif valueIndex is not None:\n\t\t\tvalueIndex = valueIndex+self.valueGroupIndex\n\t\telse:\n\t\t\tvalueIndex = self.valueGroupIndex\n\t\tvalue = remap(pVal, self.normSliderMin, self.normSliderMax, 0, 1)\n\t\t#value = max(0, min(value, 1))\n\t\tvalue = self.Values[valueIndex].valueClampFunc(value)\n\t\t#debug('slider', value)\n\n\t\t##TextCOMP refactor 11/9/2021 - Jarrett\n\t\t##value = round(value, parent.Widget.par.Sliderdecimalplaces.eval())\n\n\t\tself.setValue(value, valueIndex)\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\t\"\"\"\n\t\tif event == 'offToOn' and panelValue.name == 'select':\n\t\t\tparent.Value.SelectOn()\n\t\telif event == 'onToOff' and panelValue.name == 'select':\n\t\t\tparent.Value.SelectOff()\n\t\telif panelValue.name in ['u', 'v']:\n\t\t\tparent.Value.ValueChange(panelValue)\n\nclass Value:\n\t\"\"\"\n\tHolds value parameter for widgets and provides common features for\n\tgetting and setting values.\n\t\"\"\"\n\tdef __init__(self, widgetComp, valuePar, index):\n\t\tself.widgetComp = widgetComp\n\t\tself.valuePar = valuePar\n\t\tself.valueIndex = index\n\t\tself.currentValue = None\n\t\tself.lastValue = None\n\t\t#self.knobClampMinMax = [widgetComp.par.Sliderclampmin.eval(),\n\t\t#\t\t\t\twidgetComp.par.Sliderclampmax.eval()]\n\t\tself.knobClampMinMax = [getattr(widgetComp.par,
              'Value'+str(self.valueIndex)).clampMin,\n\t\t\t\t\t\tgetattr(widgetComp.par, 'Value'+str(self.valueIndex)).clampMax]\n\t\t#self.normMin = getattr(widgetComp.par, 'Normminmax' + str(index) + '1').eval()\n\t\tself.normMin = getattr(widgetComp.par, 'Value'+ str(index)).normMin\n\t\t#self.normMax = getattr(widgetComp.par, 'Normminmax' + str(index) + '2').eval()\n\t\tself.normMax = getattr(widgetComp.par, 'Value'+ str(index)).normMax\n\t\tif self.knobClampMinMax[0] and self.knobClampMinMax[1]:\n\t\t\tself.valueClampFunc = self.clampMinMax\n\t\telif self.knobClampMinMax[0] and not self.knobClampMinMax[1]:\n\t\t\tself.valueClampFunc = self.clampMin\n\t\telif not self.knobClampMinMax[0] and self.knobClampMinMax[1]:\n\t\t\tself.valueClampFunc = self.clampMax\n\t\telse:\n\t\t\tself.valueClampFunc = self.clampOff\n\t\tself.valueUpdate()\n\n\tdef valueUpdate(self):\n\t\tself.lastValue = self.currentValue\n\t\tself.currentValue = self.valuePar.eval()\n\n\tdef clampMax(self, value):\n\t\treturn  min(value, 1)\n\n\tdef clampMin(self, value):\n\t\treturn  max(0, value)\n\n\tdef clampMinMax(self, value):\n\t\treturn  max(0, min(value, 1))\n\n\tdef clampOff(self, value):\n\t\treturn value\n\n\t@property\n\tdef normValue(self):\n\t\t#return self.widgetComp.GetValueNorm(self.valueIndex)\n\t\t#protoEdit\n\t\treturn getattr(parent.Widget.par, 'Value'+ str(self.valueIndex)).evalNorm()\n\ndef remap(val, fromMin, fromMax, toMin, toMax):\n\t\"\"\"\n\tRemaps val to a new range.\n\t\"\"\"\n\n\tresult = ( (val - fromMin) / (fromMax - fromMin) ) * (toMax - toMin) + toMin\n\n\treturn result\n"
            dat_content_format: text
          - name: parReinit
            type: parameterexecuteDAT
            parameters:
              fromop: =parent()
              op: =parent.Widget
              pars: Sliderknobsize w h Default* Min* Norm* Clamp* Sliderclamp* Sliderrel* Sliderorient
              onpulse: false
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [-700, 300]
            size: [130, 90]
            dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n# \n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef onValueChange(par, val, prev):\n\tparent().par.reinitextensions.pulse()\n\treturn\n\ndef onPulse(par):\n\treturn\n\ndef onExpressionChange(par, val, prev):\n\treturn\n\ndef onExportChange(par, val, prev):\n\treturn\n\ndef onEnableChange(par, val, prev):\n\treturn\n\ndef onModeChange(par, val, prev):\n\treturn\n\t"
            dat_content_format: text
          - name: glslSlider
            type: textDAT
            parameters:
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [200, -300]
            size: [130, 90]
            dat_content: "//horizontal slider: 0, vertical slider: 1\nuniform int orient;\n//the widget's current normalized value\nuniform float nrmValue;\nuniform float defaultValue;\nuniform vec2 minMax;\nuniform vec4 bgColor;\nuniform vec4 indColor;\nuniform vec4 knobColor;\nuniform int knobSize;\n//uniform float pOffset;\n//uniform float scale;\n\nlayout(location = 0) out vec4 fragColor;\n\nfloat map(float s, float a1, float a2, float b1, float b2)\n{\n    return b1 + (s-a1)*(b2-b1)/(a2-a1);\n}\n\nvec4 over(vec4 tOver, vec4 tUnder)\n{\n    return ((1.0-tOver.a)*tUnder) + tOver.a * tOver;\n}\n\nvoid main() {\n\n    //level use v if orient is 1 else use u\n    float level = orient == 1.0 ? vUV.t : vUV.s;\n\t//Flips the incoming text and textures to the correct orientation\n\tvec2 fUV = orient == 1.0 ? (vec2(0.0, 1.0)\n\t\t\t\t\t\t\t\t+ (vUV.ts*vec2(1.0, -1.0))) : vUV.st;\n\tfloat coord = orient == 1.0 ? gl_FragCoord.y : gl_FragCoord.x;\n    float sliderPixLength = uTD2DInfos[0].res.z;\n\tvec4 color = vec4(0.0);\n\t//ranged value\n\tfloat rmin = minMax.x;\n\tfloat rmax = minMax.y;\n\t//normalize knob size\n\tfloat nmKnobSize = knobSize / sliderPixLength;\n\tfloat nmKnobSizeH = nmKnobSize/2.0;\n\tfloat nmDefault = (defaultValue-rmin) / (rmax - rmin);\n\tfloat nmValueKnob = nrmValue * (1-nmKnobSize) + nmKnobSizeH;\n    float pOffset = -nrmValue * ((sliderPixLength-knobSize) / knobSize);\n    float scale = sliderPixLength / knobSize;\n    //knob uv\n    vec2 knobUV =  vec2(fUV.s*scale+pOffset, fUV.t);\n\n    //load textures\n    //vec4 textLayer = texture(sTD2DInputs[0], fUV);\n\tvec4 bgLayer = texture(sTD2DInputs[1], fUV);\n\tvec4 knobLayer = texture(sTD2DInputs[0], knobUV);\n\n\t//Level indicator color\n    if (level < nmValueKnob-(nmKnobSizeH) && level > nmDefault ||\n\t\t\t\t\tlevel < nmDefault && level >\n                    nmValueKnob+(nmKnobSizeH))\n\t//slider range color\n    {\n        color = over(indColor, color);\n  \t}\n    else\n\t//slider bg color\n  \t{\n  \t   color = bgColor;\n  \t}\n\t//remap slider range in consideration of knob width\n\tfloat remapValue = map(nrmValue, 0, 1, nmKnobSizeH,\n                                                1-(nmKnobSizeH));\n    //float remapValue = map(normValue, 0, 1, 0, 1);\n    //knob color\n\tif (level > (remapValue - (nmKnobSizeH)) &&\n\t\t\t\t\t\t\t\t      level < (remapValue + (nmKnobSizeH)))\n    //knob color and texture\n    {\n    color = over(knobColor, color);\n    color = over(knobLayer, color);\n    }\n\t//Texture mix\n    color = over(color, bgLayer);\n    //color = over(textLayer, color);\n    //color = vec4(orient);\n    //color = vec4(float(level < (remapValue + (nmKnobSizeH))));\n    //color = vec4(uTD2DInfos[0].res.z);\n\tfragColor = color;\n}\n"
            dat_content_format: text
          - name: panelexec1
            type: panelexecuteDAT
            parameters:
              fromop: =parent()
              panels: =parent()
              language: input
            position: [-550, 0]
            size: [130, 90]
            dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# prev - the previous value of the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onOffToOn(panelValue):\n\treturn\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue, prev):\n\treturn\n\t"
            dat_content_format: text
          - name: SubWidgetExt
            type: textDAT
            parameters:
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [-500, 400]
            size: [130, 90]
            tags:
            - TDExtension
            dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
            dat_content_format: text
          - name: cacheselect1
            type: cacheselectTOP
            parameters:
              cachetop: =parent.Widget.par.Widgetcachecomp.eval().op('cache') if parent.Widget.par.Widgetcachecomp.eval() else ''
              index: =((parent.Widget.par.Value0.eval()-parent.Widget.par.Value0.normMin) * (0 - -parent.Widget.par.Widgetcachecomp.eval().par.Indexrange)) / (parent.Widget.par.Value0.normMax-parent.Widget.par.Value0.normMin) + -parent.Widget.par.Widgetcachecomp.eval().par.Indexrange if parent.Widget.par.Widgetcachecomp.eval() else 0
              resolutionw: =op('label').width
              resolutionh: =op('label').height
            flags:
            - viewer
            position: [100, -700]
            size: [130, 90]
          - name: panelExecOPExec
            type: opexecuteDAT
            parameters:
              op: =ext.SubWidgetExt.PanelExecPar.eval()
            flags:
            - viewer
            position: [-700, 100]
            color: [0.05, 0.5, 0.05]
            dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
            dat_content_format: text
          - name: panelexecValueX
            type: panelexecuteDAT
            parameters:
              fromop: =me.parent()
              panels: =parent()
              panelvalue: ='select ' + ('v' if parent.Widget.par.Sliderorient.menuIndex else 'u')
              offtoon: =1-parent.Widget.par.Sliderignoreinteract
              ontooff: =1-parent.Widget.par.Sliderignoreinteract
              valuechange: =1-parent.Widget.par.Sliderignoreinteract
              defaultreadencoding: cp1252
              language: input
            position: [-700, 0]
            size: [130, 90]
            color: [0.05, 0.5, 0.05]
            dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
            dat_content_format: text
          - name: text1_callbacks
            type: textDAT
            parameters:
              language: input
            flags:
            - viewer
            - -showDocked
            position: [400, -150]
            size: [160, 130]
            dock: text
            dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
            dat_content_format: text
          - name: parexecSettingsX
            type: parameterexecuteDAT
            parameters:
              fromop: =me.parent()
              op: '=parent.Widget '
              pars: Slidercustomizeinteraction Sliderhorizontalmode Sliderverticalmode
