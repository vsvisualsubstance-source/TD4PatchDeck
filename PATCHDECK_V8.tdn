            - name: replicator1_callbacks
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, -200]
              size: [130, 90]
              dock: buttonReplicator
              dat_content: "# me - this DAT\n# \n# comp - the replicator component which is cooking\n# allOps - a list of all replicants, created or existing\n# newOps - the subset that were just created\n# template - table DAT specifying the replicator attributes\n# master - the master operator\n#\n\ndef replicate(comp, allOps, newOps, template, master):\n\n\tfor c in allOps:\n\t\t#c.display = True\n\t\t#c.render = True\n\t\t#c.par.display = 1\n\t\t#c.par.clone = comp.par.master\n\t\tc.op('bg').cook(force=True)\n\t\t#c.cook(force=True)\n\n\treturn\n"
              dat_content_format: text
            - name: replicator2_callbacks
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 150]
              size: [130, 90]
              dock: menuReplicator
              dat_content: "# me - this DAT\n# \n# comp - the replicator component which is cooking\n# allOps - a list of all replicants, created or existing\n# newOps - the subset that were just created\n# template - table DAT specifying the replicator attributes\n# master - the master operator\n#\n\ndef onReplicate(comp, allOps, newOps, template, master):\n\tfor c in allOps:\n\t\trun(\"args[0].par.enablecloningpulse.pulse() if args[0] else None\", \n\t\t\t\tc, delayFrames=1)"
              dat_content_format: text
