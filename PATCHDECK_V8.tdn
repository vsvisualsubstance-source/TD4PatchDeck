              Toxsavebuild: '2023.12230'
          flags:
          - render
          - viewer
          position: [0, -8400]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: label
            type: containerCOMP
            parameters:
              w: =parent().par.Labelwidth
              h: =parent().par.Labelheight
              layer: 1
              hmode: =parent.Widget.par.Labelhorizontalmode
              hfillweight: =parent.Widget.par.Labelhfillweight
              vmode: =parent.Widget.par.Labelverticalmode
              vfillweight: =parent.Widget.par.Labelvfillweight
              display: =parent.Widget.par.Labeldisplay
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              uvbuttonsleft: false
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Labelbgcolorr
              bgcolorg: =parent.Widget.par.Labelbgcolorg
              bgcolorb: =parent.Widget.par.Labelbgcolorb
              bgalpha: =parent.Widget.par.Labelbgcolora
              borderover: false
              enablecloning: false
            custom_pars:
              Label:
                $t: label_6
                Widgetlabel: Checkbox
                Labelfontsize: 9
                Labelalignx: left
                Labelaligny: center
                Labeloffset: [6, 0]
                Labelbgcolor: [0.2, 0.2, 0.2, 1]
                Labelfontcolor: [0.65, 0.65, 0.65, 1]
                Labelwidth: 120
                Labelverticalmode: fill
                Labelheight: 32
            flags:
            - viewer
            position: [200, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: =parent.Widget.par.Widgetlabel.eval()
                type: multiline
                wordwrap: =parent.Widget.par.Labelwordwrap.eval()
                callbacks: text1_callbacks
                legacyfontselection: true
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Labelfontbold.eval()
                italic: =parent.Widget.par.Labelitalic
                scaletofit: =parent.Widget.par.Labelfontsizemode
                fontsize: =parent.Widget.par.Labelfontsize.eval() if parent.Widget.par.Labelfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Labelfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Labelfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Labelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Labelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Labelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Labelfontcolora.eval()
                dropshadow: =parent.Widget.par.Labeldropshadow
                textoffsetx: =parent.Widget.par.Labeloffsetx.eval()
                textoffsety: =parent.Widget.par.Labeloffsety.eval()
                textpaddingl: =parent.Widget.par.Labelpadding1.eval()
                textpaddingr: =parent.Widget.par.Labelpadding2.eval()
                textpaddingb: =parent.Widget.par.Labelpadding3.eval()
                textpaddingt: =parent.Widget.par.Labelpadding4.eval()
                alignx: =parent.Widget.par.Labelalignx.eval()
                aligny: =parent.Widget.par.Labelaligny.eval()
                hmode: fill
                vmode: fill
                bottomanchor: 0.039
                helpdat: =parent.Widget.op('code/help')
                clickthrough: =parent.Widget.par.clickthrough
                top: =parent.Widget.par.Labeltop.eval()
                borderover: false
              flags:
              - viewer
              position: [0, -200]
              size: [160, 130]
            - name: parexecRunCommand
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: =parent.Widget
                pars: Labelhorizontalmode Labelverticalmode
                onpulse: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n#\n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef valueChange(par, val, prev):\n\tif par.name == 'Labelhorizontalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Labelhfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Labelwidth, 'enable', bool(1-val))\n\telif par.name == 'Labelverticalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Labelvfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Labelheight, 'enable', bool(1-val))\n\treturn\n\ndef onPulse(par):\n\treturn\n\ndef expressionChange(par, val, prev):\n\treturn\n\ndef exportChange(par, val, prev):\n\treturn\n\ndef enableChange(par, val, prev):\n\treturn\n\ndef modeChange(par, val, prev):\n\treturn\n"
              dat_content_format: text
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_11
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: valueOut
            type: outCHOP
            parameters:
              label: =me.name
              autoexportroot: =parent()
            position: [400, 0]
            inputs:
            - output
          - name: checkbox0
            type: buttonCOMP
            parameters:
              buttontype: toggleup
              scaletofit: onlyshrink
              w: =parent.Widget.par.Checkwidth
              h: =parent.Widget.par.Checkheight
              fixedaspect: =parent.Widget.par.Checkfixedaspect
              hmode: =parent.Widget.par.Checkhorizontalmode
              hfillweight: =parent.Widget.par.Checkhfillweight
              vmode: =parent.Widget.par.Checkverticalmode
              vfillweight: =parent.Widget.par.Checkvfillweight
              alignorder: 1
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              bgcolorr: 0.8
              bgcolorg: 0.8
              bgcolorb: 0.8
              bgalpha: =passive(me).panel.lselect * 0.3
              top: ./bg
              align: horizlr
              marginl: =parent.Widget.par.Checkmarginsize.eval()
              marginr: =parent.Widget.par.Checkmarginsize.eval()
              marginb: =parent.Widget.par.Checkmarginsize.eval()
              margint: =parent.Widget.par.Checkmarginsize.eval()
              justifyh: left
              parentshortcut: Value
              relpath: inherit
            sequences:
              ext:
              - object: op('./CheckExt').module.CheckExt(me)
                promote: true
            custom_pars:
              Check:
                $t: check
                Checkoffcolor: [0.18182, 0.18182, 0.18182, 1]
                Checkoncolor: [0.18182, 0.18182, 0.18182, 1]
                Checkoffcheckcolor: [0.09091, 0.09091, 0.09091, 1]
                Checkoncheckcolor: [0.81818, 0.81818, 0.81818, 1]
                Checkoffbordercolor: [0, 0, 0, 0]
                Checkonbordercolor: [0, 0, 0, 0]
                Checkoffsize: [0.618033, 0.618033]
                Checkonsize: [0.618033, 0.618033]
                Checkfixedaspect: usevert
                Checkoffborderwidth: 0
                Checkonborderwidth: 0
                Checkantialias: true
                Checkhorizontalmode: fill
                Checkverticalmode: fill
            position: [400, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: x
              type: textCOMP
              parameters:
                text: =(chr(0xF0156) if parent.Widget.par.Checklook.eval() == 'product' else chr(0xF0E1E)) if parent.Widget.par.Value0 == True else ''
                callbacks: text1_callbacks
                legacyfontselection: true
                font: Material Design Icons
                scaletofit: always
                fontcolorr: =parent.Widget.par.Checkoncheckcolorr
                fontcolorg: =parent.Widget.par.Checkoncheckcolorg
                fontcolorb: =parent.Widget.par.Checkoncheckcolorb
                fontalpha: =parent.Widget.par.Checkoncheckcolora
                textpaddingl: 0.25
                textpaddingr: 0.25
                textpaddingb: 0.25
                textpaddingt: 0.25
                textpaddingunits: relfract
                alignxmode: bbox
                alignymode: bbox
                hmode: fill
                vmode: fill
                display: =parent.Widget.par.Checklook.eval() != 'box'
                clickthrough: true
                bgcolorr: 0.3
                bgcolorg: 0.3
                bgcolorb: 0.3
                bgalpha: 1
                borderover: false
              flags:
              - viewer
              position: [0, -200]
              size: [160, 130]
            - name: check
              type: containerCOMP
              parameters:
                hmode: fill
                vmode: fill
                display: =parent.Widget.par.Checklook.eval() == 'box'
                helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
                clickthrough: true
                resizecomp: =me
                top: ./bg
                borderover: false
              flags:
              - viewer
              size: [160, 130]
              children:
              - name: bg
                type: nullTOP
                parameters:
                  filtertype: nearest
                flags:
                - viewer
                position: [400, -100]
                size: [130, 90]
                inputs:
                - switch1
              - name: 'on'
                type: rectangleTOP
                parameters:
                  sizex: =parent.Widget.par.Checkonsizew.eval()
                  sizey: =parent.Widget.par.Checkonsizeh.eval()
                  sizeunit: fraction
                  fillcolorr: =parent.Widget.par.Checkoncheckcolorr.eval()
                  fillcolorg: =parent.Widget.par.Checkoncheckcolorg.eval()
                  fillcolorb: =parent.Widget.par.Checkoncheckcolorb.eval()
                  fillalpha: =parent.Widget.par.Checkoncheckcolora.eval()
                  borderr: =parent.Widget.par.Checkonbordercolorr.eval()
                  borderg: =parent.Widget.par.Checkonbordercolorg.eval()
                  borderb: =parent.Widget.par.Checkonbordercolorb.eval()
                  borderalpha: =parent.Widget.par.Checkonbordercolora.eval()
                  bgcolorr: =parent.Widget.par.Checkoncolorr.eval()
                  bgcolorg: =parent.Widget.par.Checkoncolorg.eval()
                  bgcolorb: =parent.Widget.par.Checkoncolorb.eval()
                  bgalpha: =parent.Widget.par.Checkoncolora.eval()
                  borderwidth: =parent.Widget.par.Checkonborderwidth.eval()
                  borderwidthunit: pixels
                  cornerradius: =parent.Widget.par.Checkcornerradius.eval()
                  cornerradiusunit: fraction
                  antialias: =parent.Widget.par.Checkantialias.eval()
                  outputresolution: parpanel
                  resolutionw: 12
                  resolutionh: 12
                  resmult: false
                  outputaspect: resolution
                  inputfiltertype: nearest
                  filtertype: nearest
                flags:
                - viewer
                position: [0, -200]
                size: [130, 90]
                inputs:
                - select2
              - name: 'off'
                type: rectangleTOP
                parameters:
                  sizex: =parent.Widget.par.Checkoffsizew.eval()
                  sizey: =parent.Widget.par.Checkoffsizeh.eval()
                  sizeunit: fraction
                  fillcolorr: =parent.Widget.par.Checkoffcheckcolorr.eval()
                  fillcolorg: =parent.Widget.par.Checkoffcheckcolorg.eval()
                  fillcolorb: =parent.Widget.par.Checkoffcheckcolorb.eval()
                  fillalpha: =parent.Widget.par.Checkoffcheckcolora.eval()
                  borderr: =parent.Widget.par.Checkoffbordercolorr.eval()
                  borderg: =parent.Widget.par.Checkoffbordercolorg.eval()
                  borderb: =parent.Widget.par.Checkoffbordercolorb.eval()
                  borderalpha: =parent.Widget.par.Checkoffbordercolora.eval()
                  bgcolorr: =parent.Widget.par.Checkoffcolorr.eval()
                  bgcolorg: =parent.Widget.par.Checkoffcolorg.eval()
                  bgcolorb: =parent.Widget.par.Checkoffcolorb.eval()
                  bgalpha: =parent.Widget.par.Checkoffcolora.eval()
                  borderwidth: =parent.Widget.par.Checkoffborderwidth.eval()
                  borderwidthunit: pixels
                  cornerradius: =parent.Widget.par.Checkcornerradius.eval()
                  cornerradiusunit: fraction
                  antialias: =parent.Widget.par.Checkantialias.eval()
                  outputresolution: parpanel
                  resolutionw: 12
                  resolutionh: 12
                  resmult: false
                  outputaspect: resolution
                  inputfiltertype: nearest
                  filtertype: nearest
                flags:
                - viewer
                size: [130, 90]
                inputs:
                - select1
              - name: empty
                type: constantTOP
                parameters:
                  colorr: 0
                  colorg: 0
                  colorb: 0
                  alpha: 0
                  operand: over
                  resolutionw: =parent().width-(parent.Widget.par.Checkmarginsize.eval()*2)
                  resolutionh: =parent().height-(parent.Widget.par.Checkmarginsize.eval()*2)
                flags:
                - viewer
                position: [-400, -100]
                size: [130, 90]
              - name: select1
                type: selectTOP
                parameters:
                  top: =parent.Widget.par.Checkofftop.eval() or 'empty'
                  outputresolution: parpanel
                  resolutionw: 12
                  resolutionh: 12
                flags:
                - viewer
                position: [-200, 0]
                size: [130, 90]
              - name: select2
                type: selectTOP
                parameters:
                  top: =parent.Widget.par.Checkontop.eval() or 'empty'
                  outputresolution: parpanel
                  resolutionw: 12
                  resolutionh: 12
                flags:
                - viewer
                position: [-200, -200]
                size: [130, 90]
              - name: switch1
                type: switchTOP
                parameters:
                  index: =getattr(parent.Widget.par, 'Value'+ str(parent(2).digits)).evalNorm()
                  inputfiltertype: nearest
                  filtertype: useinput
                flags:
                - viewer
                position: [200, -100]
                size: [130, 90]
                inputs:
                - 'off'
                - 'on'
              - name: rollover
                type: containerCOMP
                parameters:
                  layer: 7
                  hmode: fill
                  vmode: fill
                  alignallow: ignore
                  display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                  clickthrough: true
                  resizecomp: =me
                  borderover: false
                  composite: =parent.Widget.par.Rollovercomposite.eval()
                flags:
                - viewer
                position: [300, 200]
                size: [160, 155]
            - name: CheckExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-850, 575]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass CheckExt(SubWidgetExt):\n\t\"\"\"\n\tCheckExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\tself.parPrefix = 'Check'\n\t\tSubWidgetExt.__init__(self, ownerComp, indexComp = parent())\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\tself.onToggleEvent(event, panelValue)\n\n\tdef makePanelExecute(self):\n\t\tSubWidgetExt.makePanelExecute(self, self.getDockExpressionToOwner()\n\t\t\t\t\t\t\t\t\t  + \".op('check')\")\n"
              dat_content_format: text
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =parent().panel.rollover or parent().panel.lselect or parent().panel.inside
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: add
              flags:
              - viewer
              position: [0, 200]
              size: [160, 130]
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-1025, 575]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: panelexecValue
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: ..
                panelvalue: lselect
                ontooff: true
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-850, 175]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-850, 275]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: parexecSettings
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Checkcustomizeinteraction Checkhorizontalmode Checkverticalmode
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-850, 375]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: python
              flags:
              - viewer
              position: [0, -360]
              size: [160, 130]
              dock: x
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
        - name: dropDownButton
          type: widgetCOMP
          parameters:
            x: 3
            y: -959
            w: 450
            h: 26
            bottomanchor: 1
            vorigin: 1
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            bgcolorr: 0.2
            bgcolorg: 0.2
            bgcolorb: 0.2
            bgalpha: 1
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            topborder: bordera
            borderover: false
            align: horizlr
            spacing: 1
            marginl: 3
            marginr: 3
            marginb: 3
            margint: 3
            opviewer: ./menuOptionsOut
            clone: =op.TDBasicWidgets.op('dropDownButton') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
              $t: values_10
            Label:
              $t: label_2
            Field:
              $t: field_8
            Menu:
              $t: menu
            Menu Look:
              $t: menu_look_2
            Button:
              $t: button_6
              Buttonlabel: =chr(0xF0140)
            Widget:
              $t: widget_4
            OPs:
              $t: ops_17
              Buttonpush0: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/dropDownButton/stringMenu0/buttonPush0
              Label: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/dropDownButton/label
              Stringfield0: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/dropDownButton/stringMenu0/stringField0
              Stringmenu0: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/dropDownButton/stringMenu0
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -14600]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: menu
            type: baseCOMP
            parameters:
              opviewer: ./menuOptionsOut
              enablecloning: false
            custom_pars:
              Menu:
                $t: menu_5
            flags:
            - viewer
            position: [200, 200]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            inputs:
            - in_menuOptions
            children:
            - name: eval1
              type: evaluateDAT
              parameters:
                expr: parent.Widget.par.Menunames.eval() + ' ' + parent.Widget.par.Menulabels.eval()
                rowindexend: =me.inputTable.numRows - 1
                colindexend: =me.inputTable.numCols - 1
              position: [200, -500]
              comment: only to test for changes
              dat_read_only: true
            - name: entries
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [600, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content: "TDF = op.TDModules.mod.TDFunctions\ntable = op('menuOptions')\n\ndef par():\n\treturn TDF.parMenu(names(), labels())\n\t\n\ndef names():\n\ttry:\n\t\treturn [c.val for c in table.col(0)][1:]\n\texcept:\n\t\treturn []\n\n\ndef labels():\n\ttry:\n\t\treturn [c.val for c in table.col(1)][1:]\n\texcept:\n\t\treturn []"
              dat_content_format: text
            - name: tablePar
              type: selectDAT
              parameters:
                dat: =parent.Widget.par.Menuoptiontable.eval() if parent.Widget.par.Menuoptiontable.eval() else ''
                rowindexend: =me.inputs[0].numRows - 1
                rowexpr: =re.match('.*',me.inputCell.val) != None
                colindexend: =me.inputs[0].numCols - 1
              flags:
              - viewer
              position: [0, -200]
              size: [130, 90]
              dat_read_only: true
            - name: out_menu0
              type: outCHOP
              parameters:
                label: Selected Index
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [800, -200]
              inputs:
              - selectedCell
            - name: out_menu1
              type: outDAT
              parameters:
                label: Selected
              flags:
              - viewer
              position: [800, -300]
              size: [130, 90]
              inputs:
              - selectedRowSelect
              dat_read_only: true
            - name: out_menu2
              type: outDAT
              parameters:
                label: Menu Options
              flags:
              - viewer
              position: [800, -500]
              size: [130, 90]
              inputs:
              - menuOptions
              dat_read_only: true
            - name: menuOptions
              type: scriptDAT
              parameters:
                callbacks: script1_callbacks
              custom_pars:
                Custom:
                  $t: custom_2
              flags:
              - viewer
              position: [400, -500]
              inputs:
              - menuOptionsInOrPar
              - eval1
              dat_read_only: true
            - name: selectedCell
              type: constantCHOP
              parameters:
                autoexportroot: =me.parent()
                exporttable: constant2_export
              sequences:
                const:
                - name: menuIndex
                  value: =parent.Widget.par.Value0.menuIndex
              flags:
              - viewer
              position: [600, -200]
              size: [130, 90]
            - name: menuOptionsIn
              type: inDAT
              parameters:
                label: Menu Options Table
              position: [0, -300]
              dat_read_only: true
            - name: inputHeaderFix
              type: insertDAT
              parameters:
                at: =0 if parent.Widget.par.Tableformat.menuIndex == 0 else 1
                contents: name label
              position: [400, -300]
              inputs:
              - menuOptionsInOrPar
              dat_read_only: true
            - name: constant2_export
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
              flags:
              - viewer
              position: [600, -325]
              size: [130, 90]
              dock: selectedCell
              dat_content:
              - - name
                - index
                - path
                - parameter
                - enable
              - - selected_cell
                - '0'
                - selectedRowSelect
                - rowindexstart
                - '1'
              - - selected_cell
                - '0'
                - selectedRowSelect
                - rowindexend
                - '1'
              dat_content_format: table
            - name: script1_callbacks
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              dock: menuOptions
              dat_content: "# me - this DAT\n# scriptOp - the OP which is cooking\n#\n# press 'Setup Parameters' in the OP to call this function to re-create the parameters.\ndef onSetupParameters(scriptOp):\n\treturn\n\n# called whenever custom pulse parameter is pushed\ndef onPulse(par):\n\treturn\n\ndef onCook(scriptOp):\n\ttry:\n\t\tscriptOp.text = setupMenuOptions(scriptOp)\n\texcept:\n\t\tscriptOp.text = \"name\\tlabel\"\n\t#scriptOp.copy(scriptOp.inputs[0])\t# no need to call .clear() above when copying\n\t#scriptOp.insertRow(['color', 'size', 'shape'], 0)\n\t#scriptOp.appendRow(['red', '3', 'square'])\n\t#scriptOp[1,0] += '**'\n\n\treturn\n\ndef setupMenuOptions(scriptOp):\n\tif hasattr(parent.Widget.par, 'Synctoboundmenu'):\n\t\tparent.Widget.par.Menulabels.readOnly = \\\n\t\t\tparent.Widget.par.Menunames.readOnly = \\\n\t\t\t\t\t\t\t\t\tparent.Widget.par.Synctoboundmenu.eval()\n\texternalMenuTable = scriptOp.inputs[0]\n\tif externalMenuTable.numCols:\n\t\tlabels = []\n\t\t#['AllRows_FirstCols', 'LabelRow_FirstCols', 'LabelRow_LabeledCols']\n\t\tif parent.Widget.par.Tableformat.eval() ==\\\n\t\t\t\t\t\t\t\t\t\t\t\t'ExcludeFirstRow_LabeledCols':\n\t\t\tnames = [c.val for c in externalMenuTable.col('name')[1:]]\n\t\t\tlabelCol = externalMenuTable.col('label')\n\t\t\tif labelCol:\n\t\t\t\tlabels = [c.val for c in labelCol[1:]]\n\t\telse:\n\t\t\tnames = [c.val for c in externalMenuTable.col(0)]\n\t\t\tlabelCol = externalMenuTable.col(1)\n\t\t\tif labelCol:\n\t\t\t\tlabels = [c.val for c in labelCol]\n\t\t\tif parent.Widget.par.Tableformat.eval() == \\\n\t\t\t\t\t\t\t\t\t\t\t\t'ExcludeFirstRow_NumberedCols':\n\t\t\t\tnames.pop(0)\n\t\t\t\tif labels:\n\t\t\t\t\tlabels.pop(0)\n\telse:\n\t\tnames = tdu.split(parent.Widget.par.Menunames)\n\t\tlabels = tdu.split(parent.Widget.par.Menulabels)\n\tfinalNames = names\n\tfinalLabels = []\n\tfor i, name in enumerate(names):\n\t\tif i < len(labels):\n\t\t\tfinalLabels.append(labels[i])\n\t\telse:\n\t\t\tfinalLabels.append(name)\n\treturn 'name\\tlabel\\n' + \\\n\t\t\t'\\n'.join([finalNames[i] + '\\t' + finalLabels[i]\n\t\t\t\t\t   \t\tfor i in range(len(finalNames))])"
              dat_content_format: text
            - name: selectedRowSelect
              type: selectDAT
              parameters:
                dat: =op('inputHeaderFix') if op('menuOptionsIn').numRows else op('menuOptions')
                firstrow: true
                extractrows: byindex
                rowindexstart: '=op(''selectedCell'')[0] + 1 # if parent.Widget.par.Tableformat.menuIndex > 0 or not op(''menuOptionsIn'').numRows else 0'
                rowindexend: '=op(''selectedCell'')[0] + 1 # if parent.Widget.par.Tableformat.menuIndex > 0 or not op(''menuOptionsIn'').numRows else 0'
                rowexpr: =re.match('.*',me.inputCell.val) != None
                colindexend: =me.inputs[0].numCols - 1
              flags:
              - viewer
              position: [600, -300]
              size: [130, 90]
              dat_read_only: true
            - name: menuOptionsInOrPar
              type: switchDAT
              parameters:
                index: =bool(parent.Widget.inputs and parent.Widget.inputs[0])
              position: [200, -300]
              size: [130, 90]
              inputs:
              - tablePar
              - menuOptionsIn
              dat_read_only: true
          - name: label
            type: containerCOMP
            parameters:
              w: =parent().par.Labelwidth
              h: =parent().par.Labelheight
              layer: 1
              hmode: =parent.Widget.par.Labelhorizontalmode
              hfillweight: =parent.Widget.par.Labelhfillweight
              vmode: =parent.Widget.par.Labelverticalmode
              vfillweight: =parent.Widget.par.Labelvfillweight
              display: =parent.Widget.par.Labeldisplay
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              uvbuttonsleft: false
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Labelbgcolorr
              bgcolorg: =parent.Widget.par.Labelbgcolorg
              bgcolorb: =parent.Widget.par.Labelbgcolorb
              bgalpha: =parent.Widget.par.Labelbgcolora
              borderover: false
              enablecloning: false
            custom_pars:
              Label:
                $t: label_6
                Widgetlabel: Drop Down Button
                Labelfontsize: 9
                Labelalignx: left
                Labelaligny: center
                Labeloffset: [6, 0]
                Labelbgcolor: [0.2, 0.2, 0.2, 1]
                Labelfontcolor: [0.65, 0.65, 0.65, 1]
                Labelwidth: 120
                Labelverticalmode: fill
                Labelheight: 32
            flags:
            - viewer
            position: [0, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
