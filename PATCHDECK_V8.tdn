              value: 0.007
            - name: Topthreshold
              style: Float
              label: top_threshold
              normMin: 0.5
              normMax: 3.0
              value: 3
          flags:
          - viewer
          position: [225, 0]
          size: [160, 130]
          inputs:
          - null2
          children:
          - name: in1
            type: inTOP
            parameters:
              label: =me.name
            flags:
            - viewer
            position: [-60, 70]
            size: [130, 90]
          - name: out1
