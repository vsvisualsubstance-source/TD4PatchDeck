                Labelwidth: 120
                Labelhfillweight: 0.5
                Labelverticalmode: fill
                Labelheight: 34
            flags:
            - viewer
            position: [200, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
