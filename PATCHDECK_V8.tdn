                    $t: expressions_2
                    Value: =parent.Widget.par.Value0.eval() == parent().digits
                    Mapoff: '='
                    Mapon: '='
                    Fontcolor: =parent.Widget.parGroup.Foldertabonfontcolor if me.par.Value else parent.Widget.parGroup.Foldertabofffontcolor
