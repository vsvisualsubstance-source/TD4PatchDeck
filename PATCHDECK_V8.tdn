          - name: out1
            type: outTOP
            parameters:
              label: =me.name
              fillmode: useinput
              filtertype: nearest
            flags:
            - viewer
            position: [2525, 200]
            size: [130, 105]
            inputs:
            - transform1
          - name: out2
            type: outCHOP
            parameters:
              label: =me.name
              autoexportroot: =parent()
            flags:
            - viewer
            position: [1150, -275]
            color: [0.67, 0.67, 0.67]
            inputs:
            - audiospect3
          - name: par1
            type: parameterCHOP
            parameters:
              ops: =op.Sndviz
