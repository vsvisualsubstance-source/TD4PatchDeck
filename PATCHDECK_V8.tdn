          bgcolorr: 0.2
          bgcolorg: 0.2
          bgcolorb: 0.2
          bgalpha: 1
          borderar: 0
          borderag: 0
          borderab: 0
          borderaalpha: 0
          borderover: false
          align: horizlr
          spacing: 1
          marginl: 3
          marginr: 3
          marginb: 3
          margint: 3
          justifyh: left
          justifyv: top
          clone: =op.TDBasicWidgets.op('sliderHorz') if hasattr(op, 'TDBasicWidgets') else ''
        sequences:
          ext:
          - promote: true
        custom_pars:
          Values:
            $t: values_5
