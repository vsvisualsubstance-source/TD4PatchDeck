              Labelfontcolor: [0.65, 0.65, 0.65, 1]
              Labelwidth: 120
              Labelverticalmode: fill
              Labelheight: 32
          flags:
          - viewer
          position: [200, -300]
          size: [160, 130]
          color: [0.5, 0.35, 0.05]
          tags:
          - TDPub
          - TDSubComp
          children:
          - name: text
