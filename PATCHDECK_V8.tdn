              - Right
            - name: Valuelabelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
            - name: Valuelabeloffset
              style: XYZW
              label: Offset
              size: 2
              startSection: true
              min: -5.0
              max: 5.0
              normMin: -5.0
              normMax: 5.0
            - name: Valuelabelpadding
              style: Float
              label: Padding
              size: 4
            - name: Valuelabelbgcolor
              style: RGBA
