  - name: execute
    type: executeDAT
    parameters:
      start: true
      create: true
      exit: true
      projectpresave: true
      projectpostsave: true
      file: Embody1/execute.py
      defaultreadencoding: cp1252
      syncfile: true
      language: input
    flags:
    - display
    position: [-275, 400]
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
