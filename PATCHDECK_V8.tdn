                legacyfontselection: true
                font: Open Sans
                bold: true
                antialias: aa8mid
                fontautosize: fitiffat
                fontsizex: 0.05
                fontsizexunit: fract
                positiony: 0.03
                positionunit: fraction
                aligny: bottom
                fontalpha: 0.95
                borderaalpha: 0
                leftborder: bordera
                rightborder: bordera
                bottomborder: bordera
                topborder: bordera
                outputresolution: custom
                resolutionw: =parent().par.w
                resolutionh: =parent().par.h
