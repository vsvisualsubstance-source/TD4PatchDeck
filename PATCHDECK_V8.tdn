              bgcolorr: =op('./text').par.Facecolor.eval()[0]
              bgcolorg: =op('./text').par.Facecolor.eval()[1]
              bgcolorb: =op('./text').par.Facecolor.eval()[2]
              bgalpha: =op('./text').par.Facecolor.eval()[3]
              crop: 'on'
              parentshortcut: Value
            sequences:
              ext:
              - object: op('./RockerExt').module.RockerExt(me)
            custom_pars:
              Rocker:
              - name: Rockerlabels
                style: Str
                label: Labels
                value: Off On
              - name: Rockerofftop
                style: TOP
                label: Rocker Off TOP
                startSection: true
              - name: Rockerontop
                style: TOP
                label: Rocker On TOP
              - name: Rockerfontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
                value: relfract
              - name: Rockerfontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                enableExpr: me.par.Rockerfontsizemode.eval() in ['points', 'panelunits']
                enable: false
                value: 20
              - name: Rockerfontfraction
                style: Float
                label: Font Fraction
                default: 1
                enableExpr: me.par.Rockerfontsizemode.eval() in ['fract', 'relfract']
              - name: Rockerscaletofit
                style: Menu
                label: Scale Text to Fit
                default: never
                menuNames:
                - never
                - always
                - onlyshrink
                menuLabels:
                - Never
                - Always
                - Only when Too Large
              - name: Rockerfontbold
                style: Toggle
                label: Font Bold
              - name: Rockeritalic
                style: Toggle
                label: Italic
              - name: Rockerdropshadow
                style: Toggle
                label: Drop Shadow
              - name: Rockeroffbgcolor
                style: RGBA
                label: Off Bg Color
                startSection: true
                default: [0.18182, 0.18182, 0.18182, 1]
                values: [0.05, 0.05, 0.05, 1]
              - name: Rockeronbgcolor
                style: RGBA
                label: On Bg Color
                default: [0.81818, 0.81818, 0.81818, 1]
                values: [0.65, 0.65, 0.65, 1]
              - name: Rockeroffbuttoncolor
                style: RGBA
                label: Off Button Color
                default: [0.382, 0.382, 0.382, 1]
                values: [0.2, 0.2, 0.2, 1]
              - name: Rockeronbuttoncolor
                style: RGBA
                label: On Button Color
                default: [0.382, 0.382, 0.382, 1]
                values: [0.45, 0.45, 0.45, 1]
              - name: Rockerofffontcolor
                style: RGBA
                label: Off Font Color
                default: [0.382, 0.382, 0.382, 1]
                values: [0.6, 0.6, 0.6, 1]
              - name: Rockeronfontcolor
                style: RGBA
                label: On Font Color
                default: [0.382, 0.382, 0.382, 1]
                values: [0.2, 0.2, 0.2, 1]
              - name: Rockercustomizeinteraction
                style: Pulse
                label: Customize Interaction
                startSection: true
              - name: Rockerpanelexec
                style: DAT
                label: Panel Exec
                readOnly: true
              - name: Rockerhorizontalmode
                style: Menu
                label: Horizontal Mode
                startSection: true
                default: fixed
                menuNames:
                - fixed
                - fill
                menuLabels:
                - Fixed Width
                - Fill
              - name: Rockerwidth
                style: Int
                label: Width
                default: 88
                min: 1.0
                max: 300.0
                clampMin: true
                normMin: 1.0
                normMax: 300.0
              - name: Rockerhfillweight
                style: Float
                label: Horizontal Fill Weight
                default: 1
                clampMin: true
              - name: Rockerverticalmode
                style: Menu
