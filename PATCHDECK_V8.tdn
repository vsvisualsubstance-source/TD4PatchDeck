              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Labelfontsize
              style: Int
              label: Font Size
              default: 10
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Labelfontsizemode.eval() in ['points', 'panelunits']
            - name: Labelfontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Labelfontsizemode.eval() in ['fract', 'relfract']
              enable: false
            - name: Labelscaletofit
              style: Menu
              label: Scale Text to Fit
              default: never
              menuNames:
              - never
              - always
              - onlyshrink
              menuLabels:
              - Never
              - Always
              - Only when Too Large
            - name: Labelfontbold
              style: Toggle
              label: Font Bold
            - name: Labelitalic
              style: Toggle
              label: Italic
            - name: Labeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Labelalignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: left
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Labelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
            - name: Labeloffset
              style: XYZW
              label: Offset
              size: 2
              startSection: true
              default: [6, 0]
              min: -5.0
              max: 5.0
              normMin: -5.0
              normMax: 5.0
            - name: Labelpadding
              style: Float
              label: Padding
              size: 4
            - name: Labelbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: [0.2, 0.2, 0.2, 1]
              clampMin: true
              clampMax: true
            - name: Labelfontcolor
              style: RGBA
              label: Font Color
              default: [0.65, 0.65, 0.65, 1]
              clampMin: true
              clampMax: true
            - name: Labelhorizontalmode
              style: Menu
              label: Horizontal Mode
              startSection: true
              default: fixed
              menuNames:
              - fixed
              - fill
              menuLabels:
              - Fixed Width
              - Fill
            - name: Labelwidth
              style: Int
              label: Width
              default: 120
