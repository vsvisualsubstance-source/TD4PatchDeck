        - name: B11
          type: widgetCOMP
          parameters:
            x: 3
            y: 3
            w: 100
            h: 50
            hmode: fill
            vmode: fill
            alignorder: 2
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            bgcolorr: =parent(3).par.Backgroundcolorr
            bgcolorg: =parent(3).par.Backgroundcolorg
            bgcolorb: =parent(3).par.Backgroundcolorb
            bgalpha: 1
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            borderover: false
            align: horizlr
            spacing: 1
            marginl: 3
            marginr: 3
            marginb: 3
            margint: 3
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('buttonMomentary') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
              $t: values_17
              Value0: ~me.op('../../control_ui').par.B11
              Valname0: =me.name
