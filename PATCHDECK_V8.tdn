              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: panelexecValue
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: ..
                panelvalue: lselect
                ontooff: true
                defaultreadencoding: cp1252
                language: input
              position: [-400, 0]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: NumericFieldExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass NumericFieldExt(SubWidgetExt):\n\t\"\"\"\n\tNumericFieldExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Numericfield'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == 'Numericfieldtype':\n\t\t\tif val == 'integer':\n\t\t\t\tparent.Widget.par.Numericfielddecimalplaces.enable = False\n\t\t\telse:\n\t\t\t\tparent.Widget.par.Numericfielddecimalplaces.enable = True\n\t\telse:\n\t\t\tSubWidgetExt.onParSettingsChange(self, par, prev)\n\n\tdef makePanelExecute(self):\n\t\tSubWidgetExt.makePanelExecute(self,\n\t\t\t\t\tself.getDockExpressionToOwner() + '.op(\"field\")')\n"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-400, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: parexecSettings
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Numericfield*
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              - -showDocked
              position: [200, 0]
              size: [130, 90]
              dock: text
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
        - name: footer
          type: widgetCOMP
          parameters:
            w: 450
            h: 26
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            leftborder: bordera
            rightborder: bordera
            bottomborder: bordera
            topborder: bordera
            align: horizlr
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('footer') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Footer:
            - name: Footerlabel
              style: Str
              label: Label
              default: Footer
            - name: Footerlabeldisplay
              style: Toggle
              label: Display
              startSection: true
              default: true
            - name: Footerlabelwordwrap
              style: Toggle
              label: Word Wrap
              startSection: true
            - name: Footerlabelfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Footerlabelfontsize
              style: Int
              label: Font Size
              default: 12
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Footerlabelfontsizemode.eval() in ['points', 'panelunits']
            - name: Footerlabelfontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Footerlabelfontsizemode.eval() in ['fract', 'relfract']
              enable: false
            - name: Footerlabelscaletofit
              style: Menu
              label: Scale Text to Fit
              default: never
              menuNames:
              - never
              - always
              - onlyshrink
              menuLabels:
              - Never
              - Always
              - Only when Too Large
            - name: Footerlabelfontbold
              style: Toggle
              label: Font Bold
            - name: Footerlabelitalic
              style: Toggle
              label: Italic
            - name: Footerlabeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Footerlabelalignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: left
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Footerlabelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
            - name: Footerlabeloffset
              style: XYZW
              label: Offset
              size: 2
              startSection: true
              default: [6, 0]
              min: -5.0
              max: 5.0
              normMin: -5.0
              normMax: 5.0
            - name: Footerlabelpadding
              style: Float
              label: Padding
              size: 4
              enable: false
            - name: Footerlabelbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: [0.1, 0.1, 0.1, 1]
              clampMin: true
              clampMax: true
            - name: Footerlabelfontcolor
              style: RGBA
              label: Font Color
              default: [0.6, 0.6, 0.6, 1]
              clampMin: true
              clampMax: true
            - name: Footerrepositionwindow
              style: Toggle
              label: Reposition Window
              startSection: true
            Widget:
            - name: Enablerollover
              style: Toggle
              label: Enable Rollover
              startSection: true
              default: true
            - name: Rollovercolor
              style: RGBA
              label: Rollover Color
              default: [0.9, 0.9, 0.9, 0.15]
              enableExpr: me.par.Enablerollover.eval()
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
              menuNames:
              - over
              - under
              - inside
              - outside
              - add
              - subtract
              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
              enableExpr: me.par.Enablerollover.eval()
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: [0.2, 0.2, 0.2, 0.65]
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              enableExpr: not me.par.Fontfile
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: footer
              enable: false
            OPs:
              $t: ops_5
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -6400]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: footer
            type: containerCOMP
            parameters:
              layer: 2
              hmode: fill
              vmode: fill
              alignorder: =-me.nodeY
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              reposition: =parent.Widget.par.Footerrepositionwindow
              bgcolorr: =parent.Widget.par.Footerlabelbgcolorr
              bgcolorg: =parent.Widget.par.Footerlabelbgcolorg
              bgcolorb: =parent.Widget.par.Footerlabelbgcolorb
              bgalpha: =parent.Widget.par.Footerlabelbgcolora
              top: ./bg
              borderover: false
              enablecloning: false
            custom_pars:
              Footer:
              - name: Footerlabel
                style: Str
                label: Label
                default: Header
                value: Footer
              - name: Footerlabeldisplay
                style: Toggle
                label: Display
                startSection: true
                default: true
              - name: Footerlabelwordwrap
                style: Toggle
                label: Word Wrap
                startSection: true
              - name: Footerlabelfontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
              - name: Footerlabelfontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                enableExpr: me.par.Footerlabelfontsizemode.eval() in ['points', 'panelunits']
                value: 10
              - name: Footerlabelfontfraction
                style: Float
                label: Font Fraction
                default: 1
                enableExpr: me.par.Footerlabelfontsizemode.eval() in ['fract', 'relfract']
                enable: false
              - name: Footerlabelscaletofit
                style: Menu
                label: Scale Text to Fit
                default: never
                menuNames:
                - never
                - always
                - onlyshrink
                menuLabels:
                - Never
                - Always
                - Only when Too Large
              - name: Footerlabelfontbold
                style: Toggle
                label: Font Bold
                value: true
              - name: Footerlabelitalic
                style: Toggle
                label: Italic
              - name: Footerlabeldropshadow
                style: Toggle
                label: Drop Shadow
              - name: Footerlabelalignx
                style: Menu
                label: Align Horizontal
                startSection: true
                default: Left
                menuNames:
                - left
                - center
                - right
                menuLabels:
                - Left
                - Center
                - Right
                value: left
              - name: Footerlabelaligny
                style: Menu
                label: Align Vertical
                default: Center
                menuNames:
                - bottom
                - center
                - top
                menuLabels:
                - Bottom
                - Center
                - Top
                value: center
              - name: Footerlabeloffset
                style: XYZW
                label: Offset
                size: 2
                startSection: true
                min: -5.0
                max: 5.0
                normMin: -5.0
                normMax: 5.0
                values: [6, 0]
              - name: Footerlabelpadding
                style: Float
                label: Padding
                size: 4
                enable: false
              - name: Footerlabelbgcolor
                style: RGBA
                label: Bg Color
                startSection: true
                default: [0.15, 0.15, 0.15, 1]
                clampMin: true
                clampMax: true
                values: [0.1, 0.1, 0.1, 1]
              - name: Footerlabelfontcolor
                style: RGBA
                label: Font Color
                default: [1, 1, 1, 0.6]
                clampMin: true
                clampMax: true
                values: [0.6, 0.6, 0.6, 1]
              - name: Footerrepositionwindow
                style: Toggle
                label: Reposition Window
                startSection: true
            flags:
            - viewer
            position: [200, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: ~parent.Widget.par.Footerlabel
                type: multiline
                wordwrap: =parent.Widget.par.Footerlabelwordwrap
                callbacks: text1_callbacks
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Footerlabelfontbold.eval()
                italic: =parent.Widget.par.Footerlabelitalic
                scaletofit: =parent.Widget.par.Footerlabelfontsizemode
                fontsize: =parent.Widget.par.Footerlabelfontsize.eval() if parent.Widget.par.Footerlabelfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Footerlabelfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Footerlabelfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Footerlabelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Footerlabelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Footerlabelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Footerlabelfontcolora.eval()
                dropshadow: =parent.Widget.par.Footerlabeldropshadow
                textoffsetx: =parent.Widget.par.Footerlabeloffsetx.eval()
                textoffsety: =parent.Widget.par.Footerlabeloffsety.eval()
                textpaddingl: =parent.Widget.par.Footerlabelpadding1
                textpaddingr: =parent.Widget.par.Footerlabelpadding2
                textpaddingb: =parent.Widget.par.Footerlabelpadding3
                textpaddingt: =parent.Widget.par.Footerlabelpadding4
                alignx: =parent.Widget.par.Footerlabelalignx.eval()
                aligny: =parent.Widget.par.Footerlabelaligny.eval()
                hmode: fill
                clickthrough: =parent.Widget.par.clickthrough
                borderover: false
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              - -showDocked
              position: [0, -175]
              size: [160, 130]
              dock: text
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
        - name: header
          type: widgetCOMP
          parameters:
            w: 450
            h: 26
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            leftborder: bordera
            rightborder: bordera
            bottomborder: bordera
            topborder: bordera
            align: horizlr
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('header') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Header:
            - name: Headerlabel
              style: Str
              label: Label
              default: Header
            - name: Headerlabeldisplay
              style: Toggle
              label: Display
              startSection: true
              default: true
            - name: Headerlabelwordwrap
              style: Toggle
              label: Word Wrap
              startSection: true
            - name: Headerlabelfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Headerlabelfontsize
              style: Int
              label: Font Size
              default: 12
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Headerlabelfontsizemode.eval() in ['points', 'panelunits']
            - name: Headerlabelfontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Headerlabelfontsizemode.eval() in ['fract', 'relfract']
              enable: false
            - name: Headerlabelscaletofit
              style: Menu
              label: Scale Text to Fit
              default: never
              menuNames:
              - never
              - always
              - onlyshrink
              menuLabels:
              - Never
              - Always
              - Only when Too Large
            - name: Headerlabelfontbold
              style: Toggle
              label: Font Bold
              default: true
            - name: Headerlabelitalic
              style: Toggle
              label: Italic
            - name: Headerlabeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Headerlabelalignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: left
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Headerlabelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
            - name: Headerlabeloffset
              style: XYZW
              label: Offset
              size: 2
              startSection: true
              default: [6, 0]
              min: -5.0
              max: 5.0
              normMin: -5.0
              normMax: 5.0
            - name: Headerlabelpadding
              style: Float
              label: Padding
              size: 4
              enable: false
            - name: Headerlabelbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: [0.1, 0.1, 0.1, 1]
              clampMin: true
              clampMax: true
            - name: Headerlabelfontcolor
              style: RGBA
              label: Font Color
              default: [0.6, 0.6, 0.6, 1]
              clampMin: true
              clampMax: true
            - name: Headerclickthrough
              style: Toggle
              label: Header Click Through
              startSection: true
            - name: Headerrepositionwindow
              style: Toggle
              label: Reposition Window
              startSection: true
            Widget:
            - name: Enablerollover
              style: Toggle
              label: Enable Rollover
              startSection: true
              default: true
            - name: Rollovercolor
              style: RGBA
              label: Rollover Color
              default: [0.9, 0.9, 0.9, 0.15]
              enableExpr: me.par.Enablerollover.eval()
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
              menuNames:
              - over
              - under
              - inside
              - outside
              - add
              - subtract
              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
              enableExpr: me.par.Enablerollover.eval()
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: [0.2, 0.2, 0.2, 0.65]
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              enableExpr: not me.par.Fontfile
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: header
              enable: false
            OPs:
              $t: ops_6
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -6200]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: header
            type: containerCOMP
            parameters:
              w: 30
              h: 30
              layer: 2
              hmode: fill
              vmode: fill
              alignorder: =-me.nodeY
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.Headerclickthrough
              resizecomp: =me
              reposition: =parent.Widget.par.Headerrepositionwindow
              bgcolorr: =parent.Widget.par.Headerlabelbgcolorr
              bgcolorg: =parent.Widget.par.Headerlabelbgcolorg
              bgcolorb: =parent.Widget.par.Headerlabelbgcolorb
              bgalpha: =parent.Widget.par.Headerlabelbgcolora
              top: ./bg
              borderover: false
              align: horizlr
              enablecloning: false
            custom_pars:
              Header:
                $t: header
                Headerlabelfontsize: 12
                Headerlabelfontbold: true
                Headerlabelalignx: left
                Headerlabelaligny: bottom
                Headerlabeloffset: [6, 0]
                Headerlabelbgcolor: [0.1, 0.1, 0.1, 1]
                Headerlabelfontcolor: [0.6, 0.6, 0.6, 1]
                Headerrepositionwindow: true
            flags:
            - viewer
            position: [200, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: ~parent.Widget.par.Headerlabel
                type: multiline
                wordwrap: =parent.Widget.par.Headerlabelwordwrap
                callbacks: text1_callbacks
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Headerlabelfontbold.eval()
                italic: =parent.Widget.par.Headerlabelitalic
                scaletofit: =parent.Widget.par.Headerlabelscaletofit
                fontsize: =parent.Widget.par.Headerlabelfontsize.eval() if parent.Widget.par.Headerlabelfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Headerlabelfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Headerlabelfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Headerlabelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Headerlabelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Headerlabelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Headerlabelfontcolora.eval()
                dropshadow: =parent.Widget.par.Headerlabeldropshadow
                textoffsetx: =parent.Widget.par.Headerlabeloffsetx.eval()
                textoffsety: =parent.Widget.par.Headerlabeloffsety.eval()
                textpaddingl: =parent.Widget.par.Headerlabelpadding1.eval()
                textpaddingr: =parent.Widget.par.Headerlabelpadding2.eval()
                textpaddingb: =parent.Widget.par.Headerlabelpadding3.eval()
                textpaddingt: =parent.Widget.par.Headerlabelpadding4.eval()
                alignx: =parent.Widget.par.Headerlabelalignx.eval()
                aligny: =parent.Widget.par.Headerlabelaligny.eval()
                hmode: fill
                clickthrough: true
                borderover: false
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              - -showDocked
              position: [0, -150]
              size: [160, 130]
              dock: text
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
