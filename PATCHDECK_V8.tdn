              default: [0.2, 0.2, 0.2, 1]
            - name: Checkoncolor
              style: RGBA
              label: On Color
              default: [0.2, 0.2, 0.2, 1]
            - name: Checkoffcheckcolor
              style: RGBA
              label: Off Check Color
              default: [0.1, 0.1, 0.1, 1]
            - name: Checkoncheckcolor
              style: RGBA
              label: On Check Color
              default: [0.7, 0.7, 0.7, 1]
            - name: Checkoffbordercolor
              style: RGBA
              label: Off Check Border Color
            - name: Checkonbordercolor
              style: RGBA
              label: On Check Border Color
            - name: Checkoffsize
              style: WH
              label: Off Size
              startSection: true
              default: 0.53
              values:
              - =me.par.Checkonsizew
              - =me.par.Checkonsizeh
            - name: Checkonsize
              style: WH
              label: On Size
              default: 0.8
            - name: Checkmarginsize
              style: Int
              label: Checkbox Margin Size
              startSection: true
              default: 2
              clampMin: true
              normMax: 8.0
            - name: Checkfixedaspect
              style: Menu
              label: Check Fixed Aspect
              startSection: true
              default: usevert
              menuNames:
              - 'off'
              - usehorz
              - usevert
              menuLabels:
              - 'Off'
              - Use Horizontal
              - Use Vertical
            - name: Checkoffborderwidth
              style: Int
              label: Check Off Border Width
              startSection: true
              clampMin: true
              normMax: 6.0
            - name: Checkonborderwidth
              style: Int
              label: Check On Border Width
              clampMin: true
              normMax: 6.0
            - name: Checkcornerradius
              style: Float
              label: Check Corner Radius
              startSection: true
            - name: Checkantialias
              style: Toggle
              label: Check Anti-Alias
            - name: Checkcustomizeinteraction
              style: Pulse
              label: Customize Interaction
              startSection: true
            - name: Checkpanelexec
              style: DAT
              label: Panel Exec
              readOnly: true
              enable: false
            - name: Checkhorizontalmode
              style: Menu
              label: Horizontal Mode
              startSection: true
              default: fixed
              menuNames:
              - fixed
