              label: On Value Change Script 0
            - name: Ontooffscript0
              style: Str
              label: On To Off Script 0
            - name: Offtoonscript0
              style: Str
              label: Off To On Script 0
            - name: Valname1
              style: Str
              label: Name 1
              startSection: true
              default: Value1
            - name: Onvaluechangescript1
              style: Str
              label: On Value Change Script 1
            - name: Ontooffscript1
              style: Str
              label: On To Off Script 1
            - name: Offtoonscript1
              style: Str
              label: Off To On Script 1
            - name: Createeditvalueparexec
              style: Pulse
              label: Create/Edit Value Par Exec
              startSection: true
            - name: Valueparexec
              style: DAT
              label: Value Par Exec
              readOnly: true
              enable: false
            Label:
            - name: Widgetlabel
              style: Str
              label: Widget Label
              default: Float2
            - name: Labeltop
              style: TOP
              label: Label TOP
            - name: Labeldisplay
              style: Toggle
              label: Display
              startSection: true
              default: true
            - name: Labelwordwrap
              style: Toggle
              label: Word Wrap
              startSection: true
            - name: Labelfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
