            - {}
          position: [620, 290]
          size: [130, 90]
          inputs:
          - pointgen1
          - transform1
        - name: circle1
          type: circlePOP
          parameters:
            connectivity: surface
            scale: 0.2
          position: [780, 170]
          size: [130, 90]
        - name: sphere1
          type: spherePOP
          parameters:
            radx: 0.05
            rady: 0.05
            radz: 0.05
            freq: 3
          flags:
          - viewer
          position: [520, 890]
          size: [130, 90]
        - name: pointgen1
          type: pointgeneratorPOP
          parameters:
            shape: circle
            numpoints: 17
            sx: 0.2
            sy: 0.2
            sz: 0.2
          flags:
          - viewer
          position: [270, 290]
        - name: line_atten
          type: linePOP
          parameters:
            divs: 1
            bypass: =not parent().par.attenuated
          sequences:
            pt:
            - posz: =-parent().par.attenuationstart
            - posz: =-parent().par.attenuationend
          custom_pars:
            Points:
              $t: points
          position: [0, 230]
          size: [130, 90]
        - name: primitive1
          type: primitivePOP
          parameters:
            method: pattern
          sequences:
            prim:
            - type: lines
              pattern: 0 1 0 2 0 3 0 4
            pt:
            - {}
            - posx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2)) + mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =-op('tube_cone1').par.height
            - posx: =mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =0-op('tube_cone1').par.height
            - posy: =-mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =-op('tube_cone1').par.height
            - posy: =mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =-op('tube_cone1').par.height
          custom_pars:
            Points:
              $t: points
          flags:
          - viewer
          position: [0, 390]
          size: [130, 90]
        - name: rectangle1
          type: rectanglePOP
          parameters:
            sizeu: 0.02
            sizev: 0.5
            anchorv: 0
          position: [0, 730]
        - name: transform1
          type: transformPOP
          parameters:
            tz: 0.8
          flags:
          - viewer
          position: [450, 370]
          size: [130, 90]
          inputs:
          - pointgen1
        - name: tube_cone1
          type: tubePOP
          parameters:
            radx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2))
            rady: 0.01
            height: =mod.math.cos(mod.math.radians(parent().par.coneangle/2))
            rows: 2
            tz: =-me.par.height*0.5
          position: [0, 620]
          size: [130, 90]
        - name: tube_cone2
          type: tubePOP
          parameters:
            radx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2)) + mod.math.sin(mod.math.radians(parent().par.conedelta/2))
            rady: =mod.math.sin(mod.math.radians(parent().par.coneangle/2))
            height: 0
            rows: 2
            tz: =-op('tube_cone1').par.height
          position: [0, 500]
          size: [130, 90]
        - name: connectivity1
          type: connectivityPOP
          position: [780, 290]
          inputs:
          - merge3
        - name: circle_attenEnd
          type: circlePOP
          parameters:
            connectivity: surface
            radx: 0.1
            rady: 0.1
            tz: =-parent().par.attenuationend
            bypass: =not parent().par.attenuated
          size: [130, 90]
        - name: primitive_cross
          type: primitivePOP
          parameters:
            method: set
            setprimtype: lines
          sequences:
            pt:
            - posx: -0.2
            - posx: 0.2
            - posy: -0.2
            - posy: 0.2
            - posz: -0.2
            - posz: 0.2
          custom_pars:
            Points:
              $t: points
          flags:
          - display
          - render
          - viewer
          position: [520, 1000]
          size: [130, 90]
        - name: tube_attenuated
          type: tubePOP
          parameters:
            surftype: rows
            radx: =parent().par.attenuationend
            rady: =parent().par.attenuationstart
            height: 0
            rows: 2
            bypass: =not parent().par.attenuated
          position: [368, 673]
          size: [130, 90]
        - name: merge_pointLight
          type: mergePOP
          sequences:
            input:
            - {}
            - {}
            - {}
            - {}
          position: [760, 820]
          size: [130, 90]
          inputs:
          - sphere1
          - primitive_quadrants
          - copy1
        - name: switch_lightType
          type: switchPOP
          parameters:
            index: =parent().par.lighttype.menuIndex
          flags:
          - display
          - render
          - viewer
          position: [1140, 500]
          size: [130, 90]
          inputs:
          - merge_pointLight
          - merge1
          - merge2
        - name: circle_attenStart
          type: circlePOP
          parameters:
            connectivity: surface
            radx: 0.1
            rady: 0.1
            tz: =-parent().par.attenuationstart
            bypass: =not parent().par.attenuated
          position: [0, 120]
          size: [130, 90]
        - name: primitive_quadrants
          type: primitivePOP
          parameters:
            method: set
            setprimtype: lines
          sequences:
            pt:
            - posx: 0.07
              posy: 0.07
              posz: 0.07
            - posx: -0.07
              posy: -0.07
              posz: -0.07
            - posx: -0.07
              posy: 0.07
              posz: 0.07
            - posx: 0.07
              posy: -0.07
              posz: -0.07
            - posx: 0.07
              posy: 0.07
              posz: -0.07
            - posx: -0.07
              posy: -0.07
              posz: 0.07
            - posx: -0.07
              posy: 0.07
              posz: -0.07
            - posx: 0.07
              posy: -0.07
              posz: 0.07
          custom_pars:
            Points:
              $t: points
          flags:
          - viewer
          position: [520, 780]
          size: [130, 90]
      - name: render1
        type: renderTOP
        parameters:
          bgcolorr: =op.Gaia.op('out_soul')['mood_r'] * 0.07
          bgcolorg: =op.Gaia.op('out_soul')['mood_g'] * 0.07
          bgcolorb: =op.Gaia.op('out_soul')['mood_b'] * 0.09
          bgcolora: 1
        flags:
        - viewer
        position: [0, -300]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
      - name: thumbnail
        type: fitTOP
        flags:
        - lock
        - viewer
        position: [1600, -300]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
        inputs:
        - out
      - name: geo_points
        type: geometryCOMP
        parameters:
          instancetop: ./script_points
          instancecolorop: ./script_points
          material: mat_points
        flags:
        - viewer
        position: [800, 200]
        size: [160, 130]
        children:
        - name: script_points
          type: scriptPOP
          parameters:
            callbacks: script_points_callbacks
          custom_pars:
            Custom:
            - name: Value
              style: Float
          flags:
          - display
          - render
          size: [130, 90]
          color: [0.67, 0.67, 0.67]
        - name: script_points_callbacks
          type: textDAT
          parameters:
            file: PATCHDECK/PATCHES/X38/geo_points/script_points_callbacks.py
            syncfile: true
            language: python
          flags:
          - viewer
          position: [0, -120]
          size: [130, 90]
          color: [0.9, 0.3, 0.4]
          tags:
          - py
          dock: script_points
      - name: mat_points
        type: constantMAT
        position: [800, 0]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
      annotations:
      - name: annotate1
        mode: annotate
        title: Gaia Mocap Field
        text: 'Abstract point-cloud driven by Gaia''s direct mocap bridge (gaia_agent chop_face/chop_pose/chop_hand). Face renders as real 3D contour points (verified x,y,z triplets); pose/hand indices are not reliably decodable per-landmark (mixed zero-padding, non-contiguous -- see patchdeck-known-issues #55), so they drive an abstract energy ring instead of a literal skeleton. Color from out_soul mood.'
        position: [-70, -372]
        size: [1870, 872]
        color: [0.45, 0.45, 0.45]
