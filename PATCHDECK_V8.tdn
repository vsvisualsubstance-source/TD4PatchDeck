      dat_content_format: table
    - name: ndiout1_grouptable1
      type: tableDAT
      parameters:
        rows: 1
        cols: 1
      flags:
      - viewer
      - -showDocked
      position: [2100, -670]
      size: [130, 90]
      dock: ndiout1
      dat_content:
      - - groups
      dat_content_format: table
    - name: master_directndi_exec
      type: parameterexecuteDAT
      parameters:
        fromop: =parent()
        op: POST_FX
        pars: Directndimode
        builtin: false
      flags:
      - viewer
      position: [925, -1225]
      size: [130, 90]
      dat_content: "# Toggles between the Master (POST_FX-mixed) output and Direct NDI mode\n# (cache1/cache2 -> ndiout1/ndiout2). Fully stops POST_FX from cooking\n# (Cooking flag, not just bypass -- POST_FX is a COMP so its 40 internal\n# ops truly stop touching the GPU, not just passthrough), bypasses\n# crossfade and MASTER_DIM (plain TOPs, no Cooking flag available), and\n# disables the combined NDI_OUT feed. preview_A/preview_B keep cooking\n# regardless: cache1/cache2 (and therefore ndiout1/ndiout2) depend on them\n# either way.\n\ndef onValueChange(par, prev):\n\tif par.name != 'Directndimode':\n\t\treturn\n\n\tdirect_mode = bool(par.eval())\n\n\tpost_fx = par.owner\n\tpost_fx.bypass = direct_mode\n\tpost_fx.allowCooking = not direct_mode\n\n\tpatches = post_fx.parent()\n\n\tcrossfade = patches.op('crossfade')\n\tif crossfade is not None:\n\t\tcrossfade.bypass = direct_mode\n\n\tmaster_dim = patches.op('MASTER_DIM')\n\tif master_dim is not None:\n\t\tmaster_dim.bypass = direct_mode\n\n\tndi_out = patches.op('NDI_OUT')\n\tif ndi_out is not None:\n\t\tndi_out.par.active = not direct_mode\n\n\treturn\n"
      dat_content_format: text
    annotations:
    - name: annotate1
      mode: annotate
      title: SHOW PATCHES
      text: 'This is the main Area where you can create Patches. '
      position: [-7975, -1019]
      size: [6569, 1028]
      color: [0.5, 0.5, 0.05]
    - name: annotate10
      mode: annotate
      title: Annotate
      position: [-2245, -1650]
      size: [1144, 1842]
      color: [0.45, 0.45, 0.45]
    - name: annotate11
      mode: annotate
      title: Annotate
      position: [1179, -1917]
      size: [1397, 3127]
      color: [0.45, 0.45, 0.45]
    - name: annotate2
      mode: annotate
      title: EMPTY CLIP
      text: Placeholder Patch to run if nothing is selected
      position: [-786, -566]
      size: [518, 120]
      color: [0.45, 0.45, 0.45]
    - name: annotate3
      mode: annotate
      title: Patch Elements
      text: Tools for use inside the Patches
      position: [-1398, -1570]
      size: [592, 1556]
      color: [0.45, 0.45, 0.45]
    - name: annotate4
      mode: annotate
      title: Switcher, Effects + Output
      position: [-170, -1073]
      size: [3111, 518]
      color: [0.5, 0.2, 0.05]
    - name: annotate5
      mode: annotate
      title: EMPTY PATCH TEMPLATE
      position: [-1081, -470]
      size: [241, 265]
      color: [0.05, 0.2, 0.5]
    - name: annotate6
      mode: annotate
      title: Deck 1
      position: [-3825, -945]
      size: [1037, 200]
      color: [0.5, 0.05, 0.05]
    - name: annotate7
