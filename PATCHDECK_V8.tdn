              - onlyshrink
              menuLabels:
              - Never
              - Always
              - Only when Too Large
            - name: Sliderfontbold
              style: Toggle
              label: Font Bold
            - name: Slideritalic
              style: Toggle
              label: Italic
            - name: Sliderdropshadow
              style: Toggle
              label: Drop Shadow
            - name: Slideralignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: center
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Slideraligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
            - name: Slideroffset
              style: XYZW
              label: Offset
              size: 2
              startSection: true
              min: -5.0
              max: 5.0
              normMin: -5.0
              normMax: 5.0
            - name: Sliderpadding
              style: Float
              label: Padding
              size: 4
            - name: Sliderknobsize
              style: Int
              label: Knob Size
              startSection: true
              default: 1
              min: 1.0
              max: 40.0
              clampMin: true
              normMin: 1.0
              normMax: 40.0
            - name: Sliderbgtop
              style: TOP
              label: Bg TOP
              startSection: true
            - name: Sliderknobtop
              style: TOP
              label: Knob TOP
            - name: Sliderbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: [0.15, 0.15, 0.15, 1]
            - name: Sliderknobcolor
              style: RGBA
              label: Knob Color
              default: [0.6, 0.6, 0.6, 1]
            - name: Sliderlabelfontcolor
              style: RGBA
