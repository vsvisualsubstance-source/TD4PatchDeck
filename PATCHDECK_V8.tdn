        position: [703, -326]
        size: [988, 524]
        color: [0.45, 0.45, 0.45]
      - name: annotate2
        mode: annotate
        title: 'Naming the controls '
        position: [745, 294]
        size: [798, 373]
        color: [0.5, 0.05, 0.35]
      - name: annotate3
        mode: annotate
        title: 'Control Input '
        position: [-51, -573]
        size: [628, 763]
        color: [0.2, 0.5, 0.05]
