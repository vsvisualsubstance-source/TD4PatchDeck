              startSection: true
            - name: Menurollcolor
              style: RGBA
              label: Roll Color
              default: [0.682353, 1, 0.498039, 1]
            - name: Menuselectcolor
              style: RGBA
              label: Select Color
            - name: Menufontoffcolor
              style: RGBA
              label: Font Off Color
              default: [0.1, 0.1, 0.1, 1]
            - name: Menufontoncolor
              style: RGBA
              label: Font On Color
              default: [0.989344, 1, 0.876, 1]
            - name: Menubuttonlabelcolor
              style: RGBA
              label: Button Label Color
            - name: Menubuttonofffacecolor
              style: RGBA
              label: Button Off Color
              default: [0.6, 0.6, 0.6, 1]
            - name: Menubuttononfacecolor
              style: RGBA
              label: Button On Color
              default: [0.382, 0.382, 0.382, 1]
            - name: Menubuttonrollcolor
              style: RGBA
              label: Button Roll Color
              default: [0.18182, 0.18182, 0.18182, 1]
            - name: Menubuttonmargin
              style: Int
              label: Menu Button Margin
              startSection: true
            - name: Menubuttonhorizontalmode
              style: Menu
              label: Horizontal Mode
              startSection: true
              default: fill
              menuNames:
              - fixed
              - fill
              menuLabels:
              - Fixed Width
              - Fill
            - name: Menubuttonwidth
              style: Int
              label: Width
              default: 47
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
            - name: Menubuttonhfillweight
              style: Float
              label: Horizontal Fill Weight
              default: 1
              clampMin: true
            - name: Menubuttonverticalmode
              style: Menu
              label: Vertical Mode
              default: fixed
