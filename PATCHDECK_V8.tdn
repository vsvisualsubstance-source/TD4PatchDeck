            bgcolorr: 0.2
            bgcolorg: 0.2
            bgcolorb: 0.2
            bgalpha: 1
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            leftborder: bordera
            rightborder: bordera
            bottomborder: bordera
            topborder: bordera
