      - name: MIDI_IN
        type: selectCHOP
        parameters:
          chops: ../../CTRL/midi_main
          autoexportroot: =parent()
        flags:
        - viewer
        position: [2078, 5413]
        size: [354, 793]
        color: [0.5, 0.35, 0.05]
      - name: export1
        type: chopexecuteDAT
        parameters:
          fromop: =parent()
          chop: null1
        flags:
        - viewer
        position: [-1275, 5751]
        size: [162, 130]
        dat_content: "ctrl = op(\"previews\")\n\n# null1's channel names don't all match previews' custom-parameter names\n# (case mismatch: MIDI-derived channels are 'KillA'/'KillB', but this\n# project's custom-parameter naming convention forces 'Killa'/'Killb' --\n# see parameters.md). Assigning a channel to a Par that doesn't exist under\n# that exact name raises tdError(\"Can only assign parameter objects...\").\n# Tried fixing it at the source via null1's Rename From/To, but that CHOP\n# parameter was verified NOT to take effect in this TD build (isolated\n# test on a throwaway nullCHOP confirmed no rename happens regardless of\n# settings) -- so the mapping is done here instead, right before lookup.\n_NAME_FIX = {'KillA': 'Killa', 'KillB': 'Killb'}\n\ndef onValueChange(channel, sampleIndex, val, prev):\n\tname = _NAME_FIX.get(channel.name, channel.name)\n\tpar = ctrl.par[name]\n\tif par is None:\n\t\treturn\n\tctrl.par[name] = channel\n\treturn\n\t"
        dat_content_format: text
      - name: select2
        type: selectCHOP
        parameters:
          channames: killA killB resetA resetB
          renameto: KillA KillB Reseta Resetb
          autoexportroot: =parent()
        flags:
        - viewer
        position: [-2060, 5785]
        size: [138, 104]
        inputs:
        - MIDI_IN1
      - name: select3
        type: selectCHOP
        parameters:
          channames: R[1-8] B[1-16] S[1-8] Fx[1-8]
          autoexportroot: =parent()
        position: [2548, 5998]
        size: [82, 56]
        inputs:
        - MIDI_IN
      - name: select4
        type: selectCHOP
        parameters:
          channames: Master
          renameto: Master
          autoexportroot: =parent()
        flags:
        - viewer
        position: [-2050, 5641]
        size: [138, 104]
        inputs:
        - MIDI_IN1
      - name: select5
        type: selectCHOP
        parameters:
          channames: Crossfade
          autoexportroot: =parent()
        position: [2480, 5625]
        size: [66, 45]
        inputs:
        - MIDI_IN
