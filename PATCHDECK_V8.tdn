    size: [130, 90]
    inputs:
    - mousein1
  - name: toolbar
    type: containerCOMP
    parameters:
      y: 368
      w: 996
      h: 40
      layer: 1000
      hmode: fill
      resizecomp: =me
      resizewmin: 400
      resizewmax: 3840
      resizehmin: 40
      resizehmax: 2160
      bgcolorr: =parent.Embody.par.Backgroundcolorr
      bgcolorg: =parent.Embody.par.Backgroundcolorg
      bgcolorb: =parent.Embody.par.Backgroundcolorb
      bgalpha: =parent.Embody.par.Backgroundcolora
      topsmoothness: mipmap
      borderover: false
      justifyv: center
      reloadbuiltin: false
    sequences:
      ext:
      - object: op('./ToolbarExt').module.ToolbarExt(me)
        name: ToolbarExt
        promote: true
    position: [300, 200]
    size: [160, 76]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
    comp_inputs:
    - manager
    children:
    - name: tooltip
      type: containerCOMP
