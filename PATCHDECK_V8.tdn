              default: 0.956863
              clampMin: true
              clampMax: true
            Widget:
            - name: Enablerollover
              style: Toggle
              label: Enable Rollover
              startSection: true
              default: true
            - name: Rollovercolor
              style: RGBA
              label: Rollover Color
              default: 0.9
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
