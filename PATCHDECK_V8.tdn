            Labelscaletofit: always
          Field:
            $t: field_4
          Slider:
            $t: slider_2
            Sliderlabelnames: Min Range
            Sliderfontsize: 15
            Cacheabletop: =op('./slider0/bg')
          Widget:
            $t: widget_9
          OPs:
            $t: ops_13
            Label: /PATCHDECK/UI/DMX_Interface/dmx_minrange/label
