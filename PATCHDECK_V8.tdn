            type: glslTOP
            parameters:
              pixeldat: cut_glsl
              computedat: cut_flux_compute
            sequences:
              vec:
              - name: uCut
                valuex: =parent().par.Cutmodeflux.menuIndex
                valuey: =parent().par.Cutcols
                valuez: =parent().par.Cutrows
                valuew: =parent().par.Cutamount
              - name: uAnim
