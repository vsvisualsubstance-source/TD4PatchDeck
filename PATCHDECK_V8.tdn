                  fontsizex: =op('fontHelper').par.fontsizex
                  positionx: =parent.Widget.par.Menuitemhorizontalpadding1
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menufontcolorr
                  fontcolorg: =parent.Widget.par.Menufontcolorg
                  fontcolorb: =parent.Widget.par.Menufontcolorb
                  fontalpha: =parent.Widget.par.Menufontcolora
                  bgcolorr: =parent.Widget.par.Menubgcolorr
                  bgcolorg: =parent.Widget.par.Menubgcolorg
                  bgcolorb: =parent.Widget.par.Menubgcolorb
                  bgalpha: =parent.Widget.par.Menubgcolora
                  borderar: =op('button').par.fontcolorr
                  borderag: =op('button').par.fontcolorg
                  borderab: =op('button').par.fontcolorb
                  borderaalpha: =op('button').par.bgalpha
                  borderbalpha: 0
                  resolutionh: =op('fontHelper').textHeight + parent.Widget.par.Menuitemverticalpadding * 2
