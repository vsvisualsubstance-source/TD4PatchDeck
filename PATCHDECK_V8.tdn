            Value: =op.Gaia.op('out_soul')['mood_r']
            Min: 1
            Max: 0
            Lag: 2
        flags:
        - viewer
        position: [150, 100]
        size: [160, 130]
        children:
        - name: lag1
          type: lagCHOP
          parameters:
