              label: Panel Exec
              readOnly: true
              enable: false
            Menu Look:
            - name: Menubuttonfontsize
              style: Int
              label: Button Font Size
              default: 9
              clampMin: true
              normMin: 6.0
              normMax: 24.0
            - name: Menufontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: points
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Menufontsize
              style: Int
              label: Font Size
              default: 9
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Menufontsizemode.eval() in ['points', 'panelunits']
            - name: Menufontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Menufontsizemode.eval() in ['fract', 'relfract']
              enable: false
            - name: Menuscaletofit
              style: Menu
              label: Scale Text to Fit
              default: never
              menuNames:
              - never
              - always
