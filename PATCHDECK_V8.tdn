                borderaalpha: 0
                borderbalpha: 0
                borderover: false
              position: [300, 200]
            - name: help
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              position: [200, -200]
              size: [130, 90]
              dat_content: Scroll Tabs Left
