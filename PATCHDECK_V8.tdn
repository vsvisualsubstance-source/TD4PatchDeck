      - source: dmx_audio_chase
        out: 1
    - name: cacheselect1
      type: cacheselectTOP
      parameters:
        cachetop: =parent(2).op('PATCHES/cache1')
      flags:
      - viewer
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
    - name: cacheselect2
      type: cacheselectTOP
      parameters:
        cachetop: =parent(2).op('PATCHES/cache2')
      position: [0, -125]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
    - name: dmx_audio_chase
      type: baseCOMP
      parameters:
        opviewer: 'True'
      custom_pars:
        DMX Reactive:
        - name: Usefileinput
          style: Toggle
          label: Use File Input
        - name: Palette
          style: StrMenu
          default: Rainbow (Daslight)
          menuNames:
          - Rainbow (Daslight)
          - Warm
          - Cool
          - Fire
          - Fire Inverted
          - Ocean
          - Magenta-Cyan
          - Plasma
          - Basic
          - Basic 2
          - Neon Party
          - Sunset
          - Forest
          - Deep Purple
          - Red
          - Blue
          - Yellow
          - Amber
          - Custom
          value: Warm
        - name: Custompalette1
          style: RGBA
          label: Custom Color 1
          size: 3
          default: [1, 0, 0]
        - name: Custompalette2
          style: RGBA
          label: Custom Color 2
          size: 3
          default: [0, 0, 1]
        - name: Custompalette3
          style: RGBA
          label: Custom Color 3
          size: 3
          default: [1, 1, 0]
        - name: Custompalette4
          style: RGBA
          label: Custom Color 4
          size: 3
          default: [0, 1, 0]
        - name: Custompalette5
          style: RGBA
          label: Custom Color 5
          size: 3
          default: [1, 0, 1]
        - name: Kickenable
          style: Toggle
          label: Kick Enable
          default: true
        - name: Globalsmooth
          style: Float
          label: Global Smooth
          default: 1
          min: 0.1
          max: 2.0
          clampMin: true
          clampMax: true
        - name: Mindimmer
          style: Float
          label: Min Dimmer
          default: 30
          max: 255.0
          clampMin: true
          clampMax: true
          value: 200
        - name: Maxdimmer
          style: Float
          label: Max Dimmer
          default: 255
          max: 255.0
          clampMin: true
          clampMax: true
        - name: Dimmerboost
          style: Float
          label: Dimmer Boost
          default: 1
          min: 0.1
          max: 3.0
          clampMin: true
          clampMax: true
          value: 2.97717
        - name: Smoothfactor
          style: Float
          label: Smooth Level
          default: 0.12
          min: 0.01
          clampMin: true
          clampMax: true
        - name: Colorcurve
          style: Float
          label: Color Curve
          default: 0.6
          min: 0.1
          max: 2.0
          clampMin: true
          clampMax: true
        - name: Colorsmooth
          style: Float
          label: Color Fade
          default: 0.25
          min: 0.01
          clampMin: true
          clampMax: true
        - name: Colorspeed
          style: Float
          label: Color Speed
          default: 0.2
          min: 0.01
          clampMin: true
          clampMax: true
        - name: Colorphase
          style: Float
          label: Color Phase
          clampMin: true
          clampMax: true
        - name: Videomix
          style: Float
          label: Video Mix
          startSection: true
          clampMin: true
          clampMax: true
          help: Blends fixture colors between the audio-reactive palette (0.0) and live colors sampled per-fixture from the Master video output (1.0). Linear crossfade.
          value: 0.0944882
        - name: Barphase
          style: Float
          label: Bar Phase
          clampMin: true
          clampMax: true
        - name: Agcrelease
          style: Float
          label: AGC Release
          default: 0.0008
          min: 0.0001
          max: 0.01
          clampMin: true
          clampMax: true
        - name: Minrange
          style: Float
          label: Min Range
          default: 0.02
          min: 0.001
          max: 0.3
          clampMin: true
          clampMax: true
        - name: Kickthresh
          style: Float
          label: Kick Threshold
          default: 0.35
          min: 0.05
          clampMin: true
          clampMax: true
        - name: Kickboost
          style: Float
          label: Kick Boost
          default: 100
          max: 255.0
          clampMin: true
          clampMax: true
        - name: Kickdecay
          style: Float
          label: Kick Decay
          default: 0.75
          min: 0.1
          max: 0.98
          clampMin: true
          clampMax: true
        - name: Kickcooldown
          style: Float
          label: Kick Cooldown
          default: 0.22
          min: 0.05
          clampMin: true
          clampMax: true
        - name: Kicksmooth
          style: Float
          label: Kick Smooth
          default: 0.3
          min: 0.05
          clampMin: true
          clampMax: true
        Fixture:
        - name: Fixtureprofile
          style: StrMenu
          label: Fixture Profile
          default: ZQ006018 4CH RGBW
          menuNames:
          - ZQ006018 4CH RGBW
          - ZQ006018 8CH
          - RGB 3CH
          - D+RGB 4CH
          - D+RGBW 5CH
          - RGBWA+UV 6CH
          - D+RGBW+S+M 7CH
          value: D+RGB 4CH
        - name: Nbars
          style: Int
          label: Numero Fixture
          default: 6
          min: 1.0
          clampMin: true
          normMin: 1.0
          normMax: 64.0
        - name: Startaddress
          style: Int
          label: Start Address
          default: 1
          min: 1.0
          clampMin: true
          normMin: 1.0
          normMax: 512.0
        - name: Dimmergamma
          style: Float
          label: Dimmer Gamma
          default: 2.2
          normMin: 1.0
          normMax: 3.0
        - name: Applyfixture
          style: Pulse
          label: Apply / Refresh Profiles
      position: [325, -675]
