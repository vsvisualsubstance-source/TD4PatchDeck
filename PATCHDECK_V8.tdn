            - name: popMenu
              type: containerCOMP
              parameters:
                x: 128
                y: 44
                w: '=parent().width if parent.Widget.par.Menuautowidth else parent.Widget.par.Menupopupwidth.eval() '
                h: =me.OptimalHeight
                layer: 100
                alignallow: ignore
                display: false
                resizecomp: =me
                bgcolorr: 0.2
                bgcolorg: 0.2
                bgcolorb: 0.2
                borderar: 0.2
                borderag: 0.2
                borderab: 0.2
                leftborder: bordera
                rightborder: bordera
                bottomborder: bordera
                topborder: bordera
