            dat_content_format: table
          - name: sl2_glsl_pixel
            type: textDAT
            parameters:
              language: glsl
              extension: frag
            flags:
            - viewer
            position: [0, -120]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dock: sl2_glsl
            dat_content: "\n// Example Pixel Shader\n\n// uniform float exampleUniform;\n\nout vec4 fragColor;\nvoid main()\n{\n\t// vec4 color = texture(sTD2DInputs[0], vUV.st);\n\tvec4 color = vec4(1.0);\n\tfragColor = TDOutputSwizzle(color);\n}\n"
            dat_content_format: text
          - name: fg_size_x_as_sx
            type: renameCHOP
            parameters:
              renameto: sx
            position: [-750, -340]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_size_x
          - name: ps_glsl_compute
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            - -showDocked
            position: [320, -120]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dock: ps_glsl
            dat_content: "// Example Compute Shader\n\n// uniform float exampleUniform;\n\nlayout (local_size_x = 8, local_size_y = 4) in;\nvoid main()\n{\n\t// This code is running 1:1 per pixel, so early-exit\n\t// if this thread overhangs the edge of the output\n\tif (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), ivec2(uTDOutputInfo.res.zw))))\n\t\treturn;\n\n\tvec4 color;\n\t//color = texelFetch(sTD2DInputs[0], ivec2(gl_GlobalInvocationID.xy), 0);\n\tcolor = vec4(1.0);\n\t// We need to use TDImageStoreOutput() so that 8-bit textures that are sRGB\n\t// encoded can be written to correctly from incoming linear values.\n\t// imageStore() does not do this automatically, while pixel shader outputs do.\n\tTDImageStoreOutput(0, gl_GlobalInvocationID, color);\n}\n"
            dat_content_format: text
          - name: px_glsl_compute
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            - -showDocked
            position: [320, -120]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dock: px_glsl
            dat_content: "// Example Compute Shader\n\n// uniform float exampleUniform;\n\nlayout (local_size_x = 8, local_size_y = 4) in;\nvoid main()\n{\n\t// This code is running 1:1 per pixel, so early-exit\n\t// if this thread overhangs the edge of the output\n\tif (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), ivec2(uTDOutputInfo.res.zw))))\n\t\treturn;\n\n\tvec4 color;\n\t//color = texelFetch(sTD2DInputs[0], ivec2(gl_GlobalInvocationID.xy), 0);\n\tcolor = vec4(1.0);\n\t// We need to use TDImageStoreOutput() so that 8-bit textures that are sRGB\n\t// encoded can be written to correctly from incoming linear values.\n\t// imageStore() does not do this automatically, while pixel shader outputs do.\n\tTDImageStoreOutput(0, gl_GlobalInvocationID, color);\n}\n"
            dat_content_format: text
          - name: sl_glsl_compute
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            - -showDocked
            position: [320, -120]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dock: sl_glsl
            dat_content: "// Example Compute Shader\n\n// uniform float exampleUniform;\n\nlayout (local_size_x = 8, local_size_y = 4) in;\nvoid main()\n{\n\t// This code is running 1:1 per pixel, so early-exit\n\t// if this thread overhangs the edge of the output\n\tif (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), ivec2(uTDOutputInfo.res.zw))))\n\t\treturn;\n\n\tvec4 color;\n\t//color = texelFetch(sTD2DInputs[0], ivec2(gl_GlobalInvocationID.xy), 0);\n\tcolor = vec4(1.0);\n\t// We need to use TDImageStoreOutput() so that 8-bit textures that are sRGB\n\t// encoded can be written to correctly from incoming linear values.\n\t// imageStore() does not do this automatically, while pixel shader outputs do.\n\tTDImageStoreOutput(0, gl_GlobalInvocationID, color);\n}\n"
            dat_content_format: text
          - name: sl2_glsl_compute
