              label: Font Bold
            - name: Footerlabelitalic
              style: Toggle
              label: Italic
            - name: Footerlabeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Footerlabelalignx
              style: Menu
              label: Align Horizontal
