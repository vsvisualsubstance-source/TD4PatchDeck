                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [0, 200]
              size: [160, 130]
            - name: RockerExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 500]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\nSubWidgetExt = mod.SubWidgetExt.SubWidgetExt\n\nclass RockerExt(SubWidgetExt):\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Rocker'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\tself.onToggleEvent(event, panelValue)\n"
              dat_content_format: text
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-500, 500]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: panelexecValue
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: ..
                panelvalue: lselect
                ontooff: true
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 100]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-300, 200]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: parexecSettings
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Rockercustomizeinteraction Rockerhorizontalmode Rockerverticalmode
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 300]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              position: [0, -150]
              size: [160, 130]
              dock: text
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
          - name: valueOut
            type: outCHOP
            parameters:
              label: =me.name
              autoexportroot: =parent()
            position: [400, 0]
            inputs:
            - output
        - name: buttonScript
          type: widgetCOMP
          parameters:
            w: 450
            h: 26
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            bgcolorr: 0.2
            bgcolorg: 0.2
            bgcolorb: 0.2
            bgalpha: 1
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            borderover: false
            align: horizlr
            spacing: 1
            marginl: 3
            marginr: 3
            marginb: 3
            margint: 3
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('buttonScript') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
              $t: values_18
            Label:
              $t: label_7
              Widgetlabel: Script Button
            Button:
              $t: button_3
              Buttonofflabel: Run
              Buttononlabel: Run
              Buttonfontsize: 10
              Buttonalignxmode: metrics
              Buttonalignymode: metrics
            Widget:
              $t: widget
            OPs:
            - name: Button0
              style: COMP
              label: button0
              default: ./button0
              value: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/buttonScript/button0
            - name: Label
              style: COMP
              label: label
              default: ./label
              value: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/buttonScript/label
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -7200]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: label
            type: containerCOMP
            parameters:
              w: =parent().par.Labelwidth
              h: =parent().par.Labelheight
              layer: 1
              hmode: =parent.Widget.par.Labelhorizontalmode
              hfillweight: =parent.Widget.par.Labelhfillweight
              vmode: =parent.Widget.par.Labelverticalmode
              vfillweight: =parent.Widget.par.Labelvfillweight
              display: =parent.Widget.par.Labeldisplay
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              uvbuttonsleft: false
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Labelbgcolorr
              bgcolorg: =parent.Widget.par.Labelbgcolorg
              bgcolorb: =parent.Widget.par.Labelbgcolorb
              bgalpha: =parent.Widget.par.Labelbgcolora
              borderover: false
              enablecloning: false
            custom_pars:
              Label:
                $t: label_6
                Widgetlabel: Momentary Button
                Labelfontsize: 9
                Labelalignx: left
                Labelaligny: center
                Labeloffset: [6, 0]
                Labelbgcolor: [0.2, 0.2, 0.2, 1]
                Labelfontcolor: [0.65, 0.65, 0.65, 1]
                Labelwidth: 120
                Labelverticalmode: fill
                Labelheight: 32
            flags:
            - viewer
            position: [200, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: =parent.Widget.par.Widgetlabel.eval()
                type: multiline
                wordwrap: =parent.Widget.par.Labelwordwrap.eval()
                callbacks: text1_callbacks
                legacyfontselection: true
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Labelfontbold.eval()
                italic: =parent.Widget.par.Labelitalic
                scaletofit: =parent.Widget.par.Labelfontsizemode
                fontsize: =parent.Widget.par.Labelfontsize.eval() if parent.Widget.par.Labelfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Labelfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Labelfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Labelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Labelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Labelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Labelfontcolora.eval()
                dropshadow: =parent.Widget.par.Labeldropshadow
                textoffsetx: =parent.Widget.par.Labeloffsetx.eval()
                textoffsety: =parent.Widget.par.Labeloffsety.eval()
                textpaddingl: =parent.Widget.par.Labelpadding1.eval()
                textpaddingr: =parent.Widget.par.Labelpadding2.eval()
                textpaddingb: =parent.Widget.par.Labelpadding3.eval()
                textpaddingt: =parent.Widget.par.Labelpadding4.eval()
                alignx: =parent.Widget.par.Labelalignx.eval()
                aligny: =parent.Widget.par.Labelaligny.eval()
                hmode: fill
                vmode: fill
                bottomanchor: 0.039
                helpdat: =parent.Widget.op('code/help')
                clickthrough: =parent.Widget.par.clickthrough
                top: =parent.Widget.par.Labeltop.eval()
                borderover: false
              flags:
              - viewer
              position: [0, -200]
              size: [160, 130]
            - name: parexecRunCommand
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: =parent.Widget
                pars: Labelhorizontalmode Labelverticalmode
                onpulse: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n#\n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef valueChange(par, val, prev):\n\tif par.name == 'Labelhorizontalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Labelhfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Labelwidth, 'enable', bool(1-val))\n\telif par.name == 'Labelverticalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Labelvfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Labelheight, 'enable', bool(1-val))\n\treturn\n\ndef onPulse(par):\n\treturn\n\ndef expressionChange(par, val, prev):\n\treturn\n\ndef exportChange(par, val, prev):\n\treturn\n\ndef enableChange(par, val, prev):\n\treturn\n\ndef modeChange(par, val, prev):\n\treturn\n"
              dat_content_format: text
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_11
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: button0
            type: containerCOMP
            parameters:
              w: =parent.Widget.par.Buttonwidth
              h: =parent.Widget.par.Buttonheight
              hmode: =parent.Widget.par.Buttonhorizontalmode
              hfillweight: =parent.Widget.par.Buttonhfillweight
              vmode: =parent.Widget.par.Buttonverticalmode
              vfillweight: =parent.Widget.par.Buttonvfillweight
              alignorder: 1
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Buttonbasecolorr
              bgcolorg: =parent.Widget.par.Buttonbasecolorg
              bgcolorb: =parent.Widget.par.Buttonbasecolorb
              bgalpha: =parent.Widget.par.Buttonbasecolora
              borderar: 0
              borderag: 0
              borderab: 0
              borderaalpha: 0
              borderbalpha: 0
              borderover: false
              dodisablecolor: true
              disablecolorr: =parent.Widget.par.Disablecolorr
              disablecolorg: =parent.Widget.par.Disablecolorg
              disablecolorb: =parent.Widget.par.Disablecolorb
              disablealpha: =parent.Widget.par.Disablecolora
              align: horizlr
              justifyh: left
              justifyv: center
              crop: 'on'
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./ButtonExt').module.ButtonExt(me)
                promote: true
              - {}
              - {}
              - {}
              iop:
              - {}
              - {}
            custom_pars:
              Button:
                $t: button_4
                Buttontype: Momentary
                Buttonfontsize: 9
                Buttonfontbold: true
                Buttonalignx: center
                Buttonaligny: center
                Buttonofffacecolor: [0.28, 0.28, 0.28, 1]
                Buttononfacecolor: [0.3276, 0.4719, 0.52, 1]
                Buttonborder: false
                Buttonbordercolor: [1, 1, 1, 1]
                Buttonstateexpression: parent.Widget.GetValueNorm()
                Buttonverticalmode: fill
            flags:
            - viewer
            position: [400, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: =parent.Widget.par.Buttononlabel if getattr(parent.Widget.par, 'Value'+str(parent().digits)) else parent.Widget.par.Buttonofflabel
                callbacks: text1_callbacks
                legacyfontselection: true
                font: =parent.Widget.par.Buttonfont.eval()
                fontfile: =parent.Widget.par.Buttonfontfile
                bold: =parent.Widget.par.Buttonfontbold.eval()
                italic: =parent.Widget.par.Buttonitalic
                scaletofit: =parent.Widget.par.Buttonscaletofit
                fontsize: =parent.Widget.par.Buttonfontsize.eval() if parent.Widget.par.Buttonfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Buttonfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Buttonfontsizemode.eval()
                fontcolorr: =me.par.Fontcolor.eval()[0]
                fontcolorg: =me.par.Fontcolor.eval()[1]
                fontcolorb: =me.par.Fontcolor.eval()[2]
                fontalpha: =me.par.Fontcolor.eval()[3]
                dropshadow: =parent.Widget.par.Buttondropshadow
                textoffsetx: =parent.Widget.par.Buttonoffsetx.eval()
                textoffsety: =parent.Widget.par.Buttonoffsety.eval()
                alignx: =parent.Widget.par.Buttonalignx.eval()
                alignxmode: =parent.Widget.par.Buttonalignxmode.eval()
                aligny: =parent.Widget.par.Buttonaligny.eval()
                alignymode: =parent.Widget.par.Buttonalignymode.eval()
                hmode: fill
                vmode: fill
                clickthrough: true
                bgcolorr: =me.par.Facecolor.eval()[0]
                bgcolorg: =me.par.Facecolor.eval()[1]
                bgcolorb: =me.par.Facecolor.eval()[2]
                bgalpha: =me.par.Facecolor.eval()[3]
                top: '=me.par.Mapon.eval() if me.par.Value else me.par.Mapoff.eval() '
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                borderover: false
              custom_pars:
                Expressions:
                  $t: expressions_3
                  Value: '=parent.Value.panel.select if parent.Widget.par.Buttontype.eval() == "Commands Only Ignore Value" else getattr(parent.Widget.par, ''Value''+str(parent().digits)) '
                  Mapoff: =parent.Widget.par.Buttonofftop.eval()
                  Mapon: =parent.Widget.par.Buttonontop.eval()
                  Fontcolor: =parent.Widget.parGroup.Buttononfontcolor if me.par.Value else parent.Widget.parGroup.Buttonofffontcolor
                  Facecolor: =parent.Widget.parGroup.Buttononfacecolor if me.par.Value else parent.Widget.parGroup.Buttonofffacecolor
              flags:
              - viewer
              size: [160, 130]
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [0, 300]
              size: [160, 130]
            - name: ButtonExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 400]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass ButtonExt(SubWidgetExt):\n\t\"\"\"\n\tButtonExt provides all functionality for basic widget button\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Button'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\t\tself.valueIndex = self.ownerComp.digits\n\n\t\tself.types = [\n\t\t\t\t('Momentary', {'offToOn': lambda p: self.SetValue(1),\n\t\t\t\t\t\t\t   'onToOff': lambda p: self.SetValue(0)}),\n\t\t\t\t('Momentary Up', {'offToOn': lambda p: self.SetValue(0),\n\t\t\t\t\t\t\t\t  'onToOff': lambda p: self.SetValue(1)}),\n\t\t\t\t('Toggle Down', {'offToOn': lambda p: self.Toggle()}),\n\t\t\t\t('Toggle Up',\n\t\t\t\t \t\t{'onToOff': lambda p: self.Toggle(checkInside=True)}),\n\t\t\t\t('Toggle Up Anywhere', {'onToOff':lambda p: self.Toggle()}),\n\t\t\t\t('Radio Down', {'offToOn': lambda p: self.Radio()}),\n\t\t\t\t('Radio Up',\n\t\t\t\t \t\t{'onToOff': lambda p: self.Radio(checkInside=True)}),\n\t\t\t\t('Radio Up Anywhere', {'onToOff':lambda p: self.Radio()}),\n\t\t\t\t('Exclusive Down', {'offToOn': lambda p: self.Radio()}),\n\t\t\t\t('Exclusive Up',\n\t\t\t\t \t\t{'onToOff': lambda p: self.Radio(checkInside=True)}),\n\t\t\t\t('Exclusive Up Anywhere', {'onToOff':lambda p: self.Radio()}),\n\t\t\t\t('Commands Only', {'offToOn': lambda p: self.RunOnCommand(),\n\t\t\t\t\t\t\t   \t   'onToOff': lambda p: self.RunOffCommand()}),\n\t\t\t\t('Commands Only Ignore Value', {\n\t\t\t\t\t\t\t\t   'offToOn': lambda p: self.RunOnCommand(),\n\t\t\t\t\t\t\t   \t   'onToOff': lambda p: self.RunOffCommand()})\n\t\t]\n\t\tself.buttonTypePar = parent.Widget.par.Buttontype\n\t\tself.ownerComp.par.Buttontype.menuLabels = [type[0] for type in self.types]\n\t\tself.ownerComp.par.Buttontype.menuNames = self.ownerComp.par.Buttontype.menuLabels\n\n\tdef SetValue(self, value):\n\t\t\"\"\"\n\t\tSets the value of the widget\n\t\t\"\"\"\n\t\tsetattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t\t\t\t\t\t'Value'+str(self.valueIndex), value)\n\n\tdef GetValue(self):\n\t\t\"\"\"\n\t\tSets the value of the widget\n\t\t\"\"\"\n\t\t#debug('value change')\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t\t\t\t\t\t'Value'+str(self.valueIndex))\n\n\tdef Radio(self, checkInside=False):\n\t\tif self.Toggle(checkInside):\n\t\t\tself.updateRadioGroup()\n\n\tdef Toggle(self, checkInside=False):\n\t\t\"\"\"\n\t\tSets the value of the button to on when off, and off when on\n\n\t\t:param checkInside: if True, only toggle if the mouse is currently\n\t\t\tinside the ownerComp panel.\n\t\t:return: False if skipped from not inside, otherwise True\n\t\t\"\"\"\n\t\tif checkInside and not self.ownerComp.panel.inside:\n\t\t\treturn False\n\t\tself.SetValue(1-self.GetValue())\n\t\treturn True\n\n\tdef RunOnCommand(self):\n\t\t\"\"\"\n\t\tRuns the python command for when the button turns on\n\t\t\"\"\"\n\t\t#debug('command on')\n\t\tcommand = parent.Widget.par.Offtoonscript0.eval()\n\t\tif command:\n\t\t\trun(command, fromOP=parent.Widget)\n\t\tcommand = parent.Widget.par.Onvaluechangescript0.eval()\n\t\tif command:\n\t\t\trun(command, fromOP=parent.Widget)\n\n\tdef RunOffCommand(self):\n\t\t\"\"\"\n\t\tRuns the python command for when the button turns off\n\t\t\"\"\"\n\t\t#debug('command off')\n\t\tcommand = parent.Widget.par.Ontooffscript0.eval()\n\t\tif command:\n\t\t\trun(command, fromOP=parent.Widget)\n\t\tcommand = parent.Widget.par.Onvaluechangescript0.eval()\n\t\tif command:\n\t\t\trun(command, fromOP=parent.Widget)\n\t@property\n\tdef GroupButtons(self):\n\t\ttable = parent.Widget.par.Buttongroupdat.eval()\n\t\tif not isinstance(table, DAT):\n\t\t\treturn []\n\t\ttableParent = table.parent()\n\t\treturn [tableParent.op(c.val)\n\t\t\t\t\t\t\tfor c in table.col(0) if tableParent.op(c.val)]\n\n\tdef onPanelEvent(self, event, panelValue=None):\n\t\t\"\"\"\n\t\tSelects correct funtion based on button widget type\n\t\t\"\"\"\n\t\t#debug('panelEvent', event)\n\t\ttypeIndex = self.buttonTypePar.menuIndex\n\t\tbtype
                = self.types[typeIndex][1].get(event)\n\t\t#debug(self.types[typeIndex][0])\n\t\tif btype:\n\t\t\t#debug('onPanel', event)\n\t\t\tbtype(panelValue)\n\n\tdef onParValueChange(self, par, prev):\n\t\t\"\"\"\n\t\tThe Button's value has changed.\n\t\tOnly runs when necessary (see parexecValue 'Active' parameter).\n\t\t\"\"\"\n\t\ttype = self.buttonTypePar.eval()\n\t\tif type == 'Commands_Only_Ignore_Value':\n\t\t\treturn\n\t\tif type.startswith('Radio') or type.startswith('Exclusive'):\n\t\t\tself.updateRadioGroup()\n\t\t# if par.eval():\n\t\t# \tself.RunOnCommand()\n\t\t# else:\n\t\t# \tself.RunOffCommand()\n\n\tdef updateRadioGroup(self):\n\t\t\"\"\"Turn off other radio buttons\n\n\t\t:return: False if change reverted because trying to turn off Radio,\n\t\t\totherwise True\n\t\t\"\"\"\n\t\t#debug('radiogroup')\n\t\ttype = self.buttonTypePar.eval()\n\t\tgroupButtons = self.GroupButtons\n\t\tif type.startswith('Radio') and parent.Widget.par.Value0 == 0 and \\\n\t\t\t\tnot any([button.par.Value0 for button in groupButtons]):\n\t\t\tself.SetValue(1)\n\t\t\treturn False\n\t\tif parent.Widget.par.Value0:\n\t\t\tfor button in groupButtons:\n\t\t\t\tif button != parent.Widget:\n\t\t\t\t\tbutton.par.Value0 = False\n\t\treturn True\n\n\tdef onParSettingsChange(self, par, prev):\n\t\tif par.name == self.buttonTypePar.name:\n\t\t\tif par.eval().startswith('Momentary'):\n\t\t\t\tself.onPanelEvent('onToOff')\n\t\t\telif par.eval().startswith('Radio') \\\n\t\t\t\t\t\t\t\t\tor par.eval().startswith('Exclusive'):\n\t\t\t\tself.updateRadioGroup()\n\t\t\tparent.Widget.par.Buttongroupdat.enable = \\\n\t\t\t\t\t\t\t\t\t\tpar.eval().startswith('Radio') \\\n\t\t\t\t\t\t\t\t\t\tor par.eval().startswith('Exclusive')\n\t\telse:\n\t\t\tSubWidgetExt.onParSettingsChange(self, par, prev)\n"
              dat_content_format: text
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-600, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: parexecValue
              type: parameterexecuteDAT
              parameters:
                active: =(not parent.Widget.par.Buttontype.eval().startswith('Command')) or parent.Widget.par.Buttontype.eval().startswith('Radio') or parent.Widget.par.Buttontype.eval().startswith('Exclusive')
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: ='Value' + str(parent().digits)
                onpulse: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, -100]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Custom command execution for value changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParValueChange(par, prev)\n\n"
              dat_content_format: text
            - name: panelexecValue
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: ..
                panelvalue: lselect
                ontooff: true
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 0]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-400, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: parexecSettings
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Buttoncustomizeinteraction Buttonborder Buttonhorizontalmode Buttonverticalmode
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 200]
              size: [130, 90]
              color: [0.2, 0.5, 0.05]
              comment: Execution for parameter changes - This should be removed along with the subclass functionality
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              position: [0, -150]
              size: [160, 130]
              dock: text
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
          - name: overlay
