          type: baseCOMP
          custom_pars:
            Custom:
            - name: Period
              style: Float
              label: period
              value: 1.9
            - name: Transform
              style: XYZW
              label: transform
              size: 3
              values: [19.3, 17, 6.9]
            - name: Rotatedegrees
              style: XYZW
              label: rotate(degrees)
              size: 3
              values:
              - 162
              - 70
              - =absTime.seconds*20
            - name: Bottomthreshold
              style: Float
