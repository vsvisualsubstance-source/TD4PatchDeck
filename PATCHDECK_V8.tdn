                Menurollcolor: [0.3185, 0.3185, 0.3185, 1]
                Menuselectcolor: [0.4419, 0.4419, 0.4419, 1]
                Menufontoffcolor: [0.8, 0.8, 0.8, 1]
                Menufontoncolor: [0.65, 0.65, 0.65, 1]
                Menubuttonofffacecolor: [0.3, 0.3, 0.3, 1]
                Menubuttononfacecolor: [0.3276, 0.4719, 0.52, 1]
                Menubuttonrollcolor: [0.7, 0.7, 0.7, 0.35]
            flags:
            - viewer
            position: [0, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
