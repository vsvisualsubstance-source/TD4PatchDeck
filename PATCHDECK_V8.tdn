                bgcolorg: =parent.Widget.par.Slider2dknobcolorg
                bgcolorb: =parent.Widget.par.Slider2dknobcolorb
                bgalpha: =parent.Widget.par.Slider2dknobcolora
                top: knobBg
                borderar: =parent.Widget.par.Slider2dknobbordercolorr
                borderag: =parent.Widget.par.Slider2dknobbordercolorg
                borderab: =parent.Widget.par.Slider2dknobbordercolorb
                borderaalpha: =parent.Widget.par.Slider2dknobbordercolora
                borderbalpha: 0
                leftborder: bordera
                rightborder: bordera
                bottomborder: bordera
                topborder: bordera
                borderover: false
