                comment: this is required do not delete
                dat_content:
                - - column
                  - Symbol
                - - columnLabel
                  - ''
                - - sourceData
                  - ''
                - - sourceDataMode
                  - constant
                - - cellLook
                  - button
                - - topPath
                  - ''
                - - help
