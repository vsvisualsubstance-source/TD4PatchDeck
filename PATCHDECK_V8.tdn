                menuNames:
                - 16_bit_float
                - 32_bit_float
                menuLabels:
                - 16 bit float
                - 32 bit float
                value: 32_bit_float
              - name: Passes
                style: Int
                label: passes
                normMin: 1.0
                normMax: 3.0
                value: 2
              - name: Timestep
                style: Float
                label: time step
                value: =1/me.time.rate
