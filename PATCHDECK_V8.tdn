                values: [0.3, 0.3, 0.3, 1]
              - name: Menubuttondisablecolor
                style: RGBA
                label: Button Disable Color
                default: [0, 0, 0, 0.5]
                values: [0.7, 0.7, 0.7, 1]
              - name: Menufontsize
                style: Int
                label: Menu Font Size
                startSection: true
                default: 8
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                value: 10
              - name: Menufontbold
                style: Toggle
                label: Menu Font Bold
              - name: Menuitemverticalpadding
                style: Int
                label: Item Vertical Padding
                default: 4
                max: 100.0
                clampMin: true
                normMax: 30.0
                value: 6
              - name: Menuitemhorizontalpadding1
                style: Int
                label: Item Horizontal Padding
                default: 4
                clampMin: true
                normMax: 20.0
                value: 10
              - name: Menubgcolor
                style: RGBA
                label: Menu Background Color
                startSection: true
                default: [0.3, 0.3, 0.3, 1]
                values: [0.7, 0.7, 0.7, 1]
              - name: Menurollbgcolor
                style: RGBA
                label: Menu Roll Bg Color
                default: [1, 1, 1, 0.1]
                values: [0.8, 0.8, 0.8, 1]
              - name: Menuselectbgcolor
                style: RGBA
                label: Menu Select Bg Color
                default: [0.5, 0.5, 0.5, 1]
                values: [0.6, 0.6, 0.6, 1]
              - name: Menudisablebgcolor
                style: RGBA
                label: Menu Disable Bg Color
