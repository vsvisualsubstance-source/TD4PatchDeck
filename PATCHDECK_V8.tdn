          justifyh: left
          justifyv: top
          clone: =op.TDBasicWidgets.op('sliderVert') if hasattr(op, 'TDBasicWidgets') else ''
        sequences:
          ext:
          - promote: true
        custom_pars:
          Values:
            $t: values_7
            Value0: ~op('control_ui').par.S8
            Valname0: =me.name
          Label:
            $t: label_9
            Labeldisplay: false
            Labelfontsize: 40
          Field:
            $t: field_5
