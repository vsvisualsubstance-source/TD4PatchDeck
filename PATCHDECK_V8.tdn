                default: 120
                min: 8.0
                max: 900.0
                clampMin: true
              - name: Graphheight
                style: Int
                label: Altezza grafico
                default: 38
                min: 8.0
                max: 300.0
                value: 50
              - name: Graphwidth
                style: Int
                label: Larghezza grafico
                default: 260
                min: 40.0
                max: 1200.0
              - name: Graphcolor
                style: RGBA
                label: Colore grafico
                size: 3
                default: [0.2, 0.95, 0.75]
              Griglia:
              - name: Showgrid
                style: Toggle
                label: Griglia numerica
                default: true
              - name: Gridpos
                style: Menu
                label: Posizione
                default: bottomleft
                menuNames:
                - topleft
                - topright
                - bottomleft
                - bottomright
                menuLabels:
                - Alto sx
                - Alto dx
                - Basso sx
                - Basso dx
              - name: Gridsort
                style: Menu
                label: Ordinamento
                default: id
                menuNames:
