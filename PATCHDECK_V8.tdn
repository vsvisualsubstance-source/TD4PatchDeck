                style: OP
                label: Operator Viewer
              - name: Activeviewer
                style: Toggle
                label: Active Viewer
                startSection: true
              - name: Sizewidgettoviewer
                style: Pulse
                label: Size Widget To Viewer
                startSection: true
              - name: Viewhorizontalmode
                style: Menu
                label: Horizontal Mode
                startSection: true
                default: fixed
                menuNames:
                - fixed
                - fill
                menuLabels:
                - Fixed Width
                - Fill
                value: fill
              - name: Viewwidth
                style: Int
                label: Width
                default: 88
                min: 1.0
                max: 300.0
                clampMin: true
                normMin: 1.0
                normMax: 300.0
              - name: Viewhfillweight
                style: Float
                label: Horizontal Fill Weight
                default: 1
                clampMin: true
              - name: Viewverticalmode
                style: Menu
                label: Vertical Mode
                default: fixed
                menuNames:
                - fixed
                - fill
                menuLabels:
                - Fixed Height
                - Fill
                value: fill
              - name: Viewheight
                style: Int
                label: Height
                default: 88
                min: 1.0
                max: 300.0
                clampMin: true
                normMin: 1.0
                normMax: 300.0
              - name: Viewvfillweight
                style: Float
                label: Vertical Fill Weight
                default: 1
                clampMin: true
              - name: Viewmargins
                style: Int
                label: Viewer Margins
                size: 4
                startSection: true
              - name: Viewjustifyh
                style: Menu
                label: Justify Horizontal
                startSection: true
                default: 'off'
                menuNames:
                - 'off'
                - left
                - center
                - right
                menuLabels:
                - 'Off'
                - Left
                - Center
                - Right
              - name: Viewjustifyv
                style: Menu
                label: Justify Vertical
                default: 'off'
                menuNames:
                - 'off'
                - top
                - center
                - bottom
                menuLabels:
                - 'Off'
                - Top
                - Center
                - Bottom
              - name: Viewfixedaspect
                style: Menu
                label: View Fixed Aspect
                default: 'off'
                menuNames:
                - 'off'
                - horizontal
                - vertical
                menuLabels:
                - 'Off'
                - Horizontal
                - Vertical
              - name: Viewaspectratio
                style: WH
                label: View Aspect Ratio
                startSection: true
                default: [16, 9]
              - name: Viewuseaspect
                style: Toggle
                label: View Use Aspect
              - name: Viewareabgcolor
                style: RGBA
                label: View Area BG Color
                startSection: true
                values: [0.1, 0.1, 0.1, 1]
              - name: Viewerbgcolor
                style: RGBA
                label: Viewer BG Color
            flags:
            - viewer
            position: [300, -400]
            size: [160, 130]
            tags:
            - TDSubComp
            children:
            - name: opviewer
              type: opviewerCOMP
              parameters:
                opviewer: =parent.Widget.par.Operatorviewer.eval() if parent.Widget.par.Operatorviewer.eval() else ''
                w: 366
                h: 205
                fixedaspect: =parent.Widget.par.Viewfixedaspect.eval()
                aspect: =parent.Widget.par.Viewaspectratiow.eval() / parent.Widget.par.Viewaspectratioh.eval()
                sizefromwindow: true
                clickthrough: =1-parent.Widget.par.Activeviewer
                bgcolorr: =parent.Widget.par.Viewerbgcolorr
                bgcolorg: =parent.Widget.par.Viewerbgcolorg
                bgcolorb: =parent.Widget.par.Viewerbgcolorb
                bgalpha: =parent.Widget.par.Viewerbgcolora
                enablecloning: false
              sequences:
                ext:
                - promote: true
              position: [0, -200]
            - name: parexec1
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: =parent.Widget
                pars: Sizewidgettoviewer Operatorviewer
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n# \n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef valueChange(par, val, prev):\n\tparent().cook(force=True)\n\treturn\n\ndef onPulse(par):\n\tpar.owner.par.w = parent().width + par.owner.par.marginl + \\\n\t\t\t\t\t  \t\t\t\t\tpar.owner.par.marginr\n\tpar.owner.par.h = parent().height + par.owner.par.margint + \\\n\t\t\t\t\t  \t\t\t\t\tpar.owner.par.marginb\n\tpar.owner.par.hmode = 'fixed'\n\tpar.owner.par.vmode = 'fixed'\n\treturn\n\ndef expressionChange(par, val, prev):\n\treturn\n\ndef exportChange(par, val, prev):\n\treturn\n\ndef enableChange(par, val, prev):\n\treturn\n\t"
              dat_content_format: text
            - name: OpViewerExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 0]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass OpViewerExt(SubWidgetExt):\n\t\"\"\"\n\tOpViewerExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'View'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\t\tself.attrDict = {'w':'width', 'h':'height'}\n\n\tdef GetViewedOpSize(self, parSize):\n\t\tviewedOp = self.ownerComp.par.opviewer.eval()\n\t\tif viewedOp:\n\t\t\tif hasattr(viewedOp, self.attrDict[parSize]):\n\t\t\t\tif not hasattr(viewedOp.par, 'stufffromwindow') or not viewedOp.par.stufffromwindow.eval():\n\t\t\t\t\treturn getattr(viewedOp, self.attrDict[parSize])\n\t\treturn getattr(self.ownerComp.parent(), self.attrDict[parSize])\n"
              dat_content_format: text
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-500, 0]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: parexecSettings
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Viewhorizontalmode Viewverticalmode
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, -200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\tdebug(par)\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\tdebug(par)\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
        - name: parexec1
          type: parameterexecuteDAT
          parameters:
            fromop: =parent()
            op: ..
            pars: Updatedeployed
            valuechange: false
            builtin: false
            defaultreadencoding: cp1252
            language: input
          flags:
          - viewer
          position: [-700, 0]
          size: [130, 90]
          dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n# \n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef onValueChange(par, prev):\n\treturn\n\ndef onPulse(par):\n\tif par.name == 'Updatedeployed':\n\t\tupdateDeployed()\n\ndef onExpressionChange(par, val, prev):\n\treturn\n\ndef onExportChange(par, val, prev):\n\treturn\n\ndef onEnableChange(par, val, prev):\n\treturn\n\ndef onModeChange(par, val, prev):\n\treturn\n\ndef updateDeployed():\n\twidgets = op('/').findChildren(tags=('TDBasicWidget',))\n\tdeployed = [w for w in widgets if w.par.clone.eval()\n\t\t\t\tand w.par.clone.eval().parent() == me.parent()\n\t\t\t\tand w.par.clone.eval() != w]\n\top.TDUpdater.Update(deployed, updater=op('TDUpdateSystem'))"
          dat_content_format: text
        - name: slider2D
          type: widgetCOMP
          parameters:
            w: 450
            h: 180
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            bgcolorr: 0.2
            bgcolorg: 0.2
            bgcolorb: 0.2
            bgalpha: 1
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            borderover: false
            align: horizlr
            spacing: 1
            marginl: 3
            marginr: 3
            marginb: 3
            margint: 3
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('slider2D') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
            - name: Value0
              style: Float
              label: Value 0
              value: 0.608939
            - name: Value1
              style: Float
              label: Value 1
              value: 0.439306
            - name: Valname0
              style: Str
              label: Name 0
              startSection: true
              default: X
            - name: Onvaluechangescript0
              style: Str
              label: On Value Change Script 0
            - name: Ontooffscript0
              style: Str
              label: On To Off Script 0
            - name: Offtoonscript0
              style: Str
              label: Off To On Script 0
            - name: Valname1
              style: Str
              label: Name 1
              startSection: true
              default: Y
            - name: Onvaluechangescript1
              style: Str
              label: On Value Change Script 1
            - name: Ontooffscript1
              style: Str
              label: On To Off Script 1
            - name: Offtoonscript1
              style: Str
              label: Off To On Script 1
            - name: Createeditvalueparexec
              style: Pulse
              label: Create/Edit Value Par Exec
              startSection: true
            - name: Valueparexec
              style: DAT
              label: Value Par Exec
              readOnly: true
              enable: false
            Label:
            - name: Widgetlabel
              style: Str
              label: Widget Label
              default: Slider 2D
            - name: Labeltop
              style: TOP
              label: Label TOP
            - name: Labeldisplay
              style: Toggle
              label: Display
              startSection: true
              default: true
            - name: Labelwordwrap
              style: Toggle
              label: Word Wrap
              startSection: true
            - name: Labelfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Labelfontsize
              style: Int
              label: Font Size
              default: 10
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Labelfontsizemode.eval() in ['points', 'panelunits']
            - name: Labelfontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Labelfontsizemode.eval() in ['fract', 'relfract']
              enable: false
            - name: Labelscaletofit
              style: Menu
              label: Scale Text to Fit
              default: never
              menuNames:
              - never
