              normMax: 5.0
            - name: Sectionlabelpadding
              style: Float
              label: Padding
              size: 4
            - name: Sectionlabelbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              clampMin: true
              clampMax: true
            - name: Sectionlabelfontcolor
