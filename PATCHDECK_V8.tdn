            parameters:
              chop: audiospect3
              format: ~op('hi').par.format
            flags:
            - viewer
            position: [1400, 0]
          - name: mid
            type: choptoTOP
            parameters:
              chop: audiospect2
              format: ~op('hi').par.format
            flags:
            - render
            - viewer
            position: [1400, 200]
          - name: fit1
            type: fitTOP
            parameters:
              resolutionw: 1920
              resolutionh: 1080
            flags:
            - viewer
            position: [2400, 50]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
