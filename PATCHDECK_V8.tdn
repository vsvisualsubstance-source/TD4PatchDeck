              label: Scale Text to Fit
              default: never
              menuNames:
              - never
              - always
              - onlyshrink
              menuLabels:
              - Never
              - Always
              - Only when Too Large
            - name: Labelfontbold
              style: Toggle
              label: Font Bold
            - name: Labelitalic
              style: Toggle
              label: Italic
            - name: Labeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Labelalignx
