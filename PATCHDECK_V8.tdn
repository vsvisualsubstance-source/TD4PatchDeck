          - name: popDialog
            type: containerCOMP
            parameters:
              w: 260
              h: =me.DialogHeight
              display: false
              resizecomp: =me
              bgcolorr: 0.3
              bgcolorg: 0.3
              bgcolorb: 0.3
              bgalpha: 1
              topsmoothness: usetop
              borderover: false
              parentshortcut: Dialog
              clone: =op.TDTox.op('popDialog')
              relpath: inherit
            sequences:
              ext:
              - object: me.mod.PopDialogExt.PopDialogExt(me)
                promote: true
              - object: me.mod.CallbacksExt.CallbacksExt(me)
                promote: true
            custom_pars:
              Pop Dialog:
              - name: Open
                style: Pulse
              - name: Close
                style: Pulse
              - name: Title
                style: Str
                startSection: true
                value: Error
              - name: Text
                style: Str
                value: There is an issue with the Audio Device In CHOP\n (Sndviz/audioSrc/audiodevin1)
              - name: Textentryarea
                style: Toggle
                label: Text Entry Area
              - name: Textentrydefault
                style: Str
                label: Text Entry Default
                value: Default Text
              - name: Textentrytype
                style: Menu
                label: Text Entry Type
                default: string
                menuNames:
                - string
                - float
                - integer
                - password
                menuLabels:
                - String
                - Float
                - Integer
                - Password
              - name: Buttons
                style: Int
                default: 1
                min: 1.0
                max: 4.0
                clampMax: true
                normMin: 1.0
                normMax: 4.0
              - name: Buttonlabel1
                style: Str
                label: Button Label 1
                value: OK
              - name: Buttonlabel2
                style: Str
                label: Button Label 2
                value: Cancel
              - name: Buttonlabel3
                style: Str
                label: Button Label 3
              - name: Buttonlabel4
                style: Str
                label: Button Label 4
              - name: Escbutton
                style: Menu
                label: On Esc Press Button
                default: '''None'''
                menuNames:
                - '1'
                - '2'
                - '3'
                - '4'
                - None
                menuLabels:
                - Button 1
                - Button 2
                - Button 3
                - Button 4
                - None
                value: '1'
              - name: Enterbutton
                style: Menu
                label: On Enter Press Button
                default: '''None'''
                menuNames:
                - '1'
                - '2'
                - '3'
                - '4'
                - None
                menuLabels:
                - Button 1
                - Button 2
                - Button 3
                - Button 4
                - None
                value: '1'
              - name: Esconclickaway
                style: Toggle
                label: Esc On Click Away
                value: true
              Advanced:
              - name: Callbacks
                style: Header
              - name: Editcallbacks
                style: Pulse
                label: Edit Callbacks
              - name: Callbackdat
                style: DAT
                label: Callback DAT
                value: /PATCHDECK/PATCHES/X35/Sndviz/audio/popDialog/config/callbacks
              - name: Printcallbacks
                style: Toggle
                label: Print Callbacks
              - name: Popupwindow
                style: Header
                label: Popup Window
                startSection: true
              - name: Windowcomp
                style: COMP
                label: Window Comp
                readOnly: true
                value: /PATCHDECK/PATCHES/X35/Sndviz/audio/popDialog/popDialogWindow
              - name: Dpiscaling
                style: Menu
                label: DPI Scaling
                default: usedpiscale
                menuSource: op('./popDialogWindow').par.dpiscaling
              - name: Includedialog
                style: Toggle
                label: Include in Placement Dialog
                default: true
                value: false
              About:
              - name: Help
                style: Pulse
              - name: Version
                style: Str
                default: 1.2.1
                readOnly: true
              - name: Toxsavebuild
                style: Str
                label: .tox Save Build
                readOnly: true
                value: '2022.22720'
