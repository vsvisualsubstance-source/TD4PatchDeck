                  borderaalpha: 0
                  borderbalpha: 0
                  borderover: false
                custom_pars:
                  Expressions:
                    $t: expressions_3
                    Value: =parent.Widget.par.Value0.eval() == parent().digits
                    Mapoff: '='
                    Mapon: '='
                    Fontcolor: =parent.Widget.parGroup.Foldertabonfontcolor if me.par.Value else parent.Widget.parGroup.Foldertabofffontcolor
                    Facecolor: =parent.Widget.parGroup.Foldertabonfacecolor if me.par.Value else parent.Widget.parGroup.Foldertabofffacecolor
                flags:
