            clickthrough: =parent.Widget.par.clickthrough
            resizecomp: =me
            borderover: false
            align: horizlr
            spacing: 1
            justifyv: center
            parentshortcut: Value
            enablecloning: false
          sequences:
            ext:
            - object: op('./NumericFieldExt').module.NumericFieldExt(me)
          custom_pars:
            Field:
              $t: field_7
