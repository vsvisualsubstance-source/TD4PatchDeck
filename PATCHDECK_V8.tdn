              Numericfieldwidth: =me.par.h
            Knob:
              $t: knob
              Knoblabel: =me.op('../../data_nul_b')[0,0]
              Knoblabeldisplay: false
              Knobfontsize: 30
              Knobbgcolor: [0.09495, 0.09495, 0.15, 1]
              Knobfontcolor: [0.903, 0.903, 0.903, 1]
              Knobhorizontalmode: fill
