              - g
              - b
              - a
            - - '0'
              - '0'
              - '0'
              - '0'
              - '0'
            - - '0.347607'
              - '0'
              - '0'
              - '1'
              - '1'
            - - '0.6675063'
              - '0'
              - '1'
              - '0'
              - '1'
            - - '1'
              - '1'
              - '0'
              - '0'
              - '1'
            dat_content_format: table
          - name: glsl1_pixel
            type: textDAT
            parameters:
              defaultreadencoding: cp1252
              language: glsl
              extension: glsl
            flags:
            - viewer
            position: [1880, 150]
            size: [130, 90]
            dock: addLookupMix
            dat_content: "const vec3 W = vec3(0.2989, 0.5870, 0.1140);\n\nfloat luminance(vec3 rgb)\n{\n\treturn dot(rgb, W);\n}\n\nuniform float uInputLevel;\nuniform float uBloomIntensity;\nuniform float uGlowIntensity;\nuniform vec3 uGlowColor;\nuniform float uRampIntensity;\n\n\nlayout(location = 0) out vec4 fragColor;\nlayout(location = 1) out vec4 bloomColor;\nvoid main()\n{\n\n\tvec4 inputTexture = texture(sTD2DInputs[0], vUV.st);\n\tvec3 bloom = texture(sTD2DInputs[1], vUV.st).rgb;\n\n\n\tfloat luma = luminance(bloom);\n\n\tbloom *= uBloomIntensity;\n\n\tif (uGlowIntensity > 0.0)\n\t{\n\t\tbloom += uGlowColor * luma * uGlowIntensity;\n\t}\n\n\tif (uRampIntensity > 0.0)\n\t{\n\t\tbloom += texture(sTD2DInputs[2], vec2(luma, 0.5)).rgb * uRampIntensity;\n\t}\n\n\n\n\tfragColor = TDOutputSwizzle(inputTexture * uInputLevel + vec4(bloom, luma));\n\tbloomColor = TDOutputSwizzle(vec4(bloom, luma));\n\n}\n"
            dat_content_format: text
          - name: replicator1
            type: replicatorCOMP
            parameters:
              method: bynum
              numreplicants: ~parent.Bloom.par.Iterations
              repsuffixstart: 0
              opprefix: iter
              master: master
              destination: =parent()
              callbacks: replicator1_callbacks
              layout: vertical
              layoutorigin1: 771
            position: [770, 355]
          - name: window_ramp
