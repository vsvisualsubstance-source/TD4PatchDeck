    - name: X37
      type: baseCOMP
      parameters:
        opviewer: ./thumbnail
      custom_pars:
        Custom:
        - name: Name
          style: Str
          default: Gaia Words
          help: Display name shown in the PatchDeck patch grid UI.
          value: 37 Gaia Words
      flags:
      - viewer
      - -allowCooking
      position: [-2225, -925]
      size: [160, 130]
      children:
      - name: out
        type: outTOP
        parameters:
          label: =me.name
        flags:
        - viewer
        position: [1600, 0]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
        inputs:
        - level1
      - name: comp1
        type: compositeTOP
        parameters:
          operand: over
          legacyxform: true
          outputresolution: custom
          resolutionw: =mod.vars.resX
          resolutionh: =mod.vars.resY
          format: rgba8fixed
        position: [800, 0]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
        inputs:
        - text_thought
        - text_word
      - name: level1
        type: levelTOP
        position: [1200, 0]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
        inputs:
        - comp1
      - name: text_word
        type: textTOP
        parameters:
          text: =op.Gaia.op('dat_word_current')[0,0]
          bold: true
          fontsizex: 120
          fontsizey: 120
          alignx: right
          aligny: bottom
          borderspace1: 100
          borderspace2: 90
          fontcolorr: =op.Gaia.op('out_soul')['mood_r']
          fontcolorg: =op.Gaia.op('out_soul')['mood_g']
          fontcolorb: =op.Gaia.op('out_soul')['mood_b']
          fontalpha: 0.6
          bgcolorr: =op.Gaia.op('out_soul')['mood_r'] * 0.22
          bgcolorg: =op.Gaia.op('out_soul')['mood_g'] * 0.22
          bgcolorb: =op.Gaia.op('out_soul')['mood_b'] * 0.22
          bgalpha: 1
          outputresolution: custom
          resolutionw: =mod.vars.resX
          resolutionh: =mod.vars.resY
          format: rgba8fixed
        flags:
        - viewer
        position: [0, -400]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
      - name: thumbnail
        type: fitTOP
        parameters:
          outputresolution: quarter
        flags:
        - lock
        - viewer
        position: [2000, 0]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
        inputs:
        - out
      - name: text_thought
        type: textTOP
        parameters:
          text: =op.Gaia.op('dat_thought')[0,0]
          wordwrap: true
          fontsizex: 34
          fontsizey: 34
          borderspace1: 160
          borderspace2: 120
          fontcolorr: 0.97
          fontcolorg: 0.97
          fontcolorb: 0.95
          outputresolution: custom
          resolutionw: =mod.vars.resX
          resolutionh: =mod.vars.resY
          format: rgba8fixed
        flags:
        - viewer
        position: [400, 400]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
      annotations:
      - name: annotate1
        mode: annotate
        title: Gaia Words
        text: Mood-tinted background (out_soul mood_rgb) with the current Gaia thought sentence as focal text and a cycling lexicon word as a soft accent, bottom-right third.
        position: [-70, -470]
        size: [2270, 1130]
        color: [0.45, 0.45, 0.45]
    - name: X38
      type: baseCOMP
      parameters:
        opviewer: ./thumbnail
      custom_pars:
        Custom:
        - name: Name
          style: Str
          default: Gaia Mocap Field
          value: 38 Gaia Mocap
      flags:
      - viewer
      - -allowCooking
      position: [-2050, -925]
      size: [160, 130]
      children:
      - name: out
        type: outTOP
        parameters:
          label: =me.name
        flags:
        - viewer
        position: [1200, -300]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
        inputs:
        - level1
      - name: cam1
        type: cameraCOMP
        parameters:
          ty: 0.5
          tz: 9
        flags:
        - viewer
        position: [0, 200]
        size: [160, 130]
        children:
        - name: file1
          type: fileinPOP
          parameters:
            file: =app.samplesFolder + '/Geo/defcam.tog'
          size: [130, 90]
      - name: blur1
        type: blurTOP
        parameters:
          size: 4
        flags:
        - viewer
        position: [400, -300]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
        inputs:
        - render1
      - name: level1
        type: levelTOP
        parameters:
          brightness1: 1.3
        flags:
        - viewer
        position: [800, -300]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
        inputs:
        - blur1
      - name: light1
        type: lightCOMP
        position: [400, 200]
        children:
        - name: copy1
          type: copyPOP
          parameters:
            ncy: 2
            rx: 90
          flags:
          - viewer
          position: [520, 670]
          size: [130, 90]
          inputs:
          - tube_attenuated
        - name: merge1
          type: mergePOP
          sequences:
            input:
            - {}
            - {}
            - {}
            - {}
            - {}
            - {}
            - {}
          position: [250, 500]
          size: [130, 90]
          inputs:
          - rectangle1
          - tube_cone1
          - tube_cone2
          - primitive1
          - line_atten
          - circle_attenStart
          - circle_attenEnd
        - name: merge2
          type: mergePOP
          sequences:
            input:
            - {}
            - {}
          position: [950, 230]
          size: [130, 90]
          inputs:
          - connectivity1
          - circle1
        - name: merge3
          type: mergePOP
          sequences:
            input:
            - {}
            - {}
          position: [620, 290]
          size: [130, 90]
          inputs:
          - pointgen1
          - transform1
        - name: circle1
          type: circlePOP
          parameters:
            connectivity: surface
            scale: 0.2
          position: [780, 170]
          size: [130, 90]
        - name: sphere1
          type: spherePOP
          parameters:
            radx: 0.05
            rady: 0.05
            radz: 0.05
            freq: 3
          flags:
          - viewer
          position: [520, 890]
          size: [130, 90]
        - name: pointgen1
          type: pointgeneratorPOP
          parameters:
            shape: circle
            numpoints: 17
            sx: 0.2
            sy: 0.2
            sz: 0.2
          flags:
          - viewer
          position: [270, 290]
        - name: line_atten
          type: linePOP
          parameters:
            divs: 1
            bypass: =not parent().par.attenuated
          sequences:
            pt:
            - posz: =-parent().par.attenuationstart
            - posz: =-parent().par.attenuationend
          custom_pars:
            Points:
              $t: points
          position: [0, 230]
          size: [130, 90]
        - name: primitive1
          type: primitivePOP
          parameters:
            method: pattern
          sequences:
            prim:
            - type: lines
              pattern: 0 1 0 2 0 3 0 4
            pt:
            - {}
            - posx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2)) + mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =-op('tube_cone1').par.height
            - posx: =mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =0-op('tube_cone1').par.height
            - posy: =-mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =-op('tube_cone1').par.height
            - posy: =mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =-op('tube_cone1').par.height
          custom_pars:
            Points:
              $t: points
          flags:
          - viewer
          position: [0, 390]
          size: [130, 90]
        - name: rectangle1
          type: rectanglePOP
          parameters:
            sizeu: 0.02
            sizev: 0.5
            anchorv: 0
          position: [0, 730]
        - name: transform1
          type: transformPOP
          parameters:
            tz: 0.8
          flags:
          - viewer
          position: [450, 370]
          size: [130, 90]
          inputs:
          - pointgen1
        - name: tube_cone1
          type: tubePOP
          parameters:
            radx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2))
            rady: 0.01
            height: =mod.math.cos(mod.math.radians(parent().par.coneangle/2))
            rows: 2
            tz: =-me.par.height*0.5
          position: [0, 620]
          size: [130, 90]
        - name: tube_cone2
          type: tubePOP
          parameters:
            radx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2)) + mod.math.sin(mod.math.radians(parent().par.conedelta/2))
            rady: =mod.math.sin(mod.math.radians(parent().par.coneangle/2))
            height: 0
            rows: 2
            tz: =-op('tube_cone1').par.height
          position: [0, 500]
          size: [130, 90]
        - name: connectivity1
          type: connectivityPOP
          position: [780, 290]
          inputs:
          - merge3
        - name: circle_attenEnd
          type: circlePOP
          parameters:
            connectivity: surface
            radx: 0.1
            rady: 0.1
            tz: =-parent().par.attenuationend
            bypass: =not parent().par.attenuated
          size: [130, 90]
        - name: primitive_cross
          type: primitivePOP
          parameters:
            method: set
            setprimtype: lines
          sequences:
            pt:
            - posx: -0.2
            - posx: 0.2
            - posy: -0.2
            - posy: 0.2
            - posz: -0.2
            - posz: 0.2
          custom_pars:
            Points:
              $t: points
          flags:
          - display
          - render
          - viewer
          position: [520, 1000]
          size: [130, 90]
        - name: tube_attenuated
          type: tubePOP
          parameters:
            surftype: rows
            radx: =parent().par.attenuationend
            rady: =parent().par.attenuationstart
            height: 0
            rows: 2
            bypass: =not parent().par.attenuated
          position: [368, 673]
          size: [130, 90]
        - name: merge_pointLight
          type: mergePOP
          sequences:
            input:
            - {}
            - {}
            - {}
            - {}
          position: [760, 820]
          size: [130, 90]
          inputs:
          - sphere1
          - primitive_quadrants
          - copy1
        - name: switch_lightType
          type: switchPOP
          parameters:
            index: =parent().par.lighttype.menuIndex
          flags:
          - display
          - render
          - viewer
          position: [1140, 500]
          size: [130, 90]
          inputs:
          - merge_pointLight
          - merge1
          - merge2
        - name: circle_attenStart
          type: circlePOP
          parameters:
            connectivity: surface
            radx: 0.1
            rady: 0.1
            tz: =-parent().par.attenuationstart
            bypass: =not parent().par.attenuated
          position: [0, 120]
          size: [130, 90]
        - name: primitive_quadrants
          type: primitivePOP
          parameters:
            method: set
            setprimtype: lines
          sequences:
            pt:
            - posx: 0.07
              posy: 0.07
              posz: 0.07
            - posx: -0.07
              posy: -0.07
              posz: -0.07
            - posx: -0.07
              posy: 0.07
              posz: 0.07
            - posx: 0.07
              posy: -0.07
              posz: -0.07
            - posx: 0.07
              posy: 0.07
              posz: -0.07
            - posx: -0.07
              posy: -0.07
              posz: 0.07
            - posx: -0.07
              posy: 0.07
              posz: -0.07
            - posx: 0.07
              posy: -0.07
              posz: 0.07
          custom_pars:
            Points:
              $t: points
          flags:
          - viewer
          position: [520, 780]
          size: [130, 90]
      - name: render1
        type: renderTOP
        parameters:
          bgcolorr: =op.Gaia.op('out_soul')['mood_r'] * 0.07
          bgcolorg: =op.Gaia.op('out_soul')['mood_g'] * 0.07
          bgcolorb: =op.Gaia.op('out_soul')['mood_b'] * 0.09
          bgcolora: 1
        flags:
        - viewer
        position: [0, -300]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
      - name: thumbnail
        type: fitTOP
        flags:
        - lock
        - viewer
        position: [1600, -300]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
        inputs:
        - out
      - name: geo_points
        type: geometryCOMP
        parameters:
          instancetop: ./script_points
          instancecolorop: ./script_points
          material: mat_points
        flags:
        - viewer
        position: [800, 200]
        size: [160, 130]
        children:
        - name: script_points
          type: scriptPOP
          parameters:
            callbacks: script_points_callbacks
          custom_pars:
            Custom:
            - name: Value
              style: Float
          flags:
          - display
          - render
          size: [130, 90]
          color: [0.67, 0.67, 0.67]
        - name: script_points_callbacks
          type: textDAT
          parameters:
            language: python
          flags:
          - viewer
          position: [0, -120]
          size: [130, 90]
          dock: script_points
          dat_content: "\"\"\"\nScript POP Callbacks\n\nme - this DAT\n\nscriptOp - the OP which is cooking\n\"\"\"\n\nimport math\n\n# press 'Setup Parameters' in the OP to call this function to re-create \n# the parameters\ndef onSetupParameters(scriptOp: scriptPOP):\n\t\"\"\"\n\tCalled to setup custom parameters for the Script POP.\n\t\"\"\"\n\tpage = scriptOp.appendCustomPage('Custom')\n\tp = page.appendFloat('Value', label='Value')\n\treturn\n\ndef onPulse(par: Par):\n\t\"\"\"\n\tCalled when a custom pulse parameter is pushed.\n\t\n\tArgs:\n\t\tpar: The parameter that was pulsed\n\t\"\"\"\n\treturn\n\nFACE_REGIONS = [\n\t('eye_left', 16), ('eye_right', 16),\n\t('eyebrow_left', 10), ('eyebrow_right', 10),\n\t('lips', 40), ('nose', 24), ('oval', 36),\n]  # order/sizes verified live against chop_face -- see patchdeck-known-issues #56/#60\nFACE_POINTS_PER_PERSON = sum(n for _, n in FACE_REGIONS)  # 152 -> *3 floats = 456, matches chop_face\n\n\ndef onCook(scriptOp: scriptPOP):\n\t\"\"\"\n\tCalled when the Script POP needs to cook.\n\n\tDraws CONNECTED LINE shapes, not a scattered point cloud (a plain point\n\tcloud from this data read as unrecognizable noise -- fixed per user\n\tfeedback). Face renders as real per-region contour outlines (eyes,\n\tbrows, lips, nose, oval) using chop_face's now-numerically-sorted\n\tper-region point order (patchdeck-known-issues #60) -- when a face is\n\tactually being detected; pose/hand OSC indices are not decodable\n\tper-landmark (#55/#56) so they each become ONE closed line loop whose\n\tradius is modulated by their raw per-channel values in order -- an\n\thonest \"energy waveform ring\", not a fake skeleton. Color from out_soul\n\tmood (same palette as X36/X37).\n\t\"\"\"\n\tstagingData = scriptPOP.createGeometryStagingData()\n\tstagingData.createPointAttrib(name=\"P\")\n\tstagingData.createVertAttrib(name=\"Color\", numComps=4, numMatCols=1, arrSize=0, type=AttribDataType.FLOAT32, qualifier=AttribQualifier.COLOR, defaultValue=(1, 1, 1, 1))\n\n\tpositions = []\n\tcolors = []\n\tstrips = []\n\n\tsoul = op.Gaia.op('out_soul') if hasattr(op, 'Gaia') else None\n\tif soul is not None:\n\t\tmood_r = soul['mood_r'].eval()\n\t\tmood_g = soul['mood_g'].eval()\n\t\tmood_b = soul['mood_b'].eval()\n\telse:\n\t\tmood_r, mood_g, mood_b = 0.6, 0.5, 0.9\n\n\tface = op.Gaia.op('chop_face') if hasattr(op, 'Gaia') else None\n\tif face is not None:\n\t\tvals = [c.eval() for c in face.chans()]\n\t\tper_person = FACE_POINTS_PER_PERSON * 3\n\t\tnum_persons = len(vals) // per_person\n\t\tfor p in range(num_persons):\n\t\t\tbase = p * per_person\n\t\t\toffset = 0\n\t\t\tfor region_name, npts in FACE_REGIONS:\n\t\t\t\tstart = len(positions)\n\t\t\t\tfor k in range(npts):\n\t\t\t\t\tidx = base + offset + k * 3\n\t\t\t\t\tif idx + 2 >= len(vals):\n\t\t\t\t\t\tbreak\n\t\t\t\t\tx, y, z = vals[idx], vals[idx + 1], vals[idx + 2]\n\t\t\t\t\tpositions.append(((x - 0.5) * 5.0, (0.5 - y) * 5.0 + 1.0, z * 5.0))\n\t\t\t\t\tcolors.append((1.0, 0.92, 0.85, 1.0))\n\t\t\t\tend = len(positions)\n\t\t\t\tif end - start >= 2:\n\t\t\t\t\tstrip = list(range(start, end))\n\t\t\t\t\tstrip.append(start)  # close the loop -- eye/brow/lips/oval are closed contours\n\t\t\t\t\tstrips.append(strip)\n\t\t\t\toffset += npts * 3\n\n\tfor chop_name, radius, y_center, base_color in (\n\t\t('chop_pose', 3.2, -1.2, (mood_r, mood_g, mood_b, 0.85)),\n\t\t('chop_hand', 2.2, 0.9, (mood_r, mood_g, mood_b, 0.85)),\n\t):\n\t\tchop = op.Gaia.op(chop_name) if hasattr(op, 'Gaia') else None\n\t\tif chop is None:\n\t\t\tcontinue\n\t\tchans = list(chop.chans())\n\t\tn = len(chans)\n\t\tif n < 3:\n\t\t\tcontinue\n\t\tstart = len(positions)\n\t\tfor i, ch in enumerate(chans):\n\t\t\tv = ch.eval()\n\t\t\tangle = (i / n) * 2.0 * math.pi\n\t\t\tr = radius + v * 1.2\n\t\t\tpositions.append((math.cos(angle) * r, y_center + v * 0.4, math.sin(angle) * r))\n\t\t\tcolors.append(base_color)\n\t\tend = len(positions)\n\t\tstrip = list(range(start, end))\n\t\tstrip.append(start)\n\t\tstrips.append(strip)\n\n\tif not positions:\n\t\tpositions = [(0.0, 0.0, 0.0)]\n\t\tcolors
            = [(0.3, 0.3, 0.3, 1.0)]\n\n\tstagingData.appendPointAttribValues(\"P\", positions)\n\tstagingData.appendVertAttribValues(\"Color\", colors)\n\tfor strip in strips:\n\t\tstagingData.appendPrimLineStrip(tuple(strip))\n\tif not strips:\n\t\tstagingData.appendPrimPoints(list(range(len(positions))))\n\n\tscriptOp.buildGeometry(stagingData)\n\treturn\n\ndef onGetCookLevel(scriptOp: scriptPOP) -> CookLevel:\n\t\"\"\"\n\tSets the scriptOp's cook level, the conditions necessary to cause a cook.\n\n\tReturn one of the following:\n\t\tCookLevel.AUTOMATIC - inputs changed and output being used. \n\t\t\t\t\t\t\t TD default behavior.\n\t\tCookLevel.ON_CHANGE - inputs changed, output used or not.\n\t\tCookLevel.WHEN_USED - every frame when output is being used\n\t\tCookLevel.ALWAYS - every frame\n\t\"\"\"\n\n\treturn CookLevel.WHEN_USED\n"
          dat_content_format: text
