          - name: ps_glsl_info
            type: infoDAT
            parameters:
              op: ps_glsl
            flags:
            - viewer
            position: [160, -120]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dock: ps_glsl
            dat_read_only: true
          - name: ps_glsl_text
            type: textDAT
            position: [1800, 160]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dat_content: |
              // ordinamento a trasposizione pari-dispari, per colonne
              // sTD2DInputs[0] = immagine viva   sTD2DInputs[1] = stato del frame prima
              // uP: x = fase (0/1)  y = soglia luminanza  z = rigenerazione
              out vec4 fragColor;
              uniform vec4 uP;

              float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

              vec4 state(ivec2 p)
              {
                  vec4 prev = texelFetch(sTD2DInputs[1], p, 0);
                  vec4 live = texelFetch(sTD2DInputs[0], p, 0);
                  return mix(prev, live, uP.z);
              }

              void main()
              {
                  ivec2 res = textureSize(sTD2DInputs[1], 0);
                  ivec2 uv  = ivec2(gl_FragCoord.xy);
                  vec4 cur  = state(uv);

                  // alternando la fase le coppie sono (0,1)(2,3)... poi (1,2)(3,4)...
                  bool lower = ((uv.y + int(uP.x)) % 2 == 0);
                  int  oy    = lower ? uv.y + 1 : uv.y - 1;

                  if (oy < 0 || oy >= res.y) {
                      fragColor = TDOutputSwizzle(cur);
                      return;
                  }

                  vec4 other = state(ivec2(uv.x, oy));
                  float a = lum(cur.rgb);
                  float b = lum(other.rgb);

                  // sotto soglia i pixel non partecipano: decide DOVE si spezza
                  if (a > uP.y && b > uP.y) {
                      if (lower  && a > b) cur = other;
                      if (!lower && b > a) cur = other;
                  }

                  fragColor = TDOutputSwizzle(cur);
              }
            dat_content_format: text
          - name: px_glsl_info
            type: infoDAT
            parameters:
              op: px_glsl
            flags:
            - viewer
            position: [160, -120]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dock: px_glsl
            dat_read_only: true
          - name: px_glsl_text
            type: textDAT
            position: [1200, 160]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dat_content: |
              // quantizzazione colore + dithering ordinato 4x4 (Bayer)
              // uP: x = livelli per canale  y = intensita' dithering
              out vec4 fragColor;
              uniform vec4 uP;

              const float bayer[16] = float[16](
                   0.0,  8.0,  2.0, 10.0,
                  12.0,  4.0, 14.0,  6.0,
                   3.0, 11.0,  1.0,  9.0,
                  15.0,  7.0, 13.0,  5.0
              );

              void main()
              {
                  vec4 src = texture(sTD2DInputs[0], vUV.st);
                  float levels = max(2.0, uP.x);

                  int bx = int(mod(gl_FragCoord.x, 4.0));
                  int by = int(mod(gl_FragCoord.y, 4.0));
                  float threshold = (bayer[by * 4 + bx] + 0.5) / 16.0 - 0.5;

                  vec3 col = src.rgb + threshold * uP.y / levels;     // dither PRIMA
                  col = clamp(floor(col * levels + 0.5) / levels, 0.0, 1.0);

                  fragColor = TDOutputSwizzle(vec4(col, src.a));
              }
            dat_content_format: text
          - name: sl_glsl_info
            type: infoDAT
            parameters:
              op: sl_glsl
            flags:
            - viewer
            position: [160, -120]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dock: sl_glsl
            dat_read_only: true
          - name: sl_glsl_text
            type: textDAT
            position: [400, -140]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dat_content: |
              // taglio a bande, deriva continua (nessuna oscillazione)
              // uP: x = numero bande  y = spostamento  z = tempo  w = irregolarita'
              // uQ: x = modalita' (0 = orizzontali, 1 = verticali, 2 = entrambe)
              out vec4 fragColor;
              uniform vec4 uP;
              uniform vec4 uQ;

              float hash(float n) { return fract(sin(n * 127.1) * 43758.5453); }

              // la deriva cresce nel tempo, il fract la fa rientrare dall'altro lato
              float bandShift(float b)
              {
                  float calmo = 0.3 + 0.7 * hash(b + 5.0);            // stesso verso
                  float rotto = (hash(b + 9.0) * 2.0 - 1.0) * 2.0;    // versi misti
                  return uP.z * mix(calmo, rotto, uP.w) * uP.y;
              }

              void main()
              {
                  vec2 uv = vUV.st;
                  vec2 st = uv;
                  int  mode = int(uQ.x + 0.5);
                  float bands = max(2.0, uP.x);

                  if (mode == 0 || mode == 2) {
                      float b = floor(uv.y * bands);
                      st.x = fract(st.x + bandShift(b));
                  }
                  if (mode == 1 || mode == 2) {
                      float b = floor(uv.x * bands) + 137.0;   // indice dalla X ORIGINALE
                      st.y = fract(st.y + bandShift(b));
                  }

                  fragColor = TDOutputSwizzle(texture(sTD2DInputs[0], st));
              }
            dat_content_format: text
          - name: fg_rand_shape
            type: noiseCHOP
            parameters:
              type: random
              seed: =parent().par.Seed + 2
              channelname: shape
              end: =parent().par.Count - 1
            position: [-1350, -420]
          - name: fg_shape_pick
            type: expressionCHOP
            sequences:
              expr:
              - expr: '=(lambda att: att[(me.sampleIndex * 7 + int(parent().par.Seed) * 13) % len(att)] if att else -1)([i for i, t in enumerate([parent().par.Shapecircle, parent().par.Shaperect, parent().par.Shapehex]) if t])'
            position: [-1200, -420]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_rand_shape
          - name: ps_glsl_pixel
            type: textDAT
