          - name: ramp1_keys
            type: tableDAT
            parameters:
              defaultreadencoding: cp1252
            flags:
            - viewer
            position: [1220, -430]
            size: [130, 90]
            dock: ramp1
            dat_content:
            - - pos
              - r
              - g
              - b
              - a
            - - '0'
              - '0'
              - '0'
              - '0'
              - '0'
            - - '0.347607'
              - '0'
              - '0'
              - '1'
              - '1'
            - - '0.6675063'
              - '0'
              - '1'
              - '0'
              - '1'
            - - '1'
              - '1'
              - '0'
              - '0'
              - '1'
            dat_content_format: table
          - name: glsl1_pixel
            type: textDAT
            parameters:
              defaultreadencoding: cp1252
              language: glsl
              extension: glsl
            flags:
            - viewer
            position: [1880, 150]
            size: [130, 90]
            dock: addLookupMix
            dat_content: "const vec3 W = vec3(0.2989, 0.5870, 0.1140);\n\nfloat luminance(vec3 rgb)\n{\n\treturn dot(rgb, W);\n}\n\nuniform float uInputLevel;\nuniform float uBloomIntensity;\nuniform float uGlowIntensity;\nuniform vec3 uGlowColor;\nuniform float uRampIntensity;\n\n\nlayout(location = 0) out vec4 fragColor;\nlayout(location = 1) out vec4 bloomColor;\nvoid main()\n{\n\n\tvec4 inputTexture = texture(sTD2DInputs[0], vUV.st);\n\tvec3 bloom = texture(sTD2DInputs[1], vUV.st).rgb;\n\n\n\tfloat luma = luminance(bloom);\n\n\tbloom *= uBloomIntensity;\n\n\tif (uGlowIntensity > 0.0)\n\t{\n\t\tbloom += uGlowColor * luma * uGlowIntensity;\n\t}\n\n\tif (uRampIntensity > 0.0)\n\t{\n\t\tbloom += texture(sTD2DInputs[2], vec2(luma, 0.5)).rgb * uRampIntensity;\n\t}\n\n\n\n\tfragColor = TDOutputSwizzle(inputTexture * uInputLevel + vec4(bloom, luma));\n\tbloomColor = TDOutputSwizzle(vec4(bloom, luma));\n\n}\n"
            dat_content_format: text
          - name: replicator1
            type: replicatorCOMP
            parameters:
              method: bynum
              numreplicants: ~parent.Bloom.par.Iterations
              repsuffixstart: 0
              opprefix: iter
              master: master
              destination: =parent()
              callbacks: replicator1_callbacks
              layout: vertical
              layoutorigin1: 771
            position: [770, 355]
          - name: window_ramp
            type: windowCOMP
            parameters:
              winop: parameter1
              title: =me
              justifyh: center
              justifyv: center
            flags:
            - viewer
            position: [1580, -470]
          - name: addLookupMix
            type: glslTOP
            parameters:
              pixeldat: glsl1_pixel
              computedat: glsl1_compute
              autodispatchsize: false
              inputextenduv: hold
            sequences:
              vec:
              - name: uBloomIntensity
                valuex: ~parent.Bloom.par.Bloom
              - name: uGlowIntensity
                valuex: ~parent.Bloom.par.Glow
                valuey: 1
                valuez: 1
                valuew: 1
              - name: uGlowColor
                valuex: ~parent.Bloom.par.Glowcolorr
                valuey: ~parent.Bloom.par.Glowcolorg
                valuez: ~parent.Bloom.par.Glowcolorb
                valuew: 1
              - name: uRampIntensity
                valuex: ~parent.Bloom.par.Glowinputramp
                valuey: 1
                valuez: 1
                valuew: 1
              - name: uInputLevel
                valuex: ~parent.Bloom.par.Inputlevel
                valuey: 1
                valuez: 1
                valuew: 1
            flags:
            - viewer
            position: [1880, 30]
            size: [130, 72]
            inputs:
            - in1
            - level2
            - level4
          - name: moviefilein1
            type: moviefileinTOP
            parameters:
              file: =app.samplesFolder + '/Map/Nature/Movie.2.mp4'
              reload: true
              hwdecode: false
            flags:
