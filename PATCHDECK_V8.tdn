              topoffset: =- (0 if me.digits == parent.Widget.par.Value0.menuIndex else parent.Widget.par.Foldertabopenmargin) if parent.Widget.extensionsReady else 0
              display: =len(parent().HiddenTabInfo) if parent().extensionsReady else False
              enable: =parent().RightButtonEnable if parent().extensionsReady else False
              helpdat: '=None # ./help'
              borderar: 0
              borderag: 0
              borderab: 0
              borderaalpha: 0
              borderbalpha: 0
              enablecloning: true
              relpath: inherit
            position: [800, -500]
            size: [160, 130]
            comp_inputs:
            - widthTools
            children:
            - name: 'on'
              type: textCOMP
              parameters:
                text: =chr(0xF035F)
                callbacks: on_textCOMP_callbacks
                legacyfontselection: true
                font: Material Design Icons
                fontsize: =parent.Widget.par.Foldertabfontsize.eval() * 1.5
                fontsizeunits: points
                fontcolorr: =parent.Widget.par.Foldertabonfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Foldertabonfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Foldertabonfontcolorb.eval()
                fontalpha: =parent.Widget.par.Foldertabonfontcolora.eval()
                alignxmode: bbox
                alignymode: bbox
                w: 75
                h: 26
                hmode: fill
                vmode: fill
                display: =parent().par.enable
                clickthrough: true
                bgcolorr: =parent.Widget.par.Foldertabonfacecolorr.eval()
                bgcolorg: =parent.Widget.par.Foldertabonfacecolorg.eval()
                bgcolorb: =parent.Widget.par.Foldertabonfacecolorb.eval()
                bgalpha: =parent.Widget.par.Foldertabonfacecolora.eval()
                borderar: =parent.Widget.par.Foldertabonbordercolorr.eval()
                borderag: =parent.Widget.par.Foldertabonbordercolorg.eval()
                borderab: =parent.Widget.par.Foldertabonbordercolorb.eval()
                borderaalpha: 0
                borderbalpha: 0
                borderover: false
              flags:
              - viewer
              position: [275, -375]
              size: [160, 130]
            - name: 'off'
              type: textCOMP
              parameters:
                text: =chr(0xF035F)
                callbacks: off_textCOMP_callbacks
                legacyfontselection: true
                font: Material Design Icons
                fontsize: =parent.Widget.par.Foldertabfontsize.eval() * 1.5
                fontsizeunits: points
                fontcolorr: =parent.Widget.par.Foldertabofffontcolorr.eval()
                fontcolorg: =parent.Widget.par.Foldertabofffontcolorg.eval()
                fontcolorb: =parent.Widget.par.Foldertabofffontcolorb.eval()
                fontalpha: =parent.Widget.par.Foldertabofffontcolora.eval()
                alignxmode: bbox
                alignymode: bbox
                w: 75
                h: 26
                hmode: fill
                vmode: fill
                display: =not op('on').par.display
                clickthrough: true
                bgcolorr: =parent.Widget.par.Foldertabofffacecolorr.eval()
                bgcolorg: =parent.Widget.par.Foldertabofffacecolorg.eval()
                bgcolorb: =parent.Widget.par.Foldertabofffacecolorb.eval()
                bgalpha: =parent.Widget.par.Foldertabofffacecolora.eval()
                borderar: =parent.Widget.par.Foldertaboffbordercolorr.eval()
                borderag: =parent.Widget.par.Foldertaboffbordercolorg.eval()
                borderab: =parent.Widget.par.Foldertaboffbordercolorb.eval()
                borderaalpha: 0
                borderbalpha: 0
                borderover: false
              flags:
              - viewer
              position: [275, -175]
              size: [160, 130]
            - name: help
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              position: [700, -575]
              size: [130, 90]
              dat_content: Scroll Tabs Right
              dat_content_format: text
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =parent().panel.rollover or parent().panel.lselect
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Foldertabrollcolorr.eval()
                bgcolorg: =parent.Widget.par.Foldertabrollcolorg.eval()
                bgcolorb: =parent.Widget.par.Foldertabrollcolorb.eval()
                bgalpha: =parent.Widget.par.Foldertabrollcolora.eval()
                borderover: false
                composite: add
                enablecloning: false
              flags:
              - viewer
              position: [950, -75]
              size: [160, 130]
            - name: insideParent
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                rows: 2
              flags:
              - viewer
              position: [625, 0]
              size: [130, 90]
              dat_content:
              - - '''path'''
                - '''parameter'''
                - '''value'''
                - '''enable'''
              - - '''rollover/panel'''
                - '''component'''
                - '''"'' + parent().path + ''"'''
                - '1'
              dat_content_format: table
            - name: on_textCOMP_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              position: [350, -525]
              size: [160, 130]
              dock: 'on'
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
            - name: off_textCOMP_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              position: [350, -525]
              size: [160, 130]
              dock: 'off'
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
          - name: menuChangedExec
            type: datexecuteDAT
            parameters:
              dat: menuOptions
              language: input
            position: [100, 300]
            size: [130, 90]
            color: [0.05, 0.5, 0.05]
            dat_content: "# me - this DAT.\n# \n# dat - the changed DAT\n# rows - a list of row indices\n# cols - a list of column indices\n# cells - the list of cells that have changed content\n# prev - the list of previous string contents of the changed cells\n# \n# Make sure the corresponding toggle is enabled in the DAT Execute DAT.\n# \n# If rows or columns are deleted, sizeChange will be called instead of row/col/cellChange.\n\n\ndef onTableChange(dat):\n\tparent().CalculateSizes()\n\ndef onRowChange(dat, rows):\n\treturn\n\ndef onColChange(dat, cols):\n\treturn\n\ndef onCellChange(dat, cells, prev):\n\treturn\n\ndef onSizeChange(dat):\n\treturn\n\t"
            dat_content_format: text
          - name: panelExecOPExec
            type: opexecuteDAT
            parameters:
              op: =ext.SubWidgetExt.PanelExecPar.eval() if parent().extensionsReady else ''
            flags:
            - viewer
            position: [-1100, 100]
            color: [0.05, 0.5, 0.05]
            dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
            dat_content_format: text
          - name: panelexecValueX
            type: panelexecuteDAT
            parameters:
              fromop: =me.parent()
              panels: tab* buttonTabsLeft buttonTabsRight buttonTabDropDown buttonAddTab
              panelvalue: lselect
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [-1100, 0]
            size: [130, 90]
            color: [0.05, 0.5, 0.05]
            dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
            dat_content_format: text
          - name: parexecSettingsX
            type: parameterexecuteDAT
            parameters:
              fromop: =me.parent()
              op: '=parent.Widget '
              pars: Folder* Menunames Menulabels Menuoptiontable Tableformat
              builtin: false
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [-1100, 200]
            size: [130, 90]
            color: [0.05, 0.5, 0.05]
            comment: Execution for parameter changes
            dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
            dat_content_format: text
          - name: buttonTabDropDown
            type: buttonCOMP
            parameters:
              scaletofit: onlyshrink
              y: =1-(me.digits == parent.Widget.par.Value0.eval())
              w: '=op(''./on'').evalTextSize(op(''./on'').par.value)[0] '
              h: 50
              leftanchor: 1
              horigin: 1
              vmode: fill
              topoffset: =- (0 if me.digits == parent.Widget.par.Value0.menuIndex else parent.Widget.par.Foldertabopenmargin) if parent.Widget.extensionsReady else 0
              alignorder: 2
              display: =((parent().HiddenTabInfo or any([t.par.display and t.par.Shrunken for t in ops('tab*')])) and parent.Widget.par.Folderdropdown) if parent().extensionsReady else False
              helpdat: '=None # ./help'
              borderar: 0
              borderag: 0
              borderab: 0
              borderaalpha: 0
              borderbalpha: 0
              enablecloning: true
              relpath: inherit
            position: [1100, -500]
            size: [160, 130]
            comp_inputs:
            - widthTools
            children:
            - name: 'on'
              type: textCOMP
              parameters:
                text: =chr(0xF013E)
                callbacks: on_textCOMP_callbacks
                legacyfontselection: true
                font: Material Design Icons
                fontsize: 0.6
                fontsizeunits: fract
                fontcolorr: =parent.Widget.par.Foldertabonfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Foldertabonfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Foldertabonfontcolorb.eval()
                fontalpha: =parent.Widget.par.Foldertabonfontcolora.eval()
                alignxmode: bbox
                alignymode: bbox
                w: 75
                h: =parent().height
                hmode: fill
                vmode: fill
                clickthrough: true
                borderar: =parent.Widget.par.Foldertabonbordercolorr.eval()
                borderag: =parent.Widget.par.Foldertabonbordercolorg.eval()
                borderab: =parent.Widget.par.Foldertabonbordercolorb.eval()
                borderaalpha: =parent.Widget.par.Foldertabonbordercolora.eval()
                borderbalpha: 0
                borderover: false
              flags:
              - viewer
              size: [160, 130]
            - name: help
              type: convertDAT
              position: [475, -300]
              inputs:
              - hiddenTabs
              dat_read_only: true
            - name: table1
              type: tableDAT
              parameters:
                fill: setsize
                rows: =len(parent(2).Labels) if parent(2).extensionsReady else 0
                cols: 1
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
              dat_content:
              - - ''
              - - ''
              - - ''
              - - ''
              - - ''
              - - ''
              - - ''
              - - ''
              dat_content_format: table
            - name: table2
              type: tableDAT
              parameters:
                rows: 1
                cols: 1
              flags:
              - viewer
              position: [0, -400]
              size: [130, 90]
              dat_content:
              - - parent(2).Labels[me.inputCell.row] + (' (selected)' if me.inputCell.row == parent(2).SelectedTab else '')
              dat_content_format: table
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =parent().panel.rollover or parent().panel.lselect
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Foldertabrollcolorr.eval()
                bgcolorg: =parent.Widget.par.Foldertabrollcolorg.eval()
                bgcolorb: =parent.Widget.par.Foldertabrollcolorb.eval()
                bgalpha: =parent.Widget.par.Foldertabrollcolora.eval()
                borderover: false
                composite: add
                enablecloning: false
              flags:
              - viewer
              position: [575, 400]
              size: [160, 130]
            - name: hiddenTabs
              type: evaluateDAT
              parameters:
                expr: '''help'''
                rowindexend: =me.inputTable.numRows - 1
                colindexend: =me.inputTable.numCols - 1
              position: [200, -300]
              inputs:
              - table1
              - table2
              dat_read_only: true
            - name: insideParent
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                rows: 2
              flags:
              - viewer
              position: [375, 425]
              size: [130, 90]
              dat_content:
              - - '''path'''
                - '''parameter'''
                - '''value'''
                - '''enable'''
              - - '''rollover/panel'''
                - '''component'''
                - '''"'' + parent().path + ''"'''
                - '1'
              dat_content_format: table
            - name: on_textCOMP_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              position: [0, -160]
              size: [160, 130]
              dock: 'on'
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
          - name: dragDropCallbacks
            type: textDAT
            parameters:
              language: input
            flags:
            - viewer
            position: [-900, -200]
            size: [130, 90]
            color: [0.05, 0.5, 0.05]
            dat_content: "from dataclasses import dataclass\n\n@dataclass\nclass Tab:\n\tindex: int\n\n# callbacks when associated Panel is being dropped on\ndef onHoverStartGetAccept(comp, info):\n\t\"\"\"\n\tCalled when comp needs to know if dragItems are acceptable as a drop.\n\n\tArgs:\n\t\tcomp: the Component being hovered over\n\t\tinfo: A dictionary containing all info about hover, including:\n\t\t\tdragItems: a list of objects being dragged over comp\n\n\tReturns:\n\t\tTrue if comp can receive dragItems\n\t\"\"\"\n\tdragItems = info['dragItems']\n\tretValue = ext.SubWidgetExt.RaiseDragDrop(comp, info) \n\tif retValue is not None:\n\t\treturn retValue\t\t\n\tif dragItems and parent.Widget.par.Folderdragtoreorder \\\n\t\t\t\t\t\t\t\t\t\t\tand isinstance(dragItems[0], Tab):\n\t\treturn True\n\tif not parent.Widget.par.Folderdragtoreorder.eval() or len(dragItems) != 1:\n\t\treturn False\n\treturn False\n\ndef onHoverEnd(comp, info):\n\t\"\"\"\n\tCalled when dragItems leave comp's hover area.\n\n\tArgs:\n\t\tcomp: the Component being hovered over\n\t\tinfo: A dictionary containing all info about hover, including:\n\t\t\tdragItems: a list of objects being dragged over comp\n\t\"\"\"\n\tretValue = ext.SubWidgetExt.RaiseDragDrop(comp, info) \n\tif retValue is not None:\n\t\treturn retValue\n\t# print('onHoverEnd', comp.name, dragItems)\n\ndef onDropGetResults(comp, info):\n\t\"\"\"\n\tCalled when comp receives a drop of dragItems. This will only be called if\n\tonHoverStartGetAccept has returned True for these dragItems.\n\n\tArgs:\n\t\tcomp: the Component being hovered over\n\t\tinfo: A dictionary containing all info about drop, including:\n\t\t\tdragItems: a list of objects being dragged over comp\n\n\tReturns:\n\t\tA dictionary of results with descriptive keys. Most commonly:\n\t\t{'createdOPs':[list of created ops in order of corresponding drag item]}\n\t\"\"\"\n\tdragItems = info['dragItems']\n\tretValue = ext.SubWidgetExt.RaiseDragDrop(comp, info) \n\tif retValue is not None:\n\t\treturn retValue\n\tif comp == parent():\n\t\ttoTab = len(parent.Widget.par.Value0.menuNames) \n\telif comp.par.parentshortcut == 'Tab':\n\t\ttoTab = comp.par.Index.eval()  \n\telse:\n\t\ttoTab = comp.parent.Tab.par.Index.eval()\n\tfromTab = dragItems[0].index\n\tval = parent.Widget.par.Value0.eval()\n\tif parent.Widget.par.Folderreorderscript.enable and \\\n\t\t\t\t\t\t\t\tparent.Widget.par.Folderreorderscript.eval():\n\t\tretValue = eval(parent.Widget.par.Folderreorderscript.eval(), \n\t\t\t\t\t\t\t\t\t{'fromIndex': fromTab, 'toIndex':toTab})\n\telse:\n\t\tretValue = None\n\tif retValue is None:\n\t\tmenuNames = tdu.split(parent.Widget.par.Menunames)\n\t\tmenuLabels = tdu.split(parent.Widget.par.Menulabels)\n\t\tif menuLabels:\n\t\t\tlabels = tdu.split(parent.Widget.par.Menulabels)\n\t\t\tif labels:\n\t\t\t\twhile len(labels) < len(menuNames):\n\t\t\t\t\tlabels.append(menuNames[len(labels)])\n\t\tmenuNames.insert(toTab, menuNames.pop(fromTab))\n\t\tparent.Widget.par.Menunames = ' '.join([repr(n) for n in menuNames])\n\t\tif menuLabels:\n\t\t\tlabels.insert(toTab, labels.pop(fromTab))\n\t\t\tparent.Widget.par.Menulabels = ' '.join([repr(n) for n in labels])\n\t\tif parent.Widget.par.Folderhelpstrings.mode == ParMode.CONSTANT:\n\t\t\thelpStrings = tdu.split(parent.Widget.par.Folderhelpstrings)\n\t\t\tif helpStrings:\n\t\t\t\twhile len(helpStrings) < len(menuNames):\n\t\t\t\t\thelpStrings.append('')\n\t\t\t\thelpStrings.insert(toTab, helpStrings.pop(fromTab))\n\t\t\t\tparent.Widget.par.Folderhelpstrings = \\\n\t\t\t\t\t\t\t\t\t\t' '.join([repr(n) for n in helpStrings])\n\tif parent.Widget.par.Value0.mode in (ParMode.CONSTANT, ParMode.BIND):\n\t\tparent.Widget.par.Value0 = val\n\tparent.Widget.cook(force=True, recurse=True)\n\treturn { 'dropped': dragItems[0], 'droppedOn' : comp }\n\ndef onDragStartGetItems(comp, info):\n\t\"\"\"\n\tCalled when information about dragged items is required.\n\n\tArgs:\n\t\tcomp: the panel Component that is being dragged\n\t\tinfo: A dictionary containing all info about drag\n\n\tReturns:\n\t\tA list of dragItems:
              [object1, object2, ...]\n\t\"\"\"\n\tretValue = ext.SubWidgetExt.RaiseDragDrop(comp, info) \n\tif retValue is not None:\n\t\treturn retValue\n\tif parent.Widget.par.Folderdragtoreorder:\n\t\tif comp.par.parentshortcut == 'Tab':\n\t\t\tindex = comp.par.Index.eval()\n\t\telse:\n\t\t\tindex = comp.parent.Tab.par.Index.eval()\n\t\titems = [Tab(index)]\n\t\t#debug(items)\n\t\treturn items\n\ndef onDragEnd(comp, info):\n\t\"\"\"\n\tCalled when a drag action ends.\n\n\tArgs:\n\t\tcomp: the panel Component that was being dragged\n\t\tinfo: A dictionary containing all info about drag, including:\n\t\t\taccepted: True if the drag was accepted\n\t\t\tdropResults: a dict of drop results. This is the return value of \n\t\t\t\tonDropGetResults\n\t\t\tdragItems: a list of objects being dragged over comp\n\t\"\"\"\n\tretValue = ext.SubWidgetExt.RaiseDragDrop(comp, info) \n\tif retValue is not None:\n\t\treturn retValue\n"
            dat_content_format: text
          - name: keyboardin1_callbacks
            type: textDAT
            parameters:
              language: input
            flags:
            - viewer
            position: [-900, -400]
            size: [130, 90]
            color: [0.05, 0.5, 0.05]
            dock: kbTabControl
            dat_content: "# me - This DAT\n# \n# dat - The DAT that received the key event\n# key - The name of the key attached to the event.\n#\t\tThis tries to be consistent regardless of which language\n#\t\tthe keyboard is set to. The values will be the english/ASCII\n#\t\tvalues that most closely match the key pressed.\n#\t\tThis is what should be used for shortcuts instead of 'character'.\n# character - The unicode character generated.\n# alt - True if the alt modifier is pressed\n# ctrl - True if the ctrl modifier is pressed\n# shift - True if the shift modifier is pressed\n# state - True if the event is a key press event\n# time - The time when the event came in milliseconds\n# cmd - True if the cmd modifier is pressed\n\ndef onKey(dat, key, character, alt, lAlt, rAlt, ctrl, lCtrl, rCtrl, shift, lShift, rShift, state, time, cmd, lCmd, rCmd):\n\tif not ctrl or not state:\n\t\treturn\n\ttabs = [int(i.val) for i in op('menuOptions').col('index')[1:]]\n\ttry:\n\t\tindex = tabs.index(parent.Widget.par.Value0.menuIndex)\n\t\tif shift:\n\t\t\tif index:\n\t\t\t\tparent.Widget.par.Value0 = tabs[index-1]\n\t\telse:\n\t\t\tif index + 1 < len(tabs):\n\t\t\t\tparent.Widget.par.Value0 = tabs[index+1]\n\t\t\t\n\texcept:\n\t\tpass\n\t\n\n# shortcutName is the name of the shortcut\n\ndef onShortcut(dat, shortcutName, time):\n\treturn;\n\t"
            dat_content_format: text
          - name: panelexecDeleteButtons
            type: panelexecuteDAT
            parameters:
              fromop: =me.parent()
              panels: tab*/deleteButton
              panelvalue: lselect
              offtoon: false
              ontooff: true
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [-1100, -100]
            size: [130, 90]
            color: [0.05, 0.5, 0.05]
            dat_content: "def onToOff(panelValue):\n\tif not panelValue.owner.panel.rollover:\n\t\treturn\n\tif parent.Widget.par.Folderdeletescript:\n\t\texec(parent.Widget.par.Folderdeletescript.eval(), \n\t\t\t\t{'index':panelValue.owner.parent().par.Index.eval()})\n\telse:\n\t\traise Exception('Missing Delete Script (\"index\" '\n\t\t\t\t\t\t\t'contains tab index to delete)')\n\n"
            dat_content_format: text
