              label: =me.name
            flags:
            - viewer
            position: [460, 70]
            size: [130, 90]
            inputs:
            - gyroid_glsl
          - name: glsl1_info
            type: infoDAT
            parameters:
              op: gyroid_glsl
            flags:
            - viewer
            position: [360, -95]
            size: [130, 90]
            dock: gyroid_glsl
            dat_read_only: true
          - name: glsl1_pixel
            type: textDAT
            parameters:
              language: glsl
              extension: frag
            flags:
            - viewer
            position: [200, -95]
            size: [130, 90]
            dock: gyroid_glsl
            dat_content: "uniform vec3 u_transform, u_rotate;\nuniform vec2 u_thresh;\nuniform float u_period, u_amp, u_offset;\n\nvec2 rotate(vec2 p, float theta) {\n\t\n\ttheta = radians(theta);\n    float s = sin(theta);\n    float c = cos(theta);\n    mat2 m = mat2(c, s, -s, c);\n    return m * p;\n}\n\nout vec4 fragColor;\nvoid main()\n{\n\tvec3 p = texture(sTD2DInputs[0], vUV.st).xyz;\n\tp.xy = rotate(p.xy, u_rotate.x);\n\tp.yz = rotate(p.yz, u_rotate.y);\n\tp.zx = rotate(p.zx, u_rotate.z);\n\t\n\tp *= 10.0/u_period;\n\tp -= u_transform;\n\t\n\t\n\tfloat gyroid = dot(sin(p), cos(p.zxy));\n\t\n\tgyroid *= u_amp;\n\tgyroid += u_offset;\n\t\n\tgyroid = smoothstep(u_thresh.x, u_thresh.y, gyroid);\n\t\n\tvec4 color = vec4(gyroid);\n\tfragColor = TDOutputSwizzle(color);\n}\n"
            dat_content_format: text
          - name: gyroid_glsl
            type: glslTOP
            parameters:
              pixeldat: glsl1_pixel
              computedat: glsl1_compute
              format: mono32float
            sequences:
              vec:
              - name: u_period
                valuex: =parent().par.Period
              - name: u_transform
                valuex: =parent().par.Transformx
                valuey: =parent().par.Transformy
                valuez: =parent().par.Transformz
                valuew: =parent().par.Transformz
              - name: u_rotate
                valuex: =parent().par.Rotatedegreesx
                valuey: =parent().par.Rotatedegreesy
                valuez: =parent().par.Rotatedegreesz
                valuew: =parent().par.Rotatedegreesz
              - name: u_amp
                valuex: 1
                valuey: 1
                valuez: 1
                valuew: 1
              - name: u_offset
                valuex: 0
                valuey: 1
                valuez: 1
                valuew: 1
              - name: u_thresh
                valuex: =parent().par.Bottomthreshold
                valuey: =parent().par.Topthreshold
                valuez: 1
                valuew: 1
            flags:
            - viewer
            position: [200, 25]
            size: [130, 90]
            inputs:
            - in1
