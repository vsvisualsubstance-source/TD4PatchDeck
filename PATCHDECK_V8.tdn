          justifyh: left
          justifyv: top
          clone: =op.TDBasicWidgets.op('buttonMomentary') if hasattr(op, 'TDBasicWidgets') else ''
        sequences:
          ext:
          - promote: true
        custom_pars:
          Values:
            $t: values_17
            Value0: ~op('control_ui').par.B2
            Valname0: =me.name
          Label:
            $t: label_7
            Labeldisplay: false
            Labelalignx: center
          Button:
