              size: [130, 90]
              dat_read_only: true
            - name: knobBg
              type: selectTOP
              parameters:
                top: =parent.Widget.par.Knobbgtop.eval() or ''
              flags:
              - viewer
              position: [0, -400]
              size: [130, 90]
            - name: KnobExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass KnobExt(SubWidgetExt):\n\t\"\"\"\n\tKnobExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Knob'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\t\tself.knobRotateRateScale = parent.Widget.par.Knobsensitivity.eval()\n\t\tself.lastv = None\n\t\tself.normMin = parent.Widget.par.Value0.normMin\n\t\tself.normMax = parent.Widget.par.Value0.normMax\n\t\t#debug(normMin, normMax)\n\t\tself.knobRotateRateScale = self.KnobRotateScale\n\t\tself.cVal = None\n\n\n\tdef UpdateAttributes(self):\n\t\t\"\"\"\n\t\tUpdates attributes after changes to widget parameter values\n\t\t\"\"\"\n\t\tself.knobRotateRateScale = parent.Widget.par.Knobsensitivity.eval()\n\t\tself.normMin = parent.Widget.par.Value0.normMin\n\t\tself.normMax = parent.Widget.par.Value0.normMax\n\t\tself.knobRotateRateScale = self.KnobRotateScale\n\n\t@property\n\tdef KnobRotateScale(self):\n\t\treturn float(op('knobRotateScale')[0,0].val)\n\t\t# return (parent.Widget.par.Knobsensitivity.eval()) * \\\n\t\t# \t\t\t\t\t\t\t\t\t(self.normMax-self.normMin) * \\\n\t\t# \t\t\t\t\t\t\t\t\t(parent.Widget.height/512)\n\n\tdef Select(self, panelValue):\n\t\t\"\"\"\n\t\tFirst click on knob sets offset location\n\t\t\"\"\"\n\t\tself.knobRotateRateScale = self.KnobRotateScale\n\t\tif panelValue.name == 'select':\n\t\t\tidNum = panelValue.owner.digits\n\t\t\tself.cVal = getattr(parent.Widget.par, 'Value'+ str(idNum)).eval()\n\t\t\tself.lastV = (panelValue.owner.panel.v.val*self.knobRotateRateScale)\n\n\tdef ValueChange(self, panelValue):\n\t\t\"\"\"\n\t\tManages value change using previous value and offset\n\t\t\"\"\"\n\t\tif panelValue.name == 'v':\n\t\t\tidNum = panelValue.owner.digits\n\t\t\t#lastV = me.fetch('lastv')\n\t\t\tnewV = panelValue.val*self.knobRotateRateScale\n\t\t\t#debug('newV', newV)\n\t\t\tincr = newV-self.lastV\n\t\t\t#debug('incr', incr)\n\t\t\t#widgetCValue = getattr(parent.Widget.par, 'Value'+ str(idNum)).eval()\n\t\t\t#widgetNValue = widgetCValue + incr\n\t\t\t\n\t\t\twidgetNValue = self.cVal + incr\n\t\t\t#parent.Widget.SetValue(widgetNValue, index = idNum)\n\t\t\tsetattr(parent.Widget.par, 'Value'+ str(idNum), widgetNValue)\n\t\t\t#debug('cValue', widgetCValue, incr)\n\t\t\tself.lastV = newV\n\t\t\tself.cVal = widgetNValue\n\t\t\t#debug(knobRotateRateScale )\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name[:5] in ['Defau',\n\t\t\t\t\t\t\t\t'Normm',\n\t\t\t\t\t\t\t\t'Clamp',\n\t\t\t\t\t\t\t\t'Minma'] \\\n\t\t\t\t\tor par.name == 'Knobsensitivity':\n\t\t\tself.UpdateAttributes()\n\t\telse:\n\t\t\tSubWidgetExt.onParSettingsChange(self, par, prev)\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tOn panel event\n\t\t\"\"\"\n\t\tif event == 'valueChange':\n\t\t\t#debug('vc', panelValue.name)\n\t\t\tparent().ValueChange(panelValue)\n\t\telif event == 'offToOn':\n\t\t\t#debug('oo', panelValue.name)\n\t\t\tparent().Select(panelValue)"
              dat_content_format: text
            - name: switch1
              type: switchTOP
              parameters:
                index: =parent.Widget.par.Cacheactive
              flags:
              - viewer
              position: [600, -300]
              size: [130, 90]
              inputs:
              - knobWidgetShader
              - cacheselect1
            - name: switch2
              type: switchTOP
              parameters:
                blend: =parent.Widget.par.Cacheoptimized
              flags:
              - viewer
              position: [800, -400]
              size: [130, 90]
              inputs:
              - switch1
              - cacheselect1
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [200, 400]
              size: [160, 130]
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: cacheselect1
              type: cacheselectTOP
              parameters:
                cachetop: =parent.Widget.par.Widgetcachecomp.eval().op('cache') if parent.Widget.par.Widgetcachecomp.eval() else ''
                index: =((parent.Widget.par.Value0.eval()-parent.Widget.par.Value0.normMin) * (0 - -parent.Widget.par.Widgetcachecomp.eval().par.Indexrange)) / (parent.Widget.par.Value0.normMax-parent.Widget.par.Value0.normMin) + -parent.Widget.par.Widgetcachecomp.eval().par.Indexrange if parent.Widget.par.Widgetcachecomp.eval() else 0
                resolutionw: =op('label').width
                resolutionh: =op('label').height
              flags:
              - viewer
              position: [200, -500]
              size: [130, 90]
            - name: glslKnobWidget
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [200, -100]
              size: [130, 90]
              dat_content: "//This shader creates a knob ui element\n\nuniform float rangeGapAngle;\nuniform vec3 indicatorAndDialInset; //\nuniform float knobRadius;\nuniform vec4 knobRangeColor;\nuniform vec4 knobLevelColor;\nuniform vec4 knobDialColor;\nuniform vec4 knobBgColor;\nuniform float knobNormValue;\nuniform float defaultValue;\nuniform int knobIndicatorDir;\nuniform float offset;\nuniform float offset2;\nuniform vec2 minMax;\nuniform float knobValue;\nuniform float knotchWidth;\nuniform vec4 knotchColor;\nuniform float knotchLength;\n\nuniform float rot;\n\nconst float PI = 3.141592653589793238462643383;\n\nuniform sampler2D sInputs0;\n\nlayout(location = 0) out vec4 fragColor;\n\n// functions\nmat2 rotate2d(float _angle){\n    return mat2(cos(_angle),-sin(_angle),\n                sin(_angle),cos(_angle));\n}\n\nfloat box(in vec2 _st, in vec2 _size){\n    _size = vec2(0.5) - _size*0.5;\n    vec2 uv = smoothstep(_size,\n                        _size+vec2(0.001),\n                        _st);\n    uv *= smoothstep(_size,\n                    _size+vec2(0.001),\n                    vec2(1.0)-_st);\n    return uv.x*uv.y;\n}\n\nfloat circle(in vec2 uv, in float radius) {\n    vec2 dist = uv-vec2(0.5);\n    //radius = 1.0;\n    return 1.0-smoothstep(radius-(radius*0.01 ),\n            radius+(radius*0.01), dot(dist,dist)*4.0);\n}\n\nfloat atan2(in float y, in float x) {\n    return x == 0.0 ? sign(y)*PI/2 : atan(y, x);\n}\n\nvec4 circle2(vec2 uv, vec2 pos, float rad, vec4 color) {\n  vec2 dist = uv-vec2(0.5);\n  float d1 = length(pos - uv) - rad;\n  float d2 = length(pos - uv) - rad+0;\n\tfloat t = clamp(d1, 0.0, 1.0);\n\n\treturn vec4(color.rgb, (1.0 - t)*color.a);\n}\n\nvec4 circle3(vec2 _st, float _radius, vec4 color){\n  vec2 dist = _st-vec2(0.5); //_st-vec2(0.5);\n  //_radius = 0.2;\n  //_radius = 1.0;\n  float circ = 1.-smoothstep(_radius-(_radius*0.015),\n                         _radius+(_radius*0.015),\n                         dot(dist,dist)*4.0);\n  return circ*color;\n}\n\nfloat aastep(float threshold, float value) {\n  float afwidth = 0.7 * length(vec2(dFdx(value), dFdy(value)));\n  return smoothstep(threshold-afwidth, threshold+afwidth, value);\n}\n\nvec4 over(vec4 tOver, vec4 tUnder)\n{\n    return ((1.0-tOver.a)*tUnder) + (tOver*tOver.a);\n}\n\nvec4 atop(vec4 tOver, vec4 tUnder)\n{\n    return ((1.0-tOver.a)*tUnder) + tOver.a * tOver;\n}\n\nfloat map(float s, float a1, float a2, float b1, float b2)\n{\n    return b1 + (s-a1)*(b2-b1)/(a2-a1);\n}\n\nvec2 rotateUV(float offset, vec2 uv)\n{\n    float rot = offset;\n    uv-=.5;\n    mat2 m = mat2(cos(rot), -sin(rot), sin(rot), cos(rot));\n    uv  = m * uv;\n\n    uv+=.5;\n    return uv;\n}\n\nvec2 cartPolar(vec2 p) {\n    return vec2(atan((p).y, (p).x), length(p));\n}\n\nvoid main() {\n\n\tvec2 fragCoord = gl_FragCoord.xy;\n\tvec2 res = uTDOutputInfo.res.zw;\n\tfloat fit = max(res.x-3, res.y-3)/2;\n\n    float rotInd = radians(map(knobValue, minMax.x,\n                            minMax.y, rangeGapAngle, 360-rangeGapAngle));\n    float rotMidPoint = radians(map(((minMax.x+minMax.y)/2), minMax.x,\n                            minMax.y, rangeGapAngle, 360-rangeGapAngle));\n    float rotDefault = radians(map(defaultValue, minMax.x, minMax.y,\n                                        rangeGapAngle, 360-rangeGapAngle));\n\n\n    vec2 xUV = rotateUV(rotMidPoint, vUV.st);\n    float zoneWipe = (atan2((xUV.s-0.5), xUV.t-0.5));\n\n    //maps atan2 output from 0-180 to continuous 0-360\n    if ( sign(zoneWipe)<0 ){\n        zoneWipe = map(zoneWipe, radians(-180), radians(0),\n                                            radians(180.), radians(360));\n    }\n\n    float rangeGap = radians(rangeGapAngle);\n    float range360 = radians(360);\n\n    float rangeZone = zoneWipe > rangeGap &&\n                        zoneWipe < (range360 - rangeGap)  ? 1.0 : 0.0;\n\n    float indZone = 0;\n    if ( knobValue < defaultValue ){\n        indZone = zoneWipe > rotInd && zoneWipe < rotDefault ? 1.0 : 0.0;\n    }\n    else if ( knobValue > defaultValue ){\n        indZone = zoneWipe
                < rotInd && zoneWipe > rotDefault ? 1.0 : 0.0;\n    }\n\n\n    vec2 iUV = rotateUV(-rotInd, vUV.st);\n    //vec4 textLayer = texture(sTD2DInputs[0], vUV.st);\n\tvec4 knobLayer = texture(sTD2DInputs[0], iUV);\n    vec4 bgLayer = texture(sTD2DInputs[1], vUV.st);\n\n    float knobDialScale = indicatorAndDialInset.x;\n    float knobRangeScale = indicatorAndDialInset.y;\n    float knobLevelScale = indicatorAndDialInset.z;\n\n    vec4 color = vec4(knobBgColor.rgb * knobBgColor.a, knobBgColor.a);\n    color = over(bgLayer, color);\n\n    //vec4 knobDial = circle2(fragCoord, res/2,\n    //                                    fit*(knobDialScale), knobDialColor);\n    //vec4 knobDial = circle3(fragCoord/res,\n    //                                    knobDialScale, knobDialColor);\n\n    vec4 knobDial = circle2(fragCoord, res/2,\n                              (fit*knobDialScale), knobDialColor);\n\n    //vec4 knobDialCut = circle3(fragCoord/res,\n    //                         knobDialScale-0.02, knobDialColor);\n\n    vec4 knobDialCut = circle2(fragCoord, res/2,\n                            (fit*knobDialScale-1), knobDialColor);\n\n    vec4 knobRange = circle2(fragCoord, res/2,\n                                        (fit*knobRangeScale), knobRangeColor);\n    knobRange = (knobRange * rangeZone) * floor(1-knobDialCut.a);\n\n    vec4 knobLevel = circle2(fragCoord, res/2,\n                                        fit*knobLevelScale, vec4(1.0,1.0,1.0,1.0))*floor(1-knobDialCut.a);\n    vec4 knotchLayer = circle2(fragCoord, res/2,\n                                        fit*knobDialScale, knotchColor);\n    vec4 knotchMask = circle2(fragCoord, res/2,\n                                    fit*knobDialScale-knotchLength, vec4(1.0));\n    //knotchLayer = knotchLayer * knotchZone;\n    float knotchScaler = (1-knotchLength)*(knobDialScale/2);\n    float knotchVal = box(vec2(iUV.x,iUV.y+(knobLevelScale/4)+knotchScaler),\n                                vec2(knotchWidth/20,knobLevelScale/2));\n    vec4 knotch = knotchColor*knotchVal*knobLevel.a;\n\n    knobLevel = knobLevel * indZone;\n    color = atop(knobRange, color);\n    color = atop(knobLevel*knobLevelColor, color);\n    color = atop(knobDial, color);\n    color = atop(knobLayer, color);\n    color = atop(knotch, color);\n    //color = over(textLayer, color);\n\n    //color = over(knotchLayer*(1-knotchMask), color);\n\tfragColor = color;\n\t//fragColor = ind;\n\n}\n"
              dat_content_format: text
            - name: knobRotateScale
              type: evaluateDAT
              parameters:
                expr: parent.Widget.par.Knobsensitivity.eval() * (parent.Widget.par.Value0.normMax-parent.Widget.par.Value0.normMin) * (parent.Widget.height/512)
                rowindexend: =me.inputTable.numRows - 1
                colindexend: =me.inputTable.numCols - 1
              position: [0, 400]
              dat_read_only: true
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-200, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: panelexecValueX
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: =parent()
                panelvalue: ='select ' + 'v'
                valuechange: true
                defaultreadencoding: cp1252
                language: input
              position: [-200, 0]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              - -showDocked
              position: [200, 50]
              size: [160, 130]
              dock: text
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
            - name: knobWidgetShader
              type: glslTOP
              parameters:
                pixeldat: glslKnobWidget
                autodispatchsize: false
                dispatchsizey: 1
                clearoutputs: false
                outputresolution: custom
                resolutionw: =parent().height
                resolutionh: =parent().height
                format: rgba8fixed
              sequences:
                vec:
                - name: indicatorAndDialInset
                  valuex: =parent.Widget.par.Knobdialscale.eval()
                  valuey: =parent.Widget.par.Knobrangescale.eval()
                  valuez: =parent.Widget.par.Knoblevelscale.eval()
                - name: minMax
                  valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).normMin
                  valuey: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).normMax
                - name: rangeGapAngle
                  valuex: =parent.Widget.par.Knobrangegapangle.eval()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knobRangeColor
                  valuex: =parent.Widget.par.Knobrangecolorr.eval()
                  valuey: =parent.Widget.par.Knobrangecolorg.eval()
                  valuez: =parent.Widget.par.Knobrangecolorb.eval()
                  valuew: =parent.Widget.par.Knobrangecolora.eval()
                - name: knobLevelColor
                  valuex: =parent.Widget.par.Knoblevelcolorr.eval()
                  valuey: =parent.Widget.par.Knoblevelcolorg.eval()
                  valuez: =parent.Widget.par.Knoblevelcolorb.eval()
                  valuew: =parent.Widget.par.Knoblevelcolora.eval()
                - name: knobDialColor
                  valuex: =parent.Widget.par.Knobdialcolorr.eval()
                  valuey: =parent.Widget.par.Knobdialcolorg.eval()
                  valuez: =parent.Widget.par.Knobdialcolorb.eval()
                  valuew: =parent.Widget.par.Knobdialcolora.eval()
                - name: knobBgColor
                  valuex: 0
                - name: knobIndicatorDir
                  valuex: 1
                - name: knotchWidth
                  valuex: =parent.Widget.par.Knotchwidth.eval()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knotchLength
                  valuex: =parent.Widget.par.Knotchlength.eval()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knobNormValue
                  valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).evalNorm()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: defaultValue
                  valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).default
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knobBaseColor
                  valuex: 0
                  valuew: 1
                - name: offset
                  valuex: 0
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: offset2
                  valuex: 0
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knobValue
                  valuex: =parent.Widget.par.Value0.eval()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knotchColor
                  valuex: =parent.Widget.par.Knotchcolorr.eval()
                  valuey: =parent.Widget.par.Knotchcolorg.eval()
                  valuez: =parent.Widget.par.Knotchcolorb.eval()
                  valuew: =parent.Widget.par.Knotchcolora.eval()
              flags:
              - render
              - viewer
              position: [200, -300]
              size: [130, 90]
              inputs:
              - knob
              - knobBg
            - name: parexecSettingsX
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Knobcustomizeinteraction Default0 Norm* Clamp* Min* Knobsensitivity Knobhoriz* Knobvert*
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_13
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: valueOut
            type: outCHOP
            parameters:
              label: =me.name
              autoexportroot: =parent()
            position: [400, 0]
            inputs:
            - output
        - name: masterList
          type: widgetCOMP
          parameters:
            w: 450
            h: 128
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            bgcolorr: 0.2
            bgcolorg: 0.2
            bgcolorb: 0.2
            bgalpha: 1
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            topborder: bordera
            borderover: false
            align: horizlr
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('masterList') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
            - {}
            - {}
            - {}
            iop:
            - {}
            - {}
          custom_pars:
            Lister:
            - name: Refresh
              style: Pulse
            - name: Helppage
              style: Pulse
              label: Help Page
              startSection: true
            - name: Editconfigcomp
              style: Pulse
              label: Edit Config COMP
            - name: Editcoldefine
              style: Pulse
              label: Edit Column Definitions
              enableExpr: not me.par.Autodefinecols.eval()
            - name: Editcallbacks
              style: Pulse
              label: Edit Callbacks
            - name: Printcallbacks
              style: Toggle
              label: Print Callbacks
            - name: Inputtabledat
              style: DAT
              label: Input Table DAT
              startSection: true
            - name: Refreshoninputchange
              style: Toggle
              label: Refresh On Input Change
            - name: Inputtablehasheaders
              style: Toggle
              label: Input Table Has Headers
            - name: Autosyncinputtable
              style: Toggle
              label: Auto-sync Input Table
              enableExpr: me.par.Inputtabledat.eval() is not None and me.par.Inputtablehasheaders.eval()
              enable: false
            - name: Autodefinecols
              style: Toggle
              label: Auto-define Columns
              startSection: true
            - name: Recreateautocolumns
              style: Pulse
              label: Recreate Auto-columns
            - name: Copyautocolstoconfig
              style: Pulse
              label: Copy Auto Cols To Config
            - name: Header
              style: Toggle
              label: Show Header
              startSection: true
              default: true
            - name: Clickableheader
              style: Toggle
              label: Clickable Header
              enableExpr: me.par.Header.eval() and me.par.Header.enable
            - name: Selectablerows
              style: Toggle
              label: Selectable Rows
              default: true
            - name: Multiplerowselect
              style: Toggle
              label: Multiple Row Select
              enableExpr: me.par.Selectablerows.eval()
            - name: Dragtoreorderrows
              style: Toggle
              label: Drag To Reorder Rows
              enableExpr: me.par.Selectablerows.eval()
            - name: Arrowkeys
              style: Toggle
              label: Arrow Keys
              enableExpr: me.par.Selectablerows.eval()
            - name: Deletekey
              style: Toggle
              label: Delete Key
              enableExpr: me.par.Selectablerows.eval()
            - name: Highlightrollover
              style: Toggle
              label: Highlight Rollover
              default: true
            - name: Rowstriping
              style: Menu
              label: Row Striping
              default: None
              menuNames:
              - None
              - Striping
              - Dividing_Line
              menuLabels:
              - None
              - Striping
              - Dividing Line
            - name: Drophighlight
              style: Menu
              label: Drop Highlight
              default: 'Off'
              menuNames:
              - 'Off'
              - Above_Row
              - Below_Row
              - Row
              - Cell
              menuLabels:
              - 'Off'
              - Above Row
              - Below Row
              - Row
              - Cell
            Sort/Filter/Select:
              $t: sort/filter/select
            Advanced:
            - name: Allowundo
              style: Toggle
              label: Allow Undo
              default: true
            - name: Advancedcallbacks
              style: Toggle
              label: Do Advanced Callbacks
            - name: Rawdata
              style: Python
              label: Raw Data
              default: '[]'
              defaultExpr: None
              defaultMode: EXPRESSION
              value: =[]
            - name: Linkedtable
              style: DAT
              label: Linked Table DAT
            - name: Lockconfigs
              style: Toggle
              label: Lock Configs
              startSection: true
              default: true
            - name: Configcomp
              style: COMP
              label: Config Comp
              default: masterListConfig
            - name: Callbackdat
              style: DAT
              label: Callback DAT
              default: masterListConfig/callbacks
              value: =me.par.Configcomp.eval().op('callbacks')
            Colors:
            - name: Listercellheight
              style: Int
              label: Lister Cell Height
              default: 25
              min: 1.0
              max: 64.0
              clampMin: true
              normMin: 1.0
              normMax: 64.0
            - name: Listerfontsize
              style: Int
              label: Items Font Size
              startSection: true
              default: 10
            - name: Listerbasecolor
              style: RGBA
              label: Base Color
              startSection: true
              default: [0.1, 0.1, 0.1, 1]
            - name: Listerheadercolor
              style: RGBA
              label: Header Color
              startSection: true
              default: [0.15, 0.15, 0.15, 1]
            - name: Listerheaderfontcolor
              style: RGBA
              label: Header Font Color
              default: [0.8, 0.8, 0.8, 1]
            - name: Listerheaderfontbold
              style: Toggle
              label: Header Font Bold
              default: true
            - name: Listeritemscolor
              style: RGBA
              label: Items Color
              startSection: true
              default: [0.7, 0.7, 0.7, 1]
            - name: Listerodditemscolor
              style: RGBA
              label: Odd Items Color
              default: [0.45, 0.45, 0.45, 1]
            - name: Listeritemsfontcolor
              style: RGBA
              label: Items Font Color
              default: [0.1, 0.1, 0.1, 1]
            - name: Listeritemsfontbold
              style: Toggle
              label: Items Font Bold
            - name: Listerrowselectcolor
              style: RGBA
              label: Row Select Color
              startSection: true
              default: [0.621699, 0.677373, 0.741, 1]
            - name: Listerrowselectfontcolor
              style: RGBA
              label: Row Select Font Color
              default: [0, 0.2295, 0.459, 1]
            - name: Listerrowselectfontbold
              style: Toggle
              label: Row Select Font Bold
            - name: Listerrowrollcolor
              style: RGBA
              label: Row Roll Color
              startSection: true
              default: [0.75, 0.75, 0.75, 1]
            - name: Listerrowrollfontcolor
              style: RGBA
              label: Row Roll Font Color
              default: [0.1, 0.1, 0.1, 1]
            - name: Listerbuttonoffcolor
              style: RGBA
              label: Button Off Color
              startSection: true
              default: [0.7, 0.7, 0.7, 1]
            - name: Listerbuttonrollcolor
              style: RGBA
              label: Button Roll Color
              default: [0.8, 0.8, 0.8, 1]
            - name: Listerbuttononcolor
              style: RGBA
              label: Button On Color
              default: [0, 0, 0, 1]
            - name: Listerbuttonofffontcolor
              style: RGBA
              label: Button Off Font Color
              default: [0.2, 0.2, 0.2, 1]
            - name: Listerbuttonrollfontcolor
              style: RGBA
              label: Button Roll Font Color
              default: [0, 0, 0, 1]
            - name: Listerbuttononfontcolor
              style: RGBA
              label: Button On Font Color
              default: [0, 0, 0, 1]
            - name: Listerbuttonfontbold
              style: Toggle
              label: 'Button Font Bold '
            Widget:
            - name: Enablerollover
              style: Toggle
              label: Enable Rollover
              startSection: true
              default: true
            - name: Rollovercolor
              style: RGBA
              label: Rollover Color
              default: [0.9, 0.9, 0.9, 0.15]
              enableExpr: me.par.Enablerollover.eval()
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
              menuNames:
              - over
              - under
              - inside
              - outside
              - add
              - subtract
              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
              enableExpr: me.par.Enablerollover.eval()
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: [0.2, 0.2, 0.2, 0.65]
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              enableExpr: not me.par.Fontfile
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: masterList
              enable: false
            OPs:
            - name: Lister
              style: COMP
              label: lister
              default: ./list/lister
              readOnly: true
            About:
              $t: about_5
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -1800]
          size: [160, 130]
          children:
          - name: in1
            type: inDAT
            parameters:
              label: =me.name
            position: [0, -200]
            dat_read_only: true
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: list
            type: containerCOMP
            parameters:
              hmode: fill
              vmode: fill
              helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
              resizecomp: =me
              borderover: false
              parentshortcut: List
              enablecloning: false
            sequences:
              ext:
              - object: op('./SubWidgetExt').module.SubWidgetExt(me)
                promote: true
            flags:
            - viewer
            position: [200, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDSubComp
            inputs:
            - in1
            children:
            - name: in1
              type: inDAT
              parameters:
                label: =me.name
              position: [-150, 0]
              dat_read_only: true
            - name: out1
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [200, 100]
              size: [130, 90]
              inputs:
              - lister
              dat_read_only: true
            - name: out2
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [200, -50]
              size: [130, 90]
              inputs:
              - source: lister
                out: 1
              dat_read_only: true
            - name: lister
              type: listCOMP
              parameters:
                callbacks: ./internalCallbacks
                rows: =ext.ListerExt.nRows if me.extensionsReady else 0
                cols: =ext.ListerExt.nCols if me.extensionsReady else 0
                lockfirstrow: =me.par.Header
                offcellcallbacks: true
                w: 30
                h: 30
                hmode: fill
                vmode: fill
                alignorder: =-me.nodeY
                sizefromwindow: true
                clickthrough: true
                mouserel: true
                resizecomp: =me
                repocomp: =me
                bgcolorr: =parent.Widget.par.Listerbasecolorr
                bgcolorg: =parent.Widget.par.Listerbasecolorg
                bgcolorb: =parent.Widget.par.Listerbasecolorb
                bgalpha: =parent.Widget.par.Listerbasecolora
                borderover: false
                crop: 'on'
                dragscript: ''
                drop: legacy
                dropscript: ./dropUpdater
                parentshortcut: Lister
                opviewer: ./listOut
                clone: =op.TDTox.op('lister')
                relpath: inherit
              sequences:
                ext:
                - object: me.mod.ListerExt.ListerExt(me)
                  promote: true
                iop:
                - {}
                - {}
              custom_pars:
                Lister:
                - name: Refresh
                  style: Pulse
                  startSection: true
                  help: 'Manually refresh the lister. NOTE: This re-analyzes raw data for lister, so dynamically added lister data might disappear!'
                - name: Editconfigcomp
                  style: Pulse
                  label: Edit Config COMP
                  help: Open a network editor window for the Lister's Config Component.
                - name: Editcoldefine
                  style: Pulse
                  label: Edit Column Definitions
                  help: Open the lister's colDefine table. (Only available when Auto-define Columns is off)
                - name: Editcallbacks
                  style: Pulse
                  label: Edit Callbacks
                  help: Open a text editor for the Lister's callbacks.
                - name: Printcallbacks
                  style: Toggle
                  label: Print Callbacks
                  help: Enables debug prints of all callbacks (whether found or not) to the textport.
                  value: =parent.Widget.par.Printcallbacks
                - name: Inputtabledat
                  style: DAT
                  label: Input Table DAT
                  startSection: true
                  help: Table used as input to the lister. Wired input will override this.
                  value: =parent.Widget.par.Inputtabledat.eval() or ''
                - name: Inputtablehasheaders
                  style: Toggle
                  label: Input Table Has Headers
                  default: true
                  help: If True, the first row of the input table will be treated as column headers. For this to work, every column must have a non-blank header.
                  enableExpr: me.par.Inputtabledat.eval() and not me.par.Header.eval()
                  enable: false
                  value: =parent.Widget.par.Inputtablehasheaders
                - name: Refreshoninputchange
                  style: Toggle
                  label: Refresh On Input Change
                  help: When on, lister will be automatically refreshed when wired inputTable changes.
                  enableExpr: me.par.Inputtabledat.eval()
                  enable: false
                  value: =parent.Widget.par.Refreshoninputchange
                - name: Autosyncinputtable
                  style: Toggle
                  label: Auto-sync Input Table
                  help: 'If True, changes to the lister will be mirrored back to Input Table DAT automatically. This only works for columns with the following sourceDataModes: int, float, string, version, blank, color. Only available when Input Table DAT is defined via parameter and Input Table Has Headers is True.'
                  enableExpr: me.par.Inputtabledat.eval()
                  enable: false
                  value: =parent.Widget.par.Autosyncinputtable
                - name: Sourceindexinoutput
                  style: Toggle
                  label: Source Index In Output
                  help: If True, adds a column to the output DATs that holds the original index of the row data, from the input source. Useful for referring back to source tables after data is sorted or rearranged.
                  enableExpr: me.par.Inputtabledat.eval()
                  enable: false
                - name: Autodefinecols
                  style: Toggle
                  label: Auto-define Columns
                  startSection: true
                  help: Enables automatic generation of table columns.
                  value: =parent.Widget.par.Autodefinecols
                - name: Recreateautocolumns
                  style: Pulse
                  label: Recreate Auto-columns
                  help: Re-analyzes raw data to create automatic column definitions. This will resize column widths, among other things.
                  enableExpr: me.par.Autodefinecols.eval()
                  enable: false
                - name: Copyautocolstoconfig
                  style: Pulse
                  label: Copy Auto Cols To Config
                  help: 'Pressing this button copies the column settings created by Autodefine Columns into the lister''s custom colDefine table. This is useful for creating a starting point based on Autodefine settings. WARNING: this will destroy all current custom column settings.'
                  enableExpr: me.par.Autodefinecols.eval()
                  enable: false
                - name: Header
                  style: Toggle
                  startSection: true
                  default: true
                  help: Enables the table header.
                  value: =parent.Widget.par.Header
                - name: Sizablecols
                  style: Toggle
                  label: Sizable Cols
                  default: true
                  help: Drag edges to size columns
                  enableExpr: me.par.Header.eval() and me.par.Header.enable
                - name: Savecolresizes
                  style: Toggle
                  label: Save Col Resizes
                  help: Save resized column sizes in Column Definitions
                  enableExpr: me.par.Sizablecols.eval() and me.par.Sizablecols.enable and not me.par.Autodefinecols
                - name: Clickableheader
                  style: Menu
                  label: Clickable Header
                  default: 'False'
                  menuNames:
                  - 'Off'
                  - Set Sort and Filter Column
                  - Set Sort Column
                  - Set Filter Column
                  help: Enables click-to-sort columns feature.
                  enableExpr: me.par.Header.eval() and me.par.Header.enable
                  value: 'Off'
                - name: Selectablerows
                  style: Toggle
                  label: Selectable Rows
                  default: true
                  help: Enables selection of rows.
                  value: =parent.Widget.par.Selectablerows
                - name: Multiplerowselect
                  style: Toggle
                  label: Multiple Row Select
                  help: Enables selection of multiple rows using shift and ctrl keys. Only available when Selectable Rows is on.
                  enableExpr: me.par.Selectablerows.eval()
                  value: =parent.Widget.par.Multiplerowselect
                - name: Dragtoreorderrows
                  style: Toggle
                  label: Drag To Reorder Rows
                  help: Enables drag to reorder feature. Only available when Selectable Rows is on (rows must be selected to reorder).
                  enableExpr: me.par.Selectablerows.eval()
                  value: =parent.Widget.par.Dragtoreorderrows
                - name: Arrowkeys
                  style: Toggle
                  label: Arrow Keys
                  help: Enables moving the row selection using arrow keys. Only available when Selectable Rows is on.
                  enableExpr: me.par.Selectablerows.eval()
                  value: =parent.Widget.par.Arrowkeys
                - name: Deletekey
                  style: Toggle
                  label: Delete Key
                  help: Enables selected row deletion using Delete key. Only available when Selectable Rows is on.
                  enableExpr: me.par.Selectablerows.eval()
                  value: =parent.Widget.par.Deletekey
                - name: Highlightrollover
                  style: Toggle
                  label: Highlight Rollover
                  default: true
                  help: When on, rows will be highlighted when rolled over with the mouse. See Config Component inside for highlight colors.
                  value: =parent.Widget.par.Highlightrollover
                - name: Rowstriping
                  style: Menu
                  label: Row Striping
                  default: '''None'''
                  menuNames:
                  - None
                  - Striping
                  - Dividing_Line
                  menuLabels:
                  - None
                  - Striping
                  - Dividing Line
                  help: Striping behavior
                  value: =parent.Widget.par.Rowstriping
                - name: Drophighlight
                  style: Menu
                  label: Drop Highlight
                  default: 'Off'
                  menuNames:
                  - 'Off'
                  - Above_Row
                  - Below_Row
                  - Row
                  - Cell
                  menuLabels:
                  - 'Off'
                  - Above Row
                  - Below Row
                  - Row
                  - Cell
                  help: Defines preview when an external object is dragged into lister and defined as an acceptable drop (see onDropHover callback in Basic Callbacks). The color of the line or highlight will be defined by the dragDropLineColor or dragDropOverlayColor rows in the define table, respectively.
                  value: =parent.Widget.par.Drophighlight
                Select/Sort/Filter:
                - name: Select
                  style: Header
                - name: Saveselectedrows
                  style: Toggle
                  label: Save Selected Rows
                  help: If True, save selection state between loads and when copying/cutting/pasting component.
                - name: Saveseloninputchange
                  style: Toggle
                  label: Save Sel. On Input Change
                  help: If input table changes, save selected rows by number even if row objects are different
                - name: Allowemptyselection
                  style: Toggle
                  label: Allow Empty Selection
                  default: true
                  help: When Off, select the first row if no other row is selected.
                - name: Selectedoutput
                  style: Menu
                  label: Selected Output
                  default: Lister Data
                  menuNames:
                  - Lister Data
                  - Input Table Data
                  help: Determines contents of the out_selected component output.
                - name: Selectedrows
                  style: Str
                  label: Selected Rows
                  startSection: true
                  help: Always contains a space delimited list of the currently selected rows.
                  value: ~parent.Widget.par.Selectedrows
                - name: Sort
                  style: Header
                  startSection: true
                - name: Savesort
                  style: Toggle
                  label: Save Sort
                  default: true
                  help: If True, save sort state between loads and when copying/cutting/pasting component.
                  value: false
                - name: Usesortindicatorchars
                  style: Toggle
                  label: Use Sort Indicator Chars
                  help: If True, display the following characters in sorted column headers to indicate sort direction
                  value: true
                - name: Sortchar
                  style: Str
                  label: Sort Char
                  default: Λ
                  help: If list is sorted by a column, display this in column header after label
                  enableExpr: me.par.Usesortindicatorchars.eval()
                - name: Sortreversechar
                  style: Str
                  label: Sort Reverse Char
                  default: V
                  help: If list is reverse sorted by a column, display this in column header after label
                  enableExpr: me.par.Usesortindicatorchars.eval()
                - name: Sortcols
                  style: Str
                  label: Sort Columns
                  startSection: true
                  help: A space delimited list of columns to sort by. Note that this is set automatically when Clickable Header is set to True.
                  value: ~parent.Widget.par.Sortcols
                - name: Sortreverse
                  style: Toggle
                  label: Sort Reverse
                  help: When True, sort order is reversed.
                  value: ~parent.Widget.par.Sortreverse
                - name: Filter
                  style: Header
                  startSection: true
                - name: Savefilter
                  style: Toggle
                  label: Save Filter
                  help: If True, save filter state between loads and when copying/cutting/pasting component.
                - name: Filterstring
                  style: Str
                  label: Filter String
                  help: In order to be displayed, rows must contain the filter string in one or more of the filter columns.
                  value: ~parent.Widget.par.Filterstring
                - name: Filtercols
                  style: Str
                  label: Filter Columns
                  startSection: true
                  help: A space delimited list of columns to apply the filter to. If this is blank, no filter will be applied.
                  value: ~parent.Widget.par.Filtercols
                Advanced:
                - name: Allowundo
                  style: Toggle
                  label: Allow Undo
                  help: Enables Undo features when user edits cells and moves rows.
                  value: =parent.Widget.par.Allowundo
                - name: Advancedcallbacks
                  style: Toggle
                  label: Do Advanced Callbacks
                  help: Enables advanced callback features. See inside the internal Docs component for more information.
                  value: =parent.Widget.par.Advancedcallbacks
                - name: Rawdata
                  style: Python
                  label: Raw Data
                  defaultMode: EXPRESSION
                  help: This is a versatile parameter that can be either contain a path to a tableDAT containing data for the Lister, a python list, a python list of lists, or a python list of dictionaries. Useful for testing different kinds of input.
                  value: =parent.Widget.par.Rawdata.eval() or ''
                - name: Linkedtable
                  style: DAT
                  label: Linked Table DAT
                  help: The lister's contents will be locked to the contents of this DAT. Changes to the DAT will be reflected in Lister and vice-versa.
                  value: =parent.Widget.par.Linkedtable.eval() or ''
                - name: Lockconfigs
                  style: Toggle
                  label: Lock Configs
                  startSection: true
                  help: Turn off to allow changes to the following two parameters...
                  value: =parent.Widget.par.Lockconfigs
                - name: Configcomp
                  style: COMP
                  label: Config Comp
                  default: .
                  help: The Lister's Config Component containing format information.
                  enable: false
                  value: =parent.Widget.par.Configcomp.eval() or 'config'
                - name: Callbackdat
                  style: DAT
                  label: Callback DAT
                  default: .
                  help: The DAT containing the Lister's custom callbacks. Normally this is located in the Config Component.
                  enable: false
                  value: =parent.Widget.par.Callbackdat.eval() or 'config/callbacks'
                About:
                - name: Help
                  style: Pulse
                - name: Version
                  style: Str
                  default: 1.22.4
                  readOnly: true
                  value: 1.19.2
                - name: Toxsavebuild
                  style: Str
                  label: .tox Save Build
                  readOnly: true
                  value: '2023.31421'
              flags:
              - viewer
              size: [160, 130]
              color: [0.35, 0.05, 0.5]
              tags:
              - TDPub
              inputs:
              - in1
              palette_clone: true
            - name: opexec1
              type: opexecuteDAT
              parameters:
                op: =op('lister').par.Configcomp or ''
                childrename: true
              flags:
              - viewer
              position: [425, 100]
              dat_content: "# me - this DAT.\n# changeOp - the operator that has changed\n# \n# Make sure the corresponding toggle is enabled in the OP Execute DAT.\n\ndef onPreCook(changeOp):\n\treturn\n\ndef onPostCook(changeOp):\n\treturn\n\ndef onOPDelete():\n\tparent.List.OnDelete()\n\treturn\n\ndef onFlagChange(changeOp, flag):\n\treturn\n\ndef onWireChange(changeOp):\n\treturn\n\ndef onNameChange(changeOp):\n\treturn\n\ndef onPathChange(changeOp):\n\treturn\n\ndef onUIChange(changeOp):\n\treturn\n\ndef onNumChildrenChange(changeOp):\n\treturn\n\ndef onChildRename(changeOp):\n\treturn\n\ndef onCurrentChildChange(changeOp):\n\treturn\n\ndef onExtensionChange(changeOp, extension):\n\treturn\n\t"
              dat_content_format: text
            - name: parexec1
              type: parameterexecuteDAT
              parameters:
                active: false
                fromop: =parent()
                op: =parent.Widget
                pars: Edit*
                valuechange: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n# \n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef onValueChange(par, prev):\n\treturn\n\ndef onPulse(par):\n\t\"\"\"\n\tFirst PromoteConfigComp will check to ensure config component is properly \n\tpromoted, then it runs the requested pulse for Edit commands\n\t\"\"\"\n\tparent.List.PromoteConfigComp()\n\t#debug(par.name, 'pulse')\n\tgetattr(op('lister').par, par.name).pulse()\n\treturn\n\ndef onExpressionChange(par, val, prev):\n\treturn\n\ndef onExportChange(par, val, prev):\n\treturn\n\ndef onEnableChange(par, val, prev):\n\treturn\n\ndef onModeChange(par, val, prev):\n\treturn\n\t"
              dat_content_format: text
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 200]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: extensionParExec
              type: parameterexecuteDAT
              parameters:
                active: false
                fromop: =parent()
                op: =parent()
                pars: '*'
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 0]
              size: [130, 90]
              dat_content: "# This is a callback system for parameters. \n# to use:\n#\t- create a function in ParCallbacksExt/ParCallbacks\n#\t  using the same name as the parameter.\n\t\ndef onValueChange(par, val, prev):\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par, val, prev)\n\ndef onPulse(par):\n\t#debug(par)\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par)\n\ndef onExpressionChange(par, val, prev):\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par, val, prev)\n\ndef onExportChange(par, val, prev):\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par, val, prev)\n\ndef onEnableChange(par, val, prev):\n\treturn\n\t"
              dat_content_format: text
          - name: out1
            type: outDAT
            parameters:
              label: =me.name
            flags:
            - viewer
            position: [500, -125]
            size: [130, 90]
            inputs:
            - list
            dat_read_only: true
          - name: out2
            type: outDAT
            parameters:
              label: =me.name
            flags:
            - viewer
            position: [500, -300]
            size: [130, 90]
            inputs:
            - source: list
              out: 1
            dat_read_only: true
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: customPars
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Lister:
              - name: Refresh
                style: Pulse
              - name: Helppage
                style: Pulse
                label: Help Page
                startSection: true
              - name: Editconfigcomp
                style: Pulse
                label: Edit Config COMP
              - name: Editcoldefine
                style: Pulse
                label: Edit Column Definitions
                enableExpr: not me.par.Autodefinecols.eval()
              - name: Editcallbacks
                style: Pulse
                label: Edit Callbacks
              - name: Printcallbacks
                style: Toggle
                label: Print Callbacks
              - name: Inputtabledat
                style: DAT
                label: Input Table DAT
                startSection: true
              - name: Refreshoninputchange
                style: Toggle
                label: Refresh On Input Change
              - name: Inputtablehasheaders
                style: Toggle
                label: Input Table Has Headers
              - name: Autosyncinputtable
                style: Toggle
                label: Auto-sync Input Table
                enableExpr: me.par.Inputtabledat.eval() is not None and me.par.Inputtablehasheaders.eval()
                enable: false
              - name: Autodefinecols
                style: Toggle
                label: Auto-define Columns
                startSection: true
              - name: Recreateautocolumns
                style: Pulse
                label: Recreate Auto-columns
                enable: false
              - name: Copyautocolstoconfig
                style: Pulse
                label: Copy Auto Cols To Config
                enable: false
              - name: Header
                style: Toggle
                label: Show Header
                startSection: true
                default: true
              - name: Clickableheader
                style: Toggle
                label: Clickable Header
                enableExpr: me.par.Header.eval() and me.par.Header.enable
              - name: Selectablerows
                style: Toggle
                label: Selectable Rows
                default: true
              - name: Multiplerowselect
                style: Toggle
                label: Multiple Row Select
                enableExpr: me.par.Selectablerows.eval()
              - name: Dragtoreorderrows
                style: Toggle
                label: Drag To Reorder Rows
                enableExpr: me.par.Selectablerows.eval()
              - name: Arrowkeys
                style: Toggle
                label: Arrow Keys
                enableExpr: me.par.Selectablerows.eval()
              - name: Deletekey
                style: Toggle
                label: Delete Key
                enableExpr: me.par.Selectablerows.eval()
              - name: Highlightrollover
                style: Toggle
                label: Highlight Rollover
                default: true
              - name: Rowstriping
                style: Menu
                label: Row Striping
                default: '''None'''
                menuNames:
                - None
                - Striping
                - Dividing_Line
                menuLabels:
                - None
                - Striping
                - Dividing Line
                value: None
              - name: Drophighlight
                style: Menu
                label: Drop Highlight
                default: 'Off'
                menuNames:
                - 'Off'
                - Above_Row
                - Below_Row
                - Row
                - Cell
                menuLabels:
                - 'Off'
                - Above Row
                - Below Row
                - Row
                - Cell
              Sort/Filter/Select:
                $t: sort/filter/select
              Advanced:
              - name: Allowundo
                style: Toggle
                label: Allow Undo
              - name: Advancedcallbacks
                style: Toggle
                label: Do Advanced Callbacks
              - name: Rawdata
                style: Python
                label: Raw Data
                defaultExpr: None
                defaultMode: EXPRESSION
                value: =None
              - name: Linkedtable
                style: DAT
                label: Linked Table DAT
              - name: Lockconfigs
                style: Toggle
                label: Lock Configs
                startSection: true
              - name: Configcomp
                style: COMP
                label: Config Comp
                default: .
                value: ''
              - name: Callbackdat
                style: DAT
                label: Callback DAT
                default: .
                value: ''
              Colors:
              - name: Listercellheight
                style: Int
                label: Lister Cell Height
                default: 24
                min: 1.0
                max: 64.0
                clampMin: true
                normMin: 1.0
                normMax: 64.0
                value: 25
              - name: Listerfontsize
                style: Int
                label: Items Font Size
                startSection: true
                default: 10
              - name: Listerbasecolor
                style: RGBA
                label: Base Color
                startSection: true
                default: [0.15, 0.15, 0.15, 1]
