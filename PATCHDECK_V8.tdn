          resizecomp: =me
          topsmoothness: usetop
          borderover: false
          align: horizlr
        flags:
        - viewer
        position: [-1850, -375]
        size: [176, 83]
        comp_inputs:
        - 2_bottom
        children:
        - name: 1_reseta
          type: widgetCOMP
          parameters:
            y: 803
            w: =me.panelParent().width/8
            h: 50
            vmode: fill
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            bgcolorr: 0.2
            bgcolorg: 0.2
            bgcolorb: 0.2
            borderar: 0.5
            borderag: 0.5
            borderab: 0.5
            borderbalpha: 0
            leftborder: bordera
            bottomborder: bordera
            topborder: bordera
            borderover: false
            multrgb: false
            align: horizlr
            spacing: 1
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('buttonMomentary') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
