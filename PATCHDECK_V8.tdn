              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
