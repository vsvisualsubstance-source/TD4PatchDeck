                tz: ~parent.PointGenerator.par.Tz
                rx: ~parent.PointGenerator.par.Rx
                ry: ~parent.PointGenerator.par.Ry
                rz: ~parent.PointGenerator.par.Rz
                sx: ~parent.PointGenerator.par.Sx
                sy: ~parent.PointGenerator.par.Sy
                sz: ~parent.PointGenerator.par.Sz
                px: ~parent.PointGenerator.par.Px
                py: ~parent.PointGenerator.par.Py
