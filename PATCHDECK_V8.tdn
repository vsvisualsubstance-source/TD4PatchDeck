              value: /PATCHDECK/PATCHES/X29/FluidPOP/POP_Fluid_Solver
            - name: Space2
              style: Header
              label: ' '
            - name: Init
              style: Pulse
            - name: Start
              style: Pulse
            - name: Space
              style: Header
              label: ' '
            - name: Resolution
              style: Int
              default: 32
              normMin: 8.0
              normMax: 64.0
            - name: Size
              style: XYZW
              size: 3
              default: 1
              normMin: 0.1
              values: [1.9, 1.1, 1.1]
            - name: Space3
              style: Header
              label: ' '
            - name: Copyright
              style: Str
              default: SARV
