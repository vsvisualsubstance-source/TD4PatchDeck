            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -12000]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: label
            type: containerCOMP
            parameters:
              w: =parent().par.Labelwidth
              h: =parent().par.Labelheight
              layer: 1
              hmode: =parent.Widget.par.Labelhorizontalmode
              hfillweight: =parent.Widget.par.Labelhfillweight
              vmode: =parent.Widget.par.Labelverticalmode
              vfillweight: =parent.Widget.par.Labelvfillweight
              display: =parent.Widget.par.Labeldisplay
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              uvbuttonsleft: false
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Labelbgcolorr
              bgcolorg: =parent.Widget.par.Labelbgcolorg
              bgcolorb: =parent.Widget.par.Labelbgcolorb
              bgalpha: =parent.Widget.par.Labelbgcolora
              borderover: false
              enablecloning: false
            custom_pars:
              Label:
                $t: label_6
                Widgetlabel: Slider Range
                Labelfontsize: 9
                Labelalignx: left
                Labelaligny: center
                Labeloffset: [6, 0]
                Labelbgcolor: [0.2, 0.2, 0.2, 1]
                Labelfontcolor: [0.65, 0.65, 0.65, 1]
                Labelwidth: 120
                Labelhfillweight: 0.5
                Labelverticalmode: fill
                Labelheight: 34
            flags:
            - viewer
            position: [0, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: =parent.Widget.par.Widgetlabel.eval()
                type: multiline
                wordwrap: =parent.Widget.par.Labelwordwrap.eval()
                callbacks: text1_callbacks
                legacyfontselection: true
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Labelfontbold.eval()
                italic: =parent.Widget.par.Labelitalic
                scaletofit: =parent.Widget.par.Labelfontsizemode
                fontsize: =parent.Widget.par.Labelfontsize.eval() if parent.Widget.par.Labelfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Labelfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Labelfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Labelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Labelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Labelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Labelfontcolora.eval()
                dropshadow: =parent.Widget.par.Labeldropshadow
                textoffsetx: =parent.Widget.par.Labeloffsetx.eval()
                textoffsety: =parent.Widget.par.Labeloffsety.eval()
                textpaddingl: =parent.Widget.par.Labelpadding1.eval()
                textpaddingr: =parent.Widget.par.Labelpadding2.eval()
                textpaddingb: =parent.Widget.par.Labelpadding3.eval()
                textpaddingt: =parent.Widget.par.Labelpadding4.eval()
                alignx: =parent.Widget.par.Labelalignx.eval()
                aligny: =parent.Widget.par.Labelaligny.eval()
                hmode: fill
                vmode: fill
                bottomanchor: 0.039
                helpdat: =parent.Widget.op('code/help')
                clickthrough: =parent.Widget.par.clickthrough
                top: =parent.Widget.par.Labeltop.eval()
                borderover: false
              flags:
              - viewer
              position: [0, -200]
              size: [160, 130]
            - name: parexecRunCommand
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: =parent.Widget
                pars: Labelhorizontalmode Labelverticalmode
                onpulse: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n#\n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef valueChange(par, val, prev):\n\tif par.name == 'Labelhorizontalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Labelhfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Labelwidth, 'enable', bool(1-val))\n\telif par.name == 'Labelverticalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Labelvfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Labelheight, 'enable', bool(1-val))\n\treturn\n\ndef onPulse(par):\n\treturn\n\ndef expressionChange(par, val, prev):\n\treturn\n\ndef exportChange(par, val, prev):\n\treturn\n\ndef enableChange(par, val, prev):\n\treturn\n\ndef modeChange(par, val, prev):\n\treturn\n"
              dat_content_format: text
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_11
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: margins
            type: containerCOMP
            parameters:
              hmode: fill
              vmode: fill
              alignorder: =-me.nodeY
              resizecomp: =me
              borderover: false
              align: =1 if parent.Widget.par.Sliderorient == 'horz' else 3
              spacing: =parent.Widget.par.Slideralignmargin1
              crop: 'on'
            flags:
            - viewer
            position: [500, -225]
            size: [160, 130]
            color: [0.5, 0.5, 0.05]
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: valueOut
            type: outCHOP
            parameters:
              label: =me.name
              autoexportroot: =parent()
            position: [400, 0]
            inputs:
            - output
          - name: layoutPars
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Slider:
                $t: slider_5
                Slideralignmargin: [1, 1]
            flags:
            - viewer
            position: [700, 300]
            size: [160, 130]
            tags:
            - TDSubComp
          - name: rangeSlider0
            type: containerCOMP
            parameters:
              w: 30
              h: 30
              hmode: fill
              vmode: fill
              alignorder: 1
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              top: ./bg
              borderover: false
              align: horizlr
              spacing: 2
              justifyv: center
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./RangeExt').module.RangeExt(me)
                promote: true
            custom_pars:
              Slider:
                $t: slider
                Slideralignx: left
                Slideraligny: bottom
                Sliderknobsize: 5
                Sliderbgcolor: [0.15, 0.15, 0.15, 1]
                Sliderknobcolor: [0.6, 0.6, 0.6, 1]
                Sliderindicatorcolor: [0.325, 0.325, 0.325, 1]
                Sliderlabelfontcolor: [0.075, 0.075, 0.075, 1]
            flags:
            - viewer
            position: [500, -475]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            comp_inputs:
            - margins
            children:
            - name: bg
              type: nullTOP
              flags:
              - viewer
              position: [800, 0]
              size: [130, 90]
              inputs:
              - slider
            - name: knob
              type: selectTOP
              parameters:
                top: =parent.Widget.par.Sliderknobtop.eval() or ''
              flags:
              - viewer
              position: [200, 0]
              size: [130, 90]
            - name: text
              type: textCOMP
              parameters:
                text: =parent.Widget.par.Sliderlabelname if parent.Widget.par.Sliderlabeldisplay.val else ''
                callbacks: text1_callbacks
                legacyfontselection: true
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Sliderfontbold.eval()
                italic: =parent.Widget.par.Slideritalic
                scaletofit: =parent.Widget.par.Sliderscaletofit
                fontsize: =parent.Widget.par.Sliderfontsize.eval() if parent.Widget.par.Sliderfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Sliderfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Sliderfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Sliderlabelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Sliderlabelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Sliderlabelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Sliderlabelfontcolora.eval()
                dropshadow: =parent.Widget.par.Sliderdropshadow
                textoffsetx: =parent.Widget.par.Slideroffsetx.eval()
                textoffsety: =parent.Widget.par.Slideroffsety.eval()
                alignx: =parent.Widget.par.Slideralignx.eval()
                aligny: =parent.Widget.par.Slideraligny.eval()
                hmode: fill
                vmode: fill
                display: =parent.Widget.par.Sliderlabeldisplay
                clickthrough: true
                borderover: false
              flags:
              - viewer
              position: [400, 200]
              size: [160, 130]
            - name: info1
              type: infoDAT
              parameters:
                op: slider
                language: input
              flags:
              - viewer
              position: [600, -200]
              size: [130, 90]
              dat_read_only: true
            - name: slider
              type: glslTOP
              parameters:
                pixeldat: rangeSlider
                autodispatchsize: false
                dispatchsizey: 1
                clearoutputs: false
                outputresolution: parpanel
                resolutionw: 2531
                resolutionh: 26
                inputfiltertype: nearest
                format: rgba8fixed
              sequences:
                vec:
                - name: orient
                  valuex: =parent.Widget.par.Sliderorient.menuIndex
                - name: bgColor
                  valuex: =parent.Widget.par.Sliderbgcolorr.eval()
                  valuey: =parent.Widget.par.Sliderbgcolorg.eval()
                  valuez: =parent.Widget.par.Sliderbgcolorb.eval()
                  valuew: =parent.Widget.par.Sliderbgcolora.eval()
                - name: indColor
                  valuex: =parent.Widget.par.Sliderindicatorcolorr.eval()
                  valuey: =parent.Widget.par.Sliderindicatorcolorg.eval()
                  valuez: =parent.Widget.par.Sliderindicatorcolorb.eval()
                  valuew: =parent.Widget.par.Sliderindicatorcolora.eval()
                - name: knobColor
                  valuex: =parent.Widget.par.Sliderknobcolorr.eval()
                  valuey: =parent.Widget.par.Sliderknobcolorg.eval()
                  valuez: =parent.Widget.par.Sliderknobcolorb.eval()
                  valuew: =parent.Widget.par.Sliderknobcolora.eval()
                - name: normValues
                  valuex: =getattr(parent.Widget.par, 'Value'+ str(0)).evalNorm()
                  valuey: =getattr(parent.Widget.par, 'Value'+ str(1)).evalNorm()
                  valuez: 1
                  valuew: 1
                - name: defaultValues
                  valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).default
                  valuey: =getattr(parent.Widget.par, 'Value'+ str(parent().digits+1)).default
                  valuez: 1
                  valuew: 1
                - name: minMax
                  valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).normMin
                  valuey: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).normMax
                  valuez: 1
                  valuew: 1
                - name: knobSize
                  valuex: =parent.Widget.par.Sliderknobsize.eval()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - valuex: 1
                - valuex: 1
                - valuex: 0
                  valuey: 1
                  valuez: 1
                  valuew: 1
              flags:
              - viewer
              position: [400, 0]
              size: [130, 90]
              inputs:
              - knob
              - sliderBg
            - name: RangeExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass RangeExt(SubWidgetExt):\n\t\"\"\"\n\tValueExt is an extension that controls multiple values for a value component.\n\tA value component is a widget sub component that visualizes and provides\n\tinteractivity for setting values.\n\t\"\"\"\n\tdef __init__(self, ownerComp, dimension=1):\n\t\t# The component to which this extension is attached\n\t\t\"\"\"\n\t\tThis extension inpterprets panel interactions and controls the\n\t\tmasterSlider widget values.\n\t\t\"\"\"\n\t\tself.parPrefix = 'Slider'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\t\tself.widgetComp = self.ownerComp.parent.Widget\n\t\t#Dimesion refers to the dimension of this sub-component.  A slider\n\t\t#found in an RGBA widget will have a dimension of 1, while a range\n\t\t#slider will have a dimension of 2 since it requires two values\n\t\t#for the single ui element\n\t\tself.dimension = 2\n\t\t#The value group index allows for multiple range faders in the same\n\t\t#widget\n\t\tself.valueGroupIndex = math.floor(self.ownerComp.digits/self.dimension)\n\t\t#Slider variables\n\t\tself.LoadSliderAttribs(self.valueGroupIndex)\n\n\t\tself.select = False\n\t\tself.insideKnob = False\n\t\tself.lastClickPos = None\n\t\t#The current normalized values\n\n\t\tself.knobIndex = None\n\t\t#The function to use to process incoming ValueChange events\n\t\tself.valueProc = None\n\t\t#The current start values\n\t\tself.startValues = []\n\t\tself.startDiffs = []\n\n\tdef ReloadAttribs(self):\n\t\t\"\"\"\n\t\tReloads slider attributes after widget parameter changes\n\t\t\"\"\"\n\t\tself.LoadSliderAttribs(self.valueGroupIndex)\n\n\tdef LoadSliderAttribs(self, groupIndex):\n\t\t\"\"\"\n\t\tPreloads the slider values for the Value component.\n\t\t\"\"\"\n\t\t#debug('inside', groupIndex)\n\t\tself.index = groupIndex\n\t\tself.res = [getattr(self.ownerComp, i) for i in ['width', 'height']]\n\t\tself.knobWidth = self.ownerComp.parent.Widget.par.Sliderknobsize.eval()\n\t\tself.orient = self.ownerComp.parent.Widget.par.Sliderorient.menuIndex\n\t\ttry:\n\t\t\tself.normKnobWidth = self.knobWidth / self.res[self.orient]\n\t\texcept:\n\t\t\tself.normKnobWidth = 0\n\t\tself.knobMargin = self.normKnobWidth/2\n\t\tself.panelVar = self.ownerComp.panel.v if self.orient \\\n\t\t\t\t\t\t\t\t\t\t\t\t\telse self.ownerComp.panel.u\n\t\tself.normSliderMin = self.normKnobWidth/2\n\t\tself.normSliderMax = 1-(self.normKnobWidth/2)\n\t\tself.Pars = [getattr(self.ownerComp.parent.Widget.par, \\\n\t\t\t\t\t\t\t\t'Value'+str(i)) for i in range(self.dimension)]\n\t\tself.Values = [Value(self.widgetComp, par[1],\n\t\t\t\t\t\t\t\tself.valueGroupIndex+par[0]) \\\n\t\t\t\t\t\t\t\tfor par in enumerate(self.Pars)]\n\n\tdef ValueChange(self, panelValue):\n\t\t\"\"\"\n\t\tHandles a value change taking into consideration all the attributes\n\t\tof this slider sub-component.\n\t\t\"\"\"\n\t\t#debug('val chan')\n\t\tif self.select:\n\t\t\tself.valueProc(panelValue.val, self.knobIndex)\n\n\tdef checkInRange(self):\n\t\t\"\"\"\n\t\tChecks if the click is in the range area\n\t\t\"\"\"\n\n\t\tpval = self.lastClickPos\n\t\tnormValues = self.startValues\n\t\tnormValues = [remap(normValues[0], 0, 1, self.knobMargin,\n\t\t\t\t\t\t\t\t\t\t1-(self.knobMargin*3)),\n\t\t\t\t\t\t\t\tremap(normValues[1], 0, 1, self.knobMargin*3,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t1-(self.knobMargin))]\n\n\t\t#debug('knobMargin', self.knobMargin)\n\t\t#debug('normValues', normValues)\n\n\t\tif pval < normValues[0]-self.knobMargin:\n\t\t\tself.inRange = False\n\t\t\tself.outRangeKnobIndex = 0\n\t\t\tself.knobIndex = 0\n\t\telif pval > normValues[1]+self.knobMargin:\n\t\t\tself.inRange = False\n\t\t\tself.outRangeKnobIndex = 1\n\t\t\tself.knobIndex = 1\n\t\telif pval > normValues[0]+self.knobMargin and pval < normValues[1]-self.knobMargin:\n\t\t\tself.inRange = True\n\t\t\tself.outRangeKnobIndex = 0\n\n\t\treturn self.inRange\n\n\tdef valueChangeRange(self, panelValue, valueIndex):\n\t\t\"\"\"\n\t\tHandles a value change event deciding what action
                to take based on\n\t\tclick position in u or v\n\t\t\"\"\"\n\t\t#debug('range')\n\t\t#debug('sv', self.startValues, self.startDiffs)\n\n\t\toffset = panelValue-self.lastClickPos\n\t\toffset = (offset)*(1/(1-(self.normKnobWidth*2)))\n\t\t#debug(offset)\n\t\tnormValues = [v.normValue for v in self.Values]\n\t\toffsetValues = [offset+i for i in self.startValues]\n\t\t#debug(offsetValues)\n\t\tsetValue = False\n\t\tfor i in range(2):\n\t\t\t#debug(offset)\n\t\t\t#If the incoming offset is not outside the start end range\n\t\t\tif offset < 0 and offsetValues[0] > 0 or \\\n\t\t\t\t\t\t\t\t\toffset > 0 and offsetValues[1] < 1:\n\t\t\t\tself.setValue(offsetValues[i], i)\n\t\t\telif offset < 0 and offsetValues[0] < 0:\n\t\t\t\tself.setValue(0,0)\n\t\t\t\t#Zero out right handle by subtracting the failed offset\n\t\t\t\t#for left handle ( kinda cheating but it works )\n\t\t\t\tself.setValue(normValues[1]-normValues[0], 1)\n\t\t\telif offset > 0 and offsetValues[1] > 1:\n\t\t\t\tself.setValue(1,1)\n\t\t\t\t#Max out left handle by adding the failed offset\n\t\t\t\t#for right handle passed 1\n\t\t\t\tself.setValue(normValues[0]+(1-normValues[1]), 0)\n\n\tdef rangeClamp(self, value, valueIndex):\n\t\tif valueIndex == 0:\n\t\t\tvalue = min(value, self.Values[1].normValue)\n\t\telif valueIndex == 1:\n\t\t\tvalue = max(value, self.Values[0].normValue)\n\t\treturn value\n\n\tdef SelectOn(self):\n\t\t\"\"\"\n\t\tGathers information when the panel is initially selected. The\n\t\tinformation is used when interaction with the widget sub-component\n\t\tpanel generates valueChange callback events. These events are\n\t\tsubsequently handled by the ValueChange() method of this class.\n\t\t\"\"\"\n\t\t#knobClickIndex will be None if not clicked or knob index if a knob\n\t\t#was clicked\n\t\tknobIndex = self.checkKnobClick()\n\t\tif knobIndex is None:\n\t\t\tif self.checkInRange():\n\t\t\t\tself.valueProc = self.valueChangeRange\n\t\t\telse:\n\t\t\t\tself.valueProc = self.valueChangeSlider\n\t\telse:\n\t\t\tself.valueProc = self.valueChangeKnob\n\t\tself.select = True\n\n\tdef SelectOff(self):\n\t\t\"\"\"\n\t\tTurns off select state for this value.\n\t\t\"\"\"\n\t\tself.select = False\n\t\tself.mode = None\n\t\tself.valueProc = None\n\t\tself.insideKnob = False\n\t\tself.lastClickPos = None\n\n\tdef reNormalizeWithKnobs(self, knobMargin):\n\t\t\"\"\"\n\t\tThis function allows for renormalizing the normalized values\n\t\ttaking into consideration the knob size.\n\t\t\"\"\"\n\t\tnormValues = self.getNormValues()\n\t\treturn [remap(normValues[0], 0, 1, knobMargin,\n\t\t\t\t\t\t\t\t1-(knobMargin*3)),\n\t\t\t\t\t\tremap(normValues[1], 0, 1, knobMargin*3,\n\t\t\t\t\t\t\t\t\t\t\t\t1-(knobMargin))]\n\n\n\tdef checkKnobClick(self):\n\t\t\"\"\"\n\t\tChecks if click was inside a knob or not.  Returns None if not or the\n\t\tknob index starting at 0 if a knob was clicked.\n\t\t\"\"\"\n\t\t#knobMargin = self.normKnobWidth/2\n\t\tnormValues = self.reNormalizeWithKnobs(self.knobMargin)\n\t\tpval = self.panelVar.val\n\t\tknobIndex = None\n\t\tfor i in range(self.dimension):\n\t\t\t#print('check', pval, normValues[i]-(self.knobMargin), normValues[i]+(self.knobMargin), self.knobMargin, self.knobWidth)\n\t\t\tif pval > normValues[i]-(self.knobMargin) and \\\n\t\t\t\t\t\t\t\t\t\tpval < (normValues[i]+(self.knobMargin)):\n\t\t\t\t#print('knobClick')\n\t\t\t\tself.startValues = self.getNormValues()\n\t\t\t\t#debug('startValues set', self.startValues)\n\t\t\t\tself.lastClickPos = pval\n\t\t\t\tself.insideKnob = True\n\t\t\t\tknobIndex = i\n\t\t\t\tself.knobIndex = knobIndex\n\t\t\t\tbreak\n\t\t\telse:\n\t\t\t\tself.startValues = self.getNormValues()\n\t\t\t\t#debug('startValues set', self.startValues)\n\t\t\t\tself.lastClickPos = pval\n\t\t\t\tself.insideKnob = False\n\t\t\t\tself.knobClickOffset = None\n\t\t\t\tself.startDiffs = sorted([(i[0], abs(pval - i[1])) for i \\\n\t\t\t\t\t\t\tin enumerate(normValues)], key=lambda tup: tup[1])\n\n\t\treturn knobIndex\n\n\tdef setValue(self, value, index):\n\t\t#self.widgetComp.SetValueNorm(value,\tindex)\n\t\tgetattr(parent.Widget.par,
                'Value'+ str(index)).normVal = value\n\n\tdef getNormValues(self):\n\t\treturn [self.Values[v].normValue for v in range(self.dimension)]\n\n\tdef getNormMin(self, index):\n\t\treturn self.Values[index].normMin\n\n\tdef getNormMax(self, index):\n\t\treturn self.Values[index].normMax\n\n\tdef valueChangeKnob(self, pVal, valueIndex):\n\t\t\"\"\"\n\t\tChanges value using the knob.  This generates a value change only if\n\t\tthe knob is moved.  Clicking anywhere on the knob will not change\n\t\tthe value.\n\t\t\"\"\"\n\t\t#debug('knob')\n\t\tvalueIndex = valueIndex+self.valueGroupIndex\n\t\toffset = (pVal-self.lastClickPos)*(1/(1-(self.normKnobWidth*2)))\n\t\tvalue = (offset + self.startValues[valueIndex])\n\t\tvalue = self.rangeClamp(value, valueIndex)\n\t\tself.setValue(value, valueIndex)\n\n\tdef valueChangeSlider(self, pVal, valueIndex):\n\t\t\"\"\"\n\t\tChanges value not using the knob.  This generates a value change only\n\t\tif the slider area with no knob is selected.\n\t\t\"\"\"\n\t\t#debug('slider')\n\t\tif valueIndex is not None:\n\t\t\twidgetValueIndex = valueIndex+self.valueGroupIndex\n\t\telse:\n\t\t\twidgetValueIndex = self.valueGroupIndex\n\t\tif valueIndex == 0:\n\t\t\tvalue = remap(pVal, self.normKnobWidth/2,\n\t\t\t\t\t\t\t\t1-(self.normKnobWidth*1.5), 0, 1)\n\t\tif valueIndex == 1:\n\t\t\tvalue = remap(pVal, self.normKnobWidth*1.5,\n\t\t\t\t\t\t\t\t1-(self.normKnobWidth/2), 0, 1)\n\t\tvalue = self.rangeClamp(value, valueIndex)\n\t\tself.setValue(value, widgetValueIndex)\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == 'Sliderknobsize':\n\t\t\tself.ReloadAttribs()\n\t\telse:\n\t\t\tSubWidgetExt.onParSettingsChange(self, par, prev)\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\t\"\"\"\n\t\tif event == 'offToOn' and panelValue.name == 'select':\n\t\t\tparent.Value.SelectOn()\n\t\telif event == 'onToOff' and panelValue.name == 'select':\n\t\t\tparent.Value.SelectOff()\n\t\telif panelValue.name in ['u', 'v']:\n\t\t\tparent.Value.ValueChange(panelValue)\n\nclass Value:\n\t\"\"\"\n\tHolds value parameter for widgets and provides common features for\n\tgetting and setting values.\n\t\"\"\"\n\tdef __init__(self, widgetComp, valuePar, index):\n\t\tself.widgetComp = widgetComp\n\t\tself.valuePar = valuePar\n\t\tself.valueIndex = index\n\t\tself.currentValue = None\n\t\tself.lastValue = None\n\t\t#self.normMin = getattr(widgetComp.par, 'Normminmax' + str(index) + '1').eval()\n\t\tself.normMin = getattr(parent.Widget.par, 'Value'+ str(index)).normMin\n\t\t#self.normMax = getattr(widgetComp.par, 'Normminmax' + str(index) + '2').eval()\n\t\tself.normMin = getattr(parent.Widget.par, 'Value'+ str(index)).normMax\n\t\tself.valueUpdate()\n\n\tdef valueUpdate(self):\n\t\tself.lastValue = self.currentValue\n\t\tself.currentValue = self.valuePar.eval()\n\n\t@property\n\tdef normValue(self):\n\t\t#return self.widgetComp.GetValueNorm(self.valueIndex)\n\t\treturn getattr(parent.Widget.par, 'Value'+ str(self.valueIndex)).normVal\n\ndef remap(val, fromMin, fromMax, toMin, toMax):\n\t\"\"\"\n\tRemaps val to a new range.\n\t\"\"\"\n\tresult = ( (val - fromMin) / (fromMax - fromMin) ) * (toMax - toMin) + toMin\n\treturn result\n"
              dat_content_format: text
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [400, 425]
              size: [160, 130]
            - name: sliderBg
              type: selectTOP
              parameters:
                top: =parent.Widget.par.Sliderbgtop.eval() or ''
              flags:
              - viewer
              position: [200, -100]
              size: [130, 90]
            - name: RangeExt1
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass RangeExt(SubWidgetExt):\n\t\"\"\"\n\tValueExt is an extension that controls multiple values for a value component.\n\tA value component is a widget sub component that visualizes and provides\n\tinteractivity for setting values.\n\t\"\"\"\n\tdef __init__(self, ownerComp, dimension=1):\n\t\t# The component to which this extension is attached\n\t\t\"\"\"\n\t\tThis extension inpterprets panel interactions and controls the\n\t\tmasterSlider widget values.\n\t\t\"\"\"\n\t\tself.parPrefix = 'Slider'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\t\tself.widgetComp = self.ownerComp.parent.Widget\n\t\t#Dimesion refers to the dimension of this sub-component.  A slider\n\t\t#found in an RGBA widget will have a dimension of 1, while a range\n\t\t#slider will have a dimension of 2 since it requires two values\n\t\t#for the single ui element\n\t\tself.dimension = 2\n\t\t#The value group index allows for multiple range faders in the same\n\t\t#widget\n\t\tself.valueGroupIndex = math.floor(self.ownerComp.digits/self.dimension)\n\t\t#Slider variables\n\t\tself.LoadSliderAttribs(self.valueGroupIndex)\n\n\t\tself.select = False\n\t\tself.insideKnob = False\n\t\tself.lastClickPos = None\n\t\t#The current normalized values\n\n\t\tself.knobIndex = None\n\t\t#The function to use to process incoming ValueChange events\n\t\tself.valueProc = None\n\t\t#The current start values\n\t\tself.startValues = []\n\t\tself.startDiffs = []\n\n\tdef ReloadAttribs(self):\n\t\t\"\"\"\n\t\tReloads slider attributes after widget parameter changes\n\t\t\"\"\"\n\t\tself.LoadSliderAttribs(self.valueGroupIndex)\n\n\tdef LoadSliderAttribs(self, groupIndex):\n\t\t\"\"\"\n\t\tPreloads the slider values for the Value component.\n\t\t\"\"\"\n\t\t#debug('inside', groupIndex)\n\t\tself.index = groupIndex\n\t\tself.res = [getattr(self.ownerComp, i) for i in ['width', 'height']]\n\t\tself.knobWidth = self.ownerComp.parent.Widget.par.Sliderknobsize.eval()\n\t\tself.orient = self.ownerComp.parent.Widget.par.Sliderorient.menuIndex\n\t\tself.normKnobWidth = self.knobWidth / self.res[self.orient]\n\t\tself.knobMargin = self.normKnobWidth/2\n\t\tself.panelVar = self.ownerComp.panel.v if self.orient \\\n\t\t\t\t\t\t\t\t\t\t\t\t\telse self.ownerComp.panel.u\n\t\tself.normSliderMin = self.normKnobWidth/2\n\t\tself.normSliderMax = 1-(self.normKnobWidth/2)\n\t\tself.Pars = [getattr(self.ownerComp.parent.Widget.par, \\\n\t\t\t\t\t\t\t\t'Value'+str(i)) for i in range(self.dimension)]\n\t\tself.Values = [Value(self.widgetComp, par[1],\n\t\t\t\t\t\t\t\tself.valueGroupIndex+par[0]) \\\n\t\t\t\t\t\t\t\tfor par in enumerate(self.Pars)]\n\n\tdef ValueChange(self, panelValue):\n\t\t\"\"\"\n\t\tHandles a value change taking into consideration all the attributes\n\t\tof this slider sub-component.\n\t\t\"\"\"\n\t\t#debug('val chan')\n\t\tif self.select:\n\t\t\tself.valueProc(panelValue.val, self.knobIndex)\n\n\tdef checkInRange(self):\n\t\t\"\"\"\n\t\tChecks if the click is in the range area\n\t\t\"\"\"\n\n\t\tpval = self.lastClickPos\n\t\tnormValues = self.startValues\n\t\tnormValues = [remap(normValues[0], 0, 1, self.knobMargin,\n\t\t\t\t\t\t\t\t\t\t1-(self.knobMargin*3)),\n\t\t\t\t\t\t\t\tremap(normValues[1], 0, 1, self.knobMargin*3,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t1-(self.knobMargin))]\n\n\t\t#debug('knobMargin', self.knobMargin)\n\t\t#debug('normValues', normValues)\n\n\t\tif pval < normValues[0]-self.knobMargin:\n\t\t\tself.inRange = False\n\t\t\tself.outRangeKnobIndex = 0\n\t\t\tself.knobIndex = 0\n\t\telif pval > normValues[1]+self.knobMargin:\n\t\t\tself.inRange = False\n\t\t\tself.outRangeKnobIndex = 1\n\t\t\tself.knobIndex = 1\n\t\telif pval > normValues[0]+self.knobMargin and pval < normValues[1]-self.knobMargin:\n\t\t\tself.inRange = True\n\t\t\tself.outRangeKnobIndex = 0\n\n\t\treturn self.inRange\n\n\tdef valueChangeRange(self, panelValue, valueIndex):\n\t\t\"\"\"\n\t\tHandles a value change event deciding what action to take based on\n\t\tclick position in u or v\n\t\t\"\"\"\n\t\t#debug('range')\n\t\t#debug('sv',
                self.startValues, self.startDiffs)\n\n\t\toffset = panelValue-self.lastClickPos\n\t\toffset = (offset)*(1/(1-(self.normKnobWidth*2)))\n\t\t#debug(offset)\n\t\tnormValues = [v.normValue for v in self.Values]\n\t\toffsetValues = [offset+i for i in self.startValues]\n\t\t#debug(offsetValues)\n\t\tsetValue = False\n\t\tfor i in range(2):\n\t\t\t#debug(offset)\n\t\t\t#If the incoming offset is not outside the start end range\n\t\t\tif offset < 0 and offsetValues[0] > 0 or \\\n\t\t\t\t\t\t\t\t\toffset > 0 and offsetValues[1] < 1:\n\t\t\t\tself.setValue(offsetValues[i], i)\n\t\t\telif offset < 0 and offsetValues[0] < 0:\n\t\t\t\tself.setValue(0,0)\n\t\t\t\t#Zero out right handle by subtracting the failed offset\n\t\t\t\t#for left handle ( kinda cheating but it works )\n\t\t\t\tself.setValue(normValues[1]-normValues[0], 1)\n\t\t\telif offset > 0 and offsetValues[1] > 1:\n\t\t\t\tself.setValue(1,1)\n\t\t\t\t#Max out left handle by adding the failed offset\n\t\t\t\t#for right handle passed 1\n\t\t\t\tself.setValue(normValues[0]+(1-normValues[1]), 0)\n\n\tdef rangeClamp(self, value, valueIndex):\n\t\tif valueIndex == 0:\n\t\t\tvalue = min(value, self.Values[1].normValue)\n\t\telif valueIndex == 1:\n\t\t\tvalue = max(value, self.Values[0].normValue)\n\t\treturn value\n\n\tdef SelectOn(self):\n\t\t\"\"\"\n\t\tGathers information when the panel is initially selected. The\n\t\tinformation is used when interaction with the widget sub-component\n\t\tpanel generates valueChange callback events. These events are\n\t\tsubsequently handled by the ValueChange() method of this class.\n\t\t\"\"\"\n\t\t#knobClickIndex will be None if not clicked or knob index if a knob\n\t\t#was clicked\n\t\tknobIndex = self.checkKnobClick()\n\t\tif knobIndex is None:\n\t\t\tif self.checkInRange():\n\t\t\t\tself.valueProc = self.valueChangeRange\n\t\t\telse:\n\t\t\t\tself.valueProc = self.valueChangeSlider\n\t\telse:\n\t\t\tself.valueProc = self.valueChangeKnob\n\t\tself.select = True\n\n\tdef SelectOff(self):\n\t\t\"\"\"\n\t\tTurns off select state for this value.\n\t\t\"\"\"\n\t\tself.select = False\n\t\tself.mode = None\n\t\tself.valueProc = None\n\t\tself.insideKnob = False\n\t\tself.lastClickPos = None\n\n\tdef reNormalizeWithKnobs(self, knobMargin):\n\t\t\"\"\"\n\t\tThis function allows for renormalizing the normalized values\n\t\ttaking into consideration the knob size.\n\t\t\"\"\"\n\t\tnormValues = self.getNormValues()\n\t\treturn [remap(normValues[0], 0, 1, knobMargin,\n\t\t\t\t\t\t\t\t1-(knobMargin*3)),\n\t\t\t\t\t\tremap(normValues[1], 0, 1, knobMargin*3,\n\t\t\t\t\t\t\t\t\t\t\t\t1-(knobMargin))]\n\n\n\tdef checkKnobClick(self):\n\t\t\"\"\"\n\t\tChecks if click was inside a knob or not.  Returns None if not or the\n\t\tknob index starting at 0 if a knob was clicked.\n\t\t\"\"\"\n\t\t#knobMargin = self.normKnobWidth/2\n\t\tnormValues = self.reNormalizeWithKnobs(self.knobMargin)\n\t\tpval = self.panelVar.val\n\t\tknobIndex = None\n\t\tfor i in range(self.dimension):\n\t\t\t#print('check', pval, normValues[i]-(self.knobMargin), normValues[i]+(self.knobMargin), self.knobMargin, self.knobWidth)\n\t\t\tif pval > normValues[i]-(self.knobMargin) and \\\n\t\t\t\t\t\t\t\t\t\tpval < (normValues[i]+(self.knobMargin)):\n\t\t\t\t#print('knobClick')\n\t\t\t\tself.startValues = self.getNormValues()\n\t\t\t\t#debug('startValues set', self.startValues)\n\t\t\t\tself.lastClickPos = pval\n\t\t\t\tself.insideKnob = True\n\t\t\t\tknobIndex = i\n\t\t\t\tself.knobIndex = knobIndex\n\t\t\t\tbreak\n\t\t\telse:\n\t\t\t\tself.startValues = self.getNormValues()\n\t\t\t\t#debug('startValues set', self.startValues)\n\t\t\t\tself.lastClickPos = pval\n\t\t\t\tself.insideKnob = False\n\t\t\t\tself.knobClickOffset = None\n\t\t\t\tself.startDiffs = sorted([(i[0], abs(pval - i[1])) for i \\\n\t\t\t\t\t\t\tin enumerate(normValues)], key=lambda tup: tup[1])\n\n\t\treturn knobIndex\n\n\tdef setValue(self, value, index):\n\t\t#self.widgetComp.SetValueNorm(value,\tindex)\n\t\tgetattr(parent.Widget.par, 'Value'+ str(index)).normVal = value\n\n\tdef getNormValues(self):\n\t\treturn
                [self.Values[v].normValue for v in range(self.dimension)]\n\n\tdef getNormMin(self, index):\n\t\treturn self.Values[index].normMin\n\n\tdef getNormMax(self, index):\n\t\treturn self.Values[index].normMax\n\n\tdef valueChangeKnob(self, pVal, valueIndex):\n\t\t\"\"\"\n\t\tChanges value using the knob.  This generates a value change only if\n\t\tthe knob is moved.  Clicking anywhere on the knob will not change\n\t\tthe value.\n\t\t\"\"\"\n\t\t#debug('knob')\n\t\tvalueIndex = valueIndex+self.valueGroupIndex\n\t\toffset = (pVal-self.lastClickPos)*(1/(1-(self.normKnobWidth*2)))\n\t\tvalue = (offset + self.startValues[valueIndex])\n\t\tvalue = self.rangeClamp(value, valueIndex)\n\t\tself.setValue(value, valueIndex)\n\n\tdef valueChangeSlider(self, pVal, valueIndex):\n\t\t\"\"\"\n\t\tChanges value not using the knob.  This generates a value change only\n\t\tif the slider area with no knob is selected.\n\t\t\"\"\"\n\t\t#debug('slider')\n\t\tif valueIndex is not None:\n\t\t\twidgetValueIndex = valueIndex+self.valueGroupIndex\n\t\telse:\n\t\t\twidgetValueIndex = self.valueGroupIndex\n\t\tif valueIndex == 0:\n\t\t\tvalue = remap(pVal, self.normKnobWidth/2,\n\t\t\t\t\t\t\t\t1-(self.normKnobWidth*1.5), 0, 1)\n\t\tif valueIndex == 1:\n\t\t\tvalue = remap(pVal, self.normKnobWidth*1.5,\n\t\t\t\t\t\t\t\t1-(self.normKnobWidth/2), 0, 1)\n\t\tvalue = self.rangeClamp(value, valueIndex)\n\t\tself.setValue(value, widgetValueIndex)\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == 'Sliderknobsize':\n\t\t\tself.ReloadAttribs()\n\t\telse:\n\t\t\tSubWidgetExt.onParSettingsChange(self, par, prev)\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\t\"\"\"\n\t\tif event == 'offToOn' and panelValue.name == 'select':\n\t\t\tparent.Value.SelectOn()\n\t\telif event == 'onToOff' and panelValue.name == 'select':\n\t\t\tparent.Value.SelectOff()\n\t\telif panelValue.name in ['u', 'v']:\n\t\t\tparent.Value.ValueChange(panelValue)\n\nclass Value:\n\t\"\"\"\n\tHolds value parameter for widgets and provides common features for\n\tgetting and setting values.\n\t\"\"\"\n\tdef __init__(self, widgetComp, valuePar, index):\n\t\tself.widgetComp = widgetComp\n\t\tself.valuePar = valuePar\n\t\tself.valueIndex = index\n\t\tself.currentValue = None\n\t\tself.lastValue = None\n\t\t#self.normMin = getattr(widgetComp.par, 'Normminmax' + str(index) + '1').eval()\n\t\tself.normMin = getattr(parent.Widget.par, 'Value'+ str(index)).normMin\n\t\t#self.normMax = getattr(widgetComp.par, 'Normminmax' + str(index) + '2').eval()\n\t\tself.normMin = getattr(parent.Widget.par, 'Value'+ str(index)).normMax\n\t\tself.valueUpdate()\n\n\tdef valueUpdate(self):\n\t\tself.lastValue = self.currentValue\n\t\tself.currentValue = self.valuePar.eval()\n\n\t@property\n\tdef normValue(self):\n\t\t#return self.widgetComp.GetValueNorm(self.valueIndex)\n\t\treturn getattr(parent.Widget.par, 'Value'+ str(self.valueIndex)).normVal\n\ndef remap(val, fromMin, fromMax, toMin, toMax):\n\t\"\"\"\n\tRemaps val to a new range.\n\t\"\"\"\n\tresult = ( (val - fromMin) / (fromMax - fromMin) ) * (toMax - toMin) + toMin\n\treturn result\n"
              dat_content_format: text
            - name: parReinit
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: Sliderknobsize w h Default* Min* Norm* Clamp* Sliderclamp* Sliderrel* Sliderorient
                onpulse: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, 600]
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n# \n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef onValueChange(par, val, prev):\n\tparent().par.reinitextensions.pulse()\n\treturn\n\ndef onPulse(par):\n\treturn\n\ndef onExpressionChange(par, val, prev):\n\treturn\n\ndef onExportChange(par, val, prev):\n\treturn\n\ndef onEnableChange(par, val, prev):\n\treturn\n\ndef onModeChange(par, val, prev):\n\treturn\n\t"
              dat_content_format: text
            - name: rangeSlider
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [400, -400]
              size: [130, 90]
              dat_content: "//horizontal slider: 0, vertical slider: 1\nuniform int orient;\n//the widget's current normalized value\nuniform vec2 normValues;\nuniform vec2 defaultValues;\nuniform vec2 minMax;\nuniform vec4 bgColor;\nuniform vec4 indColor;\nuniform vec4 knobColor;\nuniform int knobSize;\n//uniform float offset2;\n//uniform float pOffset;\n//uniform float scale;\n\nlayout(location = 0) out vec4 fragColor;\n\nfloat map(float s, float a1, float a2, float b1, float b2)\n{\n    return b1 + (s-a1)*(b2-b1)/(a2-a1);\n}\n\nvec4 over(vec4 tOver, vec4 tUnder)\n{\n    return ((1.0-tOver.a)*tUnder) + tOver.a * tOver;\n}\n\nvoid main() {\n\n    float normValue1 = normValues.x;\n    float normValue2 = normValues.y;\n    float defaultValue1 = defaultValues.x;\n    float defaultValue2 = defaultValues.y;\n\n    //level use v if orient is 1 else use u\n    float level = orient == 1.0 ? vUV.t : vUV.s;\n\t//Flips the incoming text and textures to the correct orientation\n\tvec2 fUV = orient == 1.0 ? (vec2(0.0, 1.0)\n\t\t\t\t\t\t\t\t+ (vUV.ts*vec2(1.0, -1.0))) : vUV.st;\n\tfloat coord = orient == 1.0 ? gl_FragCoord.y : gl_FragCoord.x;\n    float pWidth = uTD2DInfos[0].res.z;\n\tvec4 color = vec4(0.0);\n\t//ranged value\n\tfloat rmin = minMax.x;\n\tfloat rmax = minMax.y;\n\t//normalize knob size\n\tfloat nmKnobSize = knobSize / pWidth;\n\tfloat nmKnobSizeH = nmKnobSize/2.0;\n\tfloat nmDefault = (defaultValue1-rmin) / (rmax - rmin);\n    float pOffset1 = -normValue1 * ((pWidth-(knobSize*2)) / knobSize);\n    float pOffset2 = -normValue2 * ((pWidth-(knobSize*2)) / knobSize);\n    float scale = pWidth / knobSize;\n    //knob uv\n    vec2 knobUV1 =  vec2(fUV.s*scale+pOffset1, fUV.t);\n    vec2 knobUV2 =  vec2((fUV.s-nmKnobSize)*scale+pOffset2, fUV.t);\n    //load textures\n    //vec4 textLayer = texture(sTD2DInputs[0], fUV);\n\tvec4 bgLayer = texture(sTD2DInputs[1], fUV);\n\tvec4 knobLayer1 = texture(sTD2DInputs[0], knobUV1);\n    vec4 knobLayer2 = texture(sTD2DInputs[0], knobUV2);\n\n    float remapValue1 = map(normValue1, 0, 1, nmKnobSizeH,\n                                        1-(nmKnobSizeH)-nmKnobSize);\n    float remapValue2 = map(normValue2, 0, 1, nmKnobSizeH+nmKnobSize,\n                                        1-(nmKnobSizeH));\n\n\t//Level indicator color\n    if (level > (remapValue1+nmKnobSizeH) && level <\n                                        (remapValue2-nmKnobSizeH))\n    {\n      color = indColor;\n  \t}\n  \telse\n    {\n  \t   color = bgColor;\n  \t}\n\n    //knob1 color\n    if (level > (remapValue1 - (nmKnobSizeH)) &&\n\t\t\t\t\t\t\t\tlevel < (remapValue1 + (nmKnobSizeH)))\n    {\n        color = over(knobColor, color);\n        color = over(knobLayer1, color);\n    }\n\n    //knob2 color\n    if (level > (remapValue2 - (nmKnobSizeH)) &&\n  \t\t\t\t\t\t\t\tlevel < (remapValue2 + (nmKnobSizeH)))\n    {\n        color = over(knobColor, color);\n        color = over(knobLayer2, color);\n    }\n\n\t//Text over\n    //color = over(textLayer, color);\n\tfragColor = color;\n}\n"
              dat_content_format: text
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-200, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: panelexecValueX
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: =parent()
                panelvalue: ='select ' + ('v' if parent.Widget.par.Sliderorient.menuIndex else 'u')
                ontooff: true
                valuechange: true
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, 0]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              position: [400, 50]
              size: [160, 130]
              dock: text
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
            - name: parexecSettingsX
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: 'Slidercustomizeinteraction Sliderhorizontalmode Sliderverticalmode Sliderknobsize '
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
          - name: numericValue0
            type: containerCOMP
            parameters:
              w: =parent.Widget.par.Numericfieldwidth
              h: =parent.Widget.par.Numericfieldheight
              hmode: =parent.Widget.par.Numericfieldhorizontalmode
              hfillweight: =parent.Widget.par.Numericfieldhfillweight
              vmode: =parent.Widget.par.Numericfieldverticalmode
              vfillweight: =parent.Widget.par.Numericfieldvfillweight
              alignorder: =0 if parent.Widget.par.Sliderorient == 'horz' else 2
              display: =parent.Widget.par.Numericfielddisplay
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              borderover: false
              align: horizlr
              spacing: 1
              justifyv: center
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./NumericFieldExt').module.NumericFieldExt(me)
            custom_pars:
              Field:
                $t: field_7
                Numericfieldtype: float
                Numericfieldformatting: scientific
                Numericfielddecimalplaces: 2
                Numericfieldfontsize: 9
                Numericfieldalignx: left
                Numericfieldaligny: bottom
                Numericfieldbgcolor: [0.28, 0.28, 0.28, 1]
                Numericfieldfontcolor: [0.7, 0.7, 0.7, 1]
                Numericfieldbordercolor: [0, 0, 0, 0]
                Numericfieldhorizontalmode: fill
                Numericfieldwidth: 40
                Numericfieldverticalmode: fill
            flags:
            - viewer
            position: [300, -400]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            comp_inputs:
            - margins
            children:
            - name: text
              type: textCOMP
              parameters:
                text: ~getattr(parent.Widget.par, 'Value'+str(parent().digits))
                type: =me.par.type.menuNames.index(parent.Widget.par.Numericfieldtype.eval())
                formatting: =parent.Widget.par.Numericfieldformatting
                customformatting: ~parent.Widget.par.Numericfieldcustom
                precision: =parent.Widget.par.Numericfielddecimalplaces.eval()
                editmode: =0 if parent.Widget.par.Numericfieldreadonly.eval() else (2 if parent.Widget.par.Numericfieldupdatewhiletyping.eval() else 1)
                fieldfocus: =parent.Widget.par.Numericfieldfocus
                callbacks: text1_callbacks
                legacyfontselection: true
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Numericfieldfontbold.eval()
                italic: =parent.Widget.par.Numericfielditalic
                scaletofit: =parent.Widget.par.Numericfieldscaletofit
                fontsize: =parent.Widget.par.Numericfieldfontsize.eval() if parent.Widget.par.Numericfieldfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Numericfieldfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Numericfieldfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Numericfieldfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Numericfieldfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Numericfieldfontcolorb.eval()
                fontalpha: =parent.Widget.par.Numericfieldfontcolora.eval()
                dropshadow: =parent.Widget.par.Numericfielddropshadow
                textoffsetx: =parent.Widget.par.Numericfieldoffsetx.eval()
                textoffsety: =parent.Widget.par.Numericfieldoffsety.eval()
                textpaddingl: =parent.Widget.par.Numericfieldpadding1.eval()
                textpaddingr: =parent.Widget.par.Numericfieldpadding2.eval()
                textpaddingb: =parent.Widget.par.Numericfieldpadding3.eval()
                textpaddingt: =parent.Widget.par.Numericfieldpadding4.eval()
                alignx: =parent.Widget.par.Numericfieldalignx.eval()
                aligny: =parent.Widget.par.Numericfieldaligny.eval()
                hmode: fill
                vmode: fill
                clickthrough: =parent.Widget.par.clickthrough
                bgcolorr: =parent.Widget.par.Numericfieldbgcolorr
                bgcolorg: =parent.Widget.par.Numericfieldbgcolorg
                bgcolorb: =parent.Widget.par.Numericfieldbgcolorb
                bgalpha: =parent.Widget.par.Numericfieldbgcolora
                borderover: false
              flags:
              - viewer
              size: [160, 130]
            - name: panel1
              type: panelCHOP
              parameters:
                component: text
              position: [200, 0]
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [0, -200]
              size: [160, 130]
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-600, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: panelexecValue
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: ..
                panelvalue: lselect
                ontooff: true
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 0]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: NumericFieldExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass NumericFieldExt(SubWidgetExt):\n\t\"\"\"\n\tNumericFieldExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Numericfield'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == 'Numericfieldtype':\n\t\t\tif val == 'integer':\n\t\t\t\tparent.Widget.par.Numericfielddecimalplaces.enable = False\n\t\t\telse:\n\t\t\t\tparent.Widget.par.Numericfielddecimalplaces.enable = True\n\t\telse:\n\t\t\tSubWidgetExt.onParSettingsChange(self, par, prev)\n\n\tdef makePanelExecute(self):\n\t\tSubWidgetExt.makePanelExecute(self,\n\t\t\t\t\tself.getDockExpressionToOwner() + '.op(\"field\")')\n"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-400, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: parexecSettings
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Numericfield*
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              position: [200, 0]
              size: [130, 90]
              dock: text
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
          - name: numericValue1
            type: containerCOMP
            parameters:
              w: =parent.Widget.par.Numericfieldwidth
              h: =parent.Widget.par.Numericfieldheight
              hmode: =parent.Widget.par.Numericfieldhorizontalmode
              hfillweight: =parent.Widget.par.Numericfieldhfillweight
              vmode: =parent.Widget.par.Numericfieldverticalmode
              vfillweight: =parent.Widget.par.Numericfieldvfillweight
              alignorder: =2 if parent.Widget.par.Sliderorient == 'horz' else 0
              display: =parent.Widget.par.Numericfielddisplay
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              borderover: false
              align: horizlr
              spacing: 1
              justifyv: center
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./NumericFieldExt').module.NumericFieldExt(me)
            custom_pars:
              Field:
                $t: field_7
                Numericfieldtype: float
                Numericfieldformatting: scientific
                Numericfielddecimalplaces: 2
                Numericfieldfontsize: 9
                Numericfieldalignx: left
                Numericfieldaligny: bottom
                Numericfieldbgcolor: [0.28, 0.28, 0.28, 1]
                Numericfieldfontcolor: [0.7, 0.7, 0.7, 1]
                Numericfieldbordercolor: [0, 0, 0, 0]
                Numericfieldhorizontalmode: fill
                Numericfieldwidth: 40
                Numericfieldverticalmode: fill
            flags:
            - viewer
            position: [700, -500]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            comp_inputs:
            - margins
            children:
            - name: text
              type: textCOMP
              parameters:
                text: ~getattr(parent.Widget.par, 'Value'+str(parent().digits))
                type: =me.par.type.menuNames.index(parent.Widget.par.Numericfieldtype.eval())
                formatting: =parent.Widget.par.Numericfieldformatting
                customformatting: ~parent.Widget.par.Numericfieldcustom
                precision: =parent.Widget.par.Numericfielddecimalplaces.eval()
                editmode: =0 if parent.Widget.par.Numericfieldreadonly.eval() else (2 if parent.Widget.par.Numericfieldupdatewhiletyping.eval() else 1)
                fieldfocus: =parent.Widget.par.Numericfieldfocus
                callbacks: text1_callbacks
                legacyfontselection: true
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Numericfieldfontbold.eval()
                italic: =parent.Widget.par.Numericfielditalic
                scaletofit: =parent.Widget.par.Numericfieldscaletofit
                fontsize: =parent.Widget.par.Numericfieldfontsize.eval() if parent.Widget.par.Numericfieldfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Numericfieldfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Numericfieldfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Numericfieldfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Numericfieldfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Numericfieldfontcolorb.eval()
                fontalpha: =parent.Widget.par.Numericfieldfontcolora.eval()
                dropshadow: =parent.Widget.par.Numericfielddropshadow
                textoffsetx: =parent.Widget.par.Numericfieldoffsetx.eval()
                textoffsety: =parent.Widget.par.Numericfieldoffsety.eval()
                textpaddingl: =parent.Widget.par.Numericfieldpadding1.eval()
                textpaddingr: =parent.Widget.par.Numericfieldpadding2.eval()
                textpaddingb: =parent.Widget.par.Numericfieldpadding3.eval()
                textpaddingt: =parent.Widget.par.Numericfieldpadding4.eval()
                alignx: =parent.Widget.par.Numericfieldalignx.eval()
                aligny: =parent.Widget.par.Numericfieldaligny.eval()
                hmode: fill
                vmode: fill
                clickthrough: =parent.Widget.par.clickthrough
                bgcolorr: =parent.Widget.par.Numericfieldbgcolorr
                bgcolorg: =parent.Widget.par.Numericfieldbgcolorg
                bgcolorb: =parent.Widget.par.Numericfieldbgcolorb
                bgalpha: =parent.Widget.par.Numericfieldbgcolora
                borderover: false
              flags:
              - viewer
              size: [160, 130]
            - name: panel1
              type: panelCHOP
              parameters:
                component: text
              position: [200, 0]
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [0, -200]
              size: [160, 130]
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-600, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
