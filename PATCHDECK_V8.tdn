                values: [0.56, 0.63, 0.7, 1]
              - name: Menufontcolor
                style: RGBA
                label: Menu Font Color
                default: [0.9, 0.9, 0.9, 1]
                clampMin: true
                clampMax: true
                values: [0.1, 0.1, 0.1, 1]
              - name: Menurollfontcolor
                style: RGBA
                label: Menu Roll Font Color
                default: [0.9, 0.9, 0.9, 1]
                values: [0.1, 0.1, 0.1, 1]
              - name: Menuselectfontcolor
                style: RGBA
                label: Menu Select Font Color
                default: [0.9, 0.9, 0.9, 1]
              - name: Menudisablefontcolor
                style: RGBA
                label: Menu Disable Font Color
                default: [0.4, 0.4, 0.4, 1]
                values: [0.5, 0.5, 0.5, 1]
              - name: Menuhighlightfontcolor
                style: RGBA
                label: Menu Highlight Font Color
                default: [0.9, 0.9, 0.9, 1]
                values: [0.141, 0.0957654, 0.041172, 1]
              - name: Menubordercolor
                style: RGBA
                label: Menu Border Color
              - name: Menudividercolor
                style: RGBA
                label: Menu Divider Color
                values: [0.2, 0.2, 0.2, 1]
            flags:
