            - name: Buttonlabel
              style: Str
              label: Label
              default: Push
              value: =chr(0xF004B)
            - name: Buttonfont
              style: Menu
              label: Font
              startSection: true
              default: Material Design Icons
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
            - name: Buttonfontfile
              style: File
              label: Font File
            - name: Buttonfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
