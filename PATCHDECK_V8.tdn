            Button:
              $t: button_2
              Buttonofflabel: =me.op('../../data_nul_a')[3,4]
              Buttononlabel: =me.op('../../data_nul_a')[3,4]
              Buttonfont: Open Sans
              Buttonfontsizemode: fract
              Buttonfontsize: 50
              Buttonfontfraction: 0.4
