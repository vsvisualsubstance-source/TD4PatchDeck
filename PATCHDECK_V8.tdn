              borderar: =parent.Widget.par.Slider2dbordercolorr
              borderag: =parent.Widget.par.Slider2dbordercolorg
              borderab: =parent.Widget.par.Slider2dbordercolorb
              borderaalpha: =parent.Widget.par.Slider2dbordercolora
              borderbalpha: 0
