              clampMax: true
            - name: Labelfontcolor
              style: RGBA
              label: Font Color
              default: [0.65, 0.65, 0.65, 1]
              clampMin: true
              clampMax: true
            - name: Labelhorizontalmode
              style: Menu
              label: Horizontal Mode
              startSection: true
              default: fixed
