              label: Label TOP
            - name: Labeldisplay
              style: Toggle
              label: Display
              startSection: true
              default: true
            - name: Labelwordwrap
              style: Toggle
              label: Word Wrap
              startSection: true
            - name: Labelfontsizemode
              style: Menu
              label: Font Size Mode
