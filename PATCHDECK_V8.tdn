                default: [0.1, 0.1, 0.1, 1]
                min: [1.0, 0.772, 0.498, 0.0]
                values: [0.956863, 1, 0.498039, 0.6]
              - name: Buttononfontcolor
                style: RGBA
                label: On Font Color
                default: [0.2, 0.2, 0.2, 1]
                values: [0.956863, 1, 0.498039, 0.6]
              - name: Buttonborder
