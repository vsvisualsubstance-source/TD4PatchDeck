              style: COMP
              label: stringField0
              default: ./stringField0
              readOnly: true
              value: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/masterStringField/stringField0
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, 2400]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_11
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: valueOut
            type: outDAT
            parameters:
              label: =me.name
            position: [400, 0]
            size: [130, 90]
            inputs:
            - output
            dat_read_only: true
          - name: stringField0
            type: containerCOMP
            parameters:
              w: =parent.Widget.par.Stringfieldwidth
              h: =parent.Widget.par.Stringfieldheight
              layer: 4
              hmode: =parent.Widget.par.Stringfieldhorizontalmode
              hfillweight: =parent.Widget.par.Stringfieldhfillweight
              vmode: =parent.Widget.par.Stringfieldverticalmode
              vfillweight: =parent.Widget.par.Stringfieldvfillweight
              alignorder: =-me.nodeY
              display: =parent.Widget.par.Stringfielddisplay
              helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              top: ./bg
              borderover: false
              spacing: 1
              justifyv: center
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./StringFieldExt').module.StringFieldExt(me)
            custom_pars:
              Field:
                $t: field_9
                Stringfieldcursor: true
                Stringfieldfontsizemode: relfract
                Stringfieldfontsize: 20
                Stringfieldalignx: left
                Stringfieldaligny: bottom
            flags:
            - viewer
            position: [0, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: ~getattr(parent.Widget.par, 'Value'+str(parent().digits))
                type: =('password' if parent.Widget.par.Stringfieldprotected.eval() else 'string' )
                formatting: ='customfstring' if parent.Widget.par.Stringfieldconspaces.eval() else 'default'
                customformatting: '{val.replace(" ","_")}'
                editmode: ='locked' if passive(me).panel.alt or parent.Widget.par.Stringfieldreadonly else ('editablecontinuous' if  parent.Widget.par.Stringfieldupdatewhiletyping else 'editable')
                fieldfocus: =parent.Widget.par.Stringfieldfocus.eval()
                legacyfontselection: true
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Stringfieldfontbold.eval()
                italic: =parent.Widget.par.Stringfielditalic
                scaletofit: =parent.Widget.par.Stringfieldscaletofit
                fontsize: =parent.Widget.par.Stringfieldfontsize.eval() if parent.Widget.par.Stringfieldfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Stringfieldfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Stringfieldfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Stringfieldfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Stringfieldfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Stringfieldfontcolorb.eval()
                fontalpha: =parent.Widget.par.Stringfieldfontcolora.eval()
                dropshadow: =parent.Widget.par.Stringfielddropshadow
                textoffsetx: =parent.Widget.par.Stringfieldoffsetx.eval()
                textoffsety: =parent.Widget.par.Stringfieldoffsety.eval()
                textpaddingl: =parent.Widget.par.Stringfieldpadding1.eval()
                textpaddingr: =parent.Widget.par.Stringfieldpadding2.eval()
                textpaddingb: =parent.Widget.par.Stringfieldpadding3.eval()
                textpaddingt: =parent.Widget.par.Stringfieldpadding4.eval()
                alignx: =parent.Widget.par.Stringfieldalignx.eval()
                aligny: =parent.Widget.par.Stringfieldaligny.eval()
                w: 30
                h: 30
                hmode: fill
                vmode: fill
                alignorder: =10000 - (me.nodeY)
                cursor: ='pointer' if parent.Widget.par.Stringfieldcursor.eval() else 'invisible'
                clickthrough: =parent.Widget.par.clickthrough
                bgcolorr: =parent.Widget.par.Stringfieldbgcolorr.eval()
                bgcolorg: =parent.Widget.par.Stringfieldbgcolorg.eval()
                bgcolorb: =parent.Widget.par.Stringfieldbgcolorb.eval()
                bgalpha: =parent.Widget.par.Stringfieldbgcolora.eval()
                top: ./bg
                borderar: =parent.Widget.par.Stringfieldbordercolorr.eval()
                borderag: =parent.Widget.par.Stringfieldbordercolorg.eval()
                borderab: =parent.Widget.par.Stringfieldbordercolorb.eval()
                borderaalpha: =parent.Widget.par.Stringfieldbordercolora.eval()
                leftborder: =parent.Widget.par.Stringfieldborderleft.eval()
                rightborder: =parent.Widget.par.Stringfieldborderright.eval()
                bottomborder: =parent.Widget.par.Stringfieldborderbottom.eval()
                topborder: =parent.Widget.par.Stringfieldbordertop.eval()
                borderover: false
              flags:
              - viewer
              size: [160, 130]
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [0, 200]
              size: [160, 130]
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-700, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: StringFieldExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-500, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass StringFieldExt(SubWidgetExt):\n\t\"\"\"\n\tStringFieldExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Stringfield'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef makePanelExecute(self):\n\t\toppath = parent.Widget.relativePath(self.ownerComp)[2:]\n\t\tSubWidgetExt.makePanelExecute(self, self.getDockExpressionToOwner()\n\t\t\t\t\t\t\t\t\t  + \".op('field')\")\n"
              dat_content_format: text
            - name: panelexecValue
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: ..
                panelvalue: lselect
                ontooff: true
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-500, 0]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-500, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: parexecSettings
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Stringfieldcustomizeinteraction Stringfieldhorizontalmode Stringfieldverticalmode
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-500, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
        - name: fieldFolderBrowser
