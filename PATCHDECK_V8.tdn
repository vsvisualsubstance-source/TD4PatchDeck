              - Fixed Height
              - Fill
            - name: Buttonheight
              style: Int
              label: Height
              default: 88
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
              enableExpr: me.par.Buttonverticalmode =='fixed'
              enable: false
            - name: Buttonvfillweight
