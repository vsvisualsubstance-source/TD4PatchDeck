    type: containerCOMP
    parameters:
      h: 26
      hmode: fill
      alignorder: -1
      resizecomp: =me
      bgcolorr: =parent.Embody.par.Backgroundcolorr
      bgcolorg: =parent.Embody.par.Backgroundcolorg
      bgcolorb: =parent.Embody.par.Backgroundcolorb
      bgalpha: =parent.Embody.par.Backgroundcolora
      align: horizlr
      marginl: 8
      justifyh: left
      justifyv: top
    sequences:
      ext:
      - object: op('./WindowHeaderExt').module.WindowHeaderExt(me)
        promote: true
    custom_pars:
      Header:
      - name: Headerlabel
        style: Str
        label: Label
        value: =f'Embody v{parent.Embody.par.Version}'
      Controls:
      - name: Windowcomp
        style: COMP
        label: Window COMP
        value: /Embody1/window_manager
