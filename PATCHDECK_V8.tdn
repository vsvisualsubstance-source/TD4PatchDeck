              Numericvalue1: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/slider4Rgba/numericValue1
              Numericvalue2: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/slider4Rgba/numericValue2
              Numericvalue3: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/slider4Rgba/numericValue3
