            Toxsavebuild: '2023.12141'
        flags:
        - viewer
        position: [-325, -925]
        size: [160, 76]
        comp_inputs:
        - buttons_panel_b
        children:
        - name: code
          type: baseCOMP
          parameters:
            enablecloning: false
          sequences:
