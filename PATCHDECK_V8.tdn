                  fontcolorb: =parent.Widget.par.Menufontoffcolorb
                  fontalpha: =parent.Widget.par.Menufontoffcolora
                  bgcolorr: =parent.Widget.par.Menubuttonofffacecolorr
                  bgcolorg: =parent.Widget.par.Menubuttonofffacecolorg
                  bgcolorb: =parent.Widget.par.Menubuttonofffacecolorb
                  bgalpha: =parent.Widget.par.Menubuttonofffacecolora
