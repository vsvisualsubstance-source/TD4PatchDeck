                Slider2dlabeldisplay: false
                Slider2dlabelfontsize: 9
                Slider2dlabelfontbold: false
                Slider2dbgcolor: [0.15, 0.15, 0.15, 1]
                Slider2dbordercolor: [0, 0, 0, 0.6]
                Slider2dknobcolor: [0.6, 0.6, 0.6, 1]
                Slider2dknobbordercolor: [0, 0, 0, 0.5]
                Slider2drollovercolor: [0.1, 0.1, 0.1, 1]
                Slider2dlabelfontcolor: [0.42, 0.65333, 0.7, 1]
                Slider2dwidth: 180
                Slider2dverticalmode: fill
                Slider2dheight: 129
            position: [400, -400]
            comp_inputs:
            - sliderAndLabel0
            children:
            - name: bg
              type: nullTOP
              flags:
              - viewer
              position: [700, -100]
              size: [130, 90]
              inputs:
