            - name: DropMenuExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass DropMenuExt(SubWidgetExt):\n\t\"\"\"\n\tDropMenuExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Menu'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == 'Menurunonclick':\n\t\t\tparent.Widget.par.Menucommandonclick.enable = val\n\t\telif par.name == 'Menuautowidth':\t\n\t\t\tparent.Widget.par.Menupopupwidth.enable = not par.eval()\n\t\telse:\n\t\t\tSubWidgetExt.onParSettingsChange(self, par, prev)\n\t\t\t\n"
              dat_content_format: text
            - name: buttonPush0
              type: containerCOMP
              parameters:
                w: 30
                h: 30
                hmode: fill
                vmode: fill
                alignorder: 1
                enable: =parent.Widget.par.enable
                helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
                clickthrough: =parent.Widget.par.clickthrough
                resizecomp: =me
                top: ./bg
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                borderover: false
                align: horizlr
                justifyh: left
                justifyv: center
                crop: 'on'
                parentshortcut: Value
                enablecloning: false
              sequences:
                ext:
                - object: op('./ButtonPushExt').module.ButtonPushExt(me)
                  promote: true
              custom_pars:
                Button:
                  $t: button
                  Buttonlabel: 
                  Buttonfontsize: 16
                  Buttonfontbold: true
                  Buttonalignx: center
                  Buttonalignxmode: bbox
                  Buttonaligny: center
                  Buttonalignymode: bbox
                  Buttonofffacecolor: [0.4, 0.4, 0.4, 1]
                  Buttononfacecolor: [0.6, 0.6, 0.6, 0]
                  Buttonhorizontalmode: fixed
                  Buttonwidth: 72
              flags:
              - viewer
              position: [700, -200]
              size: [160, 130]
              color: [0.5, 0.35, 0.05]
              tags:
              - TDPub
              - TDSubComp
              comp_inputs:
              - sizer
              children:
              - name: text
                type: textCOMP
                parameters:
                  text: =parent.Widget.par.Buttonlabel
                  callbacks: text1_callbacks
                  font: =parent.Widget.par.Buttonfont.eval()
                  fontfile: =parent.Widget.par.Buttonfontfile
                  bold: =parent.Widget.par.Buttonfontbold.eval()
                  scaletofit: =parent.Widget.par.Buttonscaletofit
                  fontsize: =parent.Widget.par.Buttonfontsize.eval() if parent.Widget.par.Buttonfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Buttonfontfraction.eval()
                  fontsizeunits: =parent.Widget.par.Buttonfontsizemode.eval()
                  fontcolorr: =me.par.Fontcolor.eval()[0]
                  fontcolorg: =me.par.Fontcolor.eval()[1]
                  fontcolorb: =me.par.Fontcolor.eval()[2]
                  fontalpha: =me.par.Fontcolor.eval()[3]
                  textoffsetx: =parent.Widget.par.Buttonoffsetx.eval()
                  textoffsety: =parent.Widget.par.Buttonoffsety.eval()
                  textpaddingl: =parent.Widget.par.Buttonpadding1.eval()
                  textpaddingr: =parent.Widget.par.Buttonpadding2.eval()
                  textpaddingb: =parent.Widget.par.Buttonpadding3.eval()
                  textpaddingt: =parent.Widget.par.Buttonpadding4.eval()
                  alignx: =parent.Widget.par.Buttonalignx.eval()
                  alignxmode: =parent.Widget.par.Buttonalignxmode.eval()
                  aligny: =parent.Widget.par.Buttonaligny.eval()
                  alignymode: =parent.Widget.par.Buttonalignymode.eval()
                  hmode: fill
                  clickthrough: true
                  bgcolorr: =me.par.Facecolor.eval()[0]
                  bgcolorg: =me.par.Facecolor.eval()[1]
                  bgcolorb: =me.par.Facecolor.eval()[2]
                  bgalpha: =me.par.Facecolor.eval()[3]
                  top: '=me.par.Mapon.eval() if me.par.Value else me.par.Mapoff.eval() '
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  borderover: false
                custom_pars:
                  Expressions:
                    $t: expressions_2
                    Value: =parent.Value.panel.select
                    Mapoff: =parent.Widget.par.Buttonofftop.eval()
                    Mapon: =parent.Widget.par.Buttonontop.eval()
                    Fontcolor: =parent.Widget.parGroup.Buttononfontcolor if me.par.Value else parent.Widget.parGroup.Buttonofffontcolor
                    Facecolor: =parent.Widget.parGroup.Buttononfacecolor if me.par.Value else parent.Widget.parGroup.Buttonofffacecolor
              - name: rollover
                type: containerCOMP
                parameters:
                  layer: 7
                  hmode: fill
                  vmode: fill
                  alignallow: ignore
                  display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                  clickthrough: true
                  resizecomp: =me
                  bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                  bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                  bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                  bgalpha: =parent.Widget.par.Rollovercolora.eval()
                  borderover: false
                  composite: =parent.Widget.par.Rollovercomposite.eval()
                flags:
                - viewer
                position: [0, 200]
                size: [160, 130]
              - name: SubWidgetExt
                type: textDAT
                parameters:
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [-500, 400]
                size: [130, 90]
                tags:
                - TDExtension
                dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
                dat_content_format: text
              - name: ButtonPushExt
                type: textDAT
                parameters:
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [-300, 400]
                size: [130, 90]
                tags:
                - TDExtension
                dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass ButtonPushExt(SubWidgetExt):\n\t\"\"\"\n\tButtonPushExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\tself.parPrefix = 'Button'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tSelects correct funtion based on button widget\n\t\ttype\n\t\t\"\"\"\n\t\tval = panelValue != 0\n\t\trunCommand = self.parDict['runcommand']\n\t\tcommandOn = self.parDict['commandon']\n\t\tcommandOff = self.parDict['commandoff']\n\t\tif runCommand:\n\t\t\tif val and commandOn is not None:\n\t\t\t\tself.runCommand(commandOn)\n\t\t\telif not val and commandOff is not None:\n\t\t\t\tself.runCommand(commandOff)\n\n\n"
                dat_content_format: text
              - name: panelexecValue
                type: panelexecuteDAT
                parameters:
                  active: =getattr(parent.Widget.par, ext.SubWidgetExt.parPrefix+'runcommand')
                  fromop: =me.parent()
                  panels: ..
                  panelvalue: lselect
                  ontooff: true
                  defaultreadencoding: cp1252
                  language: input
                position: [-300, 0]
                size: [130, 90]
                color: [0.05, 0.5, 0.05]
                dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
                dat_content_format: text
              - name: panelExecOPExec
                type: opexecuteDAT
                parameters:
                  op: =ext.SubWidgetExt.PanelExecPar.eval()
                flags:
                - viewer
                position: [-300, 100]
                color: [0.05, 0.5, 0.05]
                dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
                dat_content_format: text
              - name: parexecSettings
                type: parameterexecuteDAT
                parameters:
                  fromop: =me.parent()
                  op: '=parent.Widget '
                  pars: Buttonpanelexecute Buttoncustomizeinteraction
                  builtin: false
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [-300, 200]
                size: [130, 90]
                color: [0.05, 0.5, 0.05]
                comment: Execution for parameter changes
                dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
                dat_content_format: text
              - name: text1_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                - -showDocked
                position: [0, -150]
                size: [160, 130]
                dock: text
                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: execMenuDrop
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: buttonPush0
                ontooff: true
                defaultreadencoding: cp1252
                language: input
              position: [900, -200]
              size: [130, 90]
              dat_content: "# me is this DAT.\n# \n# panelValue is the PanelValue object that changed.\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef offToOn(panelValue):\n\tif not parent.Widget.par.Menuautoclose and op('popMenu').IsOpen:\n\t\top('popMenu').Close()\n\t\treturn\n\tvaluePar = getattr(parent.Widget.par, 'Value'+str(parent().digits))\n\tmenuLabels = valuePar.menuLabels\n\tmenuNames = valuePar.menuNames\n\tif menuLabels:\n\t\top('popMenu').Open(callback=menuEvent,\n\t\t\t\t\t\t\titems=menuLabels,\n\t\t\t\t\t\t\tautoClose=parent.Widget.par.Menuautoclose)\n\telse:\n\t\top('popMenu').Open(callback=menuEvent,\n\t\t\t\t\t\t   items=menuNames,\n\t\t\t\t\t\t\tautoClose=parent.Widget.par.Menuautoclose)\n\tif parent.Widget.par.Menurunonclick.eval():\n\t\tcommand = parent.Widget.par.Menucommandonclick.eval()\n\t\tif command:\n\t\t\trun(command, fromOP=parent.Widget)\n\ndef whileOn(panelValue):\n\treturn\n\ndef onToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef valueChange(panelValue):\n\treturn\n\ndef menuEvent(info):\n\tif hasattr(parent.Widget, 'SetValue'):\n\t\tparent.Widget.SetValue(info['index'])\n\telse:\n\t\tparent.Widget.par.Value0.menuIndex = info['index']\n"
              dat_content_format: text
            - name: stringField0
              type: containerCOMP
              parameters:
                w: 30
                h: 30
                layer: 4
                hmode: fill
                vmode: fill
                display: =parent.Widget.par.Stringfielddisplay
                helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
                clickthrough: =parent.Widget.par.clickthrough
                resizecomp: =me
                top: ./bg
                borderover: false
                spacing: 1
                justifyv: center
                parentshortcut: Value
                enablecloning: false
                clone: =parent(2).par.Package.eval().SubComp('TDWidgetKit', 'masterStringField/stringField0')
              sequences:
                ext:
                - object: op('./StringFieldExt').module.StringFieldExt(me)
              custom_pars:
                Field:
                  $t: field_9
                  Stringfieldcursor: true
                  Stringfieldfontsize: 10
                  Stringfieldalignx: left
                  Stringfieldaligny: bottom
                  Stringfieldbgcolor: [0.618, 0.618, 0.618, 1]
                  Stringfieldfontcolor: [0.184, 0.184, 0.184, 1]
                  Stringfieldbordercolor: [0, 0, 0, 0]
                  Stringfieldborderleft: false
                  Stringfieldborderright: false
                  Stringfieldbordertop: false
                  Stringfieldborderbottom: false
              flags:
              - viewer
              position: [400, 0]
              size: [160, 130]
              color: [0.5, 0.35, 0.05]
              tags:
              - TDPub
              - TDSubComp
              children:
              - name: text
                type: textCOMP
                parameters:
                  text: ~getattr(parent.Widget.par, 'Value'+str(parent().digits))
                  type: =('password' if parent.Widget.par.Stringfieldprotected.eval() else 'string' )
                  formatting: ='customfstring' if parent.Widget.par.Stringfieldconspaces.eval() else 'default'
                  customformatting: '{val.replace(" ","_")}'
                  editmode: ='locked' if passive(me).panel.alt or parent.Widget.par.Stringfieldreadonly else ('editablecontinuous' if  parent.Widget.par.Stringfieldupdatewhiletyping else 'editable')
                  fieldfocus: =parent.Widget.par.Stringfieldfocus.eval()
                  font: =parent.Widget.par.Font.eval()
                  fontfile: =parent.Widget.par.Fontfile
                  bold: =parent.Widget.par.Stringfieldfontbold.eval()
                  italic: =parent.Widget.par.Stringfielditalic
                  scaletofit: =parent.Widget.par.Stringfieldscaletofit
                  fontsize: =parent.Widget.par.Stringfieldfontsize.eval() if parent.Widget.par.Stringfieldfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Stringfieldfontfraction.eval()
                  fontsizeunits: =parent.Widget.par.Stringfieldfontsizemode.eval()
                  fontcolorr: =parent.Widget.par.Stringfieldfontcolorr.eval()
                  fontcolorg: =parent.Widget.par.Stringfieldfontcolorg.eval()
                  fontcolorb: =parent.Widget.par.Stringfieldfontcolorb.eval()
                  fontalpha: =parent.Widget.par.Stringfieldfontcolora.eval()
                  dropshadow: =parent.Widget.par.Stringfielddropshadow
                  textoffsetx: =parent.Widget.par.Stringfieldoffsetx.eval()
                  textoffsety: =parent.Widget.par.Stringfieldoffsety.eval()
                  textpaddingl: =parent.Widget.par.Stringfieldpadding1.eval()
                  textpaddingr: =parent.Widget.par.Stringfieldpadding2.eval()
                  textpaddingb: =parent.Widget.par.Stringfieldpadding3.eval()
                  textpaddingt: =parent.Widget.par.Stringfieldpadding4.eval()
                  alignx: =parent.Widget.par.Stringfieldalignx.eval()
                  aligny: =parent.Widget.par.Stringfieldaligny.eval()
                  w: 30
                  h: 30
                  hmode: fill
                  alignorder: =10000 - (me.nodeY)
                  cursor: ='pointer' if parent.Widget.par.Stringfieldcursor.eval() else 'invisible'
                  clickthrough: =parent.Widget.par.clickthrough
                  bgcolorr: =parent.Widget.par.Stringfieldbgcolorr.eval()
                  bgcolorg: =parent.Widget.par.Stringfieldbgcolorg.eval()
                  bgcolorb: =parent.Widget.par.Stringfieldbgcolorb.eval()
                  bgalpha: =parent.Widget.par.Stringfieldbgcolora.eval()
                  top: ./bg
                  borderar: =parent.Widget.par.Stringfieldbordercolorr.eval()
                  borderag: =parent.Widget.par.Stringfieldbordercolorg.eval()
                  borderab: =parent.Widget.par.Stringfieldbordercolorb.eval()
                  borderaalpha: =parent.Widget.par.Stringfieldbordercolora.eval()
                  leftborder: =parent.Widget.par.Stringfieldborderleft.eval()
                  rightborder: =parent.Widget.par.Stringfieldborderright.eval()
                  bottomborder: =parent.Widget.par.Stringfieldborderbottom.eval()
                  topborder: =parent.Widget.par.Stringfieldbordertop.eval()
                  borderover: false
              - name: rollover
                type: containerCOMP
                parameters:
                  layer: 7
                  hmode: fill
                  vmode: fill
                  alignallow: ignore
                  display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                  clickthrough: true
                  resizecomp: =me
                  bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                  bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                  bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                  bgalpha: =parent.Widget.par.Rollovercolora.eval()
                  borderover: false
                  composite: =parent.Widget.par.Rollovercomposite.eval()
                flags:
                - viewer
                position: [0, 200]
                size: [160, 130]
              - name: SubWidgetExt
                type: textDAT
                parameters:
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [-700, 400]
                size: [130, 90]
                tags:
                - TDExtension
                dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
                dat_content_format: text
              - name: StringFieldExt
                type: textDAT
                parameters:
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [-500, 400]
                size: [130, 90]
                tags:
                - TDExtension
                dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass StringFieldExt(SubWidgetExt):\n\t\"\"\"\n\tStringFieldExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Stringfield'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef makePanelExecute(self):\n\t\toppath = parent.Widget.relativePath(self.ownerComp)[2:]\n\t\tSubWidgetExt.makePanelExecute(self, self.getDockExpressionToOwner()\n\t\t\t\t\t\t\t\t\t  + \".op('field')\")\n"
                dat_content_format: text
              - name: panelexecValue
                type: panelexecuteDAT
                parameters:
                  fromop: =me.parent()
                  panels: ..
                  panelvalue: lselect
                  ontooff: true
                  defaultreadencoding: cp1252
                  language: input
                position: [-500, 0]
                size: [130, 90]
                color: [0.05, 0.5, 0.05]
                dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
                dat_content_format: text
              - name: panelExecOPExec
                type: opexecuteDAT
                parameters:
                  op: =ext.SubWidgetExt.PanelExecPar.eval()
                flags:
                - viewer
                position: [-500, 100]
                color: [0.05, 0.5, 0.05]
                dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
                dat_content_format: text
              - name: parexecSettings
                type: parameterexecuteDAT
                parameters:
                  fromop: =me.parent()
                  op: '=parent.Widget '
                  pars: Stringfieldcustomizeinteraction Stringfieldhorizontalmode Stringfieldverticalmode
                  builtin: false
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [-500, 200]
                size: [130, 90]
                color: [0.05, 0.5, 0.05]
                comment: Execution for parameter changes
                dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
                dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [0, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: parexecSettingsX
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Menurunonclick Menucustomizeinteraction Menuautowidth
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
          - name: in_menuOptions
            type: inDAT
            parameters:
              label: Menu Options Table
            position: [0, 200]
            dat_read_only: true
          - name: out_menu0Index
            type: outCHOP
            parameters:
              label: Selected Index
              autoexportroot: =me.parent()
            flags:
            - viewer
            position: [400, 400]
            inputs:
            - menu
          - name: out_menu2Options
            type: outDAT
            parameters:
              label: Menu Options
            flags:
            - viewer
            position: [400, 200]
            size: [130, 90]
            inputs:
            - source: menu
              out: 2
            dat_read_only: true
          - name: out_menu1Selected
            type: outDAT
            parameters:
              label: Selected
            flags:
            - viewer
            position: [400, 300]
            size: [130, 90]
            inputs:
            - source: menu
              out: 1
            dat_read_only: true
        - name: masterTextEditor
          type: widgetCOMP
          parameters:
            w: 450
            h: 128
            enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
            bgcolorr: 0.2
            bgcolorg: 0.2
            bgcolorb: 0.2
            bgalpha: 1
            borderar: 0
            borderag: 0
            borderab: 0
            borderaalpha: 0
            leftborder: bordera
            rightborder: bordera
            bottomborder: bordera
            topborder: bordera
            align: verttb
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('masterTextEditor') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Text Editor:
            - name: Editorlabel
              style: Str
              label: Label
              default: Text Editor
            - name: Editorheaderheight
              style: Int
              label: Editor Header Height
              startSection: true
              default: 31
            - name: Editorlabeldisplay
              style: Toggle
              label: Display
              startSection: true
              default: true
            - name: Editorlabelfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Editorlabelfontsize
              style: Int
              label: Font Size
              default: 12
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Editorlabelfontsizemode.eval() in ['points', 'panelunits']
            - name: Editorlabelfontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Editorlabelfontsizemode.eval() in ['fract', 'relfract']
              enable: false
            - name: Editorlabelscaletofit
              style: Menu
              label: Scale Text to Fit
              default: never
              menuNames:
              - never
              - always
              - onlyshrink
              menuLabels:
              - Never
              - Always
              - Only when Too Large
            - name: Editorlabelfontbold
              style: Toggle
              label: Font Bold
            - name: Editorlabelitalic
              style: Toggle
              label: Italic
            - name: Editorlabeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Editorlabelalignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: left
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Editorlabelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
            - name: Editorlabeloffset
              style: XYZW
              label: Offset
              size: 2
              startSection: true
              default: [6, 0]
              min: -5.0
              max: 5.0
              normMin: -5.0
              normMax: 5.0
            - name: Editorlabelpadding
              style: Float
              label: Padding
              size: 4
            - name: Editorlabelbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: [0.1, 0.1, 0.1, 1]
              clampMin: true
              clampMax: true
            - name: Editorlabelfontcolor
              style: RGBA
              label: Font Color
              default: [0.6, 0.6, 0.6, 1]
              clampMin: true
              clampMax: true
            - name: Editordat
              style: DAT
              label: Editor DAT
              startSection: true
              enable: false
            - name: Editoredit
              style: Pulse
              label: Edit
            Widget:
            - name: Enablerollover
              style: Toggle
              label: Enable Rollover
              startSection: true
              default: true
            - name: Rollovercolor
              style: RGBA
              label: Rollover Color
              default: [0.9, 0.9, 0.9, 0.15]
              enableExpr: me.par.Enablerollover.eval()
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
              menuNames:
              - over
              - under
              - inside
              - outside
              - add
              - subtract
              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
              enableExpr: me.par.Enablerollover.eval()
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: [0.2, 0.2, 0.2, 0.65]
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              enableExpr: not me.par.Fontfile
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: masterTextEditor
              enable: false
            OPs:
            - name: Texteditor
              style: COMP
              label: textEditor
              default: ./textEditor
              readOnly: true
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -1400]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: textEditor
            type: containerCOMP
            parameters:
              w: 30
              h: 30
              layer: 2
              hmode: fill
              vmode: fill
              alignorder: =-me.nodeY
              helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              top: ./bg
              borderover: false
              align: verttb
              enablecloning: false
            sequences:
              ext:
              - object: op('./TextExt').module.TextExt(me)
                promote: true
              - {}
              - {}
              - {}
              iop:
              - {}
              - {}
            custom_pars:
              Text Editor:
              - name: Editorlabel
                style: Str
                label: Label
                default: Header
                value: Editor
              - name: Editorheaderheight
                style: Int
                label: Editor Header Height
                startSection: true
                value: 26
              - name: Editorlabeldisplay
                style: Toggle
                label: Display
                startSection: true
                default: true
              - name: Editorlabelfontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
                value: relfract
              - name: Editorlabelfontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                enableExpr: me.par.Editorlabelfontsizemode.eval() in ['points', 'panelunits']
                enable: false
                value: 20
              - name: Editorlabelfontfraction
                style: Float
                label: Font Fraction
                default: 1
                enableExpr: me.par.Editorlabelfontsizemode.eval() in ['fract', 'relfract']
              - name: Editorlabelscaletofit
                style: Menu
                label: Scale Text to Fit
                default: never
                menuNames:
                - never
                - always
                - onlyshrink
                menuLabels:
                - Never
                - Always
                - Only when Too Large
              - name: Editorlabelfontbold
                style: Toggle
                label: Font Bold
              - name: Editorlabelitalic
                style: Toggle
                label: Italic
              - name: Editorlabeldropshadow
                style: Toggle
                label: Drop Shadow
              - name: Editorlabelalignx
                style: Menu
                label: Align Horizontal
                startSection: true
                default: Center
                menuNames:
                - left
                - center
                - right
                menuLabels:
                - Left
                - Center
                - Right
                value: left
              - name: Editorlabelaligny
                style: Menu
                label: Align Vertical
                default: Center
                menuNames:
                - bottom
                - center
                - top
                menuLabels:
                - Bottom
                - Center
                - Top
                value: center
              - name: Editorlabeloffset
                style: XYZW
                label: Offset
                size: 2
                startSection: true
                min: -5.0
                max: 5.0
                normMin: -5.0
                normMax: 5.0
              - name: Editorlabelpadding
                style: Float
                label: Padding
                size: 4
              - name: Editorlabelbgcolor
                style: RGBA
                label: Bg Color
                startSection: true
                default: [0.15, 0.15, 0.15, 1]
                clampMin: true
                clampMax: true
                values: [0.1, 0.1, 0.1, 1]
              - name: Editorlabelfontcolor
                style: RGBA
                label: Font Color
                default: [1, 1, 1, 0.6]
                clampMin: true
                clampMax: true
                values: [0.6, 0.6, 0.6, 1]
              - name: Editordat
                style: DAT
                label: Editor DAT
                startSection: true
              - name: Editoredit
                style: Pulse
                label: Edit
            flags:
            - viewer
            position: [0, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: opviewerCOMP
              parameters:
                opviewer: =parent.Widget.par.Editordat.eval() or ''
                helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
                clickthrough: =parent.Widget.par.clickthrough
              sequences:
                ext:
                - {}
                - {}
                - {}
                - {}
                iop:
                - {}
                - {}
              position: [0, -200]
            - name: header
              type: containerCOMP
              parameters:
                h: =parent.Widget.par.Editorheaderheight
                hmode: fill
                display: =parent.Widget.par.Editorlabeldisplay
                helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
                clickthrough: =parent.Widget.par.clickthrough
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Editorlabelbgcolorr
                bgcolorg: =parent.Widget.par.Editorlabelbgcolorg
                bgcolorb: =parent.Widget.par.Editorlabelbgcolorb
                bgalpha: =parent.Widget.par.Editorlabelbgcolora
                borderover: false
              flags:
              - viewer
              size: [160, 130]
              children:
              - name: text
                type: textCOMP
                parameters:
                  text: =parent.Widget.par.Editorlabel.eval() if parent.Widget.par.Editorlabeldisplay.eval() == 1 else ''
                  callbacks: text1_callbacks
                  font: =parent.Widget.par.Font.eval()
                  fontfile: =parent.Widget.par.Fontfile
                  bold: =parent.Widget.par.Editorlabelfontbold.eval()
                  italic: =parent.Widget.par.Editorlabelitalic
                  scaletofit: =parent.Widget.par.Editorlabelscaletofit
                  fontsize: =parent.Widget.par.Editorlabelfontsize.eval() if parent.Widget.par.Editorlabelfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Editorlabelfontfraction.eval()
                  fontsizeunits: =parent.Widget.par.Editorlabelfontsizemode.eval()
                  fontcolorr: =parent.Widget.par.Editorlabelfontcolorr.eval()
                  fontcolorg: =parent.Widget.par.Editorlabelfontcolorg.eval()
                  fontcolorb: =parent.Widget.par.Editorlabelfontcolorb.eval()
                  fontalpha: =parent.Widget.par.Editorlabelfontcolora.eval()
                  dropshadow: =parent.Widget.par.Editorlabeldropshadow
                  textoffsetx: =parent.Widget.par.Editorlabeloffsetx.eval()
                  textoffsety: =parent.Widget.par.Editorlabeloffsety.eval()
                  textpaddingl: =parent.Widget.par.Editorlabelpadding1
                  textpaddingr: =parent.Widget.par.Editorlabelpadding2
                  textpaddingb: =parent.Widget.par.Editorlabelpadding3
                  textpaddingt: =parent.Widget.par.Editorlabelpadding4
                  alignx: =parent.Widget.par.Editorlabelalignx.eval()
                  aligny: =parent.Widget.par.Editorlabelaligny.eval()
                  hmode: fill
                  clickthrough: true
                  borderover: false
                position: [300, 0]
              - name: text1_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                - -showDocked
                position: [300, -150]
                size: [160, 130]
                dock: text
                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: TextExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, 100]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "\"\"\"\nExtension classes enhance TouchDesigner components with python. An\nextension is accessed via ext.ExtensionClassName from any operator\nwithin the extended component. If the extension is promoted via its\nPromote Extension parameter, all its attributes with capitalized names\ncan be accessed externally, e.g. op('yourComp').PromotedFunction().\n\nHelp: search \"Extensions\" in wiki\n\"\"\"\n\nfrom TDStoreTools import StorageManager\nTDF = op.TDModules.mod.TDFunctions\n\nclass TextExt:\n\t\"\"\"\n\tTextExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\n\t@property\n\tdef editComp(self):\n\t\treturn self.ownerComp.par.Editordat.eval() or None\n\n\tdef edit(self):\n\t\teditorDATPar = self.ownerComp.parent.Widget.par.Editordat\n\t\tif not editorDATPar.eval():\n\t\t\teditorDAT = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\t\t\t\t\t\t\t\t\t\t\ttextDAT, 'editorText')\n\t\t\teditorDAT.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\teditorDAT.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\teditorDAT.dock = self.ownerComp.parent.Widget\n\t\t\teditorDAT.viewer = True\n\t\t\teditorDATPar.val = editorDAT.name\n\t\t\teditorDATPar.enable = True\n\t\t\teditorDATPar.readOnly = True\n\t\t\tself.ownerComp.op('editorTextOPExec').cook(force=True)\n\t\teditorDATPar.eval().par.edit.pulse()\n\n"
              dat_content_format: text
            - name: parexec1
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: Editoredit
                valuechange: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, -100]
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n# \n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef onValueChange(par, prev):\n\t# use par.eval() to get current value\n\treturn\n\ndef onPulse(par):\n\tif par.name == 'Editoredit':\n\t\text.TextExt.edit()\n\ndef onExpressionChange(par, val, prev):\n\treturn\n\ndef onExportChange(par, val, prev):\n\treturn\n\ndef onEnableChange(par, val, prev):\n\treturn\n\ndef onModeChange(par, val, prev):\n\treturn\n\t"
              dat_content_format: text
            - name: editorTextOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Editordat.eval()
              flags:
              - viewer
              position: [-200, -200]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Editordat.val = ''\n\tparent.Widget.par.Editordat.enable = False\t"
              dat_content_format: text
        - name: masterValueLabel
