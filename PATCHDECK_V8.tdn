              bottomborder: bordera
              topborder: bordera
              justifyh: center
              justifyv: center
              crop: 'off'
            sequences:
              ext:
              - object: op('./KnobExt').module.KnobExt(me)
                promote: true
            custom_pars:
              Knob:
                $t: knob_2
