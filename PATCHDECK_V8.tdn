              label: On To Off Script 0
            - name: Offtoonscript0
              style: Str
              label: Off To On Script 0
            - name: Valname1
              style: Str
              label: Name 1
              startSection: true
              default: Value1
            - name: Onvaluechangescript1
              style: Str
              label: On Value Change Script 1
            - name: Ontooffscript1
              style: Str
              label: On To Off Script 1
            - name: Offtoonscript1
              style: Str
              label: Off To On Script 1
            - name: Valname2
              style: Str
              label: Name 2
              startSection: true
              default: Value2
            - name: Onvaluechangescript2
              style: Str
              label: On Value Change Script 2
            - name: Ontooffscript2
              style: Str
              label: On To Off Script 2
            - name: Offtoonscript2
              style: Str
              label: Off To On Script 2
            - name: Createeditvalueparexec
              style: Pulse
              label: Create/Edit Value Par Exec
              startSection: true
            - name: Valueparexec
              style: DAT
              label: Value Par Exec
              readOnly: true
            Label:
