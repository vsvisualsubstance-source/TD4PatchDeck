              - Only when Too Large
            - name: Labelfontbold
              style: Toggle
              label: Font Bold
            - name: Labelitalic
              style: Toggle
              label: Italic
            - name: Labeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Labelalignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: left
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Labelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
