              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
              enableExpr: me.par.Enablerollover.eval()
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: [0.2, 0.2, 0.2, 0.65]
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              enableExpr: not me.par.Fontfile
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: masterValueLabel
              enable: false
            OPs:
            - name: Valuelabel0
              style: COMP
              label: valueLabel0
              default: ./valueLabel0
              readOnly: true
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -1600]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: valueLabel0
            type: containerCOMP
            parameters:
              w: =parent.Widget.par.Valuelabelwidth
              h: =parent.Widget.par.Valuelabelheight
              layer: 1
              hmode: =parent.Widget.par.Valuelabelhorizontalmode
              hfillweight: =parent.Widget.par.Valuelabelhfillweight
              vmode: =parent.Widget.par.Valuelabelverticalmode
              vfillweight: =parent.Widget.par.Valuelabelvfillweight
              display: =parent.Widget.par.Valuelabeldisplay
              helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
              clickthrough: =parent.Widget.par.clickthrough
              uvbuttonsleft: false
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Valuelabelbgcolorr
              bgcolorg: =parent.Widget.par.Valuelabelbgcolorg
              bgcolorb: =parent.Widget.par.Valuelabelbgcolorb
              bgalpha: =parent.Widget.par.Valuelabelbgcolora
              borderover: false
              enablecloning: false
            custom_pars:
              Value Label:
              - name: Valuelabel
                style: Str
                label: Value Label
                default: Label
              - name: Valuelabeltop
                style: TOP
                label: Value Label TOP
              - name: Valuelabeldisplay
                style: Toggle
                label: Display
                startSection: true
                default: true
              - name: Valuelabelwordwrap
                style: Toggle
                label: Word Wrap
                startSection: true
              - name: Valuelabelfontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
                value: relfract
              - name: Valuelabelfontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                enableExpr: me.par.Valuelabelfontsizemode.eval() in ['points', 'panelunits']
                enable: false
                value: 20
              - name: Valuelabelfontfraction
                style: Float
                label: Font Fraction
                default: 1
                enableExpr: me.par.Valuelabelfontsizemode.eval() in ['fract', 'relfract']
              - name: Valuelabelscaletofit
                style: Menu
                label: Scale Text to Fit
                default: never
                menuNames:
                - never
                - always
                - onlyshrink
                menuLabels:
                - Never
                - Always
                - Only when Too Large
              - name: Valuelabelfontbold
                style: Toggle
                label: Font Bold
              - name: Valuelabelitalic
                style: Toggle
                label: Italic
              - name: Valuelabeldropshadow
                style: Toggle
                label: Drop Shadow
              - name: Valuelabelalignx
                style: Menu
                label: Align Horizontal
                startSection: true
                default: Center
                menuNames:
                - left
                - center
                - right
                menuLabels:
                - Left
                - Center
                - Right
                value: left
              - name: Valuelabelaligny
                style: Menu
                label: Align Vertical
                default: Center
                menuNames:
                - bottom
                - center
                - top
                menuLabels:
                - Bottom
                - Center
                - Top
                value: bottom
              - name: Valuelabeloffset
                style: XYZW
                label: Offset
                size: 2
                startSection: true
                min: -5.0
                max: 5.0
                normMin: -5.0
                normMax: 5.0
              - name: Valuelabelpadding
                style: Float
                label: Padding
                size: 4
              - name: Valuelabelbgcolor
                style: RGBA
                label: Bg Color
                startSection: true
                default: [0.3, 0.3, 0.3, 1]
                clampMin: true
                clampMax: true
                values: [0.2, 0.2, 0.2, 1]
              - name: Valuelabelfontcolor
                style: RGBA
                label: Font Color
                default: [0.7, 0.7, 0.7, 1]
                clampMin: true
                clampMax: true
                values: [0.65, 0.65, 0.65, 1]
              - name: Valuelabelhorizontalmode
                style: Menu
                label: Horizontal Mode
                startSection: true
                default: fixed
                menuNames:
                - fixed
                - fill
                menuLabels:
                - Fixed Width
                - Fill
              - name: Valuelabelwidth
                style: Int
                label: Width
                default: 88
                min: 1.0
                max: 300.0
                clampMin: true
                normMin: 1.0
                normMax: 300.0
              - name: Valuelabelhfillweight
                style: Float
                label: Horizontal Fill Weight
                default: 1
                clampMin: true
              - name: Valuelabelverticalmode
                style: Menu
                label: Vertical Mode
                default: fixed
                menuNames:
                - fixed
                - fill
                menuLabels:
                - Fixed Height
                - Fill
              - name: Valuelabelheight
                style: Int
                label: Height
                default: 88
                min: 1.0
                max: 300.0
                clampMin: true
                normMin: 1.0
                normMax: 300.0
              - name: Valuelabelvfillweight
                style: Float
                label: Vertical Fill Weight
                default: 1
                clampMin: true
            flags:
            - viewer
            position: [0, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: =parent.Widget.par.Valuelabel.eval()
                type: multiline
                wordwrap: =parent.Widget.par.Valuelabelwordwrap.eval()
                callbacks: text1_callbacks
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Valuelabelfontbold.eval()
                italic: =parent.Widget.par.Valuelabelitalic
                scaletofit: =parent.Widget.par.Valuelabelscaletofit
                fontsize: =parent.Widget.par.Valuelabelfontsize.eval() if parent.Widget.par.Valuelabelfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Valuelabelfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Valuelabelfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Valuelabelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Valuelabelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Valuelabelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Valuelabelfontcolora.eval()
                dropshadow: =parent.Widget.par.Valuelabeldropshadow
                textoffsetx: =parent.Widget.par.Valuelabeloffsetx.eval()
                textoffsety: =parent.Widget.par.Valuelabeloffsety.eval()
                textpaddingl: =parent.Widget.par.Valuelabelpadding1.eval()
                textpaddingr: =parent.Widget.par.Valuelabelpadding2.eval()
                textpaddingb: =parent.Widget.par.Valuelabelpadding3.eval()
                textpaddingt: =parent.Widget.par.Valuelabelpadding4.eval()
                alignx: =parent.Widget.par.Valuelabelalignx.eval()
                aligny: =parent.Widget.par.Valuelabelaligny.eval()
                hmode: fill
                bottomanchor: 0.039
                clickthrough: true
                top: =parent.Widget.par.Valuelabeltop.eval()
                borderover: false
              position: [0, -200]
            - name: parexecRunCommand
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: =parent.Widget
                pars: Valuelabelhorizontalmode Valuelabelverticalmode
                onpulse: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n#\n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef valueChange(par, val, prev):\n\tif par.name == 'Valuelabelhorizontalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Valuelabelhfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Valuelabelwidth, 'enable', bool(1-val))\n\telif par.name == 'Valuelabelverticalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Valuelabelvfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Valuelabelheight, 'enable', bool(1-val))\n\treturn\n\ndef onPulse(par):\n\treturn\n\ndef expressionChange(par, val, prev):\n\treturn\n\ndef exportChange(par, val, prev):\n\treturn\n\ndef enableChange(par, val, prev):\n\treturn\n\ndef modeChange(par, val, prev):\n\treturn\n"
              dat_content_format: text
        - name: popMenuCallbacks
          type: textDAT
          parameters:
            defaultreadencoding: cp1252
            language: python
          flags:
          - viewer
          position: [200, -600]
          size: [130, 90]
          dock: masterIconMenu
          dat_content: "\"\"\"\nPopMenu callbacks\n\nCallbacks always take a single argument, which is a dictionary\nof values relevant to the callback. Print this dictionary to see what is\nbeing passed. The keys explain what each item is.\n\nPopMenu info keys:\n\t'cell': either cell id or -1 for no cell\n\t'item': the item label in the menu list\n\t'row': the row from the wired dat input, if applicable\n\t'details': details provided by object that caused menu to open\n\"\"\"\n\ndef onSelect(info):\n\t\"\"\"\n\tUser selects a menu option\n\t\"\"\"\n\tdebug('test')\n\ndef onRollover(info):\n\t\"\"\"\n\tMouse rolled over an item\n\t\"\"\"\n\ndef onOpen(info):\n\t\"\"\"\n\tMenu opened\n\t\"\"\"\n\ndef onClose(info):\n\t\"\"\"\n\tMenu closed\n\t\"\"\"\n\ndef onMouseDown(info):\n\t\"\"\"\n\tItem pressed\n\t\"\"\"\n\ndef onMouseUp(info):\n\t\"\"\"\n\tItem released\n\t\"\"\"\n\ndef onClick(info):\n\t\"\"\"\n\tItem pressed and released\n\t\"\"\"\n\tdebug('info')\n\ndef onLostFocus(info):\n\t\"\"\"\n\tMenu lost focus\n\t\"\"\""
          dat_content_format: text
        - name: topMenuCallbacks
          type: textDAT
          parameters:
            language: python
          flags:
          - viewer
          - -showDocked
          position: [200, -5800]
          size: [130, 90]
          dock: topMenu
          dat_content: "\"\"\"\nTopMenu callbacks\n\nCallbacks always take a single argument, which is a dictionary\nof values relevant to the callback. Print this dictionary to see what is\nbeing passed. The keys explain what each item is.\n\nTopMenu info keys:\n\t'widget': the TopMenu widget\n\t'item': the item label in the menu list\n\t'index': either menu index or -1 for none\n\t'indexPath': list of parent menu indexes leading to this item\n\t'define': TopMenu define DAT definition info for this menu item\n\t'menu': the popMenu component inside topMenu\n\"\"\"\n\n#################################\n# exampleMenuDefine callbacks\n\ndef onQuit(info):\n\t\"\"\"\n\tA simple menu item callback, named in the Top Menu DAT table\n\t\"\"\"\n\tdebug('QUIT!')\n\nguides = False\ngrid = True\n\ndef onSetting(info):\n\t\"\"\"\n\tA menu item callback that works on multiple menu items. The checkboxes in\n\tthe menu evaluate the global guides and grid variables above to determine\n\ttheir state. The expressions used to evaluate the checkbox state are\n\tdefined in the Top Menu DAT.\n\t\"\"\"\n\tglobal guides, grid\n\tif info['item'] == 'Show Guides':\n\t\tguides = not guides\n\telif info['item'] == 'Show Grid':\n\t\tgrid = not grid\n\ndef getRecentFiles(info):\n\t\"\"\"\n\tA rowCallback used in the Top Menu DAT table to automatically generate rows.\n\tThese callbacks must return a dictionary or list of dictionaries that mimic\n\tthe columns in the Top Menu DAT. Dictionaries only need the columns with\n\tdata in them, but must have corresponding columns in the Top Menu DAT in\n\torder to be recognized.\n\t\"\"\"\n\treturn [\n\t\t{'item2': 'File 1'},\n\t\t{'item2': 'File 2', 'highlight': True},\n\t\t{'item2': 'File three', 'dividerAfter': True}\n\t]\n\n# end examples\n####################################\n\n# standard menu callbacks\n\ndef onSelect(info):\n\t\"\"\"\n\tUser selects a menu option\n\t\"\"\"\n\tdebug(info)\n\ndef onRollover(info):\n\t\"\"\"\n\tMouse rolled over an item\n\t\"\"\"\n\ndef onOpen(info):\n\t\"\"\"\n\tMenu opened\n\t\"\"\"\n\ndef onClose(info):\n\t\"\"\"\n\tMenu closed\n\t\"\"\"\n\ndef onMouseDown(info):\n\t\"\"\"\n\tItem pressed\n\t\"\"\"\n\ndef onMouseUp(info):\n\t\"\"\"\n\tItem released\n\t\"\"\"\n\ndef onClick(info):\n\t\"\"\"\n\tItem pressed and released\n\t\"\"\"\n\ndef onLostFocus(info):\n\t\"\"\"\n\tMenu lost focus\n\t\"\"\""
          dat_content_format: text
        - name: masterRadioButton
          type: widgetCOMP
