            type: constantCHOP
            parameters:
              autoexportroot: =parent()
            sequences:
              const:
              - name: d
                value: 52.294203091
              - name: env
                value: 0.0106959359
              - name: heroz
                value: -88.9964
              - name: heros
            position: [0, -250]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: window
            type: windowCOMP
            parameters:
              winop: /project1/flux/OUT
              title: =me
              winw: 1280
              winh: 720
            position: [4725, -500]
          - name: flux_ui
            type: parameterexecuteDAT
            parameters:
              fromop: =parent()
              op: /project1/flux
              pars: Inject Send Edit*
              builtin: false
            position: [0, 150]
            size: [130, 90]
            dat_content: |
              # flux_ui — pulsanti e testo live del pannello flux


              def _send(comp):
                  msg = comp.par.Inject.eval().strip()
                  if not msg:
                      return
                  q = comp.op('inject_flux')
                  if q is not None:
                      q.text = (q.text + '\n' if q.text else '') + comp.par.Injectto.eval() + '\t' + msg
                  if comp.par.Injectclear.eval():
                      comp.par.Inject.val = ''


              def _open(d):
                  if d is None:
                      return
                  try:
                      d.par.edit.pulse()
                  except Exception:
                      d.openViewer()


              def onPulse(par):
                  comp = par.owner
                  if par.name == 'Send':
                      _send(comp)
                  elif par.name == 'Editflux':
                      _open(comp.op('src_flux'))
                  elif par.name == 'Edittexttt':
                      path = comp.par.Sourcecomp.eval()
                      src = comp.op(path) if path else None
                      _open(src.op('src_all') if src is not None else None)
                  return


              def onValueChange(par, prev):
                  if par.name == 'Inject' and par.eval().strip():
                      _send(par.owner)
                  return


              def onExpressionChange(*args):
                  return

              def onExportChange(*args):
                  return

              def onEnableChange(*args):
                  return

              def onModeChange(*args):
                  return
            dat_content_format: text
