            - name: popMenu
              type: containerCOMP
              parameters:
                w: =( parent().width if parent.Widget.par.Menuautowidth else parent.Widget.par.Menupopupwidth.eval() ) if parent.Widget.par.Menucustomwidth == False else parent.Widget.par.Menuwidth
                h: =me.OptimalHeight
                layer: 100
                alignallow: ignore
                display: false
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Menubgcolorr
                bgcolorg: =parent.Widget.par.Menubgcolorg
                bgcolorb: =parent.Widget.par.Menubgcolorb
                bgalpha: =parent.Widget.par.Menubgcolora
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                justifyh: left
                justifyv: bottom
                parentshortcut: Menu
                clone: =op.TDTox.op('popMenu')
                overlay: true
                x: 0
                y: 0
                borderover: true
                opviewer: ./out1
                relpath: inherit
              sequences:
                ext:
                - object: me.mod.PopMenuExt.PopMenuExt(me)
                  promote: true
                - object: me.mod.CallbacksExt.CallbacksExt(me)
                  promote: true
                - {}
                - {}
                iop:
                - {}
                - {}
              custom_pars:
                Pop Menu:
                  $t: pop_menu
                  Inputtable: RowAll_Col0
                  Items: '[''\U000f03a1'', ''\U000f03a4'', ''\U000f03a7'', ''\U000f03aa'']'
                  Highlighteditems: '[]'
                  Disableditems: '[]'
                  Dividersafteritems: '[]'
                  Checkeditems: '[]'
                  Shortcuts: '{}'
                  Maxheight: 600
                  Borders: true
                  Horizontalalign: =parent.Widget.par.Menuhorizontalalign
                  Verticalalign: =parent.Widget.par.Menuverticalalign
                  Alignoffset:
                  - =parent.Widget.par.Menualignoffset1
                  - =parent.Widget.par.Menualignoffset2
                  Buttoncomp: ..
                  Horizontalattach: Left
                  Verticalattach: Bottom
                Advanced:
                  $t: advanced
                  Printcallbacks: =parent.Widget.par.Printcallbacks
                  Callbackdat: =parent.Widget.par.Callbackdat
                  Configcomp: config
                  Windowcomp: ./window
                  Includedialog: false
                  Allowstickysubmenus: true
                About:
                  $t: about_3
                  Version: 1.3.0
                  Toxsavebuild: '2023.11831'
              flags:
              - viewer
              position: [0, -200]
              size: [160, 130]
              palette_clone: true
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                clickthrough: true
