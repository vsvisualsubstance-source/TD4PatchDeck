            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('masterSlider2D') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
            - name: Value0
              style: Float
              label: Value 0
              default: 0.5
              clampMin: true
              clampMax: true
            - name: Value1
              style: Float
              label: Value 1
              default: 0.5
              clampMin: true
              clampMax: true
            - name: Valname0
              style: Str
              label: Name 0
              startSection: true
              default: ValueX7
            - name: Onvaluechangescript0
              style: Str
              label: On Value Change Script 0
            - name: Ontooffscript0
              style: Str
              label: On To Off Script 0
            - name: Offtoonscript0
              style: Str
              label: Off To On Script 0
            - name: Valname1
              style: Str
              label: Name 1
              startSection: true
              default: ValueY7
            - name: Onvaluechangescript1
              style: Str
              label: On Value Change Script 1
            - name: Ontooffscript1
              style: Str
              label: On To Off Script 1
            - name: Offtoonscript1
              style: Str
              label: Off To On Script 1
            - name: Createeditvalueparexec
              style: Pulse
              label: Create/Edit Value Par Exec
              startSection: true
            - name: Valueparexec
              style: DAT
              label: Value Par Exec
              readOnly: true
            2DSlider:
            - name: Slider2dbehavior
              style: Menu
              label: Slider Behavior
              startSection: true
              default: stick
              menuNames:
              - regular
              - stick
              menuLabels:
              - Regular
              - Stick
              help: Regular will hold the value it was last changed to, while Stickmode will return the value to the default value when the selection is released.
            - name: Slider2dlabelname
              style: Str
              label: Label Name
              startSection: true
              default: XY
            - name: Slider2dlabeldisplay
              style: Toggle
              label: Label Display
              startSection: true
            - name: Slider2dlabelalignhorizontal
              style: Menu
              label: Label Align Horizontal
              startSection: true
              default: center
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Slider2dlabelalignvertical
              style: Menu
              label: Label Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
            - name: Slider2dknobsize
              style: Int
              label: Knob Size
              startSection: true
              default: 12
              max: 40.0
              normMax: 40.0
            - name: Slider2dlabelfontsize
              style: Int
              label: Label Font Size
              startSection: true
              default: 9
              min: 6.0
              max: 24.0
              clampMin: true
              normMin: 6.0
              normMax: 24.0
            - name: Slider2dlabelfontbold
              style: Toggle
              label: Label Font Bold
            - name: Slider2dbgtop
              style: TOP
              label: BG TOP
              startSection: true
            - name: Slider2dknobtop
              style: TOP
              label: Knob TOP
            - name: Slider2dbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: 0.09091
            - name: Slider2dbordercolor
              style: RGBA
              label: Border Color
            - name: Slider2dknobcolor
              style: RGBA
              label: Knob Color
              default: 0.4
            - name: Slider2dknobbordercolor
              style: RGBA
              label: Knob Border Color
              default: 0.7
            - name: Slider2drollovercolor
              style: RGBA
              label: Rollover Color
              default: 0.1
            - name: Slider2dlabelfontcolor
              style: RGBA
              label: Label Font Color
              default: 0.42
            - name: Slider2dhorizontalmode
              style: Menu
              label: Horizontal Mode
              startSection: true
              default: fill
              menuNames:
              - fixed
              - fill
              menuLabels:
              - Fixed Width
              - Fill
            - name: Slider2dwidth
              style: Int
              label: Width
              default: 180
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
            - name: Slider2dhfillweight
              style: Float
              label: Horizontal Fill Weight
              default: 1
              clampMin: true
            - name: Slider2dverticalmode
              style: Menu
              label: Vertical Mode
              default: fill
              menuNames:
              - fixed
              - fill
              menuLabels:
              - Fixed Height
              - Fill
            - name: Slider2dheight
              style: Int
              label: Height
              default: 129
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
            - name: Slider2dvfillweight
              style: Float
              label: Vertical Fill Weight
              default: 1
              clampMin: true
            - name: Slider2dcustomizeinteraction
              style: Pulse
              label: Customize Interaction
              startSection: true
            - name: Slider2dpanelexec
              style: DAT
              label: Panel Exec
              readOnly: true
            Widget:
            - name: Enablerollover
              style: Toggle
              label: Enable Rollover
              startSection: true
              default: true
            - name: Rollovercolor
              style: RGBA
              label: Rollover Color
              default: 0.9
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
              menuNames:
              - over
              - under
              - inside
              - outside
              - add
              - subtract
              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: 0.2
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: masterSlider2D
            OPs:
            - name: Op2dslider0
              style: COMP
              label: 2Dslider0
              default: ./2Dslider0
              readOnly: true
              value: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/masterSlider2D/2Dslider0
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_11
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: valueOut
            type: outCHOP
            parameters:
              label: =me.name
              autoexportroot: =parent()
            position: [400, 0]
            inputs:
            - output
          - name: 2Dslider0
            type: sliderCOMP
            parameters:
              w: =parent.Widget.par.Slider2dwidth
              h: =parent.Widget.par.Slider2dheight
              hmode: =parent.Widget.par.Slider2dhorizontalmode
              hfillweight: =parent.Widget.par.Slider2dhfillweight
              vmode: =parent.Widget.par.Slider2dverticalmode
              vfillweight: =parent.Widget.par.Slider2dvfillweight
              alignorder: 1
              helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
              bgcolorr: =parent.Widget.par.Slider2dbgcolorr
              bgcolorg: =parent.Widget.par.Slider2dbgcolorg
              bgcolorb: =parent.Widget.par.Slider2dbgcolorb
              bgalpha: =parent.Widget.par.Slider2dbgcolora
              borderar: =parent.Widget.par.Slider2dbordercolorr
              borderag: =parent.Widget.par.Slider2dbordercolorg
              borderab: =parent.Widget.par.Slider2dbordercolorb
              borderaalpha: =parent.Widget.par.Slider2dbordercolora
              borderbalpha: 0
              leftborder: bordera
              rightborder: bordera
              bottomborder: bordera
              topborder: bordera
            sequences:
              ext:
              - object: op('./Slider2DExt').module.Slider2DExt(me)
            custom_pars:
              2DSlider:
                $t: 2dslider
                Slider2dbehavior: stick
                Slider2dlabeldisplay: false
                Slider2dlabelfontsize: 9
                Slider2dlabelfontbold: false
                Slider2dbgcolor: [0.09091, 0.09091, 0.09091, 1]
                Slider2dbordercolor: [0, 0, 0, 0.6]
                Slider2dknobcolor: [0.3, 0.46666, 0.5, 1]
                Slider2dknobbordercolor: [0, 0, 0, 0.5]
                Slider2drollovercolor: [0.1, 0.1, 0.1, 1]
                Slider2dlabelfontcolor: [0.42, 0.65333, 0.7, 1]
                Slider2dhorizontalmode: fill
                Slider2dwidth: 180
                Slider2dverticalmode: fill
                Slider2dheight: 129
            position: [0, -200]
            children:
            - name: bg
              type: nullTOP
              flags:
              - viewer
              position: [700, -100]
              size: [130, 90]
              inputs:
              - over1
            - name: knob
              type: containerCOMP
              parameters:
                x: =tdu.remap(getattr(parent.Widget.par, 'Value'+str(parent().digits*2)).eval(), getattr(parent.Widget.par, 'Value'+ str(parent().digits)).normMin, getattr(parent.Widget.par, 'Value'+ str(parent().digits)).normMax, 0, parent().width - parent.Widget.par.Slider2dknobsize.eval())
                y: =tdu.remap(getattr(parent.Widget.par, 'Value'+str(parent().digits*2+1)).eval(), getattr(parent.Widget.par, 'Value'+str(parent().digits*2+1)).normMin, getattr(parent.Widget.par, 'Value'+str(parent().digits*2+1)).normMax, 0, parent().height - parent.Widget.par.Slider2dknobsize.eval())
                w: =parent.Widget.par.Slider2dknobsize.eval()
                h: =parent.Widget.par.Slider2dknobsize.eval()
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Slider2dknobcolorr
                bgcolorg: =parent.Widget.par.Slider2dknobcolorg
                bgcolorb: =parent.Widget.par.Slider2dknobcolorb
                bgalpha: =parent.Widget.par.Slider2dknobcolora
                top: knobBg
                borderar: =parent.Widget.par.Slider2dknobbordercolorr
                borderag: =parent.Widget.par.Slider2dknobbordercolorg
                borderab: =parent.Widget.par.Slider2dknobbordercolorb
                borderaalpha: =parent.Widget.par.Slider2dknobbordercolora
                borderbalpha: 0
                leftborder: bordera
                rightborder: bordera
                bottomborder: bordera
                topborder: bordera
                borderover: false
              flags:
              - viewer
              size: [160, 130]
              children:
              - name: bg
                type: rectangleTOP
                parameters:
                  sizex: 1
                  sizey: 1
                  fillcolorr: =parent.Widget.par.Slider2dknobcolorr
                  fillcolorg: =parent.Widget.par.Slider2dknobcolorg
                  fillcolorb: =parent.Widget.par.Slider2dknobcolorb
                  fillalpha: =parent.Widget.par.Slider2dknobcolora
                  borderr: =parent.Widget.par.Slider2dknobbordercolorr
                  borderg: =parent.Widget.par.Slider2dknobbordercolorg
                  borderb: =parent.Widget.par.Slider2dknobbordercolorb
                  borderalpha: =parent.Widget.par.Slider2dknobbordercolora
                  borderwidth: 1
                  borderwidthunit: pixels
                  antialias: false
                  outputresolution: parpanel
                  outputaspect: resolution
                  format: rgba8fixed
                flags:
                - viewer
                size: [130, 90]
            - name: label
              type: textTOP
              parameters:
                text: =parent.Widget.par.Slider2dlabelname if parent.Widget.par.Slider2dlabeldisplay else ''
                legacyparsing: true
                chopvaluereplace: true
                legacyfontselection: true
                font: =parent.Widget.par.Font.eval()
                bold: =parent.Widget.par.Slider2dlabelfontbold.eval()
                antialias: aa8mid
                fontsizex: =parent.Widget.par.Slider2dlabelfontsize.eval()
                alignx: =parent.Widget.par.Slider2dlabelalignhorizontal.eval()
                aligny: =parent.Widget.par.Slider2dlabelalignvertical.eval()
                borderspace1: 3
                borderspace2: 3
                fontcolorr: =parent.Widget.par.Slider2dlabelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Slider2dlabelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Slider2dlabelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Slider2dlabelfontcolora.eval()
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                outputresolution: parpanel
                resolutionw: 128
                resolutionh: 128
              flags:
              - viewer
              position: [300, 0]
              size: [130, 90]
            - name: over1
              type: overTOP
              parameters:
                size: input1
                legacyxform: true
              flags:
              - viewer
              position: [500, -100]
              size: [130, 90]
              inputs:
              - label
              - sliderBg
            - name: knobBg
              type: selectTOP
              parameters:
                top: =parent.Widget.par.Slider2dknobtop.eval() or ''
              flags:
              - viewer
              position: [0, -200]
              size: [130, 90]
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [0, 300]
              size: [160, 130]
            - name: sliderBg
              type: selectTOP
              parameters:
                top: =parent.Widget.par.Slider2dbgtop.eval() or ''
              flags:
              - viewer
              position: [300, -200]
              size: [130, 90]
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                fromop: =parent()
                panels: =parent()
              flags:
              - viewer
              position: [-1275, -175]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# prev - the previous value of the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onOffToOn(panelValue):\n\treturn\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue, prev):\n\treturn\n\t"
              dat_content_format: text
            - name: Slider2DExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-700, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass Slider2DExt(SubWidgetExt):\n\t\"\"\"\n\tSlider2DExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Slider2d'\n\t\tSubWidgetExt.__init__(self, ownerComp)"
              dat_content_format: text
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-900, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: widgetScriptU
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: =parent()
                panelvalue: u lselect
                offtoon: false
                ontooff: =parent.Widget.par.Slider2dbehavior == 'stick'
                valuechange: true
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-1400, 0]
              size: [130, 90]
              color: [0.2, 0.5, 0.05]
              dat_content: "def onOffToOn(panelValue):\n\treturn\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\tif panelValue.name == 'lselect':\n\t\tid = panelValue.owner.digits*2\n\t\tdefault = getattr(parent.Widget.par, 'Value'+ str(id)).default\n\t\tgetattr(parent.Widget.par, 'Value'+ str(id)).normVal = default \n\ndef whileOff(panelValue):\n\treturn\n\ndef valueChange(panelValue):\n\tif panelValue.name == 'u':\n\t\tid = panelValue.owner.digits*2\n\t\tgetattr(parent.Widget.par, 'Value'+ str(id)).normVal = panelValue.val\n"
              dat_content_format: text
            - name: widgetScriptV
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: =parent()
                panelvalue: v lselect
                offtoon: false
                ontooff: =parent.Widget.par.Slider2dbehavior == 'stick'
                valuechange: true
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-1200, 0]
              size: [130, 90]
              color: [0.2, 0.5, 0.05]
              dat_content: "def onOffToOn(panelValue):\n\treturn\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\tif panelValue.name == 'lselect':\n\t\tid = (panelValue.owner.digits*2+1)\n\t\tdefault = getattr(parent.Widget.par, 'Value'+ str(id)).default\n\t\tgetattr(parent.Widget.par, 'Value'+ str(id)).normVal = default\n\ndef whileOff(panelValue):\n\treturn\n\ndef valueChange(panelValue):\n\tif panelValue.name == 'v':\n\t\tid = (panelValue.owner.digits*2+1)\n\t\tgetattr(parent.Widget.par, 'Value'+ str(id)).normVal = panelValue.val\n\t"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-1000, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: panelexecValueX
              type: panelexecuteDAT
              parameters:
                active: false
                fromop: =me.parent()
                panels: =parent()
                panelvalue: ='select ' + 'v'
                valuechange: true
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-1000, 0]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: parexecSettings
              type: parameterexecuteDAT
              parameters:
                active: false
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Slider2druncommand Slider2dpanelexecute
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-700, 200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n# \n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef valueChange(par, val, prev):\n\text.Slider2DExt.onParSettingsChange(par, val, prev)\n\ndef onPulse(par):\n\text.Slider2DExt.onParSettingsPulse(par)\n\ndef expressionChange(par, val, prev):\n\treturn\n\ndef exportChange(par, val, prev):\n\treturn\n\ndef enableChange(par, val, prev):\n\treturn\n\ndef modeChange(par, val, prev):\n\treturn\n\t"
              dat_content_format: text
            - name: parexecSettingsX
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Slider2dcustomizeinteraction Slider2dhoriz* Slider2dvert*
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-1000, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
            - name: parexecValueChange
              type: parameterexecuteDAT
              parameters:
                active: false
                fromop: =me.parent()
                op: =parent.Widget
                pars: ='Value' + str(parent().digits) + ' ' + 'Value' + str(parent().digits+1)
                valuechange: =parent.Widget.par.Slider2druncommand
                onpulse: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-700, 0]
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n# \n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef valueChange(par, val, prev):\n\text.Slider2DExt.RunCommand()\n\ndef onPulse(par):\n\treturn\n\ndef expressionChange(par, val, prev):\n\treturn\n\ndef exportChange(par, val, prev):\n\treturn\n\ndef enableChange(par, val, prev):\n\treturn\n\ndef modeChange(par, val, prev):\n\treturn\n\t"
              dat_content_format: text
