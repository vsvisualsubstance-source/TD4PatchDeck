              iop:
              - {}
              - {}
            custom_pars:
              Text Editor:
              - name: Editorlabel
                style: Str
                label: Label
                default: Header
                value: Editor
              - name: Editorheaderheight
                style: Int
                label: Editor Header Height
                startSection: true
                value: 26
              - name: Editorlabeldisplay
                style: Toggle
                label: Display
                startSection: true
                default: true
              - name: Editorlabelfontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
                value: relfract
              - name: Editorlabelfontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                value: 20
              - name: Editorlabelfontfraction
                style: Float
                label: Font Fraction
                default: 1
              - name: Editorlabelscaletofit
                style: Menu
                label: Scale Text to Fit
                default: never
                menuNames:
                - never
                - always
                - onlyshrink
                menuLabels:
                - Never
                - Always
                - Only when Too Large
              - name: Editorlabelfontbold
                style: Toggle
                label: Font Bold
              - name: Editorlabelitalic
                style: Toggle
                label: Italic
              - name: Editorlabeldropshadow
                style: Toggle
                label: Drop Shadow
              - name: Editorlabelalignx
                style: Menu
                label: Align Horizontal
                startSection: true
                default: Center
                menuNames:
                - left
