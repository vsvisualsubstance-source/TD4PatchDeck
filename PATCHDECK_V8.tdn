                  fontalpha: =parent.Widget.par.Menufontoffcolora
                  bgcolorr: =parent.Widget.par.Menubgcolorr
                  bgcolorg: =parent.Widget.par.Menubgcolorg
                  bgcolorb: =parent.Widget.par.Menubgcolorb
                  bgalpha: =parent.Widget.par.Menubgcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
