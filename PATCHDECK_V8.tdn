                - - column
                  - Symbol
                - - columnLabel
                  - ''
                - - sourceData
                  - ''
                - - sourceDataMode
                  - constant
                - - cellLook
                  - button
                - - topPath
                  - ''
                - - help
                  - ''
                - - width
                  - '20'
                - - stretch
                  - ''
                - - editable
                  - '0'
                - - draggable
                  - '0'
                - - selectRow
                  - '1'
                - - justify
                  - CENTER
                dat_content_format: table
              - name: textSizer
                type: textTOP
                parameters:
                  text: WX|gj
                  legacyfontselection: true
                  font: =parent.Widget.par.Font
                  fontsizex: =parent.Widget.par.Menufontsize
                flags:
