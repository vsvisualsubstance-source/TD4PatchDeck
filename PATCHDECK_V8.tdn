              h: =parent.Widget.par.Stringfieldheight
              layer: 4
              hmode: =parent.Widget.par.Stringfieldhorizontalmode
              hfillweight: =parent.Widget.par.Stringfieldhfillweight
              vmode: =parent.Widget.par.Stringfieldverticalmode
              vfillweight: =parent.Widget.par.Stringfieldvfillweight
              alignorder: =-me.nodeY
              display: =parent.Widget.par.Stringfielddisplay
              helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              top: ./bg
              borderover: false
              spacing: 1
              justifyv: center
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./StringFieldExt').module.StringFieldExt(me)
            custom_pars:
              Field:
              - name: Stringfielddisplay
                style: Toggle
                label: Field Display
                default: true
              - name: Stringfieldreadonly
                style: Toggle
                label: Read Only
              - name: Stringfieldprotected
                style: Toggle
                label: Render Password Protected
                startSection: true
              - name: Stringfieldconspaces
                style: Toggle
                label: Spaces to Underscores
              - name: Stringfieldcursor
                style: Toggle
                label: Render Cursor
                value: true
              - name: Stringfieldupdatewhiletyping
                style: Toggle
                label: Update While Typing
              - name: Stringfieldfocus
                style: DAT
                label: Focus Order
                startSection: true
              - name: Stringfieldfontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
                value: relfract
              - name: Stringfieldfontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                enableExpr: me.par.Stringfieldfontsizemode.eval() in ['points', 'panelunits']
                enable: false
                value: 20
              - name: Stringfieldfontfraction
                style: Float
                label: Font Fraction
                default: 1
                enableExpr: me.par.Stringfieldfontsizemode.eval() in ['fract', 'relfract']
              - name: Stringfieldscaletofit
                style: Menu
                label: Scale Text to Fit
                default: never
                menuNames:
                - never
                - always
                - onlyshrink
                menuLabels:
                - Never
                - Always
                - Only when Too Large
              - name: Stringfieldfontbold
                style: Toggle
                label: Font Bold
              - name: Stringfielditalic
                style: Toggle
                label: Italic
              - name: Stringfielddropshadow
                style: Toggle
                label: Drop Shadow
              - name: Stringfieldalignx
                style: Menu
                label: Align Horizontal
                startSection: true
                default: Center
                menuNames:
                - left
                - center
                - right
                menuLabels:
                - Left
                - Center
                - Right
                value: left
              - name: Stringfieldaligny
                style: Menu
                label: Align Vertical
                default: Center
                menuNames:
                - bottom
                - center
