              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Labelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
