          position: [5772, 4562]
          size: [160, 76]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
