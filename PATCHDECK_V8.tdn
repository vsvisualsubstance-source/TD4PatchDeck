            type: outPOP
            flags:
            - viewer
            position: [1400, 300]
            inputs:
            - normal1
          - name: glsl1
            type: glslPOP
            parameters:
              computedat: glsl1_compute
              outputattrs: P N
              outputaccess: readwrite
              bypass: =parent().par.Computegradient
            sequences:
