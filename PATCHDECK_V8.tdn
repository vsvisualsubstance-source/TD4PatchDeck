              normMax: 6.0
              value: 0.69
            - name: Pointiness
              style: Float
              label: pointiness
              normMax: 10.0
              value: =op('math2')['low']
            - name: Harmonics
              style: Int
              label: harmonics
              min: 1.0
              max: 12.0
              clampMin: true
              normMin: 1.0
              normMax: 12.0
              value: 10
            - name: Harmonicspread
              style: Float
              label: harmonic spread
              default: 2
              normMax: 3.0
              value: 2.08
            - name: Harmonicgain
              style: Float
              label: harmonic gain
              value: 0.422
            - name: Harmonicpointiness
              style: Float
              label: harmonic pointiness
              normMax: 10.0
              value: 10
            - name: Warpamt
              style: Float
              label: warp amt
