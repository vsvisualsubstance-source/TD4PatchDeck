              startSection: true
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
            - name: Contextfontfile
              style: File
              label: Font File
            - name: Contextfontsize
              style: Int
              label: Font Size
              default: 10
              min: 1.0
              max: 30.0
              normMax: 30.0
            - name: Contextbold
