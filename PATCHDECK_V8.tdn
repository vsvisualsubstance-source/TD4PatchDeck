      - name: Sndviz
        type: containerCOMP
        parameters:
          w: 1299
          h: 1312
          display: false
          enable: false
          resizecomp: ./out1
          reposition: component
          top: ./out1
          topsmoothness: usetop
          borderover: false
          opshortcut: Sndviz
          opviewer: ./GUI
        custom_pars:
          Audio:
          - name: Input
            style: Header
          - name: Source
            style: Menu
            label: Audio Source
            default: stream
            menuNames:
            - stream
            - chop
            - file
            menuLabels:
            - Audio Device In (Stream)
            - In CHOP (Stream)
            - Audio File
          - name: Device
            style: Menu
            label: Audio Device In
            default: default
            menuSource: op.Sndviz.op('audio/audiodevin1').par.device
          - name: File
            style: File
            label: Audio File
            enable: false
            value: =app.samplesFolder+'/Audio/JeremyCaulfield_www.dumb-unit.com.mp3'
          - name: Cuefile
            style: Pulse
            label: Cue File
            enable: false
          - name: Playfile
            style: Toggle
            label: Play/Pause File
            enable: false
          - name: Loopfile
            style: Toggle
            label: Loop File
            enable: false
            value: true
          - name: Stereo
            style: Toggle
            startSection: true
            value: true
          - name: Normalize
            style: Toggle
          - name: Inputgain
            style: Float
            label: Input Gain (dB)
            normMin: -40.0
            normMax: 40.0
            value: 16
          - name: Inputbuffer
            style: Float
            label: Input Buffer (sec)
            value: 0.5
          - name: Samplingquality
            style: Menu
            label: Sampling Quality (FFT)
            default: '8192'
            menuNames:
            - '512'
            - '1024'
            - '2048'
            - '4096'
            - '8192'
            - '16384'
          - name: Header
            style: Header
            label: Output
            startSection: true
          - name: Output
            style: Toggle
            label: Enable Audio Output
          - name: Outputdevice
            style: Menu
            label: Audio Output Device
            default: default
            menuSource: op('./audio/audiodevout1').par.device
          - name: Playthruvolume
            style: Float
            label: Playthru Volume
            value: 0.113
          - name: Outputbuffer
            style: Float
            label: Output Buffer (sec)
            value: 0.15
          Video:
          - name: Stereoviz
            style: Toggle
            label: Stereo Viz
          - name: Resolution
            style: XYZW
            label: Point Cloud Native Res
            size: 2
            default: 210
            normMin: 1.0
            normMax: 9001.0
            readOnly: true
            values: [91, 91]
          - name: Pointcloudoutputres
            style: WH
            label: Point Cloud Output Res
            values:
            - 180
            - =me.par.Pointcloudoutputresw
          - name: Jumpcut
            style: Toggle
            label: Jump Cut
            startSection: true
            value: true
          - name: Pixelformat
            style: Menu
            label: Pixel Format
            default: 32-bit
            menuNames:
            - 8-bit
            - 16-bit
            - 32-bit
          - name: Rgbbalance
            style: RGBA
            label: RGB Multiplier
            size: 3
            values: [10, 10, 10]
          - name: Speed
            style: Float
            startSection: true
            default: 1
            normMax: 2.0
          - name: Reset
            style: Pulse
          Network:
          - name: Touchoutvideo
            style: Toggle
            label: Enable Touch Out (Video)
          - name: Touchoutbeats
            style: Toggle
            label: Enable Touch Out (Beats)
          About:
          - name: Version
            style: Str
            startSection: true
            readOnly: true
            value: 0.5.7
          - name: Touchbuild
            style: Str
            label: Touch Build
            readOnly: true
            value: '2025.33070'
          - name: Github
            style: Pulse
          - name: Build
            style: Int
            label: Build Number
            readOnly: true
            value: 1
          - name: Date
            style: Str
            label: Build Date
            readOnly: true
            value: 2026-08-24 10:42:24 UTC
