      - name: Backgroundcolor
        style: RGBA
        label: Background Color
        size: 3
        values: [0.05, 0.05, 0.05]
    position: [250, 475]
    size: [159, 130]
    children:
    - name: MAIN_INTERFACE
      type: containerCOMP
      parameters:
        w: 1920
        h: 1080
        aspect: =16/9
        resizecomp: =me
        borderover: false
