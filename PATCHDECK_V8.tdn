              - add
              - subtract
              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: 0.2
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: float2
            OPs:
              $t: ops_12
              Label: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/float2/label
              Numericvalue0: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/float2/numericValue0
              Numericvalue1: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/float2/numericValue1
