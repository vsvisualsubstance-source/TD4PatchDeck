          - name: fileWarningError
            type: choptoDAT
            parameters:
              chop: null2
            position: [1050, -500]
            dat_read_only: true
          - name: math3_normalised
            type: mathCHOP
            parameters:
              align: stretch
              fromrange1: =op('min')['chan1']
              fromrange2: =op('max')['chan1']
              torange1: -1
              autoexportroot: =parent()
            flags:
            - viewer
            position: [1500, 700]
            size: [130, 90]
            inputs:
            - switch1
          - name: switch3_normalise
            type: switchCHOP
            parameters:
              index: ~op.Sndviz.par.Normalize
            flags:
            - viewer
            position: [2300, 300]
            size: [130, 90]
            inputs:
            - switch1
            - switch2
          - name: switchIfNotPresentExec
            type: datexecuteDAT
            parameters:
              dat: fileWarningError
              tablechange: false
              cellchange: true
              execute: end
              defaultreadencoding: cp1252
              language: input
            position: [1050, -600]
            size: [130, 90]
            dat_content: "# me - this DAT.\n# \n# dat - the changed DAT\n# rows - a list of row indices\n# cols - a list of column indices\n# cells - the list of cells that have changed content\n# prev - the list of previous string contents of the changed cells\n# \n# Make sure the corresponding toggle is enabled in the DAT Execute DAT.\n# \n# If rows or columns are deleted, sizeChange will be called instead of row/col/cellChange.\n\n\ndef onTableChange(dat):\n\t\n\treturn\n\ndef onRowChange(dat, rows):\n\treturn\n\ndef onColChange(dat, cols):\n\treturn\n\ndef onCellChange(dat, cells, prev):\n\n\tswitch = op('switch1')\n\tinfo = op('fileWarningError')\n\twarnings = info[0,0]\n\terrors = info[0,1]\n\t\n\t\n\tif (warnings > 0):\n\t\tswitch.par.index = 1\n\telse:\n\t\tswitch.par.index = 2\n\t\n\t\n\treturn\n\ndef onSizeChange(dat):\n\treturn\n\t"
            dat_content_format: text
