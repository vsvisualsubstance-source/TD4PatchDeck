                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('colDefine')['width','Symbol']
                  resolutionh: =op('master').par.resolutionh
