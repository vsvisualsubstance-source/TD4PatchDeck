          size: [93, 155]
          color: [0.5, 0.2, 0.05]
          tags:
          - TDSubComp
        - name: valueOut
          type: outCHOP
          parameters:
            label: =me.name
            autoexportroot: =parent()
          position: [400, 0]
          inputs:
          - output
      - name: B2
        type: widgetCOMP
        parameters:
          x: 3
          y: 3
          w: 100
          h: 50
          hmode: fill
          vmode: fill
          enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
          bgcolorr: 0.2
          bgcolorg: 0.2
          bgcolorb: 0.2
          bgalpha: 1
          borderar: 0
          borderag: 0
          borderab: 0
          borderaalpha: 0
          borderover: false
          align: horizlr
          spacing: 1
          marginl: 3
