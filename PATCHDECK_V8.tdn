          - name: vertLayout
            type: containerCOMP
            parameters:
              h: 1021
              hmode: fill
              vmode: fill
              alignorder: =-me.nodeY
              resizecomp: =me
              borderover: false
              align: verttb
              spacing: =parent.Widget.par.alignmargin
