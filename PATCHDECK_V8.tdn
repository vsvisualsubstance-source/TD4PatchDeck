                style: Toggle
                label: 'Rettangolo: solo angoli'
              - name: Pointradius
                style: Float
                label: Raggio punto
                default: 6
                normMin: 1.0
                normMax: 60.0
              - name: Pointthick
                style: Int
                label: Spessore punto (-1 pieno)
                default: 2
                min: -1.0
                max: 20.0
              - name: Pointcolor
                style: RGBA
                label: Colore punto
                size: 3
                default: [0.98, 0.96, 0.9]
              - name: Scalebyarea
                style: Toggle
                label: Raggio da area
                default: true
              - name: Boxthick
                style: Int
                label: Spessore rettangolo
                default: 1
                min: 1.0
                max: 10.0
              - name: Boxpad
                style: Float
                label: Margine rettangolo
                default: 4
                normMax: 40.0
              - name: Cornerlen
                style: Float
                label: Lunghezza angoli
                default: 0.3
                normMin: 0.05
                normMax: 0.5
              - name: Boxcolor
                style: RGBA
                label: Colore rettangolo
                size: 3
                default: [0.2, 0.95, 0.75]
              - name: Showlines
                style: Toggle
                label: Linee
                default: true
              - name: Linkdist
                style: Float
                label: Distanza collegamento
                default: 0.18
                value: 0.569
              - name: Maxlinks
                style: Int
                label: Link per blob
                default: 3
                max: 20.0
                clampMin: true
              - name: Linethick
                style: Int
                label: Spessore linea
                default: 1
                min: 1.0
                max: 10.0
              - name: Linecolor
                style: RGBA
                label: Colore linea
                size: 3
                default: [0.55, 0.8, 0.85]
                values: [1, 0, 0]
              - name: Linealpha
                style: Float
                label: Opacita linea
                default: 0.45
                value: 1
              - name: Fadebylength
                style: Toggle
                label: Sfuma per lunghezza
                default: true
                value: false
              - name: Showlabels
                style: Toggle
                label: Testi
                default: true
              - name: Labeltemplate
                style: Str
                label: Template testo
                default: ID{id}  A{area:.4f}
              - name: Fontscale
                style: Float
                label: Corpo testo
                default: 0.4
                normMin: 0.1
                normMax: 3.0
              - name: Fontthick
                style: Int
                label: Spessore testo
                default: 1
                min: 1.0
                max: 6.0
              - name: Textcolor
                style: RGBA
                label: Colore testo
                size: 3
                default: 1
              - name: Labeloffset
                style: XYZW
                label: Offset testo
                size: 2
                default: [10, -10]
              - name: Labelleader
                style: Toggle
                label: Trattino di richiamo
                default: true
              Counter:
              - name: Showcounter
                style: Toggle
                label: Contatore
                default: true
              - name: Counterpos
                style: Menu
                label: Posizione
                default: topleft
                menuNames:
                - topleft
                - topright
                - bottomleft
                - bottomright
                menuLabels:
                - Alto sx
                - Alto dx
                - Basso sx
                - Basso dx
                value: bottomright
              - name: Countertemplate
                style: Str
                label: Template contatore
                default: BLOB {count}   NUOVI {new}   PICCO {peak}   TOT {total}
              - name: Counterscale
                style: Float
                label: Corpo contatore
                default: 0.55
                normMin: 0.2
                normMax: 2.0
                value: 0.4
              - name: Counterthick
                style: Int
                label: Spessore contatore
                default: 1
                min: 1.0
                max: 6.0
              - name: Countercolor
                style: RGBA
                label: Colore contatore
                size: 3
                default: 1
              - name: Countermargin
                style: Int
                label: Margine dal bordo
                default: 24
                max: 300.0
                value: 12
              - name: Panel
                style: Toggle
                label: Pannello di fondo
              - name: Countershadow
                style: Toggle
                label: Contorno scuro
                default: true
              - name: Panelalpha
                style: Float
                label: Opacita pannello
                default: 0.55
              - name: Showgraph
                style: Toggle
