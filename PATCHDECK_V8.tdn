            - name: parexec1
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: =parent.Widget
                pars: Editmenu* Callbackdat
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-900, 400]
              size: [130, 90]
              dat_content: "def valueChange(par, val, prev):\n\text.TopMenuSubCompExt.setupMenuData()\n\ndef onPulse(par):\n\tif par.name == 'Editmenudat':\n\t\tmakeMenuDefine()\n\telif par.name == 'Editmenucallbacks':\n\t\tmakeMenuCallbacks()\n\treturn\n\ndef makeMenuDefine():\n\t\"\"\"\n\tCreates a menu define DAT\n\t\"\"\"\n\tdatPar = parent.Widget.par.Topmenudat\n\tif datPar.eval() == parent().par.Topmenudat.eval() or not datPar.eval():\n\t\tsourceDAT = op('exampleMenuDefine')\n\t\tdat = parent.Widget.parent().copy(\n\t\t\t\tsourceDAT, name=parent.Widget.name + 'Define')\n\t\tdat.nodeX = parent.Widget.nodeX - 200\n\t\tdat.nodeY = parent.Widget.nodeY\n\t\tdat.dock = parent.Widget\n\t\tdatPar.val = dat.name\n\t\tdatPar.enable = True\n\t\tdatPar.readOnly = False\n\t\top('menuDATOPExec').cook(force=True)\n\tdatPar.eval().par.edit.pulse()\n\ndef makeMenuCallbacks():\n\t\"\"\"\n\tCreates a menu callbacks DAT\n\t\"\"\"\n\tdatPar = parent.Widget.par.Callbackdat\n\tif not datPar.eval():\n\t\tsourceDAT = op('emptyCallbacks')\n\t\tdat = parent.Widget.parent().copy(\n\t\t\t\tsourceDAT, name=parent.Widget.name + 'Callbacks')\n\t\tdat.nodeX = parent.Widget.nodeX - 200\n\t\tdat.nodeY = parent.Widget.nodeY - 100\n\t\tdat.dock = parent.Widget\n\t\tdatPar.val = dat.name\n\t\tdatPar.enable = True\n\t\tdatPar.readOnly = False\n\tdatPar.eval().par.edit.pulse()"
              dat_content_format: text
            - name: popMenu1
              type: containerCOMP
              parameters:
                x: 128
                y: 44
                w: =me.OptimalWidth if me .extensionsReady else 0
                h: =me.OptimalHeight if me.extensionsReady else 0
                layer: 100
                alignallow: ignore
                display: false
                resizecomp: =me
                bgcolorr: 0.2
                bgcolorg: 0.2
                bgcolorb: 0.2
                borderar: =parent.Widget.par.Menubordercolorr
                borderag: =parent.Widget.par.Menubordercolorg
                borderab: =parent.Widget.par.Menubordercolorb
                borderaalpha: =parent.Widget.par.Menubordercolora
                leftborder: bordera
                rightborder: bordera
                bottomborder: bordera
                topborder: bordera
                justifyh: left
                justifyv: bottom
                parentshortcut: Menu
                clone: =op.TDTox.op('popMenu')
                overlay: true
                borderover: true
                opviewer: ./out1
                relpath: inherit
              sequences:
                ext:
                - object: me.mod.PopMenuExt.PopMenuExt(me)
                  promote: true
                - object: op('./CallbacksExt').module.CallbacksExt(me)
                  promote: true
                - {}
                - {}
                iop:
                - {}
                - {}
              custom_pars:
                Pop Menu:
                  $t: pop_menu
                  Inputtable: RowAll_Col0
                  Items: '[''New'', ''Open'', ''Recent'', ''Quit'']'
                  Highlighteditems: '[]'
                  Disableditems: '[''Open'']'
                  Dividersafteritems: '[''Recent'']'
                  Checkeditems: '{}'
                  Shortcuts: '{''New'': ''Alt N'', ''Open'': ''Alt O''}'
                  Maxheight: 600
                  Borders: true
                  Horizontalalign: Left
                  Verticalalign: Top
                  Buttoncomp: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/topMenu/topMenu/menuButton0
                  Horizontalattach: Left
                  Verticalattach: Bottom
                Advanced:
                  $t: advanced
                  Callbackdat: ='menuCallbacks'
                  Configcomp: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/topMenu/topMenu/menuConfig
                  Windowcomp: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/topMenu/topMenu/popMenu1/window
                  Includedialog: false
                  Submenu: ='popMenu' + str(me.digits+1) if op('popMenu' + str(me.digits+1)) else ''
                About:
                  $t: about_3
                  Version: 1.3.0
                  Toxsavebuild: '2023.11831'
              flags:
              - viewer
              position: [0, 300]
              size: [160, 130]
              palette_clone: true
            - name: popMenu2
              type: containerCOMP
              parameters:
                x: 128
