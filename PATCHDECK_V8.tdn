                comment: this is required do not delete
                dat_content:
                - - column
                  - Symbol
                - - columnLabel
                  - ''
                - - sourceData
                  - ''
                - - sourceDataMode
                  - constant
                - - cellLook
                  - button
                - - topPath
                  - ''
                - - help
                  - ''
                - - width
                  - '20'
                - - stretch
                  - ''
                - - editable
                  - '0'
                - - draggable
                  - '0'
                - - selectRow
                  - '1'
                - - justify
                  - CENTER
                dat_content_format: table
