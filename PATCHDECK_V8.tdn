      - name: 1_sliderHorzXFade
        type: widgetCOMP
        parameters:
          w: =me.panelParent().width
          h: =me.panelParent().height/12
          enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
          bgcolorr: 0.2
          bgcolorg: 0.2
          bgcolorb: 0.2
          bgalpha: 1
          borderar: =parent(2).par.Bordercolorr
