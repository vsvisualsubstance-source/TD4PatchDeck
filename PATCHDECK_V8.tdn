            - name: menuConfig
              type: baseCOMP
              position: [-300, 500]
              size: [160, 130]
              comment: Contains all user-configurable ops for lister
              children:
              - name: check
                type: textTOP
                parameters:
                  text: ='\u2714'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
