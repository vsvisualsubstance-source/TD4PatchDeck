      color: [0.67, 0.67, 0.67]
    - name: container_left
      type: containerCOMP
      parameters:
        w: 852
        h: 26
        resizecomp: =me
        borderover: false
        align: horizlr
        reloadbuiltin: false
      flags:
      - viewer
      size: [160, 76]
      color: [0.325, 0.8, 0.3]
      tags:
