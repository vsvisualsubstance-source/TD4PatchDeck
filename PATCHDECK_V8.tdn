          borderag: 0
          borderab: 0
          borderaalpha: 0
          borderover: false
          align: vertbt
          spacing: 1
          marginl: 3
          marginr: 3
          marginb: 3
          margint: 3
          justifyh: left
          justifyv: top
          clone: =op.TDBasicWidgets.op('sliderVert') if hasattr(op, 'TDBasicWidgets') else ''
        sequences:
          ext:
          - promote: true
        custom_pars:
          Values:
            $t: values_7
            Value0: ~op('control_ui').par.S5
            Valname0: =me.name
          Label:
            $t: label_9
            Labeldisplay: false
            Labelfontsize: 40
          Field:
            $t: field_5
            Numericfielddisplay: false
          Slider:
            $t: slider_4
            Sliderlabelnames: =me.name
            Sliderfontsizemode: fract
            Sliderfontsize: 40
            Sliderfontfraction: 0.1
            Sliderscaletofit: onlyshrink
            Sliderfontbold: true
            Sliderknobcolor: [0, 0.366667, 0.5, 1]
            Sliderlabelfontcolor: [1, 0.2, 0.2, 1]
            Sliderindicatorcolor: [0.241533, 0.375286, 0.423, 1]
            Cacheabletop: =op('./slider0/bg')
          Widget:
            $t: widget_10
          OPs:
