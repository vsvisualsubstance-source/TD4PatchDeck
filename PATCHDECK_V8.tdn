            position: [1175, -675]
            size: [130, 90]
            dat_content: "# me is this DAT.\n#\n# panelValue is the PanelValue object that changed.\n#\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nimport os\n\ndef offToOn(panelValue):\n\treturn\n\ndef whileOn(panelValue):\n\treturn\n\ndef onToOff(panelValue):\n\n\tcurrentFolder = getattr(parent.Widget.par, 'Value'+str(panelValue.owner.digits)).eval()\n\tif os.path.isdir(currentFolder):\n\t\tstartDir = currentFolder\n\telse:\n\t\tstartDir = project.folder\n\n\tfolder = ui.chooseFolder(start = startDir, title='Select A Folder',\\\n\t\t\t\t\t\t\t\t\t\tasExpression=parent.Widget.par.Relativepath.eval())\n\tif folder:\n\t\tsetattr(parent.Widget.par, 'Value'+str(panelValue.owner.digits), folder)\n\ndef whileOff(panelValue):\n\treturn\n\ndef valueChange(panelValue):\n\treturn\n"
            dat_content_format: text
          - name: scriptSetFolder1
            type: panelexecuteDAT
            parameters:
              fromop: buttonSymbolNoValue0
              panels: buttonPush0
              offtoon: false
              ontooff: true
              defaultreadencoding: cp1252
              language: input
            flags:
            - viewer
            position: [800, -700]
            size: [130, 90]
            dat_content: "# me is this DAT.\n#\n# panelValue is the PanelValue object that changed.\n#\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nimport os\nfrom pathlib import Path, PurePath\n\ndef offToOn(panelValue):\n\treturn\n\ndef whileOn(panelValue):\n\treturn\n\ndef onToOff(panelValue):\n\n\trelativePathsMode = parent.Widget.par.Relativepaths.eval()\n\n\tcurrentFolder = getattr(parent.Widget.par, 'Value'+str(panelValue.owner.digits)).eval()\n\tif os.path.isdir(currentFolder):\n\t\tstartDir = currentFolder\n\telse:\n\t\tstartDir = project.folder\n\n\tfilePath = ui.chooseFolder(start = startDir,\n\t\ttitle='Select A Folder')\n\n\tif filePath:\n\n\t\tif relativePathsMode == 'Anywhere':\n\t\t\ttry:\n\t\t\t\tfilePath = os.path.relpath(filePath, project.folder)\n\t\t\texcept:\n\t\t\t\tpass\n\t\t\t\t\n\t\telif relativePathsMode == 'Project':\n\t\t\tisRelative = False\n\t\t\tpaths = [os.path.normpath(project.folder), os.path.normpath(filePath)]\n\t\t\ttry:\n\t\t\t\tcommonPath = os.path.commonpath(paths)\n\t\t\texcept:\n\t\t\t\tcommonPath = None\n\t\t\t\t\n\t\t\tif commonPath and os.path.normpath(commonPath) == os.path.normpath(project.folder):\n\t\t\t\ttry:\n\t\t\t\t\tfilePath = os.path.relpath(filePath, project.folder)\n\t\t\t\t\tisRelative = True\n\t\t\t\texcept:\n\t\t\t\t\tpass\n\t\t\n\t\tif parent.Widget.par.Useprojectpaths.eval():\n\t\t\tfilePath = urlPath(filePath)\n\n\t\tsetattr(parent.Widget.par, 'Value'+str(panelValue.owner.digits), filePath)\n\ndef whileOff(panelValue):\n\treturn\n\ndef valueChange(panelValue):\n\treturn\n\ndef urlPath(ipath):\n\t\"\"\"\n\tIf valid parent path is found in project.paths then a new path using the URL formatting \n\tis returned - If nothing is found, None is returned\n\t\"\"\"\n\t#os.path.normpath(path)\n\t#ipath = PurePath(ipath)\n\tnpaths = [(i[0], PurePath(os.path.normpath(i[1]))) for i in  project.paths.items()]\n\tipath = PurePath(ipath)\n\turlPath = ipath\n\tfor n in npaths:\n\t\t#test = ipath.relative_to(n[1])\n\t\t#debug(test)\n\t\ttry:\n\t\t\tppath = ipath.relative_to(n[1])\n\t\texcept:\n\t\t\tppath = None\n\t\t\n\t\tif ppath:\n\t\t\tif ppath == PurePath('.'):\n\t\t\t\turlPath = n[0] + '://'\n\t\t\telse:\n\t\t\t\turlPath = n[0] + '://' + str(ppath).replace('\\\\', '/')\n\t\t\t\n\treturn urlPath\n\t\t\t\n"
            dat_content_format: text
