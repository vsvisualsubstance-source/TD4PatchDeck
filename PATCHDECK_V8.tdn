              colindexend: =me.inputs[0].numCols - 1
            position: [0, -200]
            comment: Popup help string as set in Popuphelp parameter
            dat_read_only: true
          - name: docsHelper
            type: containerCOMP
            parameters:
              w: 32
              h: 32
              layer: 1
