        position: [745, 294]
        size: [798, 373]
        color: [0.5, 0.05, 0.35]
      - name: annotate3
        mode: annotate
        title: 'Control Input '
        position: [-51, -326]
        size: [628, 516]
        color: [0.2, 0.5, 0.05]
      - name: annotate4
        mode: annotate
        title: OUT + THUMBNAIL
        position: [1875, -325]
        size: [539, 530]
        color: [0.35, 0.05, 0.5]
