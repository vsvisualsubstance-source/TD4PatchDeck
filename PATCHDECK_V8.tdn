              Points:
                $t: points
            flags:
            - viewer
            position: [520, 780]
            size: [130, 90]
        - name: noise1
          type: noisePOP
          parameters:
            seed: 1.1
            period: 1.1
            amp0: 1
            t4d: =op('speed1')['chan1']
          flags:
          - viewer
          position: [-1200, -75]
          size: [130, 90]
          color: [0.67, 0.67, 0.67]
          inputs:
          - pointgen1
        - name: phong1
          type: phongMAT
          parameters:
            diffr: 1
            diffg: 1
            diffb: 1
            specr: 0
            specg: 0
            specb: 0
