              - name: u_scale
                type: vec3
                valuex: ~parent().par.Scalex
                valuey: ~parent().par.Scaley
                valuez: ~parent().par.Scalez
              - name: u_period
                valuex: ~parent().par.Period
              - name: u_exponent
                valuex: ~parent().par.Pointiness
              - name: u_harmonics
                type: int
                valuex: ~parent().par.Harmonics
              - name: u_h_exp
                valuex: ~parent().par.Harmonicpointiness
              - name: u_h_gain
                valuex: ~parent().par.Harmonicgain
              - name: u_h_spread
                valuex: ~parent().par.Harmonicspread
              - name: u_warp
                valuex: ~parent().par.Warpamt
              - name: u_amp
                valuex: ~parent().par.Amp
              - name: u_rot
                type: vec3
                valuex: ~parent().par.Rotatex
                valuey: ~parent().par.Rotatey
                valuez: ~parent().par.Rotatez
            position: [400, 325]
            inputs:
            - normal2
          - name: normal1
            type: normalPOP
            position: [775, 275]
            inputs:
            - switch1
          - name: normal2
            type: normalPOP
            parameters:
              nml: computeifnone
            position: [225, 275]
            inputs:
            - in1
          - name: switch1
            type: switchPOP
            parameters:
              index: ~parent().par.Computegradient
            position: [575, 275]
            size: [130, 90]
            inputs:
            - glsl1
            - gradient
          - name: gradient
            type: glslPOP
            parameters:
              computedat: glsl2_compute_gradient
              outputattrs: P N
              outputaccess: readwrite
              bypass: =not(parent().par.Computegradient)
            sequences:
              attr:
              - customname: noiseGradient
                numcomps: '3'
              - customname: displaceMap
              vec:
              - name: u_translate
                type: vec4
                valuex: ~parent().par.Transformx
                valuey: ~parent().par.Transformy
                valuez: ~parent().par.Transformz
                valuew: ~parent().par.Transformw
              - name: u_scale
                type: vec3
                valuex: ~parent().par.Scalex
                valuey: ~parent().par.Scaley
                valuez: ~parent().par.Scalez
              - name: u_period
                valuex: ~parent().par.Period
              - name: u_exponent
                valuex: ~parent().par.Pointiness
              - name: u_harmonics
                type: int
                valuex: ~parent().par.Harmonics
              - name: u_h_exp
                valuex: ~parent().par.Harmonicpointiness
              - name: u_h_gain
                valuex: ~parent().par.Harmonicgain
              - name: u_h_spread
                valuex: ~parent().par.Harmonicspread
              - name: u_warp
                valuex: ~parent().par.Warpamt
              - name: u_amp
                valuex: ~parent().par.Amp
              - name: u_rot
                type: vec3
                valuex: ~parent().par.Rotatex
                valuey: ~parent().par.Rotatey
                valuez: ~parent().par.Rotatez
              - name: u_epsilon
                valuex: ~parent().par.Epsilon
            position: [400, 0]
            inputs:
