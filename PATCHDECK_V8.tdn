        dat_content:
        - - Rotary
          - Feedback
          - X
          - Y
          - R4
        - - Sliders
          - Noise speed
          - Brightness
          - Roughness
          - Vertical
        - - Button Row 1
          - B1
          - B2
          - B3
          - B4
        - - Button Row 2
          - B5
          - B6
          - B7
          - B8
        dat_content_format: table
      - name: displace1
