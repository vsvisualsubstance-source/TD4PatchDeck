            dat_read_only: true
          - name: glsl2_pixel
            type: textDAT
            parameters:
              language: glsl
              extension: frag
            flags:
            - viewer
            position: [240, 10]
            size: [130, 90]
            dock: glsl2
            dat_content: "struct Point\n{\n\tvec3 pos;\n\tvec3 norm;\n};\n\nPoint gPoint;\n\n#include \"createPoint\"\n\nlayout(location = 0) out vec4 fragColor;\nlayout(location = 1) out vec4 normColor;\n\nvoid main()\n{\n\tvec4 point = vec4(0.0);\n\tvec4 normals = vec4(0.0);\n\tcreatePoint(vUV.st);\n\tpoint.xyz = gPoint.pos;\n\tnormals.xyz = gPoint.norm;\n\tnormColor = TDOutputSwizzle(normals);\n\tpoint.w = 1;\n\tfragColor = TDOutputSwizzle(point);\n}"
            dat_content_format: text
