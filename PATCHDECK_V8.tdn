              custom_pars:
                Operator Path:
                - name: Currentop
                  style: Str
                  label: Current OP
                  startSection: true
                  default: /
                  value: ~parent.Widget.par.Value0
                - name: Rootop
                  style: COMP
                  label: Root OP
                  startSection: true
                  default: /
                  value: =parent.Widget.par.Contextrootop
                - name: Filterclasses
