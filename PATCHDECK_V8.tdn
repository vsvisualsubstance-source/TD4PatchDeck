              - name: subMenu
                type: textTOP
                parameters:
                  text: ='\uE102'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Segoe UI Symbol
                  fontsizex: 11
                  fontsizexunit: pixels
                  fontcolorr: 0.71
                  fontcolorg: 0.72
                  fontcolorb: 0.72
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
