          clone: =op.TDBasicWidgets.op('knobFixed') if hasattr(op, 'TDBasicWidgets') else ''
        sequences:
          ext:
          - promote: true
        custom_pars:
          Values:
            $t: values_7
            Valname0: =me.name
          Label:
            $t: label_4
            Widgetlabel: =me.name
            Labelfontsizemode: fract
            Labelfontsize: 30
