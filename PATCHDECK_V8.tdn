                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: 100
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -200]
                size: [130, 48]
              - name: master
                type: textTOP
                parameters:
                  text: ''
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('fontHelper').par.font
                  bold: =op('fontHelper').par.bold
                  italic: =op('fontHelper').par.italic
                  dispmethod: bitmap
