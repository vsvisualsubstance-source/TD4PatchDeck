                - - help
                  - ''
                - - width
                  - '20'
                - - stretch
                  - ''
                - - editable
                  - '0'
                - - draggable
                  - '0'
                - - selectRow
                  - '1'
                - - justify
                  - CENTER
                dat_content_format: table
              - name: textSizer
