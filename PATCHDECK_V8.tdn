            marginr: 3
            marginb: 3
            margint: 3
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('referenceCOMP') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
            - name: Value0
              style: COMP
              label: Value 0
              default: None
              value: /
            - name: Valname0
              style: Str
              label: Name 0
              startSection: true
              default: Value
            - name: Onvaluechangescript0
              style: Str
              label: On Value Change Script 0
            - name: Ontooffscript0
