            parameters:
              file: =app.samplesFolder + '/Geo/defcam.geo'
            size: [130, 90]
        - name: geo1
          type: geometryCOMP
          parameters:
            tz: 5
            ry: =op('math1')['kick']
            rz: =absTime.seconds*10
            material: line1
          position: [-100, 125]
          size: [160, 130]
          inputs:
          - noise2
          children:
          - name: in1
            type: inSOP
            flags:
            - viewer
          - name: out1
            type: outSOP
            flags:
            - display
            - render
            - viewer
            position: [227, 0]
            inputs:
            - in1
        - name: lfo1
          type: lfoCHOP
          parameters:
            frequency: 0.002
            offset: 1
            amp: 2.07
          flags:
          - viewer
          position: [-1125, 550]
        - name: out1
          type: outTOP
          parameters:
            label: =me.name
          flags:
          - display
          - viewer
          position: [1900, 225]
          size: [130, 90]
          inputs:
          - bg
        - name: grid1
          type: gridSOP
          parameters:
            sizex: 3
            sizey: 3
            rows: =op('math1')['kick']+8
            cols: =op('math1')['low']+3
          position: [-1350, -328]
          size: [164, 193]
        - name: line1
          type: lineMAT
          parameters:
            distancefar: 10.6
            widthnear: 2
            widthaffectedbyfov: true
            linenearcolorr: 1
            linenearcolorg: 1
            linenearcolorb: 1
            linenearalpha: 0.079
            linefarcolorr: 1
            linefarcolorg: 1
            linefarcolorb: 1
            linefaralpha: 0.074
            drawpoints: true
            pointsizemultiplier: 5
            pointnearcolorr: 1
            pointnearcolorg: 1
            pointnearcolorb: 1
            pointnearalpha: 0.19
            pointfarcolorr: 1
            pointfarcolorg: 1
            pointfarcolorb: 1
            pointfaralpha: 0.22
            pointliftscale: 1.07
            scale: 0.12
            blending: true
            depthtest: false
          position: [-75, -25]
        - name: math1
          type: mathCHOP
          parameters:
            autoexportroot: =parent()
          flags:
          - viewer
          position: [-2900, 550]
          size: [130, 90]
          inputs:
          - in1
        - name: over1
          type: overTOP
          position: [950, -125]
          size: [130, 90]
          inputs:
          - bloom1
          - bloom2
        - name: over2
          type: overTOP
          position: [950, -325]
          size: [130, 90]
          inputs:
          - bloom4
          - bloom3
        - name: over3
          type: overTOP
          position: [1150, -250]
          size: [130, 90]
          inputs:
          - over1
          - over2
        - name: ramp1
          type: rampTOP
          parameters:
            dat: ramp1_keys
            color1: 0
            color2: 0
            color3: 0
            color4: 0
            phase: -1
            period: 10
          position: [500, 0]
          size: [130, 90]
          inputs:
          - transform1
        - name: bloom1
          type: bloomTOP
          parameters:
            preblacklevel: 0.047
            pregamma: 2.04
            prebrightness: 0.69
            minbloomradius: 0
            maxbloomradius: 0.145
            bloomintensity: =op('math1')['kick']*2+.2
          position: [675, 100]
          size: [130, 72]
          inputs:
          - ramp1
        - name: bloom2
          type: bloomTOP
          parameters:
            preblacklevel: 0.047
            pregamma: 2.04
            prebrightness: 0.69
            minbloomradius: 0
            maxbloomradius: 0.145
            bloomintensity: =op('math1')['snare']
          position: [675, -150]
          size: [130, 90]
          inputs:
          - ramp1
        - name: bloom3
          type: bloomTOP
          parameters:
            preblacklevel: 0.047
            pregamma: 2.04
            prebrightness: 0.69
            minbloomradius: 0
            maxbloomradius: 0.145
            bloomintensity: =op('math1')['high']
          position: [700, -275]
          size: [130, 90]
          inputs:
          - ramp1
        - name: bloom4
          type: bloomTOP
          parameters:
            preblacklevel: 0.047
            pregamma: 2.04
            prebrightness: 0.69
            minbloomradius: 0
            maxbloomradius: 0.145
            bloomintensity: =op('math1')['low']
          position: [675, -375]
          size: [130, 72]
          inputs:
          - ramp1
        - name: level1
          type: levelTOP
          parameters:
            blacklevel: 0.08
            brightness1: 0.62
            gamma1: 0.84
            contrast: 4.13
          flags:
          - bypass
          position: [1375, 50]
          size: [130, 90]
          inputs:
          - chroma1
        - name: level2
          type: levelTOP
          parameters:
            blacklevel: 0.13
            brightness1: 0.85
            gamma1: 1.52
            outputresolution: fit
            resolutionw: 1280
            resolutionh: 720
          flags:
          - bypass
          position: [1475, 250]
          size: [130, 90]
          inputs:
          - level1
        - name: noise1
          type: noiseSOP
          parameters:
            seed: 2.66
            period: 0
            harmon: 0
            exp: 0.7
            amp: 3
            tz: =op('math1')['low']
          position: [-925, 250]
          size: [130, 90]
          inputs:
          - switch1
        - name: noise2
          type: noiseSOP
          parameters:
            rough: 0.51
            exp: 4
            amp: 2.08
            keepnormals: false
            tx: =op('math1')['low']
            tz: =op('math1')['snare']
          flags:
          - bypass
          position: [-500, 275]
          size: [130, 90]
          inputs:
          - noise1
        - name: torus1
          type: torusSOP
          parameters:
            orient: x
            rows: 5
            cols: 7
          position: [-1400, -75]
        - name: chroma1
          type: chromakeyTOP
          parameters:
            ssoftlow: 1
          position: [1350, -125]
          size: [130, 90]
          inputs:
          - over3
        - name: circle1
          type: circleSOP
          parameters:
            divs: 8
            arc: closedarc
          position: [-1450, 75]
          size: [130, 90]
        - name: render1
          type: renderTOP
          parameters:
            uvunwrapcoordattrib: uv
          position: [200, 150]
          size: [130, 90]
        - name: sphere1
          type: sphereSOP
          parameters:
            radx: =op('math1')['kick']+1
            rows: =op('math1')['kick']+3
            cols: =op('math1')['snare']*2+3
          position: [-1475, 325]
          size: [130, 90]
        - name: switch1
          type: switchSOP
          parameters:
            input: =op('lfo1')['chan1']
          position: [-1125, 225]
          size: [130, 90]
          inputs:
          - transform4
          - fractal1
          - transform2
          - fractal2
        - name: fractal1
          type: fractalSOP
          parameters:
            smooth: 0
            scale: 1.9
            seed: =absTime.seconds*2
            vtxnms: true
          position: [-1275, 125]
          inputs:
          - circle1
        - name: fractal2
          type: fractalSOP
          parameters:
            smooth: 3
            scale: 30
            seed: =absTime.seconds*2
            vtxnms: true
          position: [-1075, -275]
          inputs:
          - transform3
        - name: in1_export
          type: tableDAT
          parameters:
            file: PATCHDECK/PATCHES/X16/noise_generator/in1_export.tsv
            syncfile: true
          flags:
          - viewer
          position: [-3250, 430]
          size: [130, 90]
          color: [0.9, 0.3, 0.4]
          tags:
          - tsv
          dock: in1
        - name: ramp1_keys
          type: tableDAT
          parameters:
            file: PATCHDECK/PATCHES/X16/noise_generator/ramp1_keys.tsv
            syncfile: true
          flags:
          - viewer
          position: [500, -120]
          size: [130, 90]
          color: [0.9, 0.3, 0.4]
          tags:
          - tsv
          dock: ramp1
        - name: transform1
          type: transformTOP
          parameters:
            rotate: -360
            compover: true
          position: [375, 175]
          size: [130, 90]
          inputs:
          - render1
        - name: transform2
          type: transformSOP
          parameters:
            rx: =absTime.seconds
            rz: =absTime.seconds*2
            sx: =op('math1')['kick']+1
            sz: =op('math1')['low']/2+1
          position: [-1200, -50]
          size: [130, 90]
          inputs:
          - torus1
        - name: transform3
          type: transformSOP
          parameters:
            rx: =absTime.seconds*2
            rz: =absTime.seconds
          position: [-1150, -450]
          size: [130, 90]
          inputs:
          - grid1
        - name: transform4
          type: transformSOP
          parameters:
            ty: 0.2
            rx: =absTime.seconds*2
            ry: =absTime.seconds*4
            rz: =absTime.seconds*2
          position: [-1275, 375]
          size: [130, 90]
          inputs:
          - sphere1
      annotations:
      - name: annotate1
        mode: annotate
        title: Your Patch Here
        text: "This is the space where you can create your patch. \nYou can use the variables mod.vars.resx & mod.vars.resy for X and Y Resolution. "
        position: [703, -326]
        size: [988, 524]
