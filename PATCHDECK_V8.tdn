            marginb: 3
            margint: 3
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('knobFixed') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
              $t: values_7
              Value0: ~me.op('../../control_ui').par.R5
              Valname0: =me.name
            Label:
