              style: Toggle
              label: Display
              startSection: true
              default: true
            - name: Labelwordwrap
              style: Toggle
              label: Word Wrap
              startSection: true
            - name: Labelfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Labelfontsize
              style: Int
              label: Font Size
              default: 10
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
            - name: Labelfontfraction
