            size: [130, 90]
            dock: addLookupMix
            dat_content: "const vec3 W = vec3(0.2989, 0.5870, 0.1140);\n\nfloat luminance(vec3 rgb)\n{\n\treturn dot(rgb, W);\n}\n\nuniform float uInputLevel;\nuniform float uBloomIntensity;\nuniform float uGlowIntensity;\nuniform vec3 uGlowColor;\nuniform float uRampIntensity;\n\n\nlayout(location = 0) out vec4 fragColor;\nlayout(location = 1) out vec4 bloomColor;\nvoid main()\n{\n\n\tvec4 inputTexture = texture(sTD2DInputs[0], vUV.st);\n\tvec3 bloom = texture(sTD2DInputs[1], vUV.st).rgb;\n\n\n\tfloat luma = luminance(bloom);\n\n\tbloom *= uBloomIntensity;\n\n\tif (uGlowIntensity > 0.0)\n\t{\n\t\tbloom += uGlowColor * luma * uGlowIntensity;\n\t}\n\n\tif (uRampIntensity > 0.0)\n\t{\n\t\tbloom += texture(sTD2DInputs[2], vec2(luma, 0.5)).rgb * uRampIntensity;\n\t}\n\n\n\n\tfragColor = TDOutputSwizzle(inputTexture * uInputLevel + vec4(bloom, luma));\n\tbloomColor = TDOutputSwizzle(vec4(bloom, luma));\n\n}\n"
            dat_content_format: text
          - name: replicator1
            type: replicatorCOMP
            parameters:
              method: bynum
              numreplicants: ~parent.Bloom.par.Iterations
              repsuffixstart: 0
              opprefix: iter
              master: master
              destination: =parent()
              callbacks: replicator1_callbacks
              layout: vertical
              layoutorigin1: 771
            position: [770, 355]
          - name: window_ramp
            type: windowCOMP
            parameters:
              winop: parameter1
              title: =me
              justifyh: center
              justifyv: center
            flags:
            - viewer
            position: [1580, -470]
          - name: addLookupMix
            type: glslTOP
            parameters:
              pixeldat: glsl1_pixel
              computedat: glsl1_compute
              autodispatchsize: false
              inputextenduv: hold
            sequences:
              vec:
              - name: uBloomIntensity
                valuex: ~parent.Bloom.par.Bloom
              - name: uGlowIntensity
                valuex: ~parent.Bloom.par.Glow
                valuey: 1
                valuez: 1
                valuew: 1
              - name: uGlowColor
                valuex: ~parent.Bloom.par.Glowcolorr
                valuey: ~parent.Bloom.par.Glowcolorg
                valuez: ~parent.Bloom.par.Glowcolorb
                valuew: 1
              - name: uRampIntensity
                valuex: ~parent.Bloom.par.Glowinputramp
                valuey: 1
                valuez: 1
                valuew: 1
              - name: uInputLevel
                valuex: ~parent.Bloom.par.Inputlevel
                valuey: 1
                valuez: 1
                valuew: 1
            flags:
            - viewer
            position: [1880, 30]
            size: [130, 72]
            inputs:
            - in1
            - level2
            - level4
          - name: moviefilein1
            type: moviefileinTOP
            parameters:
              file: =app.samplesFolder + '/Map/Nature/Movie.2.mp4'
              reload: true
              hwdecode: false
            flags:
            - viewer
            position: [75, 25]
            size: [130, 72]
          - name: setPixelFormat
            type: reorderTOP
            parameters:
              outputalphachan: zero
              format: =parent.Bloom.par.Format.eval()
            flags:
            - viewer
            position: [405, -116]
            size: [130, 72]
            comment: Set 11 bit, 16 bit or 32 bit float for best results
            inputs:
            - in1
          - name: replicator1_callbacks
            type: textDAT
            parameters:
              defaultreadencoding: cp1252
              language: python
            flags:
            - viewer
            - -showDocked
            position: [950, 350]
            size: [130, 90]
            dock: replicator1
            dat_content: "# me - this DAT\n# \n# comp - the replicator component which is cooking\n# allOps - a list of all replicants, created or existing\n# newOps - the subset that were just created\n# template - table DAT specifying the replicator attributes\n# master - the master operator\n#\n\n\nconnect = '''\ncomp = args[0]\nallOps = args[1]\nnumIter = comp.par.numreplicants.eval()\n\n\nfor i, c in enumerate(allOps):\n\n\n\n\tif i == 0:\n\t\top('level1').outputConnectors[0].connect(c.inputConnectors[0])\n\t\tc.outputConnectors[1].connect(op('blurUp').inputConnectors[0])\n\n\n\telse:\n\n\t\tprev = op(c.base + str(i- 1))\n\n\t\tif i == numIter - 1:\n\n\t\t\tc.outputConnectors[0].connect(op('blurDown').inputConnectors[0])\n\t\t\top('blurDown').outputConnectors[0].connect(c.inputConnectors[1])\n\t\t\tc.outputConnectors[1].connect(prev.inputConnectors[1])\n\t\t\tprev.outputConnectors[0].connect(c.inputConnectors[0])\n\t\t\t\n\t\t\top('blurDown').nodeY = c.nodeY - 200\n\n\t\telse:\n\n\t\t\t#if i != 1:\n\t\t\tc.outputConnectors[1].connect(prev.inputConnectors[1])\n\t\t\t\n\t\t\tprev.outputConnectors[0].connect(c.inputConnectors[0])\n\t\t\t\n\n'''\n\n\ndef onReplicate(comp, allOps, newOps, template, master):\n\n\trun(connect, comp, allOps, delayFrames=1)\n\n\tfor c in newOps:\n\t\t\n\t\tc.par.clone = master\n\t\t\n\n\t\tpass\n\n\treturn\n"
            dat_content_format: text
