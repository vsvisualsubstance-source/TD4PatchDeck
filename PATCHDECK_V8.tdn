              default: [0.6, 0.6, 0.6, 0]
            - name: Buttonofffontcolor
              style: RGBA
              label: Off Font Color
              default: [0.2, 0.2, 0.2, 1]
              min: [1.0, 0.772, 0.498, 0.0]
            - name: Buttononfontcolor
              style: RGBA
              label: On Font Color
              default: [0.382, 0.382, 0.382, 1]
            - name: Buttonborder
              style: Toggle
              label: Border
            - name: Buttonbordercolor
              style: RGBA
              label: Border Color
              default: 1
              enableExpr: me.par.Buttonborder == True
              enable: false
            - name: Buttonruncommand
