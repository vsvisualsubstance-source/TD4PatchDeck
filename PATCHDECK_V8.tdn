  - name: manager
    type: containerCOMP
    parameters:
      y: 13
      w: 1080
      h: 440
      resizer: true
      resizeb: true
      resizecomp: =me
      resizewmin: 250
      resizewmax: 3840
      resizehmin: 50
      resizehmax: 2160
      topsmoothness: mipmap
      borderar: =parent.Embody.par.Textcolorr * 0.5
      borderag: =parent.Embody.par.Textcolorg * 0.5
      borderab: =parent.Embody.par.Textcolorb * 0.5
      borderaalpha: =parent.Embody.par.Textcolora
      leftborder: bordera
      rightborder: bordera
      bottomborder: bordera
      topborder: bordera
      align: verttb
      reloadbuiltin: false
    position: [500, 475]
    size: [160, 92]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
  - name: parexec
    type: parameterexecuteDAT
    parameters:
      fromop: =parent()
      op: ..
      pars: '*'
      file: Embody1/parexec.py
      defaultreadencoding: cp1252
      syncfile: true
      language: input
    position: [-275, 300]
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
  - name: select1
    type: selectCHOP
    parameters:
      channames: click
      autoexportroot: =parent()
