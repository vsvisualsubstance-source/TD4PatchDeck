                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: list
            type: containerCOMP
            parameters:
              hmode: fill
              vmode: fill
              helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
              resizecomp: =me
              borderover: false
              parentshortcut: List
              enablecloning: false
            sequences:
              ext:
              - object: op('./SubWidgetExt').module.SubWidgetExt(me)
                promote: true
            flags:
            - viewer
            position: [200, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDSubComp
            inputs:
            - in1
            children:
            - name: in1
              type: inDAT
              parameters:
                label: =me.name
              position: [-150, 0]
              dat_read_only: true
            - name: out1
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [200, 100]
              size: [130, 90]
              inputs:
              - lister
              dat_read_only: true
            - name: out2
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [200, -50]
              size: [130, 90]
              inputs:
              - lister
              dat_read_only: true
            - name: lister
              type: listCOMP
              parameters:
                callbacks: ./internalCallbacks
                rows: =ext.ListerExt.nRows if me.extensionsReady else 0
                cols: =ext.ListerExt.nCols if me.extensionsReady else 0
                lockfirstrow: =me.par.Header
                w: 30
                h: 30
                alignorder: =-me.nodeY
                sizefromwindow: true
                clickthrough: true
                mouserel: true
                bgcolorr: =parent.Widget.par.Listerbasecolorr
                bgcolorg: =parent.Widget.par.Listerbasecolorg
                bgcolorb: =parent.Widget.par.Listerbasecolorb
                bgalpha: =parent.Widget.par.Listerbasecolora
                borderover: false
                crop: 'on'
                dragscript: ''
                drop: legacy
                dropscript: ./dropUpdater
                parentshortcut: Lister
                opviewer: ./listOut
                clone: =op.TDTox.op('lister')
                relpath: inherit
              sequences:
                ext:
                - object: me.mod.ListerExt.ListerExt(me)
                  promote: true
                iop:
                - {}
                - {}
              custom_pars:
                Lister:
                - name: Refresh
                  style: Pulse
                  startSection: true
                  help: 'Manually refresh the lister. NOTE: This re-analyzes raw data for lister, so dynamically added lister data might disappear!'
                - name: Editconfigcomp
                  style: Pulse
                  label: Edit Config COMP
                  help: Open a network editor window for the Lister's Config Component.
                - name: Editcoldefine
                  style: Pulse
                  label: Edit Column Definitions
                  help: Open the lister's colDefine table. (Only available when Auto-define Columns is off)
                - name: Editcallbacks
                  style: Pulse
                  label: Edit Callbacks
                  help: Open a text editor for the Lister's callbacks.
                - name: Printcallbacks
                  style: Toggle
                  label: Print Callbacks
                  help: Enables debug prints of all callbacks (whether found or not) to the textport.
                  value: =parent.Widget.par.Printcallbacks
                - name: Inputtabledat
                  style: DAT
                  label: Input Table DAT
                  startSection: true
                  help: Table used as input to the lister. Wired input will override this.
                  value: =parent.Widget.par.Inputtabledat.eval() or ''
                - name: Inputtablehasheaders
                  style: Toggle
                  label: Input Table Has Headers
                  default: true
                  help: If True, the first row of the input table will be treated as column headers. For this to work, every column must have a non-blank header.
                  value: =parent.Widget.par.Inputtablehasheaders
                - name: Refreshoninputchange
                  style: Toggle
                  label: Refresh On Input Change
                  help: When on, lister will be automatically refreshed when wired inputTable changes.
                  value: =parent.Widget.par.Refreshoninputchange
                - name: Autosyncinputtable
                  style: Toggle
                  label: Auto-sync Input Table
                  help: 'If True, changes to the lister will be mirrored back to Input Table DAT automatically. This only works for columns with the following sourceDataModes: int, float, string, version, blank, color. Only available when Input Table DAT is defined via parameter and Input Table Has Headers is True.'
                  value: =parent.Widget.par.Autosyncinputtable
                - name: Sourceindexinoutput
                  style: Toggle
                  label: Source Index In Output
                  help: If True, adds a column to the output DATs that holds the original index of the row data, from the input source. Useful for referring back to source tables after data is sorted or rearranged.
                - name: Autodefinecols
                  style: Toggle
                  label: Auto-define Columns
                  startSection: true
                  help: Enables automatic generation of table columns.
                  value: =parent.Widget.par.Autodefinecols
                - name: Recreateautocolumns
                  style: Pulse
                  label: Recreate Auto-columns
                  help: Re-analyzes raw data to create automatic column definitions. This will resize column widths, among other things.
                - name: Copyautocolstoconfig
                  style: Pulse
                  label: Copy Auto Cols To Config
                  help: 'Pressing this button copies the column settings created by Autodefine Columns into the lister''s custom colDefine table. This is useful for creating a starting point based on Autodefine settings. WARNING: this will destroy all current custom column settings.'
                - name: Header
                  style: Toggle
                  startSection: true
                  default: true
                  help: Enables the table header.
                  value: =parent.Widget.par.Header
                - name: Sizablecols
                  style: Toggle
                  label: Sizable Cols
                  default: true
                  help: Drag edges to size columns
                - name: Savecolresizes
                  style: Toggle
                  label: Save Col Resizes
                  help: Save resized column sizes in Column Definitions
                - name: Clickableheader
                  style: Menu
                  label: Clickable Header
                  default: 'False'
                  menuNames:
                  - 'Off'
                  - Set Sort and Filter Column
                  - Set Sort Column
                  - Set Filter Column
                  help: Enables click-to-sort columns feature.
                  value: 'Off'
                - name: Selectablerows
                  style: Toggle
                  label: Selectable Rows
                  default: true
                  help: Enables selection of rows.
                  value: =parent.Widget.par.Selectablerows
                - name: Multiplerowselect
                  style: Toggle
                  label: Multiple Row Select
                  help: Enables selection of multiple rows using shift and ctrl keys. Only available when Selectable Rows is on.
                  value: =parent.Widget.par.Multiplerowselect
                - name: Dragtoreorderrows
                  style: Toggle
                  label: Drag To Reorder Rows
                  help: Enables drag to reorder feature. Only available when Selectable Rows is on (rows must be selected to reorder).
                  value: =parent.Widget.par.Dragtoreorderrows
                - name: Arrowkeys
                  style: Toggle
                  label: Arrow Keys
                  help: Enables moving the row selection using arrow keys. Only available when Selectable Rows is on.
                  value: =parent.Widget.par.Arrowkeys
                - name: Deletekey
                  style: Toggle
                  label: Delete Key
                  help: Enables selected row deletion using Delete key. Only available when Selectable Rows is on.
                  value: =parent.Widget.par.Deletekey
                - name: Highlightrollover
                  style: Toggle
                  label: Highlight Rollover
                  default: true
                  help: When on, rows will be highlighted when rolled over with the mouse. See Config Component inside for highlight colors.
                  value: =parent.Widget.par.Highlightrollover
                - name: Rowstriping
                  style: Menu
                  label: Row Striping
                  default: '''None'''
                  menuNames:
                  - None
                  - Striping
                  - Dividing_Line
                  menuLabels:
                  - None
                  - Striping
                  - Dividing Line
                  help: Striping behavior
                  value: =parent.Widget.par.Rowstriping
                - name: Drophighlight
                  style: Menu
                  label: Drop Highlight
                  default: 'Off'
                  menuNames:
                  - 'Off'
                  - Above_Row
                  - Below_Row
                  - Row
                  - Cell
                  menuLabels:
                  - 'Off'
                  - Above Row
                  - Below Row
                  - Row
                  - Cell
                  help: Defines preview when an external object is dragged into lister and defined as an acceptable drop (see onDropHover callback in Basic Callbacks). The color of the line or highlight will be defined by the dragDropLineColor or dragDropOverlayColor rows in the define table, respectively.
                  value: =parent.Widget.par.Drophighlight
                Select/Sort/Filter:
                - name: Select
                  style: Header
                - name: Saveselectedrows
                  style: Toggle
                  label: Save Selected Rows
                  help: If True, save selection state between loads and when copying/cutting/pasting component.
                - name: Saveseloninputchange
                  style: Toggle
                  label: Save Sel. On Input Change
                  help: If input table changes, save selected rows by number even if row objects are different
                - name: Allowemptyselection
                  style: Toggle
                  label: Allow Empty Selection
                  default: true
                  help: When Off, select the first row if no other row is selected.
                - name: Selectedoutput
                  style: Menu
                  label: Selected Output
                  default: Lister Data
                  menuNames:
                  - Lister Data
                  - Input Table Data
                  help: Determines contents of the out_selected component output.
                - name: Selectedrows
                  style: Str
                  label: Selected Rows
                  startSection: true
                  help: Always contains a space delimited list of the currently selected rows.
                  value: ~parent.Widget.par.Selectedrows
                - name: Sort
                  style: Header
                  startSection: true
                - name: Savesort
                  style: Toggle
                  label: Save Sort
                  default: true
                  help: If True, save sort state between loads and when copying/cutting/pasting component.
                  value: false
                - name: Usesortindicatorchars
                  style: Toggle
                  label: Use Sort Indicator Chars
                  help: If True, display the following characters in sorted column headers to indicate sort direction
                  value: true
                - name: Sortchar
                  style: Str
                  label: Sort Char
                  default: Λ
                  help: If list is sorted by a column, display this in column header after label
                - name: Sortreversechar
                  style: Str
                  label: Sort Reverse Char
                  default: V
                  help: If list is reverse sorted by a column, display this in column header after label
                - name: Sortcols
                  style: Str
                  label: Sort Columns
                  startSection: true
                  help: A space delimited list of columns to sort by. Note that this is set automatically when Clickable Header is set to True.
                  value: ~parent.Widget.par.Sortcols
                - name: Sortreverse
                  style: Toggle
                  label: Sort Reverse
                  help: When True, sort order is reversed.
                  value: ~parent.Widget.par.Sortreverse
                - name: Filter
                  style: Header
                  startSection: true
                - name: Savefilter
                  style: Toggle
                  label: Save Filter
                  help: If True, save filter state between loads and when copying/cutting/pasting component.
                - name: Filterstring
                  style: Str
                  label: Filter String
                  help: In order to be displayed, rows must contain the filter string in one or more of the filter columns.
                  value: ~parent.Widget.par.Filterstring
                - name: Filtercols
                  style: Str
                  label: Filter Columns
                  startSection: true
                  help: A space delimited list of columns to apply the filter to. If this is blank, no filter will be applied.
                  value: ~parent.Widget.par.Filtercols
                Advanced:
                - name: Allowundo
                  style: Toggle
                  label: Allow Undo
                  help: Enables Undo features when user edits cells and moves rows.
                  value: =parent.Widget.par.Allowundo
                - name: Advancedcallbacks
                  style: Toggle
                  label: Do Advanced Callbacks
                  help: Enables advanced callback features. See inside the internal Docs component for more information.
                  value: =parent.Widget.par.Advancedcallbacks
                - name: Rawdata
                  style: Python
                  label: Raw Data
                  help: This is a versatile parameter that can be either contain a path to a tableDAT containing data for the Lister, a python list, a python list of lists, or a python list of dictionaries. Useful for testing different kinds of input.
                  value: =parent.Widget.par.Rawdata.eval() or ''
                - name: Linkedtable
                  style: DAT
                  label: Linked Table DAT
                  help: The lister's contents will be locked to the contents of this DAT. Changes to the DAT will be reflected in Lister and vice-versa.
                  value: =parent.Widget.par.Linkedtable.eval() or ''
                - name: Lockconfigs
                  style: Toggle
                  label: Lock Configs
                  startSection: true
                  help: Turn off to allow changes to the following two parameters...
                  value: =parent.Widget.par.Lockconfigs
                - name: Configcomp
                  style: COMP
                  label: Config Comp
                  default: .
                  help: The Lister's Config Component containing format information.
                  value: =parent.Widget.par.Configcomp.eval() or 'config'
                - name: Callbackdat
                  style: DAT
                  label: Callback DAT
                  default: .
                  help: The DAT containing the Lister's custom callbacks. Normally this is located in the Config Component.
                  value: =parent.Widget.par.Callbackdat.eval() or 'config/callbacks'
                About:
                - name: Help
                  style: Pulse
                - name: Version
                  style: Str
                  default: 1.22.4
                  readOnly: true
                  value: 1.19.2
                - name: Toxsavebuild
                  style: Str
                  label: .tox Save Build
                  readOnly: true
                  value: '2023.31421'
              flags:
              - viewer
              color: [0.35, 0.05, 0.5]
              tags:
              - TDPub
              inputs:
              - in1
              palette_clone: true
            - name: opexec1
              type: opexecuteDAT
              parameters:
                op: =op('lister').par.Configcomp or ''
                childrename: true
              flags:
              - viewer
              position: [425, 100]
              dat_content: "# me - this DAT.\n# changeOp - the operator that has changed\n# \n# Make sure the corresponding toggle is enabled in the OP Execute DAT.\n\ndef onPreCook(changeOp):\n\treturn\n\ndef onPostCook(changeOp):\n\treturn\n\ndef onOPDelete():\n\tparent.List.OnDelete()\n\treturn\n\ndef onFlagChange(changeOp, flag):\n\treturn\n\ndef onWireChange(changeOp):\n\treturn\n\ndef onNameChange(changeOp):\n\treturn\n\ndef onPathChange(changeOp):\n\treturn\n\ndef onUIChange(changeOp):\n\treturn\n\ndef onNumChildrenChange(changeOp):\n\treturn\n\ndef onChildRename(changeOp):\n\treturn\n\ndef onCurrentChildChange(changeOp):\n\treturn\n\ndef onExtensionChange(changeOp, extension):\n\treturn\n\t"
              dat_content_format: text
            - name: parexec1
              type: parameterexecuteDAT
              parameters:
                active: false
                fromop: =parent()
                op: =parent.Widget
                pars: Edit*
                valuechange: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n# \n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef onValueChange(par, prev):\n\treturn\n\ndef onPulse(par):\n\t\"\"\"\n\tFirst PromoteConfigComp will check to ensure config component is properly \n\tpromoted, then it runs the requested pulse for Edit commands\n\t\"\"\"\n\tparent.List.PromoteConfigComp()\n\t#debug(par.name, 'pulse')\n\tgetattr(op('lister').par, par.name).pulse()\n\treturn\n\ndef onExpressionChange(par, val, prev):\n\treturn\n\ndef onExportChange(par, val, prev):\n\treturn\n\ndef onEnableChange(par, val, prev):\n\treturn\n\ndef onModeChange(par, val, prev):\n\treturn\n\t"
              dat_content_format: text
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 200]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: extensionParExec
              type: parameterexecuteDAT
              parameters:
                active: false
                fromop: =parent()
                op: =parent()
                pars: '*'
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-300, 0]
              size: [130, 90]
              dat_content: "# This is a callback system for parameters. \n# to use:\n#\t- create a function in ParCallbacksExt/ParCallbacks\n#\t  using the same name as the parameter.\n\t\ndef onValueChange(par, val, prev):\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par, val, prev)\n\ndef onPulse(par):\n\t#debug(par)\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par)\n\ndef onExpressionChange(par, val, prev):\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par, val, prev)\n\ndef onExportChange(par, val, prev):\n\tcomp = op(me.par.op)\n\tif hasattr(comp, par.name):\n\t\tgetattr(comp, par.name)(par, val, prev)\n\ndef onEnableChange(par, val, prev):\n\treturn\n\t"
              dat_content_format: text
          - name: out1
            type: outDAT
            parameters:
              label: =me.name
            flags:
            - viewer
            position: [500, -125]
            size: [130, 90]
            inputs:
            - list
            dat_read_only: true
          - name: out2
            type: outDAT
            parameters:
              label: =me.name
            flags:
            - viewer
            position: [500, -300]
            size: [130, 90]
            inputs:
            - list
            dat_read_only: true
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: customPars
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Lister:
              - name: Refresh
                style: Pulse
              - name: Helppage
                style: Pulse
                label: Help Page
                startSection: true
              - name: Editconfigcomp
                style: Pulse
                label: Edit Config COMP
              - name: Editcoldefine
                style: Pulse
                label: Edit Column Definitions
              - name: Editcallbacks
                style: Pulse
                label: Edit Callbacks
              - name: Printcallbacks
                style: Toggle
                label: Print Callbacks
              - name: Inputtabledat
                style: DAT
                label: Input Table DAT
                startSection: true
              - name: Refreshoninputchange
                style: Toggle
                label: Refresh On Input Change
              - name: Inputtablehasheaders
                style: Toggle
                label: Input Table Has Headers
              - name: Autosyncinputtable
                style: Toggle
                label: Auto-sync Input Table
              - name: Autodefinecols
                style: Toggle
                label: Auto-define Columns
                startSection: true
              - name: Recreateautocolumns
                style: Pulse
                label: Recreate Auto-columns
              - name: Copyautocolstoconfig
                style: Pulse
                label: Copy Auto Cols To Config
              - name: Header
                style: Toggle
                label: Show Header
                startSection: true
                default: true
              - name: Clickableheader
                style: Toggle
                label: Clickable Header
              - name: Selectablerows
                style: Toggle
                label: Selectable Rows
                default: true
              - name: Multiplerowselect
                style: Toggle
                label: Multiple Row Select
              - name: Dragtoreorderrows
                style: Toggle
                label: Drag To Reorder Rows
              - name: Arrowkeys
                style: Toggle
                label: Arrow Keys
              - name: Deletekey
                style: Toggle
                label: Delete Key
              - name: Highlightrollover
                style: Toggle
                label: Highlight Rollover
                default: true
              - name: Rowstriping
                style: Menu
                label: Row Striping
                default: '''None'''
                menuNames:
                - None
                - Striping
                - Dividing_Line
                menuLabels:
                - None
                - Striping
                - Dividing Line
                value: None
              - name: Drophighlight
                style: Menu
                label: Drop Highlight
                default: 'Off'
                menuNames:
                - 'Off'
                - Above_Row
                - Below_Row
                - Row
                - Cell
                menuLabels:
                - 'Off'
                - Above Row
                - Below Row
                - Row
                - Cell
              Sort/Filter/Select:
