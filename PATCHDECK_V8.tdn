            - name: Rockerwidth
              style: Int
              label: Width
              default: 100
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
              enable: false
            - name: Rockerhfillweight
              style: Float
              label: Horizontal Fill Weight
              default: 1
