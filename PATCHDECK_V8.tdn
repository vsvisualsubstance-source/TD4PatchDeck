              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: menu
            type: baseCOMP
            parameters:
              opviewer: ./menuOptionsOut
              enablecloning: false
            custom_pars:
              Menu:
                $t: menu_5
            flags:
            - viewer
            position: [200, 200]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            inputs:
            - in_menuOptions
            children:
            - name: eval1
              type: evaluateDAT
              parameters:
                expr: parent.Widget.par.Menunames.eval() + ' ' + parent.Widget.par.Menulabels.eval()
                rowindexend: =me.inputTable.numRows - 1
                colindexend: =me.inputTable.numCols - 1
              position: [200, -500]
              comment: only to test for changes
              dat_read_only: true
            - name: entries
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [600, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content: "TDF = op.TDModules.mod.TDFunctions\ntable = op('menuOptions')\n\ndef par():\n\treturn TDF.parMenu(names(), labels())\n\t\n\ndef names():\n\ttry:\n\t\treturn [c.val for c in table.col(0)][1:]\n\texcept:\n\t\treturn []\n\n\ndef labels():\n\ttry:\n\t\treturn [c.val for c in table.col(1)][1:]\n\texcept:\n\t\treturn []"
              dat_content_format: text
            - name: tablePar
              type: selectDAT
              parameters:
                dat: =parent.Widget.par.Menuoptiontable.eval() if parent.Widget.par.Menuoptiontable.eval() else ''
                rowindexend: =me.inputs[0].numRows - 1
                rowexpr: =re.match('.*',me.inputCell.val) != None
                colindexend: =me.inputs[0].numCols - 1
              flags:
              - viewer
              position: [0, -200]
              size: [130, 90]
              dat_read_only: true
            - name: out_menu0
              type: outCHOP
              parameters:
                label: Selected Index
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [800, -200]
              inputs:
              - selectedCell
            - name: out_menu1
              type: outDAT
              parameters:
                label: Selected
              flags:
              - viewer
              position: [800, -300]
              size: [130, 90]
              inputs:
              - selectedRowSelect
              dat_read_only: true
            - name: out_menu2
              type: outDAT
              parameters:
                label: Menu Options
              flags:
              - viewer
              position: [800, -500]
              size: [130, 90]
              inputs:
              - menuOptions
              dat_read_only: true
            - name: menuOptions
              type: scriptDAT
              parameters:
                callbacks: script1_callbacks
              custom_pars:
                Custom:
                  $t: custom_2
              flags:
              - viewer
              position: [400, -500]
              inputs:
              - menuOptionsInOrPar
              - eval1
              dat_read_only: true
            - name: selectedCell
              type: constantCHOP
              parameters:
                autoexportroot: =me.parent()
                exporttable: constant2_export
              sequences:
                const:
                - name: menuIndex
                  value: =parent.Widget.par.Value0.menuIndex
              flags:
              - viewer
              position: [600, -200]
              size: [130, 90]
            - name: menuOptionsIn
              type: inDAT
              parameters:
                label: Menu Options Table
              position: [0, -300]
              dat_read_only: true
            - name: inputHeaderFix
              type: insertDAT
              parameters:
                at: =0 if parent.Widget.par.Tableformat.menuIndex == 0 else 1
                contents: name label
              position: [400, -300]
              inputs:
              - menuOptionsInOrPar
              dat_read_only: true
            - name: constant2_export
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
              flags:
              - viewer
              position: [600, -325]
              size: [130, 90]
              dock: selectedCell
              dat_content:
              - - name
                - index
                - path
                - parameter
                - enable
              - - selected_cell
                - '0'
                - selectedRowSelect
                - rowindexstart
                - '1'
              - - selected_cell
                - '0'
                - selectedRowSelect
                - rowindexend
                - '1'
              dat_content_format: table
            - name: script1_callbacks
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              dock: menuOptions
              dat_content: "# me - this DAT\n# scriptOp - the OP which is cooking\n#\n# press 'Setup Parameters' in the OP to call this function to re-create the parameters.\ndef onSetupParameters(scriptOp):\n\treturn\n\n# called whenever custom pulse parameter is pushed\ndef onPulse(par):\n\treturn\n\ndef onCook(scriptOp):\n\ttry:\n\t\tscriptOp.text = setupMenuOptions(scriptOp)\n\texcept:\n\t\tscriptOp.text = \"name\\tlabel\"\n\t#scriptOp.copy(scriptOp.inputs[0])\t# no need to call .clear() above when copying\n\t#scriptOp.insertRow(['color', 'size', 'shape'], 0)\n\t#scriptOp.appendRow(['red', '3', 'square'])\n\t#scriptOp[1,0] += '**'\n\n\treturn\n\ndef setupMenuOptions(scriptOp):\n\tif hasattr(parent.Widget.par, 'Synctoboundmenu'):\n\t\tparent.Widget.par.Menulabels.readOnly = \\\n\t\t\tparent.Widget.par.Menunames.readOnly = \\\n\t\t\t\t\t\t\t\t\tparent.Widget.par.Synctoboundmenu.eval()\n\texternalMenuTable = scriptOp.inputs[0]\n\tif externalMenuTable.numCols:\n\t\tlabels = []\n\t\t#['AllRows_FirstCols', 'LabelRow_FirstCols', 'LabelRow_LabeledCols']\n\t\tif parent.Widget.par.Tableformat.eval() ==\\\n\t\t\t\t\t\t\t\t\t\t\t\t'ExcludeFirstRow_LabeledCols':\n\t\t\tnames = [c.val for c in externalMenuTable.col('name')[1:]]\n\t\t\tlabelCol = externalMenuTable.col('label')\n\t\t\tif labelCol:\n\t\t\t\tlabels = [c.val for c in labelCol[1:]]\n\t\telse:\n\t\t\tnames = [c.val for c in externalMenuTable.col(0)]\n\t\t\tlabelCol = externalMenuTable.col(1)\n\t\t\tif labelCol:\n\t\t\t\tlabels = [c.val for c in labelCol]\n\t\t\tif parent.Widget.par.Tableformat.eval() == \\\n\t\t\t\t\t\t\t\t\t\t\t\t'ExcludeFirstRow_NumberedCols':\n\t\t\t\tnames.pop(0)\n\t\t\t\tif labels:\n\t\t\t\t\tlabels.pop(0)\n\telse:\n\t\tnames = tdu.split(parent.Widget.par.Menunames)\n\t\tlabels = tdu.split(parent.Widget.par.Menulabels)\n\tfinalNames = names\n\tfinalLabels = []\n\tfor i, name in enumerate(names):\n\t\tif i < len(labels):\n\t\t\tfinalLabels.append(labels[i])\n\t\telse:\n\t\t\tfinalLabels.append(name)\n\treturn 'name\\tlabel\\n' + \\\n\t\t\t'\\n'.join([finalNames[i] + '\\t' + finalLabels[i]\n\t\t\t\t\t   \t\tfor i in range(len(finalNames))])"
              dat_content_format: text
            - name: selectedRowSelect
              type: selectDAT
              parameters:
                dat: =op('inputHeaderFix') if op('menuOptionsIn').numRows else op('menuOptions')
                firstrow: true
                extractrows: byindex
                rowindexstart: '=op(''selectedCell'')[0] + 1 # if parent.Widget.par.Tableformat.menuIndex > 0 or not op(''menuOptionsIn'').numRows else 0'
                rowindexend: '=op(''selectedCell'')[0] + 1 # if parent.Widget.par.Tableformat.menuIndex > 0 or not op(''menuOptionsIn'').numRows else 0'
                rowexpr: =re.match('.*',me.inputCell.val) != None
                colindexend: =me.inputs[0].numCols - 1
              flags:
              - viewer
              position: [600, -300]
              size: [130, 90]
              dat_read_only: true
            - name: menuOptionsInOrPar
              type: switchDAT
              parameters:
                index: =bool(parent.Widget.inputs and parent.Widget.inputs[0])
              position: [200, -300]
              size: [130, 90]
              inputs:
              - tablePar
              - menuOptionsIn
              dat_read_only: true
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_11
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: valueOut
            type: outDAT
            parameters:
              label: =me.name
            position: [400, 0]
            size: [130, 90]
            inputs:
            - output
            dat_read_only: true
          - name: folderTabs
            type: containerCOMP
            parameters:
              h: 30
              hmode: fill
              vmode: fill
              alignorder: 1
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              borderar: 0
              borderag: 0
              borderab: 0
              borderaalpha: 0
              bottomborder: bordera
              bottomborderi: bordera
              align: horizlr
              spacing: =parent.Widget.par.Foldertabmargin
              justifyh: left
              justifyv: bottom
              drop: usecallbacks
              dragdropcallbacks: ./dragDropCallbacks
            sequences:
              ext:
              - object: op('./FolderExt').module.FolderExt(me)
                promote: true
              - {}
              - {}
              - {}
              iop:
              - {}
              - {}
            custom_pars:
              Folder:
                $t: folder_2
                Foldertabfontsizemode: relfract
                Foldertabfontsize: 20
                Foldertabalignx: left
                Foldertabaligny: center
              Tabs:
                $t: tabs_2
                Folderselectedtabfullsize: true
                Folderhelplabelwhenshrunk: true
                Folderdropdown: true
                Folderdragtoreorder: true
                Folderusereorderscript: true
            flags:
            - viewer
            position: [200, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: tab0
              type: buttonCOMP
              parameters:
                scaletofit: onlyshrink
                y: =1-(me.digits == parent.Widget.par.Value0.eval())
                w: =parent().TabWidths[me.digits] if parent().extensionsReady and parent().TabWidths else 0
                h: 50
                vmode: anchors
                topoffset: =- (0 if me.par.Selected else parent.Widget.par.Foldertabopenmargin) if parent.Widget.extensionsReady else 0
                display: =op('menuOptions').numRows > 1 and me.digits in parent().VisibleTabs if parent().extensionsReady else False
                clickthrough: =parent.Widget.par.clickthrough
                bgcolorr: 1
                bgalpha: 1
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                drag: usecallbacks
                drop: usecallbacks
                dragdropcallbacks: dragDropCallbacks
                parentshortcut: Tab
                enablecloning: true
                relpath: inherit
              custom_pars:
                Tab:
                  $t: tab
                  Index: =op('menuOptions')[me.digits + 1, 2] if op('menuOptions').numRows > 1 else -1
                  Selected: =me.par.Index == parent.Widget.par.Value0.menuIndex
                  Shrunken: =parent().MinTextWidths[me.digits] > me.par.w if parent().extensionsReady and parent().MinTextWidths else 0
              position: [0, 100]
              size: [160, 130]
              children:
              - name: 'on'
                type: textCOMP
                parameters:
                  text: =op('off').par.value
                  callbacks: on_textCOMP_callbacks
                  legacyfontselection: true
                  font: =parent.Widget.par.Foldertabfont.eval()
                  fontfile: =parent.Widget.par.Foldertabfontfile
                  bold: =parent.Widget.par.Foldertabfontbold.eval()
                  italic: =parent.Widget.par.Foldertabitalic
                  scaletofit: =parent.Widget.par.Foldertabscaletofit
                  fontsize: =parent.Widget.par.Foldertabfontsize.eval() if parent.Widget.par.Foldertabfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Foldertabfontfraction.eval()
                  fontsizeunits: =parent.Widget.par.Foldertabfontsizemode.eval()
                  fontcolorr: =parent.Widget.par.Foldertabonfontcolorr.eval()
                  fontcolorg: =parent.Widget.par.Foldertabonfontcolorg.eval()
                  fontcolorb: =parent.Widget.par.Foldertabonfontcolorb.eval()
                  fontalpha: =parent.Widget.par.Foldertabonfontcolora.eval()
                  dropshadow: =parent.Widget.par.Foldertabdropshadow
                  textoffsetx: =parent.Widget.par.Foldertaboffsetx.eval()
                  textoffsety: =parent.Widget.par.Foldertaboffsety.eval()
                  alignx: =parent.Widget.par.Foldertabalignx.eval()
                  alignxmode: =parent.Widget.par.Foldertabalignxmode.eval()
                  aligny: =parent.Widget.par.Foldertabaligny.eval()
                  alignymode: =parent.Widget.par.Foldertabalignymode.eval()
                  w: 75
                  h: 26
                  hmode: fill
                  vmode: fill
                  display: =not op('off').par.display
                  clickthrough: true
                  bgcolorr: =parent.Widget.par.Foldertabonfacecolorr.eval()
                  bgcolorg: =parent.Widget.par.Foldertabonfacecolorg.eval()
                  bgcolorb: =parent.Widget.par.Foldertabonfacecolorb.eval()
                  bgalpha: =parent.Widget.par.Foldertabonfacecolora.eval()
                  borderar: =parent.Widget.par.Foldertabonbordercolorr.eval()
                  borderag: =parent.Widget.par.Foldertabonbordercolorg.eval()
                  borderab: =parent.Widget.par.Foldertabonbordercolorb.eval()
                  borderaalpha: =parent.Widget.par.Foldertabonbordercolora.eval()
                  borderbalpha: 0
                  leftborder: =parent.Widget.par.Foldertabonborderleft
                  rightborder: =parent.Widget.par.Foldertabonborderright
                  bottomborder: =parent.Widget.par.Foldertabonborderbottom
                  topborder: =parent.Widget.par.Foldertabonbordertop
                  borderover: false
                flags:
                - viewer
                position: [0, -25]
                size: [160, 130]
              - name: 'off'
                type: textCOMP
                parameters:
                  text: =op('../menuOptions')[parent().digits + 1,'label']
                  callbacks: off_textCOMP_callbacks
                  legacyfontselection: true
                  font: =parent.Widget.par.Foldertabfont.eval()
                  fontfile: =parent.Widget.par.Foldertabfontfile
                  bold: =parent.Widget.par.Foldertabfontbold.eval()
                  italic: =parent.Widget.par.Foldertabitalic
                  scaletofit: =parent.Widget.par.Foldertabscaletofit
                  fontsize: =parent.Widget.par.Foldertabfontsize.eval() if parent.Widget.par.Foldertabfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Foldertabfontfraction.eval()
                  fontsizeunits: =parent.Widget.par.Foldertabfontsizemode.eval()
                  fontcolorr: =parent.Widget.par.Foldertabofffontcolorr.eval()
                  fontcolorg: =parent.Widget.par.Foldertabofffontcolorg.eval()
                  fontcolorb: =parent.Widget.par.Foldertabofffontcolorb.eval()
                  fontalpha: =parent.Widget.par.Foldertabofffontcolora.eval()
                  dropshadow: =parent.Widget.par.Foldertabdropshadow
                  textoffsetx: =parent.Widget.par.Foldertaboffsetx.eval()
                  textoffsety: =parent.Widget.par.Foldertaboffsety.eval()
                  textpaddingl: =parent.Widget.par.Foldertabpadding1.eval()
                  textpaddingr: =parent.Widget.par.Foldertabpadding2.eval()
                  textpaddingb: =parent.Widget.par.Foldertabpadding3.eval()
                  textpaddingt: =parent.Widget.par.Foldertabpadding4.eval()
                  alignx: =parent.Widget.par.Foldertabalignx.eval()
                  alignxmode: =parent.Widget.par.Foldertabalignxmode.eval()
                  aligny: =parent.Widget.par.Foldertabaligny.eval()
                  alignymode: =parent.Widget.par.Foldertabalignymode.eval()
                  w: 75
                  h: 26
                  hmode: fill
                  vmode: fill
                  display: =not parent().par.Index == parent.Widget.par.Value0.menuIndex
                  clickthrough: true
                  bgcolorr: =parent.Widget.par.Foldertabofffacecolorr.eval()
                  bgcolorg: =parent.Widget.par.Foldertabofffacecolorg.eval()
                  bgcolorb: =parent.Widget.par.Foldertabofffacecolorb.eval()
                  bgalpha: =parent.Widget.par.Foldertabofffacecolora.eval()
                  borderar: =parent.Widget.par.Foldertaboffbordercolorr.eval()
                  borderag: =parent.Widget.par.Foldertaboffbordercolorg.eval()
                  borderab: =parent.Widget.par.Foldertaboffbordercolorb.eval()
                  borderaalpha: =parent.Widget.par.Foldertaboffbordercolora.eval()
                  borderbalpha: 0
                  leftborder: =parent.Widget.par.Foldertaboffborderleft
                  rightborder: =parent.Widget.par.Foldertaboffborderright
                  bottomborder: =parent.Widget.par.Foldertaboffborderbottom
                  topborder: =parent.Widget.par.Foldertaboffbordertop
                  borderover: false
                flags:
                - viewer
                position: [0, 200]
                size: [160, 130]
              - name: fade
                type: containerCOMP
                parameters:
                  layer: 1
                  hmode: fill
                  vmode: fill
                  display: =parent().par.Shrunken
                  clickthrough: true
                  resizecomp: =me
                  top: ramp1
                  borderover: false
                  composite: multiply
                flags:
                - viewer
                position: [300, 100]
                size: [160, 130]
              - name: help
                type: evaluateDAT
                parameters:
                  expr: parent(2).HelpString(parent().digits)
                  rowindexend: =me.inputTable.numRows - 1
                  colindexend: =me.inputTable.numCols - 1
                position: [0, -400]
                dat_read_only: true
              - name: ramp1
                type: rampTOP
                parameters:
                  dat: ramp1_keys
                  color4: 0
                  extendleft: hold
                  extendright: black
                  combineinput: res
                  resolutionw: =parent().width * 3
                  resolutionh: 1
                flags:
                - viewer
                position: [325, -25]
                size: [130, 90]
              - name: button
                type: containerCOMP
                parameters:
                  w: 317
                  h: 22
                  layer: 2
                  hmode: anchors
                  vmode: fill
                  clickthrough: true
                  resizecomp: =me
                  bgcolorr: =parent.Widget.par.Foldertabonfacecolorr.eval() if parent().par.Selected else parent.Widget.par.Foldertabofffacecolorr.eval()
                  bgcolorg: =parent.Widget.par.Foldertabonfacecolorg.eval() if parent().par.Selected else parent.Widget.par.Foldertabofffacecolorg.eval()
                  bgcolorb: =parent.Widget.par.Foldertabonfacecolorb.eval() if parent().par.Selected else parent.Widget.par.Foldertabofffacecolorb.eval()
                  bgalpha: =parent.Widget.par.Foldertabonfacecolora.eval() if parent().par.Selected else parent.Widget.par.Foldertabofffacecolora.eval()
                  top: bg
                  topfill: native
                  borderar: =parent.Widget.par.Foldertabonbordercolorr.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffbordercolorr.eval()
                  borderag: =parent.Widget.par.Foldertabonbordercolorg.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffbordercolorg.eval()
                  borderab: =parent.Widget.par.Foldertabonbordercolorb.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffbordercolorb.eval()
                  borderaalpha: =parent.Widget.par.Foldertabonbordercolora.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffbordercolora.eval()
                  borderbalpha: 0
                  leftborder: =parent.Widget.par.Foldertabonborderleft.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffborderleft.eval()
                  leftborderi: =me.par.leftborder if parent.Widget.par.Folderdoubletabborders else 0
                  rightborder: =parent.Widget.par.Foldertabonborderright.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffborderright.eval()
                  rightborderi: =me.par.rightborder if parent.Widget.par.Folderdoubletabborders else 0
                  bottomborder: =parent.Widget.par.Foldertabonborderbottom.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffborderbottom.eval()
                  bottomborderi: =me.par.bottomborder if parent.Widget.par.Folderdoubletabborders else 0
                  topborder: =parent.Widget.par.Foldertabonbordertop.eval() if parent().par.Selected else parent.Widget.par.Foldertaboffbordertop.eval()
                  topborderi: =me.par.topborder if parent.Widget.par.Folderdoubletabborders else 0
                  borderover: false
                  composite: under
                sequences:
                  ext:
                  - promote: true
                flags:
                - viewer
                position: [600, 175]
                size: [160, 130]
              - name: rollover
                type: containerCOMP
                parameters:
                  layer: 7
                  hmode: fill
                  vmode: fill
                  alignallow: ignore
                  display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                  clickthrough: true
                  resizecomp: =me
                  bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                  bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                  bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                  bgalpha: =parent.Widget.par.Rollovercolora.eval()
                  borderover: false
                  composite: =parent.Widget.par.Rollovercomposite.eval()
                flags:
                - viewer
                position: [500, 400]
                size: [160, 130]
              - name: ramp1_keys
                type: tableDAT
                flags:
                - viewer
                position: [325, -150]
                size: [130, 90]
                dock: ramp1
                dat_content:
                - - pos
                  - r
                  - g
                  - b
                  - a
                - - '0'
                  - '1'
                  - '1'
