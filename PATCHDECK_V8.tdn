            - name: Menuautowidth
              style: Toggle
              label: Auto Width
              startSection: true
              default: true
            - name: Menupopupwidth
              style: Int
              label: Popup Width
              default: 33
              min: 1.0
              max: 100.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
              enable: false
            - name: Menuitemverticalpadding
              style: Int
              label: Item Vertical Padding
              default: 5
              max: 100.0
              clampMin: true
              normMax: 30.0
            - name: Menuitemhorizontalpadding1
              style: Int
              label: Item Horizontal Padding
              default: 10
              clampMin: true
              normMax: 20.0
            - name: Menuautoclose
              style: Toggle
              label: Auto Close
              default: true
            - name: Menurunonclick
              style: Toggle
              label: Run On Click
              startSection: true
            - name: Menucommandonclick
              style: Str
              label: Command On Click
              default: debug(me, 'click')
              enable: false
            - name: Menucustomizeinteraction
              style: Pulse
              label: Customize Interaction
              startSection: true
            - name: Menupanelexec
              style: DAT
              label: Panel Exec
              readOnly: true
              enable: false
            Menu Look:
            - name: Menubuttonfontsize
              style: Int
              label: Button Font Size
              default: 10
              clampMin: true
              normMin: 6.0
              normMax: 24.0
            - name: Menufontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: points
              menuNames:
              - panelunits
              - fract
              - relfract
              - points
              menuLabels:
              - Panel Units
              - Fraction
              - Fraction Aspect
              - Points
            - name: Menufontsize
              style: Int
              label: Font Size
              default: 10
              min: 1.0
              max: 20.0
              clampMin: true
              normMin: 6.0
              normMax: 20.0
              enableExpr: me.par.Menufontsizemode.eval() in ['points', 'panelunits']
            - name: Menufontfraction
              style: Float
              label: Font Fraction
              default: 1
              enableExpr: me.par.Menufontsizemode.eval() in ['fract', 'relfract']
              enable: false
            - name: Menuscaletofit
              style: Menu
              label: Scale Text to Fit
              default: never
              menuNames:
              - never
              - always
              - onlyshrink
              menuLabels:
              - Never
              - Always
              - Only when Too Large
            - name: Menufontbold
              style: Toggle
              label: Font Bold
            - name: Menuitalic
              style: Toggle
              label: Italic
            - name: Menudropshadow
              style: Toggle
              label: Drop Shadow
            - name: Menuoffset
              style: XYZW
              label: Offset
              size: 2
              startSection: true
              default: [6, 0]
              min: -5.0
              max: 5.0
              normMin: -5.0
              normMax: 5.0
            - name: Menubgcolor
              style: RGBA
              label: Background Color
              startSection: true
              default: [0.25, 0.25, 0.25, 1]
            - name: Menurollcolor
              style: RGBA
              label: Roll Color
              default: [0.3185, 0.3185, 0.3185, 1]
            - name: Menuselectcolor
              style: RGBA
              label: Select Color
              default: [0.4419, 0.4419, 0.4419, 1]
            - name: Menufontoffcolor
              style: RGBA
              label: Font Off Color
              default: [0.8, 0.8, 0.8, 1]
            - name: Menufontoncolor
              style: RGBA
              label: Font On Color
              default: [0.65, 0.65, 0.65, 1]
            - name: Menubuttoniconcolor
              style: RGBA
              label: Button Icon Color
            - name: Menubuttonofffacecolor
              style: RGBA
              label: Button Off Color
              default: [0.3, 0.3, 0.3, 1]
            - name: Menubuttononfacecolor
              style: RGBA
              label: Button On Color
              default: [0.3276, 0.4719, 0.52, 1]
            - name: Menubuttonrollcolor
              style: RGBA
              label: Button Roll Color
              default: [0.7, 0.7, 0.7, 0.35]
            - name: Popmenuwindowscalemode
              style: Menu
              label: Popmenu Window Scale Mode
              startSection: true
              default: native
              menuNames:
              - native
              - usedpiscale
              menuLabels:
              - Native
              - Use DPI Scale
              enable: false
            Widget:
            - name: Enablerollover
              style: Toggle
              label: Enable Rollover
              startSection: true
              default: true
            - name: Rollovercolor
              style: RGBA
              label: Rollover Color
              default: [0.9, 0.9, 0.9, 0.15]
              enableExpr: me.par.Enablerollover.eval()
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
              menuNames:
              - over
              - under
              - inside
              - outside
              - add
              - subtract
              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
              enableExpr: me.par.Enablerollover.eval()
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: [0.2, 0.2, 0.2, 0.65]
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              enableExpr: not me.par.Fontfile
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: masterDropMenu
              enable: false
            OPs:
            - name: Dropmenu0
              style: COMP
              label: dropmenu0
              default: ./dropmenu0
              readOnly: true
            About:
              $t: about_4
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -200]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: menu
            type: baseCOMP
            parameters:
              opviewer: ./menuOptionsOut
              enablecloning: false
            custom_pars:
              Menu:
                $t: menu_4
            flags:
            - viewer
            position: [200, 200]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            inputs:
            - in_menuOptions
            children:
            - name: eval1
              type: evaluateDAT
              parameters:
                expr: parent.Widget.par.Menunames.eval() + ' ' + parent.Widget.par.Menulabels.eval()
                rowindexend: =me.inputTable.numRows - 1
                colindexend: =me.inputTable.numCols - 1
              position: [200, -500]
              comment: only to test for changes
              dat_read_only: true
            - name: entries
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [600, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content: "TDF = op.TDModules.mod.TDFunctions\ntable = op('menuOptions')\n\ndef par():\n\treturn TDF.parMenu(names(), labels())\n\t\n\ndef names():\n\ttry:\n\t\treturn [c.val for c in table.col(0)][1:]\n\texcept:\n\t\treturn []\n\n\ndef labels():\n\ttry:\n\t\treturn [c.val for c in table.col(1)][1:]\n\texcept:\n\t\treturn []"
              dat_content_format: text
            - name: tablePar
              type: selectDAT
              parameters:
                dat: =parent.Widget.par.Menuoptiontable.eval() if parent.Widget.par.Menuoptiontable.eval() else ''
                rowindexend: =me.inputs[0].numRows - 1
                rowexpr: =re.match('.*',me.inputCell.val) != None
                colindexend: =me.inputs[0].numCols - 1
              flags:
              - viewer
              position: [0, -200]
              size: [130, 90]
              dat_read_only: true
            - name: out_menu0
              type: outCHOP
              parameters:
                label: Selected Index
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [800, -200]
              inputs:
              - selectedCell
            - name: out_menu1
              type: outDAT
              parameters:
                label: Selected
              flags:
              - viewer
              position: [800, -300]
              size: [130, 90]
              inputs:
              - selectedRowSelect
              dat_read_only: true
            - name: out_menu2
              type: outDAT
              parameters:
                label: Menu Options
              flags:
              - viewer
              position: [800, -500]
              size: [130, 90]
              inputs:
              - menuOptions
              dat_read_only: true
            - name: menuOptions
              type: scriptDAT
              parameters:
                callbacks: script1_callbacks
              custom_pars:
                Custom:
                  $t: custom_2
              position: [400, -500]
              inputs:
              - menuOptionsInOrPar
              - eval1
              dat_read_only: true
            - name: selectedCell
              type: constantCHOP
              parameters:
                autoexportroot: =me.parent()
                exporttable: constant2_export
              sequences:
                const:
                - name: menuIndex
                  value: =parent.Widget.par.Value0.menuIndex
              flags:
              - viewer
              position: [600, -200]
              size: [130, 90]
            - name: menuOptionsIn
              type: inDAT
              parameters:
                label: Menu Options Table
              position: [0, -300]
              dat_read_only: true
            - name: inputHeaderFix
              type: insertDAT
              parameters:
                at: =0 if parent.Widget.par.Tableformat.menuIndex == 0 else 1
                contents: name label
              position: [400, -300]
              inputs:
              - menuOptionsInOrPar
              dat_read_only: true
            - name: constant2_export
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
              flags:
              - viewer
              - -showDocked
              position: [600, -325]
              size: [130, 90]
              dock: selectedCell
              dat_content:
              - - name
                - index
                - path
                - parameter
                - enable
              - - selected_cell
                - '0'
                - selectedRowSelect
                - rowindexstart
                - '1'
              - - selected_cell
                - '0'
                - selectedRowSelect
                - rowindexend
                - '1'
              dat_content_format: table
            - name: script1_callbacks
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              dock: menuOptions
              dat_content: "# me - this DAT\n# scriptOp - the OP which is cooking\n#\n# press 'Setup Parameters' in the OP to call this function to re-create the parameters.\ndef onSetupParameters(scriptOp):\n\treturn\n\n# called whenever custom pulse parameter is pushed\ndef onPulse(par):\n\treturn\n\ndef onCook(scriptOp):\n\ttry:\n\t\tscriptOp.text = setupMenuOptions(scriptOp)\n\texcept:\n\t\tscriptOp.text = \"name\\tlabel\"\n\t#scriptOp.copy(scriptOp.inputs[0])\t# no need to call .clear() above when copying\n\t#scriptOp.insertRow(['color', 'size', 'shape'], 0)\n\t#scriptOp.appendRow(['red', '3', 'square'])\n\t#scriptOp[1,0] += '**'\n\n\treturn\n\ndef setupMenuOptions(scriptOp):\n\tif hasattr(parent.Widget.par, 'Synctoboundmenu'):\n\t\tparent.Widget.par.Menulabels.readOnly = \\\n\t\t\tparent.Widget.par.Menunames.readOnly = \\\n\t\t\t\t\t\t\t\t\tparent.Widget.par.Synctoboundmenu.eval()\n\texternalMenuTable = scriptOp.inputs[0]\n\tif externalMenuTable.numCols:\n\t\tlabels = []\n\t\t#['AllRows_FirstCols', 'LabelRow_FirstCols', 'LabelRow_LabeledCols']\n\t\tif parent.Widget.par.Tableformat.eval() ==\\\n\t\t\t\t\t\t\t\t\t\t\t\t'ExcludeFirstRow_LabeledCols':\n\t\t\tnames = [c.val for c in externalMenuTable.col('name')[1:]]\n\t\t\tlabelCol = externalMenuTable.col('label')\n\t\t\tif labelCol:\n\t\t\t\tlabels = [c.val for c in labelCol[1:]]\n\t\telse:\n\t\t\tnames = [c.val for c in externalMenuTable.col(0)]\n\t\t\tlabelCol = externalMenuTable.col(1)\n\t\t\tif labelCol:\n\t\t\t\tlabels = [c.val for c in labelCol]\n\t\t\tif parent.Widget.par.Tableformat.eval() == \\\n\t\t\t\t\t\t\t\t\t\t\t\t'ExcludeFirstRow_NumberedCols':\n\t\t\t\tnames.pop(0)\n\t\t\t\tif labels:\n\t\t\t\t\tlabels.pop(0)\n\telse:\n\t\tnames = tdu.split(parent.Widget.par.Menunames)\n\t\tlabels = tdu.split(parent.Widget.par.Menulabels)\n\tfinalNames = names\n\tfinalLabels = []\n\tfor i, name in enumerate(names):\n\t\tif i < len(labels):\n\t\t\tfinalLabels.append(labels[i])\n\t\telse:\n\t\t\tfinalLabels.append(name)\n\treturn 'name\\tlabel\\n' + \\\n\t\t\t'\\n'.join([finalNames[i] + '\\t' + finalLabels[i]\n\t\t\t\t\t   \t\tfor i in range(len(finalNames))])"
              dat_content_format: text
            - name: selectedRowSelect
              type: selectDAT
              parameters:
                dat: =op('inputHeaderFix') if op('menuOptionsIn').numRows else op('menuOptions')
                firstrow: true
                extractrows: byindex
                rowindexstart: '=op(''selectedCell'')[0] + 1 # if parent.Widget.par.Tableformat.menuIndex > 0 or not op(''menuOptionsIn'').numRows else 0'
                rowindexend: '=op(''selectedCell'')[0] + 1 # if parent.Widget.par.Tableformat.menuIndex > 0 or not op(''menuOptionsIn'').numRows else 0'
                rowexpr: =re.match('.*',me.inputCell.val) != None
                colindexend: =me.inputs[0].numCols - 1
              flags:
              - viewer
              position: [600, -300]
              size: [130, 90]
              dat_read_only: true
            - name: menuOptionsInOrPar
              type: switchDAT
              parameters:
                index: =bool(parent.Widget.inputs and parent.Widget.inputs[0])
              position: [200, -300]
              size: [130, 90]
              inputs:
              - tablePar
              - menuOptionsIn
              dat_read_only: true
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_13
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: valueOut
            type: outDAT
            parameters:
              label: =me.name
            position: [400, 0]
            size: [130, 90]
            inputs:
            - source: output
              out: 1
            dat_read_only: true
          - name: dropmenu0
            type: containerCOMP
            parameters:
              hmode: fill
              vmode: fill
              alignorder: =-me.nodeY
              helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              borderar: 0
              borderag: 0
              borderab: 0
              borderaalpha: 0.996
              align: horizlr
              justifyh: left
              justifyv: top
              enablecloning: false
            sequences:
              ext:
              - object: op('./DropMenuExt').module.DropMenuExt(me)
            custom_pars:
              Menu:
              - name: Menuautowidth
                style: Toggle
                label: Auto Width
                startSection: true
                default: true
              - name: Menupopupwidth
                style: Int
                label: Popup Width
                default: 120
                min: 1.0
                max: 100.0
                clampMin: true
                normMin: 1.0
                normMax: 300.0
                enable: false
                value: 33
              - name: Menuitemverticalpadding
                style: Int
                label: Item Vertical Padding
                default: 4
                max: 100.0
                clampMin: true
                normMax: 30.0
                value: 5
              - name: Menuitemhorizontalpadding1
                style: Int
                label: Item Horizontal Padding
                default: 4
                clampMin: true
                normMax: 20.0
                value: 10
              - name: Menuautoclose
                style: Toggle
                label: Auto Close
                default: true
              - name: Menurunonclick
                style: Toggle
                label: Run On Click
                startSection: true
                default: true
                value: false
              - name: Menucommandonclick
                style: Str
                label: Command On Click
                value: debug(me, 'click')
              - name: Menucustomizeinteraction
                style: Pulse
                label: Customize Interaction
                startSection: true
              - name: Menupanelexec
                style: DAT
                label: Panel Exec
                readOnly: true
              Menu Look:
              - name: Menubuttonfontsize
                style: Int
                label: Button Font Size
                clampMin: true
                normMin: 6.0
                normMax: 24.0
                value: 10
              - name: Menufontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
                value: relfract
              - name: Menufontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                enableExpr: me.par.Menufontsizemode.eval() in ['points', 'panelunits']
                enable: false
                value: 20
              - name: Menufontfraction
                style: Float
                label: Font Fraction
                default: 1
                enableExpr: me.par.Menufontsizemode.eval() in ['fract', 'relfract']
              - name: Menuscaletofit
                style: Menu
                label: Scale Text to Fit
                default: never
                menuNames:
                - never
                - always
                - onlyshrink
                menuLabels:
                - Never
                - Always
                - Only when Too Large
              - name: Menufontbold
                style: Toggle
                label: Font Bold
              - name: Menuitalic
                style: Toggle
                label: Italic
              - name: Menudropshadow
                style: Toggle
                label: Drop Shadow
              - name: Menuoffset
                style: XYZW
                label: Offset
                size: 2
                startSection: true
                min: -5.0
                max: 5.0
                normMin: -5.0
                normMax: 5.0
                values: [6, 0]
              - name: Menubgcolor
                style: RGBA
                label: Background Color
                startSection: true
                values: [0.25, 0.25, 0.25, 1]
              - name: Menurollcolor
                style: RGBA
                label: Roll Color
                default: [0.4, 0.4, 0.4, 1]
                values: [0.3185, 0.3185, 0.3185, 1]
              - name: Menuselectcolor
                style: RGBA
                label: Select Color
                values: [0.4419, 0.4419, 0.4419, 1]
              - name: Menufontoffcolor
                style: RGBA
                label: Font Off Color
                values: [0.8, 0.8, 0.8, 1]
              - name: Menufontoncolor
                style: RGBA
                label: Font On Color
                values: [0.65, 0.65, 0.65, 1]
              - name: Menubuttoniconcolor
                style: RGBA
                label: Button Icon Color
              - name: Menubuttonofffacecolor
                style: RGBA
                label: Button Off Color
                values: [0.3, 0.3, 0.3, 1]
              - name: Menubuttononfacecolor
                style: RGBA
                label: Button On Color
                values: [0.3276, 0.4719, 0.52, 1]
              - name: Menubuttonrollcolor
                style: RGBA
                label: Button Roll Color
                values: [0.7, 0.7, 0.7, 0.35]
              - name: Popmenuwindowscalemode
                style: Menu
                label: Popmenu Window Scale Mode
                startSection: true
                default: native
                menuNames:
                - native
                - usedpiscale
                menuLabels:
                - Native
                - Use DPI Scale
                enable: false
            flags:
            - viewer
            position: [0, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: config
              type: baseCOMP
              position: [200, -300]
              size: [160, 130]
              comment: Contains all user-configurable ops for lister
              children:
              - name: check
                type: textTOP
                parameters:
                  text: ='\u2714'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Segoe UI Symbol
                  fontsizex: 11
                  fontsizexunit: pixels
                  fontcolorr: 0.71
                  fontcolorg: 0.72
                  fontcolorb: 0.72
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('colDefine')['width','Symbol']
                  resolutionh: =op('master').par.resolutionh
                flags:
                - lock
                - viewer
                position: [350, 150]
                size: [130, 48]
              - name: button
                type: textTOP
                parameters:
                  text: DinglXXX|
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('master').par.font
                  fontsizex: =parent.Widget.par.Menufontsize
                  fontsizexunit: =parent.Widget.par.Menufontsizemode.eval()
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menufontoffcolorr
                  fontcolorg: =parent.Widget.par.Menufontoffcolorg
                  fontcolorb: =parent.Widget.par.Menufontoffcolorb
                  fontalpha: =parent.Widget.par.Menufontoffcolora
                  bgcolorr: =parent.Widget.par.Menubgcolorr
                  bgcolorg: =parent.Widget.par.Menubgcolorg
                  bgcolorb: =parent.Widget.par.Menubgcolorb
                  bgalpha: =parent.Widget.par.Menubgcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -200]
                size: [130, 48]
              - name: master
                type: textTOP
                parameters:
                  text: Label 3
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =parent.Widget.par.Font
                  dispmethod: bitmap
                  antialias: 'on'
                  fontsizex: =parent.Widget.par.Menufontsize
                  fontsizexunit: =parent.Widget.par.Menufontsizemode.eval()
                  positionx: =parent.Widget.par.Menuitemhorizontalpadding1
                  alignx: left
                  fontcolorr: 0.71
                  fontcolorg: 0.72
                  fontcolorb: 0.72
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  bgalpha: 1
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionh: =op('textSizer').textHeight + parent.Widget.par.Menuitemverticalpadding * 2
                flags:
                - viewer
                position: [300, -200]
                size: [130, 48]
              - name: checkOn
                type: overTOP
                parameters:
                  legacyxform: true
                flags:
                - viewer
                position: [525, 150]
                size: [130, 49]
                inputs:
                - check
                - checkOff
              - name: subMenu
                type: textTOP
                parameters:
                  text: ='\uE102'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Segoe UI Symbol
                  fontsizex: 11
                  fontsizexunit: pixels
                  fontcolorr: 0.71
                  fontcolorg: 0.72
                  fontcolorb: 0.72
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('colDefine')['width','Check']
                  resolutionh: =op('master').par.resolutionh
                flags:
                - lock
                - viewer
                position: [525, 225]
                size: [130, 48]
              - name: checkOff
                type: rectangleTOP
                parameters:
                  sizex: =min(me.par.resolutionw, me.par.resolutionh) - 3
                  sizey: =me.par.sizex
                  sizeunit: pixels
                  fillalpha: 0
                  borderr: =op('check').par.fontcolorr
                  borderg: =op('check').par.fontcolorg
                  borderb: =op('check').par.fontcolorb
                  borderwidth: 0.5
                  borderwidthunit: pixels
                  resolutionw: =op('check').par.resolutionw
                  resolutionh: =op('check').par.resolutionh
                flags:
                - viewer
                position: [525, 75]
                size: [130, 45]
              - name: callbacks
                type: textDAT
                parameters:
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [875, -425]
                size: [498, 173]
                dat_content: "#Shared Use License: This file is owned by Derivative Inc. (ï¿½Derivativeï¿½)\n#and can only be used, and/or modified for use, in conjunction with\n#Derivativeï¿½s TouchDesigner software, and only if you are a licensee who\n#has accepted Derivativeï¿½s TouchDesigner license or assignment agreement\n#(which also governs the use of this file).  You may share a modified version\n#of this file with another authorized licensee of Derivativeï¿½s TouchDesigner\n#software.  Otherwise, no redistribution or sharing of this file, with or\n#without modification, is permitted.\n\n\"\"\"\nPopMenu callbacks\n\nCallbacks always take a single argument, which is a dictionary\nof values relevant to the callback. Print this dictionary to see what is\nbeing passed. The keys explain what each item is.\n\nonSelect: user selects a menu option\nonMouseOver: mouse passes over a cell\nonMouseDown: left button pressed\nonMouseUp: left button released\nonClick: left button pressed then released on same cell\nonLostFocus: The popmenu focus has been lost\n\nCallbacks generally return a dict with:\n\t'cell': either cell id or -1 for no cell\n\t'label': the label in the menu list\n\t'row': the row from the wired dat input, if applicable\n\t'details': details provided by object that caused menu to open\n\"\"\"\n\n# def onSelect(info):\n#\tprint('SELECTED:', info['cell'], info['label'], info['row'], info['details']"
                dat_content_format: text
              - name: colDefine
                type: tableDAT
                parameters:
                  defaultreadencoding: cp1252
                  rows: 13
                  cols: 2
                flags:
                - viewer
                position: [875, -150]
                size: [360, 335]
                comment: this is required do not delete
                dat_content:
                - - column
                  - Symbol
                - - columnLabel
                  - ''
                - - sourceData
                  - ''
                - - sourceDataMode
                  - constant
                - - cellLook
                  - button
                - - topPath
                  - ''
                - - help
                  - ''
                - - width
                  - '20'
                - - stretch
                  - ''
                - - editable
                  - '0'
                - - draggable
                  - '0'
                - - selectRow
                  - '1'
                - - justify
                  - CENTER
                dat_content_format: table
              - name: textSizer
                type: textTOP
                parameters:
                  text: WX|gj
                  legacyfontselection: true
                  font: =parent.Widget.par.Font
                  fontsizex: =parent.Widget.par.Menufontsize
                flags:
                - viewer
                position: [100, -200]
                size: [130, 90]
                comment: Need this to calculate size to avoid recursion error
              - name: buttonRoll
                type: textTOP
                parameters:
                  text: XXWWWWWWW
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('master').par.font
                  fontsizex: =parent.Widget.par.Menufontsize
                  fontsizexunit: =parent.Widget.par.Menufontsizemode.eval()
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menufontoffcolorr
                  fontcolorg: =parent.Widget.par.Menufontoffcolorg
                  fontcolorb: =parent.Widget.par.Menufontoffcolorb
                  fontalpha: =parent.Widget.par.Menufontoffcolora
                  bgcolorr: =parent.Widget.par.Menurollcolorr
                  bgcolorg: =parent.Widget.par.Menurollcolorg
                  bgcolorb: =parent.Widget.par.Menurollcolorb
                  bgalpha: =parent.Widget.par.Menurollcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -300]
                size: [130, 48]
              - name: buttonPress
                type: textTOP
                parameters:
                  text: Label 3
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('master').par.font
                  fontsizex: =parent.Widget.par.Menufontsize
                  fontsizexunit: =parent.Widget.par.Menufontsizemode.eval()
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menufontoncolorr
                  fontcolorg: =parent.Widget.par.Menufontoncolorg
                  fontcolorb: =parent.Widget.par.Menufontoncolorb
                  fontalpha: =parent.Widget.par.Menufontoncolora
                  bgcolorr: =parent.Widget.par.Menuselectcolorr
                  bgcolorg: =parent.Widget.par.Menuselectcolorg
                  bgcolorb: =parent.Widget.par.Menuselectcolorb
                  bgalpha: =parent.Widget.par.Menuselectcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -400]
                size: [130, 48]
              - name: buttonDisabled
                type: textTOP
                parameters:
                  text: XXWWWWWWW
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('master').par.font
                  fontsizex: =parent.Widget.par.Menufontsize
                  fontsizexunit: =parent.Widget.par.Menufontsizemode.eval()
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: 0.5
                  fontcolorg: 0.5
                  fontcolorb: 0.5
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  bgalpha: 1
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -500]
                size: [130, 48]
              - name: buttonHighlighted
                type: textTOP
                parameters:
                  text: XXWWWWWWW
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('master').par.font
                  fontsizex: =parent.Widget.par.Menufontsize
                  fontsizexunit: =parent.Widget.par.Menufontsizemode.eval()
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: 0.5
                  fontcolorg: 0.5
                  fontcolorb: 0.5
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  bgalpha: 1
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -600]
                size: [130, 48]
            - name: popMenu
              type: containerCOMP
              parameters:
                x: 128
                y: 44
                w: '=parent().width if parent.Widget.par.Menuautowidth else parent.Widget.par.Menupopupwidth.eval() '
                h: =me.OptimalHeight
                layer: 100
                alignallow: ignore
                display: false
                resizecomp: =me
                bgcolorr: 0.2
                bgcolorg: 0.2
                bgcolorb: 0.2
                borderar: 0.2
                borderag: 0.2
                borderab: 0.2
                leftborder: bordera
                rightborder: bordera
                bottomborder: bordera
                topborder: bordera
                justifyh: left
                justifyv: bottom
                parentshortcut: Menu
                clone: =op.TDTox.op('popMenu')
                overlay: true
                borderover: true
                opviewer: ./out1
                relpath: inherit
              sequences:
                ext:
                - object: me.mod.PopMenuExt.PopMenuExt(me)
                  promote: true
                - object: me.mod.CallbacksExt.CallbacksExt(me)
                  promote: true
                - {}
                - {}
                iop:
                - {}
                - {}
              custom_pars:
                Pop Menu:
                  $t: pop_menu
                  Inputtable: RowAll_Col0
                  Items: '[''Label 1'', ''Label 2'', ''Label 3'']'
                  Highlighteditems: '[]'
                  Disableditems: '[]'
                  Dividersafteritems: '[]'
                  Checkeditems: '[]'
                  Shortcuts: '{}'
                  Maxheight: 600
                  Borders: true
                  Horizontalalign: Left
                  Verticalalign: Top
                  Buttoncomp: dropmenuSize
                  Horizontalattach: Left
                  Verticalattach: Bottom
                Advanced:
                  $t: advanced
                  Callbackdat: config/callbacks
                  Configcomp: config
                  Windowcomp: ./window
                  Includedialog: false
                About:
                  $t: about_3
                  Version: 1.3.0
                  Toxsavebuild: '2023.11831'
              flags:
              - viewer
              position: [0, -300]
              size: [160, 130]
              palette_clone: true
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [0, 200]
              size: [160, 130]
            - name: DropMenuExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-500, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass DropMenuExt(SubWidgetExt):\n\t\"\"\"\n\tDropMenuExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Menu'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == 'Menurunonclick':\n\t\t\tparent.Widget.par.Menucommandonclick.enable = val\n\t\telif par.name == 'Menuautowidth':\t\n\t\t\tparent.Widget.par.Menupopupwidth.enable = not par.eval()\n\t\telse:\n\t\t\tSubWidgetExt.onParSettingsChange(self, par, prev)\n\t\t\t\n"
              dat_content_format: text
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-700, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: dropmenuSize
              type: buttonCOMP
              parameters:
                buttontype: momentary
                w: =parent().par.w
                h: =parent().par.h
                hmode: fill
                vmode: fill
                helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
                clickthrough: =parent.Widget.par.clickthrough
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                align: horizlr
                justifyh: right
                justifyv: center
                enablecloning: true
              size: [160, 130]
              children:
              - name: text
                type: textCOMP
                parameters:
                  text: =parent.Widget.GetValueMenuLabel(parent(2).digits) if hasattr(parent.Widget, 'GetValueMenuLabel') else parent.Widget.op('menu/menuOptions')[parent.Widget.par.Value0.menuIndex + 1, 'label'] if parent.Widget.par.Value0.menuIndex is not None and parent.Widget.op('menu/menuOptions').numRows > 1 else ''
                  callbacks: text1_callbacks
                  font: =parent.Widget.par.Font.eval()
                  fontfile: =parent.Widget.par.Fontfile
                  bold: =parent.Widget.par.Menufontbold.eval()
                  italic: =parent.Widget.par.Menuitalic
                  scaletofit: =parent.Widget.par.Menuscaletofit
                  fontsize: =parent.Widget.par.Menubuttonfontsize.eval()
                  fontsizeunits: =parent.Widget.par.Menufontsizemode.eval()
                  fontcolorr: =me.par.Fontcolor.eval()[0]
                  fontcolorg: =me.par.Fontcolor.eval()[1]
                  fontcolorb: =me.par.Fontcolor.eval()[2]
                  fontalpha: =me.par.Fontcolor.eval()[3]
                  dropshadow: =parent.Widget.par.Menudropshadow
                  textoffsetx: =parent.Widget.par.Menuoffsetx.eval()
                  textoffsety: =parent.Widget.par.Menuoffsety.eval()
                  alignx: left
                  hmode: fill
                  clickthrough: true
                  bgcolorr: =me.par.Facecolor.eval()[0]
                  bgcolorg: =me.par.Facecolor.eval()[1]
                  bgcolorb: =me.par.Facecolor.eval()[2]
                  bgalpha: =me.par.Facecolor.eval()[3]
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  borderover: false
                custom_pars:
                  Expressions:
                    $t: expressions_2
                    Value: '='
                    Mapoff: '='
                    Mapon: '='
                    Fontcolor: =parent.Widget.parGroup.Menufontoncolor.eval() if me.par.Value else parent.Widget.parGroup.Menufontoffcolor.eval()
                    Facecolor: =parent.Widget.parGroup.Menubuttononfacecolor.eval() if me.par.Value else parent.Widget.parGroup.Menubuttonofffacecolor.eval()
                children:
                - name: text1
                  type: textCOMP
                  parameters:
                    text: =chr(0xF0140)
                    callbacks: text1_callbacks
                    font: Material Design Icons
                    fontsize: =parent.Widget.par.Menubuttonfontsize*2.5
                    fontcolorr: =parent().par.fontcolorr
                    fontcolorg: =parent().par.fontcolorg
                    fontcolorb: =parent().par.fontcolorb
                    fontalpha: =parent().par.fontalpha
                    textoffsetx: =-parent.Widget.height / 4
                    alignx: right
                    alignxmode: bbox
                    alignymode: bbox
                    hmode: fill
                    clickthrough: true
                    borderover: false
                - name: text1_callbacks
                  type: textDAT
                  parameters:
                    language: input
                  flags:
                  - viewer
                  - -showDocked
                  position: [0, -150]
                  size: [160, 130]
                  dock: text1
                  dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                  dat_content_format: text
              - name: text1_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                - -showDocked
                position: [0, -150]
                size: [160, 130]
                dock: text
                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: execMenuDrop
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: dropmenuSize
                ontooff: true
                defaultreadencoding: cp1252
                language: input
              position: [200, 0]
              size: [130, 90]
              dat_content: "def offToOn(panelValue):\n\tif not parent.Widget.par.Menuautoclose and op('popMenu').IsOpen:\n\t\top('popMenu').Close()\n\t\treturn\n\tvaluePar = getattr(parent.Widget.par, 'Value'+str(parent().digits))\n\tmenuLabels = valuePar.menuLabels\n\tmenuNames = valuePar.menuNames\n\tif menuLabels:\n\t\top('popMenu').Open(callback=menuEvent,\n\t\t\t\t\t\t\titems=menuLabels,\n\t\t\t\t\t\t\tautoClose=parent.Widget.par.Menuautoclose)\n\telse:\n\t\top('popMenu').Open(callback=menuEvent,\n\t\t\t\t\t\t   items=menuNames,\n\t\t\t\t\t\t\tautoClose=parent.Widget.par.Menuautoclose)\n\tif parent.Widget.par.Menurunonclick.eval():\n\t\tcommand = parent.Widget.par.Menucommandonclick.eval()\n\t\tif command:\n\t\t\trun(command, fromOP=parent.Widget)\n\ndef onOnToOff(panelValue):\n\tpass\n\ndef menuEvent(info):\n\tif hasattr(parent.Widget, 'SetValue'):\n\t\tparent.Widget.SetValue(info['index'])\n\telse:\n\t\tparent.Widget.par.Value0.menuIndex = info['index']\n"
              dat_content_format: text
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-500, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: parexecSettingsX
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Menurunonclick Menucustomizeinteraction Menuautowidth
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-500, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
          - name: in_menuOptions
