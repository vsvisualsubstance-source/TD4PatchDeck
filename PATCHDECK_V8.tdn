              end: =parent().par.Bgcount - 1
            position: [-1500, 220]
          - name: bg_pos
            type: mathCHOP
            parameters:
              chopop: add
              postoff: =absTime.seconds * parent().par.Speedbg * 3
              autoexportroot: =parent()
            position: [-1200, 260]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - bg_base
            - bg_wander
          - name: fg_dir
            type: noiseCHOP
            parameters:
              type: random
              seed: =parent().par.Seed + 5
              channelname: tx ty
              end: =parent().par.Count - 1
            position: [-1350, -20]
          - name: fg_org
            type: noiseCHOP
            parameters:
              seed: =parent().par.Seed
              period: =parent().par.Noiseperiod
              tz: =absTime.seconds * parent().par.Noisespeed
              channelname: tx ty
              end: =parent().par.Count - 1
            position: [-1350, -100]
          - name: fg_pos
            type: mergeCHOP
            parameters:
              autoexportroot: =parent()
            position: [-600, 0]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_wrap_tx
            - fg_wrap_ty
          - name: fg_rot
            type: mergeCHOP
            parameters:
              autoexportroot: =parent()
            position: [-900, -190]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_rotz
            - fg_spin3
          - name: fg_sum
            type: mathCHOP
            parameters:
              chopop: add
              autoexportroot: =parent()
            position: [-1050, 0]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_start_pos
            - fg_scroll
            - fg_wander
          - name: geo_bg
            type: geometryCOMP
            parameters:
              instancing: true
              instanceop: inst_bg
              instancetx: tx
              instancety: ty
              instancecolormode: multiply
              instancecolorop: inst_bg
              instancer: r
              instanceg: g
              instanceb: b
              material: mat_bg
            position: [50, 260]
            size: [160, 130]
            color: [0.67, 0.67, 0.67]
            children:
            - name: shape
              type: rectangleSOP
              parameters:
                sizex: =(16.000000 / max(1, parent(2).par.Bgcount) * parent(2).par.Bgsize) if parent(2).par.Bgdir.menuIndex == 0 else 17.000000
                sizey: =10.000000 if parent(2).par.Bgdir.menuIndex == 0 else (9.000000 / max(1, parent(2).par.Bgcount) * parent(2).par.Bgsize)
          - name: mask_0
            type: expressionCHOP
            sequences:
              expr:
              - expr: =(1 if int(me.inputVal) == 0 else 0) * int(parent().par.Shapecircle)
            position: [-900, -420]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_shape
          - name: mask_1
            type: expressionCHOP
            sequences:
              expr:
              - expr: =(1 if int(me.inputVal) == 1 else 0) * int(parent().par.Shaperect)
            position: [-900, -490]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_shape
          - name: mask_2
            type: expressionCHOP
            sequences:
              expr:
              - expr: =(1 if int(me.inputVal) == 2 else 0) * int(parent().par.Shapehex)
            position: [-900, -560]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_shape
          - name: mat_bg
            type: constantMAT
            parameters:
              wireframe: =parent().par.Wireframebg
              wirewidth: =parent().par.Wirewidth
            position: [50, -660]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: mat_fg
            type: constantMAT
            parameters:
              colormap: tex_null
              wireframe: =parent().par.Wireframe
              wirewidth: =parent().par.Wirewidth
            position: [50, -600]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: pal_10
            type: dattoCHOP
            parameters:
              dat: pal_10_tbl
              output: chanpercol
              firstrow: names
            position: [-1350, 1200]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: pal_11
            type: dattoCHOP
            parameters:
              dat: pal_11_tbl
              output: chanpercol
              firstrow: names
            position: [-1350, 1250]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: palc_a
            type: constantCHOP
            parameters:
              autoexportroot: =parent()
            sequences:
              const:
              - name: r
                value: =parent().par.Palcolar
              - name: g
                value: =parent().par.Palcolag
              - name: b
                value: =parent().par.Palcolab
            position: [-1500, 1350]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: palc_b
            type: constantCHOP
            parameters:
              autoexportroot: =parent()
            sequences:
              const:
              - name: r
                value: =parent().par.Palcolbr
              - name: g
                value: =parent().par.Palcolbg
              - name: b
                value: =parent().par.Palcolbb
            position: [-1500, 1395]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: palc_c
            type: constantCHOP
            parameters:
              autoexportroot: =parent()
            sequences:
              const:
              - name: r
                value: =parent().par.Palcolcr
              - name: g
                value: =parent().par.Palcolcg
              - name: b
                value: =parent().par.Palcolcb
            position: [-1500, 1440]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: palc_d
            type: constantCHOP
            parameters:
              autoexportroot: =parent()
            sequences:
              const:
              - name: r
                value: =parent().par.Palcoldr
              - name: g
                value: =parent().par.Palcoldg
              - name: b
                value: =parent().par.Palcoldb
            position: [-1500, 1485]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: palc_e
            type: constantCHOP
            parameters:
              autoexportroot: =parent()
            sequences:
              const:
              - name: r
                value: =parent().par.Palcoler
              - name: g
                value: =parent().par.Palcoleg
              - name: b
                value: =parent().par.Palcoleb
            position: [-1500, 1530]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: palc_f
            type: constantCHOP
            parameters:
              autoexportroot: =parent()
            sequences:
              const:
              - name: r
                value: =parent().par.Palcolfr
              - name: g
                value: =parent().par.Palcolfg
              - name: b
                value: =parent().par.Palcolfb
            position: [-1500, 1575]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: palc_g
            type: constantCHOP
            parameters:
              autoexportroot: =parent()
            sequences:
              const:
              - name: r
                value: =parent().par.Palcolgr
              - name: g
                value: =parent().par.Palcolgg
              - name: b
                value: =parent().par.Palcolgb
            position: [-1500, 1620]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: au_fast
            type: lagCHOP
            parameters:
              lag1: =0
              lag2: =parent().par.Audiofast
            position: [-250, -1000]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_norm
          - name: au_file
            type: audiofileinCHOP
            parameters:
              file: =parent().par.Audiofile
            position: [-1900, -900]
            color: [0.67, 0.67, 0.67]
          - name: au_gain
            type: mathCHOP
            parameters:
              gain: =parent().par.Audiogain
              autoexportroot: =parent()
            position: [-1600, -940]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_src
          - name: au_norm
            type: mathCHOP
            parameters:
              chopop: div
              autoexportroot: =parent()
            position: [-400, -940]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_raw
            - au_env_null
          - name: au_slow
            type: lagCHOP
            parameters:
              lag1: =parent().par.Audioslow * 0.5
              lag2: =parent().par.Audioslow
            position: [-250, -880]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_norm
          - name: bg_base
            type: expressionCHOP
            sequences:
              expr:
              - expr: =(me.sampleIndex / max(1, parent().par.Bgcount) - 0.5) * (16.000000 if parent().par.Bgdir.menuIndex == 0 else 9.000000)
            position: [-1350, 300]
            color: [0.67, 0.67, 0.67]
            inputs:
            - bg_n
          - name: bg_wrap
            type: limitCHOP
            parameters:
              type: loop
              min: =-(16.000000 if parent().par.Bgdir.menuIndex == 0 else 9.000000) * 0.75
              max: =(16.000000 if parent().par.Bgdir.menuIndex == 0 else 9.000000) * 0.75
              autoexportroot: =parent()
            position: [-1050, 260]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - bg_pos
          - name: ed_edge
            type: edgeTOP
            parameters:
              strength: =parent().par.Edgestrength
            position: [850, 120]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - comp
          - name: fg_rot3
            type: mathCHOP
            parameters:
              gain: =parent().par.Tiltrand * 90
              autoexportroot: =parent()
            position: [-1200, -220]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_rand_rot3
          - name: fg_rotz
            type: mathCHOP
            parameters:
              gain: =parent().par.Rotrand * 180 + absTime.seconds * parent().par.Spin * 60 + op('au_fast')['mid'] * parent().par.Audiospin * 180
              autoexportroot: =parent()
            position: [-1200, -160]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_rand_rot
          - name: fg_size
            type: mergeCHOP
            parameters:
              autoexportroot: =parent()
            position: [-600, -300]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_size_y
            - fg_size_x_as_sx
          - name: geo_hex
            type: geometryCOMP
            parameters:
              instancing: true
              instanceop: inst_fg
              instanceactive: active2
              instancetx: tx
              instancety: ty
              instancerx: rx
              instancery: ry
              instancerz: rz
              instancesx: sx
              instancesy: sy
              instancecolormode: multiply
              instancecolorop: inst_fg
              instancer: r
              instanceg: g
              instanceb: b
              material: mat_fg
            position: [50, -500]
            size: [160, 130]
            color: [0.67, 0.67, 0.67]
            comp_inputs:
            - geo_rect
            children:
            - name: shape
              type: circleSOP
              parameters:
                radx: 0.5
                rady: 0.5
                divs: 6
              flags:
              - display
              - render
              size: [130, 90]
              color: [0.67, 0.67, 0.67]
          - name: inst_bg
            type: nullCHOP
            parameters:
              autoexportroot: =parent()
            position: [-250, 260]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - bg_merge
          - name: inst_fg
            type: nullCHOP
            parameters:
              autoexportroot: =parent()
            position: [-250, -300]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_merge
          - name: ps_down
            type: resolutionTOP
            parameters:
              outputresolution: custom
              resolutionw: =max(8, int(parent().par.Resw.eval() / max(1, parent().par.Sortscale.eval())))
              resolutionh: =max(8, int(parent().par.Resh.eval() / max(1, parent().par.Sortscale.eval())))
            position: [1800, 0]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - px_switch
          - name: ps_glsl
            type: glslTOP
            parameters:
              pixeldat: ps_glsl_text
              computedat: ps_glsl_compute
              outputresolution: custom
              resolutionw: =max(8, int(parent().par.Resw.eval() / max(1, parent().par.Sortscale.eval())))
              resolutionh: =max(8, int(parent().par.Resh.eval() / max(1, parent().par.Sortscale.eval())))
            sequences:
              vec:
              - name: uP
                valuex: =absTime.frame % 2
                valuey: =parent().par.Sortthresh
                valuez: =parent().par.Sortrefresh
            position: [1950, 0]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - ps_down
            - ps_fb
          - name: ps_null
            type: nullTOP
            position: [2100, 0]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - ps_glsl
          - name: px_down
            type: resolutionTOP
            parameters:
              outputresolution: custom
              resolutionw: =max(8, int(parent().par.Resw.eval() / max(1, parent().par.Pixelsize.eval())))
              resolutionh: =max(8, int(parent().par.Resh.eval() / max(1, parent().par.Pixelsize.eval())))
            position: [1200, 0]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - sl2_switch
          - name: px_glsl
            type: glslTOP
            parameters:
              pixeldat: px_glsl_text
              computedat: px_glsl_compute
            sequences:
              vec:
              - name: uP
                valuex: =parent().par.Levels
                valuey: =parent().par.Dither
            position: [1350, 0]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - px_down
          - name: select1
            type: selectCHOP
            parameters:
              autoexportroot: =parent()
            flags:
            - bypass
            - viewer
            position: [-300, -1225]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - in1
          - name: sl_glsl
            type: glslTOP
            parameters:
              pixeldat: sl_glsl_text
              computedat: sl_glsl_compute
              outputresolution: custom
              resolutionw: =parent().par.Resw
              resolutionh: =parent().par.Resh
            sequences:
              vec:
              - name: uP
                valuex: =parent().par.Slicebands
                valuey: =parent().par.Sliceamount * (1 + op('au_fast')['high'] * parent().par.Audioslice)
                valuez: =absTime.seconds * parent().par.Slicespeed
                valuew: =parent().par.Slicechaos
              - name: uQ
                valuex: =parent().par.Slicedir.menuIndex
                valuey: 1
                valuez: 1
                valuew: 1
            position: [400, -300]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - render_fg
          - name: txt_top
            type: textTOP
            parameters:
              text: ='\n'.join(''.join((str(parent().par.Textchars)[(r*7 + c*13 + int(parent().par.Seed)) % max(1, len(str(parent().par.Textchars)))] if ((r*31 + c*17 + int(parent().par.Seed)*7) % 100) / 100.0 < parent().par.Textdensity else ' ') for c in range(int(parent().par.Textcols))) for r in range(int(parent().par.Textrows))) if parent().par.Textmode.menuIndex == 0 else str(parent().par.Textstring)
              font: =parent().par.Textfont.eval()
              fontsizex: =512 / max(1, max(int(parent().par.Textcols), int(parent().par.Textrows))) * parent().par.Textsize
              fontcolorr: =parent().par.Textcolorr
              fontcolorg: =parent().par.Textcolorg
              fontcolorb: =parent().par.Textcolorb
              bgcolorr: =parent().par.Textbgr
              bgcolorg: =parent().par.Textbgg
              bgcolorb: =parent().par.Textbgb
              bgalpha: 1
              outputresolution: custom
              resolutionw: =512
              resolutionh: =512
            position: [250, -980]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: au_decay
            type: mathCHOP
            parameters:
              gain: =parent().par.Audiodecay
              autoexportroot: =parent()
            position: [-850, -840]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_fb
          - name: au_f_low
            type: audiofilterCHOP
            parameters:
              cutofflog: 4.5
              cutofffrequency: 10000
            position: [-1450, -940]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_gain
          - name: au_f_mid
            type: audiofilterCHOP
            parameters:
              filter: bandpass
              cutofflog: 4.5
              cutofffrequency: 10000
            position: [-1450, -860]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_gain
          - name: au_n_low
            type: renameCHOP
            parameters:
              renameto: low
            position: [-1150, -940]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_rms_low
          - name: au_n_mid
            type: renameCHOP
            parameters:
              renameto: mid
            position: [-1150, -860]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_rms_mid
          - name: bg_color
            type: lookupCHOP
            position: [-900, 140]
            inputs:
            - bg_col_nrm
            - palette_chop
          - name: bg_level
            type: levelTOP
            parameters:
              opacity: =parent().par.Bgopacity
            position: [400, 260]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - render_bg
          - name: bg_merge
            type: mergeCHOP
            parameters:
              autoexportroot: =parent()
            position: [-400, 260]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - bg_xy
            - bg_color
          - name: fg_color
            type: lookupCHOP
            position: [-900, -700]
            inputs:
            - fg_col_nrm
            - palette_chop
          - name: fg_masks
            type: mergeCHOP
            parameters:
              autoexportroot: =parent()
            position: [-600, -490]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - mask_0_as_active0
            - mask_1_as_active1
            - mask_2_as_active2
          - name: fg_merge
            type: mergeCHOP
            parameters:
              autoexportroot: =parent()
            position: [-400, -300]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_pos
            - fg_rot
            - fg_size
            - fg_masks
            - fg_color
          - name: fg_shape
            type: mathCHOP
            parameters:
              fromrange2: 2
              torange2: 2
              autoexportroot: =parent()
            position: [-1050, -420]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_shape_pick
          - name: fg_spin3
            type: expressionCHOP
            sequences:
              expr:
              - expr: =me.inputVal + absTime.seconds * 60 * (parent().par.Spinx if me.chanIndex == 0 else parent().par.Spiny)
            position: [-1050, -220]
            color: [0.67, 0.67, 0.67]
            inputs:
            - fg_rot3
          - name: fg_start
            type: noiseCHOP
            parameters:
              type: random
              seed: =parent().par.Seed + 4
              channelname: tx ty
              end: =parent().par.Count - 1
            position: [-1350, 60]
          - name: geo_rect
            type: geometryCOMP
            parameters:
              sx: =1+parent(2).op('select1')['low']*.2
              sy: =1+parent(2).op('select1')['low']*.2
              sz: =1+parent(2).op('select1')['low']*.2
              instancing: true
              instanceop: inst_fg
              instanceactive: active1
              instancetx: tx
              instancety: ty
              instancerx: rx
              instancery: ry
              instancerz: rz
              instancesx: sx
              instancesy: sy
              instancecolormode: multiply
              instancecolorop: inst_fg
              instancer: r
              instanceg: g
              instanceb: b
              material: mat_fg
            flags:
            - viewer
            position: [50, -370]
            size: [160, 130]
            color: [0.67, 0.67, 0.67]
            children:
            - name: shape
              type: rectangleSOP
          - name: sl2_glsl
            type: glslTOP
            parameters:
              pixeldat: sl_glsl_text
              computedat: sl2_glsl_compute
              outputresolution: custom
              resolutionw: =parent().par.Resw
              resolutionh: =parent().par.Resh
            sequences:
              vec:
              - name: uP
                valuex: =parent().par.Slicetwobands
                valuey: =parent().par.Slicetwoamount
                valuez: =absTime.seconds * parent().par.Slicetwospeed
                valuew: =parent().par.Slicetwochaos
              - name: uQ
                valuex: =parent().par.Slicetwodir.menuIndex
                valuey: 1
                valuez: 1
                valuew: 1
            position: [1000, -120]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - ed_switch
          - name: tex_cell
            type: rectangleTOP
            parameters:
              sizex: 1
              sizey: 1
              borderwidth: =parent().par.Texwidth * 100
              outputresolution: custom
              resolutionw: =512
              resolutionh: =512
            position: [250, -840]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: tex_grid
            type: tileTOP
            position: [400, -840]
            inputs:
            - tex_cell
          - name: tex_null
            type: nullTOP
            position: [700, -820]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - tex_switch
          - name: tex_ramp
            type: rampTOP
            parameters:
              dat: tex_ramp_keys
              type: =parent().par.Texramp.eval()
              outputresolution: custom
              resolutionw: =512
              resolutionh: =512
            position: [250, -770]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
          - name: au_f_high
            type: audiofilterCHOP
            parameters:
              filter: highpass
              cutofflog: 4.5
              cutofffrequency: 10000
            position: [-1450, -780]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_gain
          - name: au_n_high
            type: renameCHOP
            parameters:
              renameto: high
            position: [-1150, -780]
            color: [0.67, 0.67, 0.67]
            inputs:
            - au_rms_high
          - name: bg_wander
            type: mathCHOP
            parameters:
              gain: =parent().par.Bgwander
              autoexportroot: =parent()
            position: [-1350, 220]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - bg_org
          - name: ed_switch
            type: switchTOP
            parameters:
              index: =parent().par.Edgeenable
            position: [850, 0]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - comp
            - ed_edge
