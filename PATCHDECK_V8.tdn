              label: Menu Options
            flags:
            - viewer
            position: [600, 200]
            size: [130, 90]
            inputs:
            - source: menu
              out: 2
            dat_read_only: true
          - name: out_menu1Selected
            type: outDAT
            parameters:
              label: Selected
            flags:
            - viewer
            position: [600, 300]
            size: [130, 90]
            inputs:
            - source: menu
              out: 1
            dat_read_only: true
