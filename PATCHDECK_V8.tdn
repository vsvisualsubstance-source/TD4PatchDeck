            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('knobFixed') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
              $t: values_7
