              - Fixed Height
              - Fill
            - name: Labelheight
              style: Int
              label: Height
              default: 34
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
              enable: false
            - name: Labelvfillweight
              style: Float
              label: Vertical Fill Weight
              default: 1
              clampMin: true
            OP:
              $t: op_2
            Widget:
            - name: Enablerollover
              style: Toggle
              label: Enable Rollover
              startSection: true
              default: true
            - name: Rollovercolor
              style: RGBA
              label: Rollover Color
              default: [0.9, 0.9, 0.9, 0.15]
              enableExpr: me.par.Enablerollover.eval()
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
              menuNames:
              - over
              - under
              - inside
              - outside
              - add
              - subtract
              - multiply
              menuLabels:
              - Over
              - Under
              - Inside
              - Outside
              - Add
              - Subtract
              - Multiply
              enableExpr: me.par.Enablerollover.eval()
            - name: Disablecolor
              style: RGBA
              label: Disable Color
              default: [0.2, 0.2, 0.2, 0.65]
            - name: Font
              style: Menu
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              enableExpr: not me.par.Fontfile
            - name: Fontfile
