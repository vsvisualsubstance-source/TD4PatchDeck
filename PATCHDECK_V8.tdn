      - viewer
      position: [675, -450]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      inputs:
      - dmx_audio_chase
    - name: null4
      type: nullTOP
      flags:
      - viewer
      position: [700, -650]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
