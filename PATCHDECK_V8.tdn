              label: Tab Label Margin
              default: 28
              max: 10.0
              clampMin: true
              normMax: 10.0
            - name: Foldertabopenmargin
              style: Int
              label: Tab Open Margin
              default: 2
              max: 8.0
              clampMin: true
              normMax: 8.0
            - name: Foldertabfont
              style: Menu
              label: Folder Tab Font
              startSection: true
              default: Open Sans
              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
