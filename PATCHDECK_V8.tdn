              clampMin: true
              clampMax: true
            - name: Foldertabofffontcolor
              style: RGBA
              label: Tab Off Font Color
              default: [0.664, 0.664, 0.664, 1]
              clampMin: true
              clampMax: true
            - name: Foldertabonfontcolor
              style: RGBA
              label: Tab On Font Color
              default: [0.7, 0.7, 0.7, 1]
              clampMin: true
              clampMax: true
            - name: Foldertabrollcolor
