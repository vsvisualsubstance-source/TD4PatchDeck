                alignorder: 1
                clickthrough: =parent.Widget.par.clickthrough
                resizecomp: =me
                borderover: false
              flags:
              - viewer
              position: [700, 0]
              size: [160, 130]
            - name: config
              type: baseCOMP
              position: [200, -200]
              size: [160, 130]
              comment: Contains all user-configurable ops for lister
              children:
              - name: check
                type: textTOP
