          - name: stringMenu0
            type: containerCOMP
            parameters:
              w: =parent.Widget.par.Stringfieldwidth
              h: =parent.Widget.par.Stringfieldheight
              hmode: =parent.Widget.par.Stringfieldhorizontalmode
              hfillweight: =parent.Widget.par.Stringfieldhfillweight
              vmode: =parent.Widget.par.Stringfieldverticalmode
              vfillweight: =parent.Widget.par.Stringfieldvfillweight
              alignorder: 1
              helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
              clickthrough: =parent.Widget.par.clickthrough
              resizecomp: =me
              borderover: false
              align: horizlr
              spacing: 1
              justifyv: center
              parentshortcut: Value
              enablecloning: false
            sequences:
              ext:
              - object: op('./DropMenuExt').module.DropMenuExt(me)
            custom_pars:
              Menu:
              - name: Menuautowidth
                style: Toggle
                label: Auto Width
                startSection: true
                default: true
              - name: Menupopupwidth
                style: Int
                label: Popup Width
                default: 120
                min: 1.0
                max: 100.0
                clampMin: true
                normMin: 1.0
                normMax: 300.0
                enable: false
              - name: Menuitemverticalpadding
                style: Int
                label: Item Vertical Padding
                default: 8
                max: 100.0
                clampMin: true
                normMax: 30.0
              - name: Menuitemhorizontalpadding1
                style: Int
                label: Item Horizontal Padding
                default: 4
                clampMin: true
                normMax: 20.0
              - name: Menuautoclose
                style: Toggle
                label: Auto Close
                default: true
              - name: Menurunonclick
                style: Toggle
                label: Run On Click
                startSection: true
                default: true
                value: false
              - name: Menucommandonclick
                style: Str
                label: Command On Click
                value: debug(me, 'click')
              - name: Menucustomizeinteraction
                style: Pulse
                label: Customize Interaction
                startSection: true
              - name: Menupanelexec
                style: DAT
                label: Panel Exec
                readOnly: true
              Menu Look:
              - name: Menufontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
                value: relfract
              - name: Menufontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                enableExpr: me.par.Menufontsizemode.eval() in ['points', 'panelunits']
                enable: false
                value: 20
              - name: Menufontfraction
                style: Float
                label: Font Fraction
                default: 1
                enableExpr: me.par.Menufontsizemode.eval() in ['fract', 'relfract']
              - name: Menuscaletofit
                style: Menu
                label: Scale Text to Fit
                default: never
                menuNames:
                - never
                - always
                - onlyshrink
                menuLabels:
                - Never
                - Always
                - Only when Too Large
              - name: Menufontbold
                style: Toggle
                label: Font Bold
              - name: Menuitalic
                style: Toggle
                label: Italic
              - name: Menudropshadow
                style: Toggle
                label: Drop Shadow
              - name: Menuoffset
                style: XYZW
                label: Offset
                size: 2
                startSection: true
                min: -5.0
                max: 5.0
                normMin: -5.0
                normMax: 5.0
              - name: Menubgcolor
                style: RGBA
                label: Background Color
                startSection: true
              - name: Menurollcolor
                style: RGBA
                label: Roll Color
                default: [0.4, 0.4, 0.4, 1]
                values: [0.281, 0.281, 0.281, 1]
              - name: Menuselectcolor
                style: RGBA
                label: Select Color
              - name: Menufontoffcolor
                style: RGBA
                label: Font Off Color
                values: [0.18182, 0.18182, 0.18182, 1]
              - name: Menufontoncolor
                style: RGBA
                label: Font On Color
                values: [0.382, 0.382, 0.382, 1]
              - name: Menubuttonofffacecolor
                style: RGBA
                label: Button Off Color
                values: [0.382, 0.382, 0.382, 1]
              - name: Menubuttononfacecolor
                style: RGBA
                label: Button On Color
                values: [0.382, 0.382, 0.382, 1]
              - name: Menubuttonrollcolor
                style: RGBA
                label: Button Roll Color
                values: [0.18182, 0.18182, 0.18182, 1]
            flags:
            - viewer
            position: [0, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: sizer
              type: containerCOMP
              parameters:
                w: =parent.Widget.par.Buttonwidth
                hmode: =parent.Widget.par.Buttonhorizontalmode
                hfillweight: =parent.Widget.par.Buttonhfillweight
                vmode: =parent.Widget.par.Buttonverticalmode
                vfillweight: =parent.Widget.par.Buttonvfillweight
                alignorder: 1
                clickthrough: =parent.Widget.par.clickthrough
                resizecomp: =me
                borderover: false
              flags:
              - viewer
              position: [700, 0]
              size: [160, 130]
            - name: config
              type: baseCOMP
              position: [200, -200]
              size: [160, 130]
              comment: Contains all user-configurable ops for lister
              children:
              - name: check
                type: textTOP
                parameters:
                  text: ='\u2714'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Segoe UI Symbol
                  fontsizex: 11
                  fontsizexunit: pixels
                  fontcolorr: 0.71
                  fontcolorg: 0.72
                  fontcolorb: 0.72
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('colDefine')['width','Symbol']
                  resolutionh: =op('master').par.resolutionh
                flags:
                - lock
                - viewer
                position: [350, 150]
                size: [130, 48]
              - name: button
                type: textTOP
                parameters:
                  text: DinglXXX|
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =parent.Widget.par.Font
                  fontsizex: =op('master').par.fontsizex
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menufontoffcolorr
                  fontcolorg: =parent.Widget.par.Menufontoffcolorg
                  fontcolorb: =parent.Widget.par.Menufontoffcolorb
                  fontalpha: =parent.Widget.par.Menufontoffcolora
                  bgcolorr: =parent.Widget.par.Menubgcolorr
                  bgcolorg: =parent.Widget.par.Menubgcolorg
                  bgcolorb: =parent.Widget.par.Menubgcolorb
                  bgalpha: =parent.Widget.par.Menubgcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -200]
                size: [130, 48]
              - name: master
