        sequences:
          ext:
          - promote: true
        custom_pars:
          Values:
          - name: Value0
            style: Float
            label: Value 0
            min: 0.001
            max: 0.3
            clampMin: true
            clampMax: true
            value: ~parent.Project.op('DMX/dmx_audio_chase').par.Minrange
          - name: Valname0
            style: Str
            label: Name 0
            startSection: true
            default: Value
          - name: Onvaluechangescript0
            style: Str
            label: On Value Change Script 0
          - name: Ontooffscript0
            style: Str
            label: On To Off Script 0
          - name: Offtoonscript0
            style: Str
            label: Off To On Script 0
          - name: Createeditvalueparexec
            style: Pulse
            label: Create/Edit Value Par Exec
            startSection: true
          - name: Valueparexec
