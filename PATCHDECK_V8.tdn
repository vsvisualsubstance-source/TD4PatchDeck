              menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              enableExpr: not me.par.Fontfile
            - name: Fontfile
              style: File
              label: Font File
            - name: Popuphelp
              style: Str
              label: Popup Help
            - name: Rightclickmenu
              style: Toggle
              label: Right Click Menu
              default: true
            - name: Update
              style: Pulse
              startSection: true
            - name: Widgettox
              style: Str
              label: Widget Tox
              default: masterFolderTabsLegacy
              enable: false
            OPs:
              $t: ops_4
            About:
              $t: about_5
              Toxsavebuild: '2023.12230'
          flags:
          - viewer
          position: [0, -1000]
          size: [160, 130]
          children:
          - name: code
            type: baseCOMP
            parameters:
              enablecloning: false
            sequences:
              ext:
              - promote: true
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: help
              type: evaluateDAT
              parameters:
                expr: parent(2).par.Popuphelp.eval()
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [0, -200]
              comment: Popup help string as set in Popuphelp parameter
              dat_read_only: true
            - name: docsHelper
              type: containerCOMP
              parameters:
                w: 32
                h: 32
                layer: 1
                display: false
                resizecomp: =me
                borderover: false
                parentshortcut: DocsHelper
                clone: =op.TDResources.op('docsHelper')
                reloadbuiltin: true
                relpath: inherit
              sequences:
                ext:
                - object: op('./DocsHelper').module.DocsHelper(me)
                  promote: true
              custom_pars:
                Docs Helper:
                  $t: docs_helper
                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_13
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
            parameters:
              layer: 100000
              hmode: fill
              vmode: fill
              alignallow: ignoremargin
              display: =1-parent().par.enable
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Disablecolorr
              bgcolorg: =parent.Widget.par.Disablecolorg
              bgcolorb: =parent.Widget.par.Disablecolorb
              bgalpha: =parent.Widget.par.Disablecolora
              topsmoothness: mipmap
              borderover: false
            flags:
            - viewer
            position: [0, 200]
            size: [93, 155]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
          - name: valueOut
            type: outCHOP
            parameters:
              label: =me.name
              autoexportroot: =parent()
            position: [400, 0]
            inputs:
            - output
          - name: folderTabs
            type: containerCOMP
            parameters:
              h: 30
              hmode: fill
              vmode: fill
              alignorder: =-me.nodeY
              helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
              resizecomp: =me
              topsmoothness: mipmap
              borderar: =parent.Widget.par.Foldertabonbordercolorr
              borderag: =parent.Widget.par.Foldertabonbordercolorg
              borderab: =parent.Widget.par.Foldertabonbordercolorb
              borderaalpha: =parent.Widget.par.Foldertabonbordercolora
              bottomborder: bordera
              bottomborderi: bordera
              align: =parent.Widget.par.Foldertabalignment.eval()
              spacing: =parent.Widget.par.Foldertabmargin
              justifyh: left
              justifyv: bottom
              enablecloning: false
            sequences:
              ext:
              - object: op('./FolderExt').module.FolderExt(me)
              - {}
              - {}
              - {}
              iop:
              - {}
              - {}
            custom_pars:
              Folder:
              - name: Foldertabnames
                style: Str
                label: Folder Tab Names
              - name: Foldertabfont
                style: Menu
                label: Folder Tab Font
                startSection: true
                default: Open Sans
                menuSource: op.TDResources.op('TDUI/fontMenuSource').par.font
              - name: Foldertabfontfile
                style: File
                label: Font File
              - name: Foldertabfontsizemode
                style: Menu
                label: Font Size Mode
                startSection: true
                default: points
                menuNames:
                - panelunits
                - fract
                - relfract
                - points
                menuLabels:
                - Panel Units
                - Fraction
                - Fraction Aspect
                - Points
                value: relfract
              - name: Foldertabfontsize
                style: Int
                label: Font Size
                default: 8
                min: 1.0
                max: 20.0
                clampMin: true
                normMin: 6.0
                normMax: 20.0
                enableExpr: me.par.Foldertabfontsizemode.eval() in ['points', 'panelunits']
                enable: false
                value: 20
              - name: Foldertabfontfraction
                style: Float
                label: Font Fraction
                default: 1
                enableExpr: me.par.Foldertabfontsizemode.eval() in ['fract', 'relfract']
              - name: Foldertabscaletofit
                style: Menu
                label: Scale Text to Fit
                default: never
                menuNames:
                - never
                - always
                - onlyshrink
                menuLabels:
                - Never
                - Always
                - Only when Too Large
              - name: Foldertabfontbold
                style: Toggle
                label: Font Bold
              - name: Foldertabitalic
                style: Toggle
                label: Italic
              - name: Foldertabdropshadow
                style: Toggle
                label: Drop Shadow
              - name: Foldertabalignment
                style: Menu
                label: Folder Tab Alignment
                startSection: true
                default: horizlr
                menuNames:
                - horizlr
                - horizrl
                - verttb
                - vertbt
                menuLabels:
                - Left to Right
                - Right to Left
                - Top to Bottom
                - Bottom to Top
              - name: Foldertabmargin
                style: Int
                label: Tab Margin
                default: 1
                max: 4.0
                clampMin: true
                normMax: 4.0
              - name: Foldertablabelmargin
                style: Int
                label: Tab Label Margin
                default: 4
                max: 10.0
                clampMin: true
                normMax: 10.0
                value: 30
              - name: Foldertabopenmargin
                style: Int
                label: Tab Open Margin
                default: 1
                max: 8.0
                clampMin: true
                normMax: 8.0
                value: 2
              - name: Foldertabrightindent
                style: Int
                label: Tab Right Indent
                default: 90
              - name: Foldertabalignx
                style: Menu
                label: Align Horizontal
                startSection: true
                default: Center
                menuNames:
                - left
                - center
                - right
                menuLabels:
                - Left
                - Center
                - Right
                value: center
              - name: Foldertabalignxmode
                style: Menu
                label: Align Horizontal Mode
                default: metrics
                menuNames:
                - metrics
                - bbox
                menuLabels:
                - Use Font Metrics
                - Use Text Bounding Box
                value: bbox
              - name: Foldertabaligny
                style: Menu
                label: Align Vertical
                default: Center
                menuNames:
                - bottom
                - center
                - top
                menuLabels:
                - Bottom
                - Center
                - Top
                value: center
              - name: Foldertabalignymode
                style: Menu
                label: Align Vertical Mode
                default: metrics
                menuNames:
                - metrics
                - bbox
                menuLabels:
                - Use Font Metrics
                - Use Text Bounding Box
                value: bbox
              - name: Foldertaboffset
                style: XYZW
                label: Offset
                size: 2
                startSection: true
                min: -5.0
                max: 5.0
                normMin: -5.0
                normMax: 5.0
              - name: Foldertabpadding
                style: Float
                label: Padding
                size: 4
              - name: Foldertabofffacecolor
                style: RGBA
                label: Tab Off Face Color
                startSection: true
                default: [0.1, 0.1, 0.1, 1]
                clampMin: true
                clampMax: true
              - name: Foldertabonfacecolor
                style: RGBA
                label: Tab On Face Color
                default: [0.2, 0.2, 0.2, 1]
                clampMin: true
                clampMax: true
                values: [0.25, 0.25, 0.25, 1]
              - name: Foldertabofffontcolor
                style: RGBA
                label: Tab Off Font Color
                default: [0.5, 0.5, 0.5, 1]
                clampMin: true
                clampMax: true
                values: [0.664, 0.664, 0.664, 1]
              - name: Foldertabonfontcolor
                style: RGBA
                label: Tab On Font Color
                default: [0.5, 0.5, 0.5, 1]
                clampMin: true
                clampMax: true
                values: [0.7, 0.7, 0.7, 1]
              - name: Foldertabrollcolor
                style: RGBA
                label: Tab Roll Color
                default: [0.45, 0.45, 0.45, 1]
                clampMin: true
                clampMax: true
                values: [0.7, 0.7, 0.7, 0.35]
              - name: Foldertaboffbordercolor
                style: RGBA
                label: Tab Off Border Color
              - name: Foldertabonbordercolor
                style: RGBA
                label: Tab On Border Color
              - name: Foldertaboffborderleft
                style: Toggle
                label: Tab Off Border Left
                startSection: true
                value: true
              - name: Foldertaboffborderright
                style: Toggle
                label: Tab Off Border Right
                value: true
              - name: Foldertaboffbordertop
                style: Toggle
                label: Tab Off Border Top
                value: true
              - name: Foldertabonborderleft
                style: Toggle
                label: 'Tab On Border Left '
                value: true
              - name: Foldertabonborderright
                style: Toggle
                label: Tab On Border Right
                value: true
              - name: Foldertabonbordertop
                style: Toggle
                label: Tab On Border Top
                value: true
              - name: Foldercustomizeinteraction
                style: Pulse
                label: Customize Interaction
                startSection: true
              - name: Folderpanelexec
                style: DAT
                label: Panel Exec
                readOnly: true
            flags:
            - viewer
            position: [0, -300]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: tab0
              type: buttonCOMP
              parameters:
                y: =1-(me.digits == parent.Widget.par.Value0.eval())
                w: =(op('./textInfo').textWidth + parent.Widget.par.Foldertablabelmargin) if parent.Widget.extensionsReady else 0
                h: 50
                hmode: fill
                vmode: fill
                topoffset: =- (0 if tdu.split(parent.Widget.par.Foldericonhexcodes.eval())[me.digits] == parent.Widget.par.Value0 else parent.Widget.par.Foldertabopenmargin) if parent.Widget.extensionsReady else 0
                postoffsety: =1-(me.digits == parent.Widget.par.Value0.eval())
                helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
                topsmoothness: mipmap
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                enablecloning: true
                clone: tab0
              position: [0, 100]
              size: [160, 130]
              children:
              - name: text
                type: textCOMP
                parameters:
                  text: ='' if len(tdu.split(parent.Widget.par.Foldertabnames.eval())) == 0 else tdu.split(parent.Widget.par.Foldertabnames.eval())[parent().digits]
                  callbacks: text1_callbacks
                  font: =parent.Widget.par.Foldertabfont.eval()
                  fontfile: =parent.Widget.par.Foldertabfontfile
                  bold: =parent.Widget.par.Foldertabfontbold.eval()
                  italic: =parent.Widget.par.Foldertabitalic
                  fontsize: =parent.Widget.par.Foldertabfontsize.eval()
                  fontcolorr: =me.par.Fontcolor.eval()[0]
                  fontcolorg: =me.par.Fontcolor.eval()[1]
                  fontcolorb: =me.par.Fontcolor.eval()[2]
                  fontalpha: =me.par.Fontcolor.eval()[3]
                  dropshadow: =parent.Widget.par.Foldertabdropshadow
                  textoffsetx: =parent.Widget.par.Foldertaboffsetx.eval()
                  textoffsety: =parent.Widget.par.Foldertaboffsety.eval()
                  textpaddingl: =parent.Widget.par.Foldertabpadding1.eval()
                  textpaddingr: =parent.Widget.par.Foldertabpadding2.eval()
                  textpaddingb: =parent.Widget.par.Foldertabpadding3.eval()
                  textpaddingt: =parent.Widget.par.Foldertabpadding4.eval()
                  alignx: =parent.Widget.par.Foldertabalignx.eval()
                  alignxmode: =parent.Widget.par.Foldertabalignxmode.eval()
                  aligny: =parent.Widget.par.Foldertabaligny.eval()
                  alignymode: =parent.Widget.par.Foldertabalignymode.eval()
                  hmode: anchors
                  clickthrough: true
                  bgcolorr: =me.par.Facecolor.eval()[0]
                  bgcolorg: =me.par.Facecolor.eval()[1]
                  bgcolorb: =me.par.Facecolor.eval()[2]
                  bgalpha: =me.par.Facecolor.eval()[3]
                  top: '=me.par.Mapon.eval() if me.par.Value else me.par.Mapoff.eval() '
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  borderover: false
                custom_pars:
                  Expressions:
                    $t: expressions_2
                    Value: =parent.Widget.par.Value0.eval() == parent().digits
                    Mapoff: '='
                    Mapon: '='
                    Fontcolor: =parent.Widget.parGroup.Foldertabonfontcolor if me.par.Value else parent.Widget.parGroup.Foldertabofffontcolor
                    Facecolor: =parent.Widget.parGroup.Foldertabonfacecolor if me.par.Value else parent.Widget.parGroup.Foldertabofffacecolor
                position: [700, 300]
              - name: rollover
                type: containerCOMP
                parameters:
                  layer: 7
                  hmode: fill
                  vmode: fill
                  alignallow: ignore
                  display: =parent().panel.rollover or parent().panel.lselect or parent().panel.inside
                  clickthrough: true
                  resizecomp: =me
                  bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                  bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                  bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                  bgalpha: =parent.Widget.par.Rollovercolora.eval()
                  borderover: false
                  composite: add
                flags:
                - viewer
                position: [700, 500]
                size: [160, 130]
              - name: insideParent
                type: tableDAT
                parameters:
                  defaultreadencoding: cp1252
                  rows: 2
                flags:
                - viewer
                position: [100, 300]
                size: [130, 90]
                dat_content:
                - - '''path'''
                  - '''parameter'''
                  - '''value'''
                  - '''enable'''
                - - '''rollover/panel'''
                  - '''component'''
                  - '''"'' + parent().path + ''"'''
                  - '1'
                dat_content_format: table
              - name: text1_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                - -showDocked
                position: [700, 150]
                size: [160, 130]
                dock: text
                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: tab1
              type: buttonCOMP
              parameters:
                y: =1-(me.digits == parent.Widget.par.Value0.eval())
                w: =(op('./textInfo').textWidth + parent.Widget.par.Foldertablabelmargin) if parent.Widget.extensionsReady else 0
                h: 50
                hmode: fill
                vmode: fill
                topoffset: =- (0 if tdu.split(parent.Widget.par.Foldericonhexcodes.eval())[me.digits] == parent.Widget.par.Value0 else parent.Widget.par.Foldertabopenmargin) if parent.Widget.extensionsReady else 0
                postoffsety: =1-(me.digits == parent.Widget.par.Value0.eval())
                helpdat: =parent.Widget.op('code/help') or parent.Widget.op('help')
                topsmoothness: mipmap
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                enablecloning: true
                clone: tab0
              position: [0, -130]
              size: [160, 130]
              children:
              - name: text
                type: textCOMP
                parameters:
                  text: ='' if len(tdu.split(parent.Widget.par.Foldertabnames.eval())) == 0 else tdu.split(parent.Widget.par.Foldertabnames.eval())[parent().digits]
                  callbacks: text1_callbacks
                  font: =parent.Widget.par.Foldertabfont.eval()
                  fontfile: =parent.Widget.par.Foldertabfontfile
                  bold: =parent.Widget.par.Foldertabfontbold.eval()
                  italic: =parent.Widget.par.Foldertabitalic
                  fontsize: =parent.Widget.par.Foldertabfontsize.eval()
                  fontcolorr: =me.par.Fontcolor.eval()[0]
                  fontcolorg: =me.par.Fontcolor.eval()[1]
                  fontcolorb: =me.par.Fontcolor.eval()[2]
                  fontalpha: =me.par.Fontcolor.eval()[3]
                  dropshadow: =parent.Widget.par.Foldertabdropshadow
                  textoffsetx: =parent.Widget.par.Foldertaboffsetx.eval()
                  textoffsety: =parent.Widget.par.Foldertaboffsety.eval()
                  textpaddingl: =parent.Widget.par.Foldertabpadding1.eval()
                  textpaddingr: =parent.Widget.par.Foldertabpadding2.eval()
                  textpaddingb: =parent.Widget.par.Foldertabpadding3.eval()
                  textpaddingt: =parent.Widget.par.Foldertabpadding4.eval()
                  alignx: =parent.Widget.par.Foldertabalignx.eval()
                  alignxmode: =parent.Widget.par.Foldertabalignxmode.eval()
                  aligny: =parent.Widget.par.Foldertabaligny.eval()
                  alignymode: =parent.Widget.par.Foldertabalignymode.eval()
                  hmode: anchors
                  clickthrough: true
                  bgcolorr: =me.par.Facecolor.eval()[0]
                  bgcolorg: =me.par.Facecolor.eval()[1]
                  bgcolorb: =me.par.Facecolor.eval()[2]
                  bgalpha: =me.par.Facecolor.eval()[3]
                  top: '=me.par.Mapon.eval() if me.par.Value else me.par.Mapoff.eval() '
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  borderover: false
                custom_pars:
                  Expressions:
                    $t: expressions_2
                    Value: =parent.Widget.par.Value0.eval() == parent().digits
                    Mapoff: '='
                    Mapon: '='
                    Fontcolor: =parent.Widget.parGroup.Foldertabonfontcolor if me.par.Value else parent.Widget.parGroup.Foldertabofffontcolor
                    Facecolor: =parent.Widget.parGroup.Foldertabonfacecolor if me.par.Value else parent.Widget.parGroup.Foldertabofffacecolor
                position: [700, 300]
              - name: rollover
                type: containerCOMP
                parameters:
                  layer: 7
                  hmode: fill
                  vmode: fill
                  alignallow: ignore
                  display: =parent().panel.rollover or parent().panel.lselect or parent().panel.inside
                  clickthrough: true
                  resizecomp: =me
                  bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                  bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                  bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                  bgalpha: =parent.Widget.par.Rollovercolora.eval()
                  borderover: false
                  composite: add
                flags:
                - viewer
                position: [700, 500]
                size: [160, 130]
              - name: insideParent
                type: tableDAT
                parameters:
                  defaultreadencoding: cp1252
                  rows: 2
                flags:
                - viewer
                position: [100, 300]
                size: [130, 90]
                dat_content:
                - - '''path'''
                  - '''parameter'''
                  - '''value'''
                  - '''enable'''
                - - '''rollover/panel'''
                  - '''component'''
                  - '''"'' + parent().path + ''"'''
                  - '1'
                dat_content_format: table
              - name: text1_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                - -showDocked
