                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: label
