            - name: Ontooffscript0
              style: Str
              label: On To Off Script 0
            - name: Offtoonscript0
              style: Str
              label: Off To On Script 0
            - name: Createeditvalueparexec
              style: Pulse
              label: Create/Edit Value Par Exec
              startSection: true
            - name: Valueparexec
              style: DAT
              label: Value Par Exec
              readOnly: true
              enable: false
            Label:
            - name: Widgetlabel
              style: Str
              label: Widget Label
              default: SOP Reference
            - name: Labeltop
              style: TOP
              label: Label TOP
            - name: Labeldisplay
              style: Toggle
              label: Display
              startSection: true
              default: true
            - name: Labelwordwrap
              style: Toggle
              label: Word Wrap
              startSection: true
            - name: Labelfontsizemode
              style: Menu
              label: Font Size Mode
              startSection: true
              default: panelunits
