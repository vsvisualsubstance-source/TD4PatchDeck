              - Fixed Height
              - Fill
            - name: Menubuttonheight
              style: Int
              label: Height
              default: 88
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
              enable: false
            - name: Menubuttonvfillweight
              style: Float
              label: Vertical Fill Weight
              default: 1
              clampMin: true
            Pop Menu:
            - name: Editcallbacks
              style: Pulse
              label: Edit Callbacks
            - name: Printcallbacks
              style: Toggle
              label: Print Callbacks
            - name: Callbackdat
              style: DAT
              label: Callback DAT
              default: popMenuCallbacks
