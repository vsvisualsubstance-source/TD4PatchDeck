                Sliderindicatorcolor: [0.325, 0.325, 0.325, 1]
                Cacheabletop: =op('./slider0/bg')
            position: [800, -975]
            comp_inputs:
            - labeledFieldSlider0
            children:
            - name: bg
              type: nullTOP
