              language: input
            flags:
            - viewer
            position: [950, -300]
            size: [130, 90]
            dat_content: "\ndef onOffToOn(channel, sampleIndex, val, prev):\n\n\tresetMIN = op('null1')[0]\n\tresetMAX = op('null1')[0] \n\n\top('table1')[1,'MIN'] = resetMIN\n\top('table1')[1,'MAX'] = resetMAX\n\n\treturn\n"
            dat_content_format: text
