value: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: CallbacksExt
              type: selectDAT
              parameters:
                dat: =op.TDModules.op('TDCallbacksExt')
                rowindexend: =me.inputs[0].numRows - 1
                rowexpr: =re.match('.*',me.inputCell.val) != None
                colindexend: =me.inputs[0].numCols - 1
              flags:
              - viewer
              position: [-900, 500]
              size: [130, 90]
              dat_read_only: true
            - name: evalMenuData
              type: evaluateDAT
              parameters:
                expr: ext.TopMenuSubCompExt.Buttons[me.inputRow]
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [-700, 0]
              inputs:
              - tableButtonLen
              dat_read_only: true
            - name: defineDATExec
              type: datexecuteDAT
              parameters:
                dat: =parent.Widget.par.Topmenudat.eval()
                defaultreadencoding: cp1252
                language: input
              position: [-700, 200]
              size: [130, 90]
              dat_content: "def onTableChange(dat):\n\tif(dat):\n\t\text.TopMenuSubCompExt.setupMenuData()\n\n\t"
              dat_content_format: text
            - name: menuCallbacks
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, 500]
              size: [130, 90]
              dat_content: "\"\"\"\nPopMenu callbacks\n\nCallbacks always take a single argument, which is a dictionary\nof values relevant to the callback. Print this dictionary to see what is\nbeing passed. The keys explain what each item is.\n\nPopMenu info keys:\n\t'cell': either cell id or -1 for no cell\n\t'item': the item label in the menu list\n\t'row': the row from the wired dat input, if applicable\n\t'details': details provided by object that caused menu to open\n\"\"\"\n\ndef onSelect(info):\n\t\"\"\"\n\tUser selects a menu option\n\t\"\"\"\n\text.TopMenuSubCompExt.passCallback(info)\n\ndef onRollover(info):\n\t\"\"\"\n\tMouse rolled over an item\n\t\"\"\"\n\text.TopMenuSubCompExt.passCallback(info)\n\ndef onOpen(info):\n\t\"\"\"\n\tMenu opened\n\t\"\"\"\n\tinfo['ownerComp'].cook(force=True)\n\text.TopMenuSubCompExt.passCallback(info)\n\ndef onClose(info):\n\t\"\"\"\n\tMenu closed\n\t\"\"\"\n\text.TopMenuSubCompExt.passCallback(info)\n\ndef onMouseDown(info):\n\t\"\"\"\n\tItem pressed\n\t\"\"\"\n\text.TopMenuSubCompExt.passCallback(info)\n\ndef onMouseUp(info):\n\t\"\"\"\n\tItem released\n\t\"\"\"\n\text.TopMenuSubCompExt.passCallback(info)\n\ndef onClick(info):\n\t\"\"\"\n\tItem pressed and released\n\t\"\"\"\n\text.TopMenuSubCompExt.passCallback(info)\n\ndef onLostFocus(info):\n\t\"\"\"\n\tMenu lost focus\n\t\"\"\"\n\text.TopMenuSubCompExt.passCallback(info)\n\n"
              dat_content_format: text
            - name: menuDATOPExec
              type: opexecuteDAT
              parameters:
                op: =(parent.Widget.par.Topmenudat.eval() if parent.Widget.par.Topmenudat.eval() else '', parent.Widget.par.Callbackdat.eval() if parent.Widget.par.Callbackdat.eval() else '')
              flags:
              - viewer
              position: [-700, 400]
              dat_content: "def onOPdelete():\n\tif not parent.Widget.par.Topmenudat:\n\t\tparent.Widget.par.Topmenudat = op('exampleMenuDefine')\n\t\text.TopMenuSubCompExt.setupMenuData()\n\tif not parent.Widget.par.Callbackdat:\n\t\tparent.Widget.par.Callbackdat = ''"
              dat_content_format: text
            - name: emptyCallbacks
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-900, 300]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content: "\"\"\"\nTopMenu callbacks\n\nCallbacks always take a single argument, which is a dictionary\nof values relevant to the callback. Print this dictionary to see what is\nbeing passed. The keys explain what each item is.\n\nTopMenu info keys:\n\t'widget': the TopMenu widget\n\t'item': the item label in the menu list\n\t'index': either menu index or -1 for none\n\t'indexPath': list of parent menu indexes leading to this item\n\t'define': TopMenu define DAT definition info for this menu item\n\t'menu': the popMenu component inside topMenu\n\"\"\"\n\n#################################\n# exampleMenuDefine callbacks\n\ndef onQuit(info):\n\t\"\"\"\n\tA simple menu item callback, named in the Top Menu DAT table\n\t\"\"\"\n\tdebug('QUIT!')\n\nguides = False\ngrid = True\n\ndef onSetting(info):\n\t\"\"\"\n\tA menu item callback that works on multiple menu items. The checkboxes in\n\tthe menu evaluate the global guides and grid variables above to determine\n\ttheir state. The expressions used to evaluate the checkbox state are\n\tdefined in the Top Menu DAT.\n\t\"\"\"\n\tglobal guides, grid\n\tif info['item'] == 'Show Guides':\n\t\tguides = not guides\n\telif info['item'] == 'Show Grid':\n\t\tgrid = not grid\n\ndef getRecentFiles(info):\n\t\"\"\"\n\tA rowCallback used in the Top Menu DAT table to automatically generate rows.\n\tThese callbacks must return a dictionary or list of dictionaries that mimic\n\tthe columns in the Top Menu DAT. Dictionaries only need the columns with\n\tdata in them, but must have corresponding columns in the Top Menu DAT in\n\torder to be recognized.\n\t\"\"\"\n\treturn [\n\t\t{'item2': 'File 1'},\n\t\t{'item2': 'File 2', 'highlight': True},\n\t\t{'item2': 'File three', 'dividerAfter': True}\n\t]\n\n# end examples\n####################################\n\n# standard menu callbacks\n\ndef onSelect(info):\n\t\"\"\"\n\tUser selects a menu option\n\t\"\"\"\n\tdebug(info)\n\ndef onRollover(info):\n\t\"\"\"\n\tMouse rolled over an item\n\t\"\"\"\n\ndef onOpen(info):\n\t\"\"\"\n\tMenu opened\n\t\"\"\"\n\ndef onClose(info):\n\t\"\"\"\n\tMenu closed\n\t\"\"\"\n\ndef onMouseDown(info):\n\t\"\"\"\n\tItem pressed\n\t\"\"\"\n\ndef onMouseUp(info):\n\t\"\"\"\n\tItem released\n\t\"\"\"\n\ndef onClick(info):\n\t\"\"\"\n\tItem pressed and released\n\t\"\"\"\n\ndef onLostFocus(info):\n\t\"\"\"\n\tMenu lost focus\n\t\"\"\""
              dat_content_format: text
            - name: menuCategories
              type: nullDAT
              flags:
              - viewer
              position: [-500, 0]
              inputs:
              - evalMenuData
              dat_read_only: true
            - name: menuReplicator
              type: replicatorCOMP
              parameters:
                method: bynum
                numreplicants: =ext.TopMenuSubCompExt.MenuLevels - 1
                repsuffixstart: 2
                opprefix: popMenu
                master: popMenu1
                destination: =parent()
                callbacks: replicator2_callbacks
                layout: horizontal
                layoutorigin1: 200
                layoutorigin2: 430
              position: [-300, 300]
            - name: tableButtonLen
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(ext.TopMenuSubCompExt.MenuData)
                cols: 1
              flags:
              - viewer
              position: [-900, 0]
              size: [130, 90]
              dat_content:
              - - ''
              - - ''
              - - ''
              dat_content_format: table
            - name: callbackCreator
              type: executeDAT
              parameters:
                create: true
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-700, 300]
              size: [130, 90]
              dat_content: "# me - this DAT\n# \n# frame - the current frame\n# state - True if the timeline is paused\n# \n# Make sure the corresponding toggle is enabled in the Execute DAT.\n\ndef start():\n\treturn\n\ndef create():\n\trun('op(' + str(me.id) + ').module.createCallback() if op(' + str(me.id) + ') else None', delayFrames=1,\n\t\t\tdelayRef=op.TDResources)\n\ndef createCallback():\n\tcallbackCOMP = ext.CallbacksExt.ownerComp\n\tcallbackDatPar = callbackCOMP.par.Callbackdat\n\tcallbackDat = callbackDatPar.eval()\n\tif callbackDat and callbackDat.path.startswith(callbackCOMP.path):\n\t\t# internal callback already exists\n\t\treturn\n\tif callbackDatPar.mode == ParMode.CONSTANT:\n\t\tcallbackDatString = callbackCOMP.par.Callbackdat.val\n\telse:\n\t\t# only create for constant mode callback DAT par\n\t\treturn\n\tpathSplit = callbackDatString.split('/')\n\tif len(pathSplit) == 1:\n\t\tcallbackTargetParentPath = callbackCOMP.parent().path\n\telse:\n\t\tcallbackTargetParentPath = '/'.join(pathSplit[:-1])\n\tcallbackTargetParent = callbackCOMP.evalExpression(\n\t\t\t\t\t\t\t\t\t'op(\"' + callbackTargetParentPath + '\")')\n\tif callbackTargetParent != callbackCOMP.parent():\n\t\t# only create next to menu\n\t\treturn\n\tif callbackDatPar.eval():\n\t\tif callbackDatPar.eval().dock == callbackCOMP:\n\t\t\t# don't create if target already docked to parent\n\t\t\treturn\n\t\telse:\n\t\t\t# we'll get an incorrect dependency arrow unless we do this:\n\t\t\tcallbackDatPar.eval().cook(force=True)\n\tcallbackDat = callbackTargetParent.create(textDAT, pathSplit[-1])\n\tcallbackDat.text = op('emptyCallbacks').text\n\tcallbackDat.nodeX = callbackCOMP.nodeX\n\tcallbackDat.nodeY = callbackCOMP.nodeY - 125\n\tcallbackDat.dock = callbackCOMP\n\tcallbackDat.showDocked = False\n\tcallbackDat.viewer = True\n\tif callbackDatPar.eval() != callbackDat:\n\t\tcallbackDatPar.val = callbackDat\n\ndef exit():\n\treturn\n\ndef frameStart(frame):\n\treturn\n\ndef frameEnd(frame):\n\treturn\n\ndef playState(state):\n\treturn\n\ndef deviceChange():\n\treturn\n\t"
              dat_content_format: text
            - name: buttonReplicator
              type: replicatorCOMP
              parameters:
                template: menuCategories
                opprefix: menuButton
                master: menuButton0
                destination: =me.parent()
                callbacks: replicator1_callbacks
                layout: vertical
                layoutorigin1: =me.nodeX
                layoutorigin2: =me.nodeY - 200
              position: [-300, 0]
            - name: callbackDATExec1
              type: datexecuteDAT
              parameters:
                dat: =parent.Widget.par.Callbackdat.eval()
                defaultreadencoding: cp1252
                language: input
              position: [-700, 500]
              size: [130, 90]
              dat_content: "def onTableChange(dat):\n\text.TopMenuSubCompExt.setupMenuData()\n\n\t"
              dat_content_format: text
            - name: TopMenuSubCompExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-900, 600]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "\"\"\"\nExtension classes enhance TouchDesigner components with python. An\nextension is accessed via ext.ExtensionClassName from any operator\nwithin the extended component. If the extension is promoted via its\nPromote Extension parameter, all its attributes with capitalized names\ncan be accessed externally, e.g. op('yourComp').PromotedFunction().\n\nHelp: search \"Extensions\" in wiki\n\"\"\"\n\nfrom collections import OrderedDict\nfrom TDStoreTools import StorageManager\nTDF = op.TDModules.mod.TDFunctions\n\nclass TopMenuSubCompExt:\n\t\"\"\"\n\tTopMenuSubCompExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\t# properties\n\t\tself.MenuData = []\n\t\tself.popMenu = self.ownerComp.op('popMenu1')\n\t\tself.menuStatusCHOPPar = self.ownerComp.op('menuStatus').par.value0\n\t\tself.lastButton = None\n\t\tTDF.createProperty(self, 'MenuLevels', 1, dependable=True)\n\t\tTDF.createProperty(self, 'Buttons', [], dependable='deep')\n\t\tTDF.createProperty(self, 'ButtonsEnable', [], dependable='deep')\n\t\tself.TopMenuDAT = parent.Widget.par.Topmenudat.eval()\n\t\trun('args[0]()', self.setupMenuData, delayFrames=1,\n\t\t\t\tdelayRef=op.TDResources)\n\n\tdef setupMenuData(self):\n\t\t\"\"\"\n\t\tSetup the menu data from the TopMenuDAT\n\t\t\"\"\"\n\t\tparent.Widget.clearScriptErrors()\n\t\tself.MenuData.clear()\n\t\tself.Buttons.clear()\n\t\tself.ButtonsEnable.clear()\n\t\tmenuDat = self.TopMenuDAT = parent.Widget.par.Topmenudat.eval()\n\t\tif menuDat is None:\n\t\t\tself.MenuData = []\n\t\t\treturn\n\t\tlastItemCol = 0 \n\t\tcurrentDepth = 0\n\t\tcurrentList = None\n\t\tcurrentIndexPath = []\n\t\tmenuData = self.MenuData\n\t\tfor rowNum, row in enumerate(menuDat.rows()):\n\t\t\t# columns\n\t\t\tif rowNum == 0:\n\t\t\t\tcolumns = [c.val for c in row]\n\t\t\t\tif len(columns) > 1:\n\t\t\t\t\twhile columns[lastItemCol + 1].startswith('item'):\n\t\t\t\t\t\tlastItemCol += 1\n\t\t\t\tcontinue\n\t\t\tself.MenuLevels = lastItemCol\n\t\t\trowDict = OrderedDict()\n\t\t\tfor c in range(len(columns)):\n\t\t\t\trowDict[columns[c]] = row[c].val\n\t\t\t# rowCallback - allows for dynamic row creation\n\t\t\tif rowDict.get('rowCallback'):\n\t\t\t\tinfo = parent.Widget.DoCallback(rowDict['rowCallback'],\n\t\t\t\t\t\t\t\t\t\t\t\t {'rowDict':rowDict,\n\t\t\t\t\t\t\t\t\t\t\t\t  'rowNum':rowNum})\n\t\t\t\tif info:\n\t\t\t\t\trowDicts = info['returnValue']\n\t\t\t\telse:\n\t\t\t\t\trowDicts = []\n\t\t\t\tif isinstance(rowDicts, dict):\n\t\t\t\t\trowDicts = [rowDicts]\n\t\t\t\telif not isinstance(rowDicts, list):\n\t\t\t\t\tself.rowError('TopMenu row callback must return either a'\n\t\t\t\t\t\t\t\t  ' row dictionary or a list of row '\n\t\t\t\t\t\t\t\t  'dictionaries.', rowNum)\n\t\t\t\t\trowDicts = []\n\t\t\t\telif not rowDicts:\n\t\t\t\t\trowDicts = []\n\t\t\telse:\n\t\t\t\trowDicts = [rowDict]\n\n\t\t\t# process actual row dictionaries\n\t\t\t# \tusually just one but can be multiple when using callbacks\n\t\t\tfor rowDict in rowDicts:\n\n\t\t\t\t# buttons\n\t\t\t\tbutton = rowDict.get('button')\n\t\t\t\tif button:\n\t\t\t\t\tsubDict = rowDict.copy()\n\t\t\t\t\tsubDict['name'] = button\n\t\t\t\t\tmenuData.append(subDict)\n\t\t\t\t\tsubDict['indexPath'] = [len(menuData) - 1]\n\t\t\t\t\tcurrentIndexPath = subDict['indexPath'].copy()\n\t\t\t\t\tsubDict['menuList'] = currentList = []\n\t\t\t\t\tself.Buttons.append(button)\n\t\t\t\t\tself.ButtonsEnable.append(not parent.Widget.evalExpression(\n\t\t\t\t\t\t\t\t\t\t\trowDict.get('disable', 'False')))\n\t\t\t\t\tcurrentDepth = 0\n\t\t\t\t\tcontinue\n\n\t\t\t\t# items\n\t\t\t\titemCol = None\n\t\t\t\tfor i in range(1, lastItemCol + 1):\n\t\t\t\t\tif rowDict.get('item' + str(i)):\n\t\t\t\t\t\titemCol = i\n\t\t\t\t\t\titem = rowDict['item' + str(i)]\n\t\t\t\t\t\trowDict['name'] = item\n\t\t\t\t\t\tbreak\n\t\t\t\t# no item column found and not a button\n\t\t\t\tif itemCol is None:\n\t\t\t\t\tself.rowError('TopMenu row must be either a button or an '\n\t\t\t\t\t\t\t  \t  'item.', rowNum)\n\t\t\t\t\tcontinue\n\t\t\t\t#
                item column jumps more than one level\n\t\t\t\tif itemCol > currentDepth + 1:\n\t\t\t\t\tself.rowError('Invalid item level.', rowNum)\n\t\t\t\t\tcontinue\n\t\t\t\t# item column is greater than current depth\n\t\t\t\t# \tcreates a new sub menu\n\t\t\t\tif itemCol > currentDepth:\n\t\t\t\t\tif itemCol == 1:\n\t\t\t\t\t\t# top level item\n\t\t\t\t\t\tsubDict = rowDict.copy()\n\t\t\t\t\telse:\n\t\t\t\t\t\t# sub menu item\n\t\t\t\t\t\tcurrentList[-1]['menuList'] = subMenu = []\n\t\t\t\t\t\tcurrentList = subMenu\n\t\t\t\t\t\tsubDict = rowDict.copy()\n\t\t\t\t\tcurrentList.append(subDict)\n\t\t\t\t\tcurrentIndexPath.append(len(currentList) - 1)\n\t\t\t\t\tsubDict['indexPath'] = currentIndexPath.copy()\n\t\t\t\t\tcurrentDepth = itemCol\n\t\t\t\t# item column is less than or equal to current depth\n\t\t\t\telse:\n\t\t\t\t\tsubDict = rowDict.copy()\n\t\t\t\t\tif itemCol < currentDepth:\n\t\t\t\t\t\tcurrentIndexPath = currentIndexPath[:itemCol]\n\t\t\t\t\t\tcurrentList = menuData[currentIndexPath[0]]['menuList']\n\t\t\t\t\t\tfor path in range(1, itemCol):\n\t\t\t\t\t\t\tcurrentList = currentList['menuList']\\\n\t\t\t\t\t\t\t\t\t\t\t\t\t[currentIndexPath[path]]\n\t\t\t\t\t\tcurrentIndexPath.append(len(currentList))\n\t\t\t\t\t\tcurrentDepth = itemCol\n\t\t\t\t\telse:\n\t\t\t\t\t\tcurrentIndexPath[-1] = len(currentList)\n\t\t\t\t\tcurrentList.append(subDict)\n\t\t\t\t\tsubDict['indexPath'] = currentIndexPath.copy()\n\t\t\t\t#debug(itemCol, currentDepth)\n\t\t# debug(menuData)\n\t\top('tableButtonLen').cook(force=True)\n\n\t\t# import json\n\t\t# op('text1').text = json.dumps(menuData, indent=4)\n\t\t# print(op('text1').text)\n\n\tdef onButton(self, panelValue):\n\t\tbuttonNum = panelValue.owner.digits\n\t\tif buttonNum == self.lastButton:\n\t\t\tself.lastButton = None\n\t\t\treturn\n\t\tif panelValue.name == 'select':\n\t\t\tif self.popMenu.IsOpen:\n\t\t\t\tself.popMenu.Close()\n\t\t\t\tif buttonNum != self.lastButton:\n\t\t\t\t\trun('args[0].openMenu(args[1], args[2])', self,\n\t\t\t\t\t\tpanelValue.owner,\n\t\t\t\t\t\tself.MenuData[buttonNum],\n\t\t\t\t\t\tdelayFrames=1, delayRef=op.TDResources)\n\t\t\t\t\tself.lastButton = buttonNum\n\t\t\t\telse:\n\t\t\t\t\tself.lastButton = None\n\t\t\telse:\n\t\t\t\tself.openMenu(panelValue.owner, self.MenuData[buttonNum])\n\t\t\t\tself.lastButton = buttonNum\n\t\t# elif self.popMenu.IsOpen and panelValue.name == 'rollover':\n\t\t# \tself.openMenu(panelValue.owner, self.MenuData[buttonNum])\n\t\t# \tself.lastButton = buttonNum\t\t\t\n\n\t@property\n\tdef lastButton(self):\n\t\treturn self._lastButton\n\t@lastButton.setter\n\tdef lastButton(self, val):\n\t\tself._lastButton = val\n\t\tif self.lastButton is None:\n\t\t\tself.menuStatusCHOPPar.val = -1\n\t\telse:\n\t\t\tself.menuStatusCHOPPar.val = val\n\n\tdef openMenu(self, buttonCOMP, itemDict, popMenu=None):\n\t\tself.lastButton = buttonCOMP.digits\n\t\titems = []\n\t\tdividersAfterItems = []\n\t\tdisabledItems = []\n\t\thighlightedItems = []\n\t\tsubMenuItems = []\n\t\tcheckedItems = {}\n\t\tshortcuts = {}\n\t\tlastItem = None\n\t\tfor info in itemDict['menuList']:\n\t\t\titem = info['name']\n\t\t\tlastItem = item\n\t\t\titems.append(item)\n\t\t\tif info.get('dividerAfter') \\\n\t\t\t\t\t\tand parent.Widget.evalExpression(info['dividerAfter']):\n\t\t\t\tdividersAfterItems.append(item)\n\t\t\tif info.get('disable') \\\n\t\t\t\t\t\t\tand parent.Widget.evalExpression(info['disable']):\n\t\t\t\tdisabledItems.append(item)\n\t\t\tif info.get('checked'):\n\t\t\t\tcheckedItems[item] = \\\n\t\t\t\t\t\t\t\tparent.Widget.evalExpression(info['checked'])\n\t\t\tif info.get('highlight') \\\n\t\t\t\t\t\t\tand parent.Widget.evalExpression(info['highlight']):\n\t\t\t\thighlightedItems.append(item)\n\t\t\tif info.get('shortcut'):\n\t\t\t\tshortcuts[item] = info['shortcut']\n\t\t\tif info.get('menuList') and info['menuList']:\n\t\t\t\tsubMenuItems.append(item)\n\t\tcallbackDetails = {'button': buttonCOMP,\n\t\t\t\t\t\t   'itemDict': itemDict}\n\t\tif popMenu is None:\n\t\t\tself.popMenu.par.Buttoncomp = buttonCOMP\n\t\t\tself.popMenu.Open(\n\t\t\t\titems=items,\n\t\t\t\thighlightedItems=highlightedItems,\n\t\t\t\tdisabledItems=disabledItems,\n\t\t\t\tdividersAfterItems=dividersAfterItems,\n\t\t\t\tcheckedItems=checkedItems,\n\t\t\t\tsubMenuItems=subMenuItems,\n\t\t\t\tshortcuts=shortcuts,\n\t\t\t\tcallbackDetails=callbackDetails,\n\t\t\t\tallowStickySubMenus=False)\n\t\telse:\n\t\t\tpopMenu.OpenSubMenu(\n\t\t\t\titems=items,\n\t\t\t\thighlightedItems=highlightedItems,\n\t\t\t\tdisabledItems=disabledItems,\n\t\t\t\tdividersAfterItems=dividersAfterItems,\n\t\t\t\tcheckedItems=checkedItems,\n\t\t\t\tsubMenuItems=subMenuItems,\n\t\t\t\tshortcuts=shortcuts,\n\t\t\t\tcallbackDetails=callbackDetails,\n\t\t\t\tallowStickySubMenus=False)\n\n\tdef
                rowError(self, error, row):\n\t\terror = parent.Widget.path + ': ' + error + \\\n\t\t\t\t\t\t\t\t\t\t\t\t' (Row: ' + str(row) + ')'\n\t\tparent.Widget.addScriptError(error)\n\t\tprint(error)\n\n\tdef openSubMenu(self, info):\n\t\tself.openMenu(info['details']['button'],\n\t\t\t\t\t  info['details']['itemDict']['menuList'][info['index']],\n\t\t\t\t\t  info['menu'])\n\n\tdef passCallback(self, info):\n\t\t\"\"\"\n\t\tpass callback up to widget callbacks\n\t\t:param info: callback info dict\n\t\t:return:\n\t\t\"\"\"\n\t\t# if info['callbackName'] == 'onSelect':\n\t\t# \timport json\n\t\t# \top('text1').text = json.dumps(info['details']['itemDict']['menuList'], indent=4)\n\t\t# \tprint(op('text1').text)\n\t\tif info['callbackName'] == 'onSelect' \\\n\t\t\t\tand info['details']['itemDict']['menuList'][\n\t\t\t\t\t\t\t\t\t\t\t\tinfo['index']].get('menuList'):\n\t\t\tself.openSubMenu(info)\n\t\t\treturn\n\t\t# elif info['callbackName'] in ['onLostFocus']:\n\t\t# \tself.lastButton = None\n\t\tif info.get('item'):\n\t\t\tparent.Widget.DoCallback(info['callbackName'],\n\t\t\t\t\t\t\t\t\t self.simplifyInfo(info))\n\t\telse:\n\t\t\tparent.Widget.DoCallback(info['callbackName'], info)\n\t\t# import json\n\t\t# op('text1').text = json.dumps(info['details']['itemDict'], indent=4)\n\t\t# print(op('text1').text)\n\t\tif info['callbackName'] == 'onSelect':\n\t\t\tself.lastButton = None\n\t\t\t# custom callbacks\n\t\t\tif info['details']['itemDict']['menuList'][\n\t\t\t\t\t\t\t\t\t\t\t\tinfo['index']].get('callback'):\n\t\t\t\tparent.Widget.DoCallback(\n\t\t\t\t\t\tinfo['details']['itemDict']['menuList'][\n\t\t\t\t\t\t\t\t\t\t\t\tinfo['index']]['callback'],\n\t\t\t\t\t\tself.simplifyInfo(info))\n\n\tdef simplifyInfo(self, info):\n\t\t\"\"\"\n\t\tReturn a simplified info dictionary for callbacks\n\t\tBasically just removes menuList and adds 'define', 'button', 'widget'\n\t\t:param info: from callback\n\t\t:return: dictionary of callback info\n\t\t\"\"\"\n\t\tif not 'details' in info:\n\t\t\traise Exception\n\t\t\treturn info\n\t\tsimpleInfo = {k:v for k,v in info.items() if k != 'details'}\n\t\tdetails = info['details']\n\t\titemDict = details['itemDict']\n\t\t# import json\n\t\t# op('text1').text = json.dumps(itemDict['menuList'], indent=4)\n\t\t# print(op('text1').text)\n\t\t# debug(itemDict.keys())\n\t\trowInfo = OrderedDict()\n\t\tfor k, v in itemDict['menuList'][info['index']].items():\n\t\t\tif k not in ['menuList']:\n\t\t\t\trowInfo[k] = v\n\t\tsimpleInfo['define'] = rowInfo\n\t\t# simpleInfo['indexPath'] = rowInfo['indexPath']\n\t\tsimpleInfo['button'] = details['button']\n\t\tsimpleInfo['widget'] = parent.Widget\n\t\treturn simpleInfo"
              dat_content_format: text
