            position: [400, 0]
            inputs:
            - output
          - name: vertLayout
            type: containerCOMP
            parameters:
              h: 1021
              hmode: fill
              vmode: fill
              alignorder: =-me.nodeY
              resizecomp: =me
              borderover: false
              align: verttb
              spacing: =parent.Widget.par.alignmargin
              justifyh: =parent.Widget.par.justifyh
              justifyv: top
              crop: 'on'
            flags:
            - viewer
            position: [550, -300]
