            position: [-1350, 140]
          - name: fg_rand_col
            type: noiseCHOP
            parameters:
              type: random
              seed: =parent().par.Colorseed
              channelname: index
              end: =parent().par.Count - 1
            position: [-1350, -700]
          - name: fg_rand_rot
            type: noiseCHOP
            parameters:
              type: random
              seed: =parent().par.Seed + 6
              channelname: rz
              end: =parent().par.Count - 1
            position: [-1350, -160]
          - name: reseed_exec
            type: parameterexecuteDAT
            parameters:
              fromop: =parent()
              op: .
              pars: Reseed Reseedcolor Palcopy
              valuechange: false
            position: [2550, 150]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dat_content: |
              import random

              SIGLE = ['a','b','c','d','e','f','g']

              def onPulse(par):
                  c = par.owner
                  if par.name == 'Reseed':
                      c.par.Seed = random.randint(0, 99999)
                  elif par.name == 'Reseedcolor':
                      c.par.Colorseed = random.randint(0, 99999)
                  elif par.name == 'Palcopy':
                      src = c.op('pal_%d' % c.par.Palette.menuIndex)
                      if src is None:
                          return   # gia' su Custom: niente da copiare
                      for n, s in enumerate(SIGLE):
                          for ch in 'rgb':
                              try:
                                  setattr(c.par, 'Palcol%s%s' % (s, ch), src[ch][n])
                              except Exception:
                                  pass
                  return
            dat_content_format: text
          - name: fg_rand_rot3
            type: noiseCHOP
            parameters:
              type: random
              seed: =parent().par.Seed + 8
              channelname: rx ry
              end: =parent().par.Count - 1
            position: [-1350, -220]
          - name: fg_rand_size
            type: noiseCHOP
            parameters:
              type: random
              seed: =parent().par.Seed + 1
              channelname: sy
              end: =parent().par.Count - 1
            position: [-1200, -300]
