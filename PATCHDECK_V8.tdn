          borderar: =[c/.5 for c in [.23, .4, .3, .6]][me.par.value0 + 2*me.panel.rollover] * me.par.colorr + .2
          borderag: =[c/.5 for c in [.23, .4, .3, .6]][me.par.value0 + 2*me.panel.rollover] * me.par.colorg + .2
          borderab: =[c/.5 for c in [.23, .4, .3, .6]][me.par.value0 + 2*me.panel.rollover] * me.par.colorb + .2
          leftborder: bordera
          rightborder: bordera
          bottomborder: bordera
          topborder: bordera
          align: verttb
          spacing: 1
          clone: =op.TDTox.op('defaultCOMPs/button')
        position: [0, -200]
        size: [160, 134]
        children:
        - name: desc
          type: textCOMP
          parameters:
            text: Stay disconnected. Enable later on the Convoy parameter page.
            type: multiline
            wordwrap: true
            callbacks: desc_callbacks
            fontsize: 11
            fontcolorr: 0.62
            fontcolorg: 0.63
            fontcolorb: 0.62
            textoffsetx: 18
            alignx: left
            aligny: top
            h: 24
            hmode: fill
            alignorder: 1
            clickthrough: true
          size: [160, 130]
          color: [0.67, 0.67, 0.67]
        - name: out1
          type: outCHOP
          parameters:
            label: =me.name
            autoexportroot: =parent()
          flags:
          - viewer
          position: [200, 200]
          color: [0.67, 0.67, 0.67]
