              label: Font Bold
            - name: Footerlabelitalic
              style: Toggle
              label: Italic
            - name: Footerlabeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Footerlabelalignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: left
              menuNames:
              - left
              - center
              - right
              menuLabels:
              - Left
              - Center
              - Right
            - name: Footerlabelaligny
              style: Menu
              label: Align Vertical
              default: center
              menuNames:
              - bottom
              - center
              - top
              menuLabels:
              - Bottom
              - Center
              - Top
