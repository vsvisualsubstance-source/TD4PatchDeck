              toranger2: =op.Sndviz.par.Rgbbalancer
              torangeg2: =op.Sndviz.par.Rgbbalanceg
              torangeb2: =op.Sndviz.par.Rgbbalanceb
              inputfiltertype: nearest
              filtertype: nearest
            flags:
            - viewer
            position: [1950, 200]
            size: [130, 105]
