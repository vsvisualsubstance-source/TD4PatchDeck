                  $t: pop_menu
                  Inputtable: RowAll_Col0
                  Items: '[''A'', ''B'', ''C'', ''D'', ''E'', ''F'', ''G'']'
                  Highlighteditems: '[]'
                  Disableditems: '[]'
                  Dividersafteritems: '[]'
                  Checkeditems: '[]'
                  Shortcuts: '{}'
                  Maxheight: 600
                  Borders: true
                  Horizontalalign: Left
                  Verticalalign: Top
                  Buttoncomp: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/masterStringMenu/stringMenu0
                  Horizontalattach: Left
                  Verticalattach: Bottom
                Advanced:
                  $t: advanced
                  Callbackdat: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/masterStringMenu/stringMenu0/config/callbacks
                  Configcomp: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/masterStringMenu/stringMenu0/config
                  Windowcomp: /PATCHDECK/UI/MAIN_INTERFACE/basicWidgets/masterStringMenu/stringMenu0/popMenu/window
                  Includedialog: false
                  Allowstickysubmenus: true
                About:
                  $t: about_3
                  Version: 1.3.0
                  Toxsavebuild: '2023.11831'
              flags:
