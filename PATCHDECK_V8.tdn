          - name: glsl1_info
            type: infoDAT
            parameters:
              op: glsl1
            flags:
            - viewer
            - -showDocked
            position: [525, 200]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dock: glsl1
            dat_read_only: true
          - name: glsl2_info
            type: infoDAT
            parameters:
              op: gradient
            flags:
            - viewer
            - -showDocked
            position: [525, -125]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            dock: gradient
            dat_read_only: true
          - name: glsl1_compute
            type: textDAT
            parameters:
              language: glsl
            position: [250, 150]
            size: [130, 90]
            dock: glsl1
            dat_content: "float noise(vec4 p){\n\n\tfloat n = TDPerlinNoise(vec4(p));\n\tn = abs(n);\n\tn = exp(-n * u_exponent);\nreturn n;\n}\n\nmat2 rot(float a){\na = radians(a);\nfloat s = sin(a), c = cos(a);\nreturn mat2(c,-s,s,c);\n}\n\nvoid rotate3D(inout vec3 p, vec3 a) {\n    p.yz = rot(a.x) * p.yz;\n    p.xz = rot(a.y) * p.xz;\n    p.xy = rot(a.z) * p.xy;\n}\n\nfloat exp_fbm(vec3 p){\n//----transforms-----//\nrotate3D(p, u_rot);\np *= 1.0/u_period;\np *= u_scale;\np -= u_translate.xyz;\n\nvec4 pos = vec4(p, u_translate.w);\n\nfloat h_gain = u_h_gain;\nfloat h_spread = u_h_spread;\n\nfloat w = 1.0;\nfloat f = 1.0;\nfloat n = 0.0;\n\nfor(int i = 0; i < u_harmonics; i++)\n\t{\n\tn += noise(pos * f) * w;\n\tw *= h_gain - exp(-n * u_h_exp) * h_gain;\n\tf *= h_spread;\n\tpos.w -= w * u_warp;\n\t\n\t}\n\nreturn n;\n}\n\nvoid main() {\n\tconst uint id = TDIndex();\n\tif(id >= TDNumElements())\n\t\treturn;\n\t\t\n\tvec3 p = TDIn_P();\n\tvec3 norm = TDIn_N();\n\tfloat displace = exp_fbm(p);\n\t\n\tp += displace * norm  * u_amp;\n\t//outputs\n\tP[id] = p;\n\tdisplaceMap[id] = displace * 0.8;\n}\n"
            dat_content_format: text
          - name: glsl2_compute_gradient
            type: textDAT
            parameters:
              language: glsl
            flags:
            - viewer
            position: [200, -125]
            size: [130, 90]
            dock: gradient
            dat_content: "float noise(vec4 p){\n\n\tfloat n = TDPerlinNoise(vec4(p));\n\tn = abs(n);\n\tn = exp(-n * u_exponent);\nreturn n;\n}\n\nmat2 rot(float a){\na = radians(a);\nfloat s = sin(a), c = cos(a);\nreturn mat2(c,-s,s,c);\n}\n\nvoid rotate3D(inout vec3 p, vec3 a) {\n    p.yz = rot(a.x) * p.yz;\n    p.xz = rot(a.y) * p.xz;\n    p.xy = rot(a.z) * p.xy;\n}\n\nfloat exp_fbm(vec3 p){\n//----transforms-----//\nrotate3D(p, u_rot);\np *= 1.0/u_period;\np *= u_scale;\np -= u_translate.xyz;\n\nvec4 pos = vec4(p, u_translate.w);\n\nfloat h_gain = u_h_gain;\nfloat h_spread = u_h_spread;\n\nfloat w = 1.0;\nfloat f = 1.0;\nfloat n = 0.0;\n\nfor(int i = 0; i < u_harmonics; i++)\n\t{\n\tn += noise(pos * f) * w;\n\tw *= h_gain - exp(-n * u_h_exp) * h_gain;\n\tf *= h_spread;\n\tpos.w -= w * u_warp;\n\t\n\t}\n\nreturn n;\n}\n\n//derivative \nvec3 gradient(vec3 p) {\n    const float eps = u_epsilon; \n    \n    float center = exp_fbm(p);\n    float dx = exp_fbm(p + vec3(eps, 0.0, 0.0)) - center;\n    float dy = exp_fbm(p + vec3(0.0, eps, 0.0)) - center;\n    float dz = exp_fbm(p + vec3(0.0, 0.0, eps)) - center;\n    \n    return (vec3(dx, dy, dz)) / eps;\n}\n\nvoid main() {\n\tconst uint id = TDIndex();\n\tif(id >= TDNumElements())\n\t\treturn;\n\t\t\n\tvec3 p = TDIn_P();\n\tvec3 norm = TDIn_N();\n\tfloat displace = exp_fbm(p) ;\n\t\n\tp += displace * norm * u_amp;\n\t//outputs\n\tP[id] = p;\n\t\n\tvec3 der = gradient(p);\n\tnoiseGradient[id] = der;\n\tdisplaceMap[id] = displace * 0.8;\n}\n"
            dat_content_format: text
