                  $t: expressions_2
                  Value: =int(getattr(parent.Widget.par, 'Value'+ str(parent().digits)).evalNorm())
                  Mapoff: =parent.Widget.par.Rockerofftop.eval()
                  Mapon: =parent.Widget.par.Rockerontop.eval()
                  Fontcolor: =parent.Widget.parGroup.Rockeronfontcolor if me.par.Value else parent.Widget.parGroup.Rockerofffontcolor
                  Facecolor: =parent.Widget.parGroup.Rockeronbuttoncolor if me.par.Value else parent.Widget.parGroup.Rockeroffbuttoncolor
                  Bgcolor: =parent.Widget.parGroup.Rockeronbgcolor if me.par.Value else parent.Widget.parGroup.Rockeroffbgcolor
