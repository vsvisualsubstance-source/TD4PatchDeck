              flags:
              - viewer
              position: [200, 300]
              size: [160, 130]
              palette_clone: true
            - name: menuConfig
              type: baseCOMP
              position: [-300, 500]
              size: [160, 130]
              comment: Contains all user-configurable ops for lister
              children:
              - name: check
                type: textTOP
                parameters:
                  text: ='\u2714'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Material Design Icons
                  fontsizex: =op('fontHelper').par.fontsizex * 0.6
                  fontcolorr: =parent.Widget.par.Menufontcolorr
                  fontcolorg: =parent.Widget.par.Menufontcolorg
                  fontcolorb: =parent.Widget.par.Menufontcolorb
                  bgcolorr: =parent.Widget.par.Menubgcolorr
                  bgcolorg: =parent.Widget.par.Menubgcolorg
                  bgcolorb: =parent.Widget.par.Menubgcolorb
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('check').par.resolutionh
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [325, 75]
                size: [130, 48]
              - name: button
                type: textTOP
                parameters:
                  text: XXWWWWWWW
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('master').par.font
                  fontsizex: =op('master').par.fontsizex
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menufontcolorr
                  fontcolorg: =parent.Widget.par.Menufontcolorg
                  fontcolorb: =parent.Widget.par.Menufontcolorb
                  fontalpha: =parent.Widget.par.Menufontcolora
                  bgcolorr: =parent.Widget.par.Menubgcolorr
                  bgcolorg: =parent.Widget.par.Menubgcolorg
                  bgcolorb: =parent.Widget.par.Menubgcolorb
                  bgalpha: =parent.Widget.par.Menubgcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: 100
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -200]
                size: [130, 48]
              - name: master
                type: textTOP
                parameters:
                  text: ''
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('fontHelper').par.font
                  bold: =op('fontHelper').par.bold
                  italic: =op('fontHelper').par.italic
                  dispmethod: bitmap
                  antialias: 'on'
                  fontsizex: =op('fontHelper').par.fontsizex
                  positionx: =parent.Widget.par.Menuitemhorizontalpadding1
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menufontcolorr
                  fontcolorg: =parent.Widget.par.Menufontcolorg
                  fontcolorb: =parent.Widget.par.Menufontcolorb
                  fontalpha: =parent.Widget.par.Menufontcolora
                  bgcolorr: =parent.Widget.par.Menubgcolorr
                  bgcolorg: =parent.Widget.par.Menubgcolorg
                  bgcolorb: =parent.Widget.par.Menubgcolorb
                  bgalpha: =parent.Widget.par.Menubgcolora
                  borderar: =op('button').par.fontcolorr
                  borderag: =op('button').par.fontcolorg
                  borderab: =op('button').par.fontcolorb
                  borderaalpha: =op('button').par.bgalpha
                  borderbalpha: 0
                  resolutionh: =op('fontHelper').textHeight + parent.Widget.par.Menuitemverticalpadding * 2
                flags:
                - viewer
                position: [300, -200]
                size: [130, 48]
              - name: checkOn
                type: overTOP
                parameters:
                  legacyxform: true
                  resolutionw: =op('check').par.resolutionh
                flags:
                - viewer
                position: [500, 75]
                size: [130, 49]
                inputs:
                - check
                - checkOff
              - name: subMenu
                type: textTOP
                parameters:
                  text: ='\uF40a'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Material Design Icons
                  antialias: aa8mid
                  fontsizex: =op('fontHelper').par.fontsizex * 1.5
                  fontcolorr: =parent.Widget.par.Menufontcolorr
                  fontcolorg: =parent.Widget.par.Menufontcolorg
                  fontcolorb: =parent.Widget.par.Menufontcolorb
                  bgcolorr: 0.35
                  bgcolorg: 0.35
                  bgcolorb: 0.35
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('check').par.resolutionh
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, 150]
                size: [130, 48]
              - name: checkOff
                type: rectangleTOP
                parameters:
                  sizex: =min(me.par.resolutionw, me.par.resolutionh) - 3
                  sizey: =me.par.sizex
                  sizeunit: pixels
                  fillalpha: 0
                  borderr: 0.71
                  borderg: 0.72
                  borderb: 0.72
                  borderwidth: 0.05
                  resolutionw: =op('check').par.resolutionh
                  resolutionh: =op('check').par.resolutionh
                flags:
                - viewer
                position: [500, 0]
                size: [130, 45]
              - name: colDefine
                type: evaluateDAT
                parameters:
                  rowindexend: =me.inputTable.numRows - 1
                  colindexend: =me.inputTable.numCols - 1
                position: [1000, 25]
                inputs:
                - colDefineBase
                - colDefineExpr
                dat_read_only: true
              - name: buttonRoll
                type: textTOP
                parameters:
                  text: XXWWWWWWW
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('master').par.font
                  fontsizex: =op('master').par.fontsizex
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menurollfontcolorr
                  fontcolorg: =parent.Widget.par.Menurollfontcolorg
                  fontcolorb: =parent.Widget.par.Menurollfontcolorb
                  fontalpha: =parent.Widget.par.Menurollfontcolora
                  bgcolorr: =parent.Widget.par.Menurollbgcolorr
                  bgcolorg: =parent.Widget.par.Menurollbgcolorg
                  bgcolorb: =parent.Widget.par.Menurollbgcolorb
                  bgalpha: =parent.Widget.par.Menurollbgcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: 100
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -300]
                size: [130, 48]
              - name: fontHelper
                type: textTOP
                parameters:
                  text: WX|gj
                  legacyfontselection: true
                  font: =parent.Widget.par.Font
                  fontsizex: =parent.Widget.par.Menufontsize
                flags:
                - viewer
                position: [100, -200]
                size: [130, 90]
                comment: Need this to calculate size to avoid recursion error
              - name: buttonPress
                type: textTOP
                parameters:
                  text: Show Grid
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =op('master').par.font
                  fontsizex: =op('master').par.fontsizex
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menuselectfontcolorr
                  fontcolorg: =parent.Widget.par.Menuselectfontcolorg
                  fontcolorb: =parent.Widget.par.Menuselectfontcolorb
                  fontalpha: =parent.Widget.par.Menuselectfontcolora
                  bgcolorr: =parent.Widget.par.Menuselectbgcolorr
                  bgcolorg: =parent.Widget.par.Menuselectbgcolorg
                  bgcolorb: =parent.Widget.par.Menuselectbgcolorb
                  bgalpha: =parent.Widget.par.Menuselectbgcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: 100
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -400]
                size: [130, 48]
              - name: dividerColor
                type: constantTOP
                parameters:
                  colorr: =parent.Widget.par.Menudividercolorr
                  colorg: =parent.Widget.par.Menudividercolorg
