          OPs:
            $t: ops_13
            Label: /PATCHDECK/CTRL/MIDI_MAPPING_REFERENCE/S4/label
            Numericvalue0: /PATCHDECK/CTRL/MIDI_MAPPING_REFERENCE/S4/numericValue0
