          position: [1150, -175]
          size: [130, 90]
          color: [0.67, 0.67, 0.67]
        - name: popto1
          type: poptoCHOP
          parameters:
            pop: linemetrics1
            thinoutrange: true
            thinrangelength: =op('lineresample1').par.resampledivs+1
            attribscope: DistStartNorm DistEndNorm
            rate: =me.time.rate
            autoexportroot: =parent()
          flags:
          - viewer
          position: [-475, -375]
