            bgcolorr: =parent(3).par.Backgroundcolorr
            bgcolorg: =parent(3).par.Backgroundcolorg
            bgcolorb: =parent(3).par.Backgroundcolorb
            bgalpha: 1
            borderar: 0.5
            borderag: 0.5
            borderab: 0.5
            borderover: false
            align: vertbt
            spacing: 1
            marginl: 3
            marginr: 3
            marginb: 3
            margint: 3
            justifyh: left
            justifyv: top
            clone: =op.TDBasicWidgets.op('sliderVert') if hasattr(op, 'TDBasicWidgets') else ''
          sequences:
            ext:
            - promote: true
          custom_pars:
            Values:
              $t: values_7
              Value0: ~me.op('../../control_ui').par.S1
              Valname0: =me.name
            Label:
