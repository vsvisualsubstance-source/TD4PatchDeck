            clampvl: false
            clampvh: false
            w: =parent.Widget.par.Knobwidth
            h: =parent.Widget.par.Knobheight
            hmode: =parent.Widget.par.Knobhorizontalmode
            hfillweight: =parent.Widget.par.Knobhfillweight
            vmode: =parent.Widget.par.Knobverticalmode
            vfillweight: =parent.Widget.par.Knobvfillweight
            alignorder: 1
            helpdat: =parent.Widget.op('code/help')
            uvbuttonsright: true
            bgcolorr: =parent.Widget.par.Knobbgcolorr
            bgcolorg: =parent.Widget.par.Knobbgcolorg
            bgcolorb: =parent.Widget.par.Knobbgcolorb
            bgalpha: =parent.Widget.par.Knobbgcolora
