      children:
      - name: status
        type: textCOMP
        parameters:
          text: =str(parent.Embody.DirtyCount()) + ' dirty' if parent.Embody.extensionsReady and parent.Embody.DirtyCount() else ''
          font: Open Sans
          fontsize: 9
          fontsizeunits: points
          fontcolorr: =parent.Embody.par.Textcolorr
          fontcolorg: =parent.Embody.par.Textcolorg
          fontcolorb: =parent.Embody.par.Textcolorb
          w: 80
          vmode: fill
          alignorder: -100
          display: false
          bgcolorr: =parent.Embody.par.Buttonbackgroundcolorr
          bgcolorg: =parent.Embody.par.Buttonbackgroundcolorg
          bgcolorb: =parent.Embody.par.Buttonbackgroundcolorb
          marginl: 3
        position: [800, -200]
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
      - name: disable
        type: textCOMP
        parameters:
          text: "\U000F0425"
          font: Material Design Icons
          fontsize: 11
          fontsizeunits: points
          fontcolorr: =parent.Embody.par.Textcolorr
          fontcolorg: =parent.Embody.par.Textcolorg
          fontcolorb: =parent.Embody.par.Textcolorb
          w: 36
          vmode: fill
          clickthrough: true
          bgcolorr: =(0.13 if parent.Embody.par.Status.eval() == 'Enabled' else parent.Embody.par.Buttonbackgroundcolorr.eval()) + (0.08 if me.fetch('hover', False) else 0)
          bgcolorg: =(0.22 if parent.Embody.par.Status.eval() == 'Enabled' else parent.Embody.par.Buttonbackgroundcolorg.eval()) + (0.08 if me.fetch('hover', False) else 0)
          bgcolorb: =(0.15 if parent.Embody.par.Status.eval() == 'Enabled' else parent.Embody.par.Buttonbackgroundcolorb.eval()) + (0.08 if me.fetch('hover', False) else 0)
          bgalpha: 1
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
      - name: perform
        type: textCOMP
        parameters:
          text: "\U000F04C5"
          font: Material Design Icons
          fontsize: 11
          fontsizeunits: points
          fontcolorr: =parent.Embody.par.Textcolorr
          fontcolorg: =parent.Embody.par.Textcolorg
          fontcolorb: =parent.Embody.par.Textcolorb
          w: 36
          vmode: fill
          alignorder: -50
          clickthrough: true
          bgcolorr: =(0.50 if parent.Embody.par.Performmode.eval() else parent.Embody.par.Buttonbackgroundcolorr.eval()) + (0.08 if me.fetch('hover', False) else 0)
          bgcolorg: =(0.25 if parent.Embody.par.Performmode.eval() else parent.Embody.par.Buttonbackgroundcolorg.eval()) + (0.08 if me.fetch('hover', False) else 0)
          bgcolorb: =(0.05 if parent.Embody.par.Performmode.eval() else parent.Embody.par.Buttonbackgroundcolorb.eval()) + (0.08 if me.fetch('hover', False) else 0)
          bgalpha: 1
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
