          - name: glsl1_pixel
            type: textDAT
            parameters:
              language: glsl
              extension: frag
            position: [1200, 1130]
            size: [130, 90]
            dock: glsl1
            dat_content: "uniform float u_delta_time, u_life_time;\n\nout vec4 fragColor;\nvoid main()\n{\n\tvec2 p = texture(sTD2DInputs[0], vUV.st).xy;\n\tvec2 vel = texture(sTD2DInputs[1], p).xy;\n\tfloat life = texture(sTD2DInputs[0],vUV.xy).a;\n\tvec2 init_p = texture(sTD2DInputs[2], vUV.xy).xy;\n\t\n\tlife += (1.0/u_life_time) * u_delta_time;\n\t\n\tif(life > 1.0)\n\t\t{\n\t\t\tlife = 0.0;\n\t\t\tp = init_p;\n\t\t}\n\t\n\t\n\tp += vel * 0.8;\n\tvec4 color = vec4(p, 0.0, life);\n\tfragColor = TDOutputSwizzle(color);\n}\n"
            dat_content_format: text
