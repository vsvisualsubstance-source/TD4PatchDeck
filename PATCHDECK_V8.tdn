              label: Font Fraction
              default: 1
            - name: Valuelabelscaletofit
              style: Menu
              label: Scale Text to Fit
              default: never
              menuNames:
              - never
              - always
              - onlyshrink
              menuLabels:
              - Never
              - Always
              - Only when Too Large
            - name: Valuelabelfontbold
              style: Toggle
              label: Font Bold
              default: true
            - name: Valuelabelitalic
              style: Toggle
              label: Italic
            - name: Valuelabeldropshadow
              style: Toggle
              label: Drop Shadow
            - name: Valuelabelalignx
              style: Menu
              label: Align Horizontal
              startSection: true
              default: center
              menuNames:
              - left
