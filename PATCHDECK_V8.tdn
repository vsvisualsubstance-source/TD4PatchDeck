          spacing: 1
          marginl: 3
          marginr: 3
          marginb: 3
          margint: 3
          justifyh: left
          justifyv: top
          clone: =op.TDBasicWidgets.op('sliderVert') if hasattr(op, 'TDBasicWidgets') else ''
        sequences:
          ext:
          - promote: true
        custom_pars:
          Values:
