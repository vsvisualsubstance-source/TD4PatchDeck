              style: RGBA
              label: Rollover Color
              default: 0.9
            - name: Rollovercomposite
              style: Menu
              label: Rollover Composite
              default: over
              menuNames:
              - over
              - under
              - inside
              - outside
              - add
              - subtract
              - multiply
