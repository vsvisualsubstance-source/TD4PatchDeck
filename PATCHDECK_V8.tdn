          size: [130, 90]
          color: [0.67, 0.67, 0.67]
        - name: selectexec
          type: chopexecuteDAT
          parameters:
            fromop: =parent()
            chop: select2
          flags:
          - viewer
          position: [-475, 25]
          size: [130, 90]
          dat_content: |
            # ------------------------------------------------
            # CHOP Execute DAT - Cambio tab UI
            # Collegato al select2 della UI
            # Aggiorna l'offset interno dell'extension
            # ------------------------------------------------

            _last_menu_index = -1  # memorizza ultimo tab selezionato

            def updateTabOffset():
                global _last_menu_index

                select2 = op('/PATCHDECK/UI/MAIN_INTERFACE/2_PATCHES/select2')
                if not select2:
                    print("[TAB] ❌ select2 non trovato")
                    return

                try:
                    menu_index = int(select2[0])
                except Exception as e:
                    print(f"[TAB] ❌ menuIndex non numerico: {select2[0]}")
                    return

                if menu_index == _last_menu_index:
                    return
                _last_menu_index = menu_index

                print(f"[TAB] MenuIndex={menu_index}")

                led_ctrl = op('/PATCHDECK/CTRL/led_controller').ext.PATCHDECKCTRLledcontroller1
                if led_ctrl:
                    led_ctrl.ui_offset = menu_index * 24  # ogni blocco UI = 24 patch
                    led_ctrl.refreshAll()
                    print(f"[LED] Tutti i LED aggiornati e sincronizzati per menu {menu_index}")

            def onValueChange(channel, sampleIndex, val, prev):
                updateTabOffset()

            # Init all'avvio
            if me.time.frame == 1:
                updateTabOffset()
                print("[CHOP EXEC TAB] ✅ Sistema tab UI pronto")
          dat_content_format: text
        - name: replicator1
          type: replicatorCOMP
          parameters:
            method: bynum
            numreplicants: 8
            opprefix: tab
            master: tab0
            destination: =parent()
            callbacks: replicator1_callbacks
            layout: horizontal
            layoutorigin1: =me.nodeX
            layoutorigin2: =me.nodeY - 200
          position: [50, -325]
        - name: replicator1_callbacks
          type: textDAT
          parameters:
            language: python
          flags:
          - viewer
          position: [-180, -485]
          size: [390, 130]
          dock: replicator1
          dat_content: "# me - this DAT\n# \n# comp - the replicator component which is cooking\n# allOps - a list of all replicants, created or existing\n# newOps - the subset that were just created\n# template - table DAT specifying the replicator attributes\n# master - the master operator\n#\n\ndef onRemoveReplicant(comp, replicant):\n\n\treplicant.destroy()\n\treturn\n\ndef onReplicate(comp, allOps, newOps, template, master):\n\n\tfor c in newOps:\n\t\t#c.display = True\n\t\t#c.render = True\n\t\t#c.par.display = 1\n\t\t#c.par.clone = comp.par.master\n\t\tpass\n\n\treturn\n"
          dat_content_format: text
      - name: AB_status
        type: tableDAT
