            - feedback1
          annotations:
          - name: annotate1
            mode: annotate
            title: Copyright
            text: The use of POP Fluid Solver tools is intended for your personal or professional creative projects, but must not be resold as-is (as .tox files, tool packs, templates, etc.). If you want to integrate these tools into a project or TouchDesigner file that will be sold to a client (installation, show pack, commercial template, client license, etc.), please contact me beforehand so we can agree on a proper license. Thanks for respecting this and supporting my work and future updates.
            position: [-2650, 150]
            size: [382, 288]
            color: [0.5, 0.05, 0.05]
        - name: POP_Fluid_Solver
          type: baseCOMP
          custom_pars:
            Custom:
            - name: Voxelgridinit
              style: OP
              label: Voxel Grid Init
              value: /PATCHDECK/PATCHES/X29/FluidPOP/Voxel_Grid_Init
            - name: Space10
              style: Header
              label: ' '
            - name: Keeptopology
              style: Toggle
              label: Keep Topology
              default: true
            - name: Space7
              style: Header
              label: ' '
            - name: Dt
              style: Float
              label: dt
              default: 0.01667
              value: =op('null3')['r4']
            - name: Space
              style: Header
              label: ' '
            - name: Viscosity
              style: Float
              default: 0.0001
              normMin: 1.0e-05
              normMax: 0.0005
              value: 0.000271
            - name: Space2
              style: Header
              label: ' '
            - name: Vcstrengthx
              style: XYZW
              label: VC Strength
              size: 1
              default: 0.05
              normMax: 0.5
              value: 0.072
            - name: Curlminx
              style: XYZW
              label: Curl Min
              size: 1
              default: 0.3
              value: 0.321
            - name: Curlmaxx
              style: XYZW
              label: Curl Max
              size: 1
              default: 0.5
              value: 0.523
            - name: Space3
              style: Header
              label: ' '
            - name: Buoyancysigma
              style: Float
              label: Buoyancy Sigma
              default: 1
              normMax: 5.0
              value: 4.64
            - name: Referencetemperature
              style: Float
              label: Reference Temperature
              normMin: -3.0
              normMax: 3.0
              value: =op('null3')['r1']
            - name: Buoyancydirection
              style: XYZW
              label: Buoyancy Direction
              size: 3
              values:
              - =op('null3')['r2']
              - =op('null3')['r3']
              - 1
            - name: Thermaldiffusivity
              style: Float
              label: Thermal Diffusivity
              default: 0.001
              normMin: 0.0001
              value: 0.506
            - name: Space4
              style: Header
              label: ' '
            - name: Particleslife
              style: Toggle
              label: Particles Life
              value: true
            - name: Pointidreuse
              style: Menu
              label: Point ID Reuse
              default: '1'
              menuNames:
              - '1'
              - '2'
              menuLabels:
              - Reuse Point IDs in Loop
              - Don't Reuse Point IDs
            - name: Maxpidvalue
              style: Int
              label: Max PID Value
              default: 10000000
              normMin: 1000000.0
              normMax: 16777200.0
            - name: Lifeseed
              style: Float
              label: Life seed
              default: 0.777
              value: 0.236
            - name: Maxages
              style: Float
              label: Max Age (s)
              default: 2
              normMin: 0.1
              normMax: 10.0
              value: 9.71
            - name: Space5
              style: Header
              label: ' '
