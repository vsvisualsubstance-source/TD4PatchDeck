              label: Padding
              size: 4
            - name: Labelbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: [0.2, 0.2, 0.2, 1]
              clampMin: true
              clampMax: true
            - name: Labelfontcolor
              style: RGBA
              label: Font Color
              default: [0.65, 0.65, 0.65, 1]
              clampMin: true
              clampMax: true
            - name: Labelhorizontalmode
