              startSection: true
              default: 0.1
              clampMin: true
              clampMax: true
            - name: Headerlabelfontcolor
              style: RGBA
              label: Font Color
              default: 0.6
              clampMin: true
              clampMax: true
            - name: Headerclickthrough
