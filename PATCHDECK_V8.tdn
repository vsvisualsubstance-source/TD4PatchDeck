                  text: ='\uF40a'
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: Material Design Icons
                  antialias: aa8mid
                  fontsizex: =op('fontHelper').par.fontsizex * 1.5
