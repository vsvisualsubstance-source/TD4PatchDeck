          align: verttb
          spacing: 1
          clone: =op.TDTox.op('defaultCOMPs/button')
        position: [0, -200]
        size: [160, 134]
        children:
        - name: desc
          type: textCOMP
          parameters:
            text: Write config at the top of the git repo.
            type: multiline
            wordwrap: true
            callbacks: desc_callbacks
            fontsize: 11
            fontcolorr: 0.62
            fontcolorg: 0.63
            fontcolorb: 0.62
            textoffsetx: 18
            alignx: left
            aligny: top
            h: 28
            hmode: fill
            alignorder: 1
            clickthrough: true
          size: [160, 130]
          color: [0.67, 0.67, 0.67]
        - name: out1
          type: outCHOP
          parameters:
            label: =me.name
            autoexportroot: =parent()
          flags:
          - viewer
          position: [275, 175]
          color: [0.67, 0.67, 0.67]
          inputs:
          - par1
        - name: par1
          type: parameterCHOP
          parameters:
            parameters: value0
            custom: false
