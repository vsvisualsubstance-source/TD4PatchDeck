                  Palettecomp: =parent(2)
                  Helpcommand: =ext.DocsHelper.HelpCommand
                  Mode: Wiki
                  Palettename: widgetsExtractor
                  Wikipage: Widgets
                  Experimental: =app.experimental
                About:
                  $t: about
                  Version: '1.3'
              position: [600, -200]
              size: [160, 130]
              comment: Clone master for wiki connection helper in palette comps
              palette_clone: true
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                active: =parent.Widget.par.Rightclickmenu
                fromop: =parent()
                panels: =[parent(2)] + parent(2).findChildren(type=PanelCOMP)
                panelvalue: rselect
                defaultreadencoding: cp1252
                language: input
              position: [200, -200]
              size: [130, 90]
              dat_content: "# me - this DAT\n# panelValue - the PanelValue object that changed\n# \n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\nTDF = op.TDModules.mod.TDFunctions\n\ndef onOffToOn(panelValue):\n\tif not panelValue.owner.panel.ctrl:\n\t\treturn\n\top.TDResources.op('popMenu').Open(\n\t\t\t\t\t\titems=['Parameters', 'Viewer', 'Network', 'Customize Component'],\n\t\t\t\t\t\tcallback=onPopMenu)\n\ndef onPopMenu(info):\n\tif info['item'] == 'Parameters':\n\t\tparent.Widget.openParameters()\n\telif info['item'] == 'Viewer':\n\t\tparent.Widget.openViewer()\n\telif info['item'] == 'Network':\n\t\tTDF.showInPane(parent.Widget)\n\telif info['item'] == 'Customize Component':\n\t\top.TDDialogs.op('CompEditor').EditComp(parent.Widget)\n\t\t\n\ndef whileOn(panelValue):\n\treturn\n\ndef onOnToOff(panelValue):\n\treturn\n\ndef whileOff(panelValue):\n\treturn\n\ndef onValueChange(panelValue):\n\treturn\n\t"
              dat_content_format: text
            - name: TDUpdateSystem
              type: containerCOMP
              parameters:
                resizecomp: =me
                topsmoothness: mipmap
                borderover: false
                clone: =op.TDUpdater.op('TDUpdateSystem')
              custom_pars:
                TD Update System:
                  $t: td_update_system
                  Updatesystem: =op.TDUpdater
                  Comptoupdate: =parent(2)
                Customizations:
                  $t: customizations
                  Invalidsourcemessage: Requires the basicWidgets package from palette>UI>Basic Widgets>Package in your project.
              flags:
              - viewer
              position: [400, -200]
              size: [160, 129]
              palette_clone: true
          - name: knob0
            type: sliderCOMP
            parameters:
              clampul: false
              clampuh: false
              clampvl: false
              clampvh: false
              w: =parent.Widget.par.Knobwidth
              h: =parent.Widget.par.Knobheight
              hmode: =parent.Widget.par.Knobhorizontalmode
              hfillweight: =parent.Widget.par.Knobhfillweight
              vmode: =parent.Widget.par.Knobverticalmode
              vfillweight: =parent.Widget.par.Knobvfillweight
              alignorder: 1
              helpdat: =parent.Widget.op('code/help')
              uvbuttonsright: true
              bgcolorr: =parent.Widget.par.Knobbgcolorr
              bgcolorg: =parent.Widget.par.Knobbgcolorg
              bgcolorb: =parent.Widget.par.Knobbgcolorb
              bgalpha: =parent.Widget.par.Knobbgcolora
              topfill: best
              borderar: 0
              borderag: 0
              borderab: 0
              borderaalpha: 0
              leftborder: bordera
              rightborder: bordera
              bottomborder: bordera
              topborder: bordera
              justifyh: center
              justifyv: center
              crop: 'off'
            sequences:
              ext:
              - object: op('./KnobExt').module.KnobExt(me)
                promote: true
            custom_pars:
              Knob:
                $t: knob_2
                Knoblabel: B
                Knobfontsize: 11
                Knobfontbold: true
                Knobsensitivity: 1
                Knobdialscale: 0.68
                Knoblevelscale: 0.773
                Knobrangescale: 0.863
                Knobrangegapangle: 0
                Knotchwidth: 0.563
                Knotchlength: 0.162
                Knobbgcolor: [0.15, 0.15, 0.15, 1]
                Knobfontcolor: [0.3, 0.3, 0.3, 1]
                Knobrangecolor: [0.325, 0.325, 0.325, 1]
                Knoblevelcolor: [0.48, 0.6825, 0.75, 1]
                Knobdialcolor: [0.5, 0.5, 0.5, 1]
                Knotchcolor: [0.1, 0.1, 0.1, 1]
                Knobrollovercolor: [0.6, 0.93333, 1, 0.25]
                Knobwidth: 110
                Knobverticalmode: fill
                Cacheabletop: =op('./knob0/bg')
            position: [350, -425]
            comp_inputs:
            - vertLayout
            children:
            - name: bg
              type: nullTOP
              flags:
              - viewer
              position: [1000, -400]
              size: [130, 90]
              inputs:
              - switch2
            - name: knob
              type: selectTOP
              parameters:
                top: =parent.Widget.par.Knobdialtop.eval() or ''
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: text
              type: textCOMP
              parameters:
                text: =parent.Widget.par.Knoblabel.eval()
                callbacks: text1_callbacks
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Knobfontbold.eval()
                italic: =parent.Widget.par.Knobitalic
                scaletofit: =parent.Widget.par.Knobscaletofit
                fontsize: =parent.Widget.par.Knobfontsize.eval() if parent.Widget.par.Knobfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Knobfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Knobfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Knobfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Knobfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Knobfontcolorb.eval()
                fontalpha: =parent.Widget.par.Knobfontcolora.eval()
                dropshadow: =parent.Widget.par.Knobdropshadow
                hmode: fill
                display: =parent.Widget.par.Knoblabeldisplay
                clickthrough: true
                borderover: false
              position: [200, 200]
            - name: info1
              type: infoDAT
              parameters:
                op: knobWidgetShader
                language: input
              flags:
              - viewer
              position: [400, -100]
              size: [130, 90]
              dat_read_only: true
            - name: knobBg
              type: selectTOP
              parameters:
                top: =parent.Widget.par.Knobbgtop.eval() or ''
              flags:
              - viewer
              position: [0, -400]
              size: [130, 90]
            - name: KnobExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass KnobExt(SubWidgetExt):\n\t\"\"\"\n\tKnobExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Knob'\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\t\tself.knobRotateRateScale = parent.Widget.par.Knobsensitivity.eval()\n\t\tself.lastv = None\n\t\tself.normMin = parent.Widget.par.Value0.normMin\n\t\tself.normMax = parent.Widget.par.Value0.normMax\n\t\t#debug(normMin, normMax)\n\t\tself.knobRotateRateScale = self.KnobRotateScale\n\t\tself.cVal = None\n\n\n\tdef UpdateAttributes(self):\n\t\t\"\"\"\n\t\tUpdates attributes after changes to widget parameter values\n\t\t\"\"\"\n\t\tself.knobRotateRateScale = parent.Widget.par.Knobsensitivity.eval()\n\t\tself.normMin = parent.Widget.par.Value0.normMin\n\t\tself.normMax = parent.Widget.par.Value0.normMax\n\t\tself.knobRotateRateScale = self.KnobRotateScale\n\n\t@property\n\tdef KnobRotateScale(self):\n\t\treturn float(op('knobRotateScale')[0,0].val)\n\t\t# return (parent.Widget.par.Knobsensitivity.eval()) * \\\n\t\t# \t\t\t\t\t\t\t\t\t(self.normMax-self.normMin) * \\\n\t\t# \t\t\t\t\t\t\t\t\t(parent.Widget.height/512)\n\n\tdef Select(self, panelValue):\n\t\t\"\"\"\n\t\tFirst click on knob sets offset location\n\t\t\"\"\"\n\t\tself.knobRotateRateScale = self.KnobRotateScale\n\t\tif panelValue.name == 'select':\n\t\t\tidNum = panelValue.owner.digits\n\t\t\tself.cVal = getattr(parent.Widget.par, 'Value'+ str(idNum)).eval()\n\t\t\tself.lastV = (panelValue.owner.panel.v.val*self.knobRotateRateScale)\n\n\tdef ValueChange(self, panelValue):\n\t\t\"\"\"\n\t\tManages value change using previous value and offset\n\t\t\"\"\"\n\t\tif panelValue.name == 'v':\n\t\t\tidNum = panelValue.owner.digits\n\t\t\t#lastV = me.fetch('lastv')\n\t\t\tnewV = panelValue.val*self.knobRotateRateScale\n\t\t\t#debug('newV', newV)\n\t\t\tincr = newV-self.lastV\n\t\t\t#debug('incr', incr)\n\t\t\t#widgetCValue = getattr(parent.Widget.par, 'Value'+ str(idNum)).eval()\n\t\t\t#widgetNValue = widgetCValue + incr\n\t\t\t\n\t\t\twidgetNValue = self.cVal + incr\n\t\t\t#parent.Widget.SetValue(widgetNValue, index = idNum)\n\t\t\tsetattr(parent.Widget.par, 'Value'+ str(idNum), widgetNValue)\n\t\t\t#debug('cValue', widgetCValue, incr)\n\t\t\tself.lastV = newV\n\t\t\tself.cVal = widgetNValue\n\t\t\t#debug(knobRotateRateScale )\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name[:5] in ['Defau',\n\t\t\t\t\t\t\t\t'Normm',\n\t\t\t\t\t\t\t\t'Clamp',\n\t\t\t\t\t\t\t\t'Minma'] \\\n\t\t\t\t\tor par.name == 'Knobsensitivity':\n\t\t\tself.UpdateAttributes()\n\t\telse:\n\t\t\tSubWidgetExt.onParSettingsChange(self, par, prev)\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tOn panel event\n\t\t\"\"\"\n\t\tif event == 'valueChange':\n\t\t\t#debug('vc', panelValue.name)\n\t\t\tparent().ValueChange(panelValue)\n\t\telif event == 'offToOn':\n\t\t\t#debug('oo', panelValue.name)\n\t\t\tparent().Select(panelValue)"
              dat_content_format: text
            - name: switch1
              type: switchTOP
              parameters:
                index: =parent.Widget.par.Cacheactive
              flags:
              - viewer
              position: [600, -300]
              size: [130, 90]
              inputs:
              - knobWidgetShader
              - cacheselect1
            - name: switch2
              type: switchTOP
              parameters:
                blend: =parent.Widget.par.Cacheoptimized
              flags:
              - viewer
              position: [800, -400]
              size: [130, 90]
              inputs:
              - switch1
              - cacheselect1
            - name: rollover
              type: containerCOMP
              parameters:
                layer: 7
                hmode: fill
                vmode: fill
                alignallow: ignore
                display: =(parent().panel.rollover or parent().panel.lselect or parent().panel.inside) * parent.Widget.par.Enablerollover.eval()
                clickthrough: true
                resizecomp: =me
                bgcolorr: =parent.Widget.par.Rollovercolorr.eval()
                bgcolorg: =parent.Widget.par.Rollovercolorg.eval()
                bgcolorb: =parent.Widget.par.Rollovercolorb.eval()
                bgalpha: =parent.Widget.par.Rollovercolora.eval()
                borderover: false
                composite: =parent.Widget.par.Rollovercomposite.eval()
              flags:
              - viewer
              position: [200, 400]
              size: [160, 130]
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-400, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n\n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: cacheselect1
              type: cacheselectTOP
              parameters:
                cachetop: =parent.Widget.par.Widgetcachecomp.eval().op('cache') if parent.Widget.par.Widgetcachecomp.eval() else ''
                index: =((parent.Widget.par.Value0.eval()-parent.Widget.par.Value0.normMin) * (0 - -parent.Widget.par.Widgetcachecomp.eval().par.Indexrange)) / (parent.Widget.par.Value0.normMax-parent.Widget.par.Value0.normMin) + -parent.Widget.par.Widgetcachecomp.eval().par.Indexrange if parent.Widget.par.Widgetcachecomp.eval() else 0
                resolutionw: =op('label').width
                resolutionh: =op('label').height
              flags:
              - viewer
              position: [200, -500]
              size: [130, 90]
            - name: glslKnobWidget
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [200, -100]
              size: [130, 90]
              dat_content: "//This shader creates a knob ui element\n\nuniform float rangeGapAngle;\nuniform vec3 indicatorAndDialInset; //\nuniform float knobRadius;\nuniform vec4 knobRangeColor;\nuniform vec4 knobLevelColor;\nuniform vec4 knobDialColor;\nuniform vec4 knobBgColor;\nuniform float knobNormValue;\nuniform float defaultValue;\nuniform int knobIndicatorDir;\nuniform float offset;\nuniform float offset2;\nuniform vec2 minMax;\nuniform float knobValue;\nuniform float knotchWidth;\nuniform vec4 knotchColor;\nuniform float knotchLength;\n\nuniform float rot;\n\nconst float PI = 3.141592653589793238462643383;\n\nuniform sampler2D sInputs0;\n\nlayout(location = 0) out vec4 fragColor;\n\n// functions\nmat2 rotate2d(float _angle){\n    return mat2(cos(_angle),-sin(_angle),\n                sin(_angle),cos(_angle));\n}\n\nfloat box(in vec2 _st, in vec2 _size){\n    _size = vec2(0.5) - _size*0.5;\n    vec2 uv = smoothstep(_size,\n                        _size+vec2(0.001),\n                        _st);\n    uv *= smoothstep(_size,\n                    _size+vec2(0.001),\n                    vec2(1.0)-_st);\n    return uv.x*uv.y;\n}\n\nfloat circle(in vec2 uv, in float radius) {\n    vec2 dist = uv-vec2(0.5);\n    //radius = 1.0;\n    return 1.0-smoothstep(radius-(radius*0.01 ),\n            radius+(radius*0.01), dot(dist,dist)*4.0);\n}\n\nfloat atan2(in float y, in float x) {\n    return x == 0.0 ? sign(y)*PI/2 : atan(y, x);\n}\n\nvec4 circle2(vec2 uv, vec2 pos, float rad, vec4 color) {\n  vec2 dist = uv-vec2(0.5);\n  float d1 = length(pos - uv) - rad;\n  float d2 = length(pos - uv) - rad+0;\n\tfloat t = clamp(d1, 0.0, 1.0);\n\n\treturn vec4(color.rgb, (1.0 - t)*color.a);\n}\n\nvec4 circle3(vec2 _st, float _radius, vec4 color){\n  vec2 dist = _st-vec2(0.5); //_st-vec2(0.5);\n  //_radius = 0.2;\n  //_radius = 1.0;\n  float circ = 1.-smoothstep(_radius-(_radius*0.015),\n                         _radius+(_radius*0.015),\n                         dot(dist,dist)*4.0);\n  return circ*color;\n}\n\nfloat aastep(float threshold, float value) {\n  float afwidth = 0.7 * length(vec2(dFdx(value), dFdy(value)));\n  return smoothstep(threshold-afwidth, threshold+afwidth, value);\n}\n\nvec4 over(vec4 tOver, vec4 tUnder)\n{\n    return ((1.0-tOver.a)*tUnder) + (tOver*tOver.a);\n}\n\nvec4 atop(vec4 tOver, vec4 tUnder)\n{\n    return ((1.0-tOver.a)*tUnder) + tOver.a * tOver;\n}\n\nfloat map(float s, float a1, float a2, float b1, float b2)\n{\n    return b1 + (s-a1)*(b2-b1)/(a2-a1);\n}\n\nvec2 rotateUV(float offset, vec2 uv)\n{\n    float rot = offset;\n    uv-=.5;\n    mat2 m = mat2(cos(rot), -sin(rot), sin(rot), cos(rot));\n    uv  = m * uv;\n\n    uv+=.5;\n    return uv;\n}\n\nvec2 cartPolar(vec2 p) {\n    return vec2(atan((p).y, (p).x), length(p));\n}\n\nvoid main() {\n\n\tvec2 fragCoord = gl_FragCoord.xy;\n\tvec2 res = uTDOutputInfo.res.zw;\n\tfloat fit = max(res.x-3, res.y-3)/2;\n\n    float rotInd = radians(map(knobValue, minMax.x,\n                            minMax.y, rangeGapAngle, 360-rangeGapAngle));\n    float rotMidPoint = radians(map(((minMax.x+minMax.y)/2), minMax.x,\n                            minMax.y, rangeGapAngle, 360-rangeGapAngle));\n    float rotDefault = radians(map(defaultValue, minMax.x, minMax.y,\n                                        rangeGapAngle, 360-rangeGapAngle));\n\n\n    vec2 xUV = rotateUV(rotMidPoint, vUV.st);\n    float zoneWipe = (atan2((xUV.s-0.5), xUV.t-0.5));\n\n    //maps atan2 output from 0-180 to continuous 0-360\n    if ( sign(zoneWipe)<0 ){\n        zoneWipe = map(zoneWipe, radians(-180), radians(0),\n                                            radians(180.), radians(360));\n    }\n\n    float rangeGap = radians(rangeGapAngle);\n    float range360 = radians(360);\n\n    float rangeZone = zoneWipe > rangeGap &&\n                        zoneWipe < (range360 - rangeGap)  ? 1.0 : 0.0;\n\n    float indZone = 0;\n    if ( knobValue < defaultValue ){\n        indZone = zoneWipe > rotInd && zoneWipe < rotDefault ? 1.0 : 0.0;\n    }\n    else if ( knobValue > defaultValue ){\n        indZone = zoneWipe
                < rotInd && zoneWipe > rotDefault ? 1.0 : 0.0;\n    }\n\n\n    vec2 iUV = rotateUV(-rotInd, vUV.st);\n    //vec4 textLayer = texture(sTD2DInputs[0], vUV.st);\n\tvec4 knobLayer = texture(sTD2DInputs[0], iUV);\n    vec4 bgLayer = texture(sTD2DInputs[1], vUV.st);\n\n    float knobDialScale = indicatorAndDialInset.x;\n    float knobRangeScale = indicatorAndDialInset.y;\n    float knobLevelScale = indicatorAndDialInset.z;\n\n    vec4 color = vec4(knobBgColor.rgb * knobBgColor.a, knobBgColor.a);\n    color = over(bgLayer, color);\n\n    //vec4 knobDial = circle2(fragCoord, res/2,\n    //                                    fit*(knobDialScale), knobDialColor);\n    //vec4 knobDial = circle3(fragCoord/res,\n    //                                    knobDialScale, knobDialColor);\n\n    vec4 knobDial = circle2(fragCoord, res/2,\n                              (fit*knobDialScale), knobDialColor);\n\n    //vec4 knobDialCut = circle3(fragCoord/res,\n    //                         knobDialScale-0.02, knobDialColor);\n\n    vec4 knobDialCut = circle2(fragCoord, res/2,\n                            (fit*knobDialScale-1), knobDialColor);\n\n    vec4 knobRange = circle2(fragCoord, res/2,\n                                        (fit*knobRangeScale), knobRangeColor);\n    knobRange = (knobRange * rangeZone) * floor(1-knobDialCut.a);\n\n    vec4 knobLevel = circle2(fragCoord, res/2,\n                                        fit*knobLevelScale, vec4(1.0,1.0,1.0,1.0))*floor(1-knobDialCut.a);\n    vec4 knotchLayer = circle2(fragCoord, res/2,\n                                        fit*knobDialScale, knotchColor);\n    vec4 knotchMask = circle2(fragCoord, res/2,\n                                    fit*knobDialScale-knotchLength, vec4(1.0));\n    //knotchLayer = knotchLayer * knotchZone;\n    float knotchScaler = (1-knotchLength)*(knobDialScale/2);\n    float knotchVal = box(vec2(iUV.x,iUV.y+(knobLevelScale/4)+knotchScaler),\n                                vec2(knotchWidth/20,knobLevelScale/2));\n    vec4 knotch = knotchColor*knotchVal*knobLevel.a;\n\n    knobLevel = knobLevel * indZone;\n    color = atop(knobRange, color);\n    color = atop(knobLevel*knobLevelColor, color);\n    color = atop(knobDial, color);\n    color = atop(knobLayer, color);\n    color = atop(knotch, color);\n    //color = over(textLayer, color);\n\n    //color = over(knotchLayer*(1-knotchMask), color);\n\tfragColor = color;\n\t//fragColor = ind;\n\n}\n"
              dat_content_format: text
            - name: knobRotateScale
              type: evaluateDAT
              parameters:
                expr: parent.Widget.par.Knobsensitivity.eval() * (parent.Widget.par.Value0.normMax-parent.Widget.par.Value0.normMin) * (parent.Widget.height/512)
                rowindexend: =me.inputTable.numRows - 1
                colindexend: =me.inputTable.numCols - 1
              position: [0, 400]
              dat_read_only: true
            - name: panelExecOPExec
              type: opexecuteDAT
              parameters:
                op: =ext.SubWidgetExt.PanelExecPar.eval()
              flags:
              - viewer
              position: [-200, 100]
              color: [0.05, 0.5, 0.05]
              dat_content: "def onOPdelete():\n\text.SubWidgetExt.PanelExecPar.val = ''\n\text.SubWidgetExt.PanelExecPar.enable = False\t"
              dat_content_format: text
            - name: panelexecValueX
              type: panelexecuteDAT
              parameters:
                fromop: =me.parent()
                panels: =parent()
                panelvalue: ='select ' + 'v'
                valuechange: true
                defaultreadencoding: cp1252
                language: input
              position: [-200, 0]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "def offToOn(panelValue):\n\text.SubWidgetExt.onPanelEvent('offToOn', panelValue)\n\ndef onToOff(panelValue):\n\text.SubWidgetExt.onPanelEvent('onToOff', panelValue)\n\ndef valueChange(panelValue):\n\text.SubWidgetExt.onPanelEvent('valueChange', panelValue)\n"
              dat_content_format: text
            - name: text1_callbacks
              type: textDAT
              parameters:
                language: input
              flags:
              - viewer
              - -showDocked
              position: [200, 50]
              size: [160, 130]
              dock: text
              dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
              dat_content_format: text
            - name: knobWidgetShader
              type: glslTOP
              parameters:
                pixeldat: glslKnobWidget
                autodispatchsize: false
                dispatchsizey: 1
                clearoutputs: false
                outputresolution: custom
                resolutionw: =parent().height
                resolutionh: =parent().height
                format: rgba8fixed
              sequences:
                vec:
                - name: indicatorAndDialInset
                  valuex: =parent.Widget.par.Knobdialscale.eval()
                  valuey: =parent.Widget.par.Knobrangescale.eval()
                  valuez: =parent.Widget.par.Knoblevelscale.eval()
                - name: minMax
                  valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).normMin
                  valuey: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).normMax
                - name: rangeGapAngle
                  valuex: =parent.Widget.par.Knobrangegapangle.eval()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knobRangeColor
                  valuex: =parent.Widget.par.Knobrangecolorr.eval()
                  valuey: =parent.Widget.par.Knobrangecolorg.eval()
                  valuez: =parent.Widget.par.Knobrangecolorb.eval()
                  valuew: =parent.Widget.par.Knobrangecolora.eval()
                - name: knobLevelColor
                  valuex: =parent.Widget.par.Knoblevelcolorr.eval()
                  valuey: =parent.Widget.par.Knoblevelcolorg.eval()
                  valuez: =parent.Widget.par.Knoblevelcolorb.eval()
                  valuew: =parent.Widget.par.Knoblevelcolora.eval()
                - name: knobDialColor
                  valuex: =parent.Widget.par.Knobdialcolorr.eval()
                  valuey: =parent.Widget.par.Knobdialcolorg.eval()
                  valuez: =parent.Widget.par.Knobdialcolorb.eval()
                  valuew: =parent.Widget.par.Knobdialcolora.eval()
                - name: knobBgColor
                  valuex: 0
                - name: knobIndicatorDir
                  valuex: 1
                - name: knotchWidth
                  valuex: =parent.Widget.par.Knotchwidth.eval()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knotchLength
                  valuex: =parent.Widget.par.Knotchlength.eval()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knobNormValue
                  valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).evalNorm()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: defaultValue
                  valuex: =getattr(parent.Widget.par, 'Value'+ str(parent().digits)).default
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knobBaseColor
                  valuex: 0
                  valuew: 1
                - name: offset
                  valuex: 0
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: offset2
                  valuex: 0
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knobValue
                  valuex: =parent.Widget.par.Value0.eval()
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: knotchColor
                  valuex: =parent.Widget.par.Knotchcolorr.eval()
                  valuey: =parent.Widget.par.Knotchcolorg.eval()
                  valuez: =parent.Widget.par.Knotchcolorb.eval()
                  valuew: =parent.Widget.par.Knotchcolora.eval()
              flags:
              - render
              - viewer
              position: [200, -300]
              size: [130, 90]
              inputs:
              - knob
              - knobBg
            - name: parexecSettingsX
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: '=parent.Widget '
                pars: Knobcustomizeinteraction Default0 Norm* Clamp* Min* Knobsensitivity Knobhoriz* Knobvert*
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-200, 200]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              comment: Execution for parameter changes
              dat_content: "def valueChange(par, val, prev):\n\text.SubWidgetExt.onParSettingsChange(par, prev)\n\ndef onPulse(par):\n\text.SubWidgetExt.onParSettingsPulse(par)\n\n"
              dat_content_format: text
          - name: label
            type: containerCOMP
            parameters:
              w: =parent().par.Labelwidth
              h: =parent().par.Labelheight
              layer: 1
              hmode: =parent.Widget.par.Labelhorizontalmode
              hfillweight: =parent.Widget.par.Labelhfillweight
              vmode: =parent.Widget.par.Labelverticalmode
              vfillweight: =parent.Widget.par.Labelvfillweight
              display: =parent.Widget.par.Labeldisplay
              helpdat: =parent.Widget.op('code/help')
              clickthrough: =parent.Widget.par.clickthrough
              uvbuttonsleft: false
              resizecomp: =me
              bgcolorr: =parent.Widget.par.Labelbgcolorr
              bgcolorg: =parent.Widget.par.Labelbgcolorg
              bgcolorb: =parent.Widget.par.Labelbgcolorb
              bgalpha: =parent.Widget.par.Labelbgcolora
              borderover: false
              enablecloning: false
            custom_pars:
              Label:
                $t: label_6
                Widgetlabel: Knob Endless
                Labelfontsize: 9
                Labelalignx: left
                Labelaligny: top
                Labeloffset: [6, 0]
                Labelbgcolor: [0.2, 0.2, 0.2, 1]
                Labelfontcolor: [0.65, 0.65, 0.65, 1]
                Labelwidth: 120
                Labelhfillweight: 0.5
                Labelverticalmode: fill
                Labelheight: 34
            flags:
            - viewer
            position: [200, -200]
            size: [160, 130]
            color: [0.5, 0.35, 0.05]
            tags:
            - TDPub
            - TDSubComp
            children:
            - name: text
              type: textCOMP
              parameters:
                text: =parent.Widget.par.Widgetlabel.eval()
                type: multiline
                wordwrap: =parent.Widget.par.Labelwordwrap.eval()
                callbacks: text1_callbacks
                font: =parent.Widget.par.Font.eval()
                fontfile: =parent.Widget.par.Fontfile
                bold: =parent.Widget.par.Labelfontbold.eval()
                italic: =parent.Widget.par.Labelitalic
                scaletofit: =parent.Widget.par.Labelfontsizemode
                fontsize: =parent.Widget.par.Labelfontsize.eval() if parent.Widget.par.Labelfontsizemode.eval() in ['points', 'panelunits'] else parent.Widget.par.Labelfontfraction.eval()
                fontsizeunits: =parent.Widget.par.Labelfontsizemode.eval()
                fontcolorr: =parent.Widget.par.Labelfontcolorr.eval()
                fontcolorg: =parent.Widget.par.Labelfontcolorg.eval()
                fontcolorb: =parent.Widget.par.Labelfontcolorb.eval()
                fontalpha: =parent.Widget.par.Labelfontcolora.eval()
                dropshadow: =parent.Widget.par.Labeldropshadow
                textoffsetx: =parent.Widget.par.Labeloffsetx.eval()
                textoffsety: =parent.Widget.par.Labeloffsety.eval()
                textpaddingl: =parent.Widget.par.Labelpadding1.eval()
                textpaddingr: =parent.Widget.par.Labelpadding2.eval()
                textpaddingb: =parent.Widget.par.Labelpadding3.eval()
                textpaddingt: =parent.Widget.par.Labelpadding4.eval()
                alignx: =parent.Widget.par.Labelalignx.eval()
                aligny: =parent.Widget.par.Labelaligny.eval()
                hmode: fill
                bottomanchor: 0.039
                helpdat: =parent.Widget.op('code/help')
                clickthrough: =parent.Widget.par.clickthrough
                top: =parent.Widget.par.Labeltop.eval()
                borderover: false
              position: [0, -200]
            - name: parexecRunCommand
              type: parameterexecuteDAT
              parameters:
                fromop: =me.parent()
                op: =parent.Widget
                pars: Labelhorizontalmode Labelverticalmode
                onpulse: false
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              size: [130, 90]
              dat_content: "# me - this DAT\n# par - the Par object that has changed\n# val - the current value\n# prev - the previous value\n#\n# Make sure the corresponding toggle is enabled in the Parameter Execute DAT.\n\ndef valueChange(par, val, prev):\n\tif par.name == 'Labelhorizontalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Labelhfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Labelwidth, 'enable', bool(1-val))\n\telif par.name == 'Labelverticalmode':\n\t\t#if par.eval() == 'fill':\n\t\tval = True if val == 'fill' else False\n\t\tsetattr(parent.Widget.par.Labelvfillweight, 'enable', val)\n\t\tsetattr(parent.Widget.par.Labelheight, 'enable', bool(1-val))\n\treturn\n\ndef onPulse(par):\n\treturn\n\ndef expressionChange(par, val, prev):\n\treturn\n\ndef exportChange(par, val, prev):\n\treturn\n\ndef enableChange(par, val, prev):\n\treturn\n\ndef modeChange(par, val, prev):\n\treturn\n"
              dat_content_format: text
          - name: output
            type: baseCOMP
            parameters:
              enablecloning: false
            custom_pars:
              Widget:
                $t: widget_13
            flags:
            - viewer
            position: [200, 0]
            size: [160, 130]
            color: [0.5, 0.2, 0.05]
            tags:
            - TDSubComp
            children:
            - name: dat
              type: outDAT
              parameters:
                label: =me.name
              flags:
              - viewer
              position: [400, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              inputs:
              - datValues
              dat_read_only: true
            - name: chop
              type: outCHOP
              parameters:
                label: =me.name
                autoexportroot: =me.parent()
              flags:
              - viewer
              position: [200, -300]
              color: [0.05, 0.5, 0.05]
              inputs:
              - Value0
            - name: Value0
              type: parameterCHOP
              parameters:
                ops: ../..
                parameters: Value0 Value1 Value2 Value3
                renamefrom: Value0 Value1 Value2 Value3
                renameto: =[getattr(parent.Widget.par, 'Valname0', ''), getattr(parent.Widget.par, 'Valname1', ''), getattr(parent.Widget.par, 'Valname2', ''), getattr(parent.Widget.par, 'Valname3', '')]
                autoexportroot: =parent()
              flags:
              - viewer
              position: [0, -300]
              size: [130, 90]
            - name: datValues
              type: evaluateDAT
              parameters:
                expr: getattr(parent.Widget.par, ['Valname', 'Value'][me.inputCell.col] + str(me.inputCell.row))
                rowindexend: =me.inputs[0].numRows - 1
                colindexend: =me.inputs[0].numCols - 1
              position: [200, -600]
              color: [0.5, 0.05, 0.5]
              inputs:
              - numValues
              dat_read_only: true
            - name: numValues
              type: tableDAT
              parameters:
                defaultreadencoding: cp1252
                fill: setsize
                rows: =len(parent.Widget.pars('Valname*'))
                cols: 2
              flags:
              - viewer
              position: [0, -600]
              size: [130, 90]
              color: [0.5, 0.05, 0.5]
              dat_content:
              - - ''
                - ''
              dat_content_format: table
            - name: valuesParexec
              type: parameterexecuteDAT
              parameters:
                fromop: =parent()
                op: =parent.Widget
                pars: =['Createeditvalueparexec'] + ['Value' + str(i) for i in range(4) if any([getattr(parent.Widget.par, parName, None) for parName in ['Onvaluechangescript' + str(i), 'Ontooffscript' + str(i), 'Offtoonscript' + str(i)]])]
                builtin: false
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [0, -775]
              size: [130, 90]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onValueChange(par, prev):\n\tparNum = par.name[-1]\n\tfor name in ['Onvaluechangescript', 'Ontooffscript', 'Offtoonscript']:\n\t\ttry:\n\t\t\tp = getattr(parent.Widget.par, name + parNum)\n\t\texcept:\n\t\t\treturn\n\t\tif p:\n\t\t\tif p.name.startswith('Onv'):\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Ont') and prev and not par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\t\t\telif p.name.startswith('Off') and not prev and par.eval():\n\t\t\t\trun(p, fromOP = parent.Widget, asParameter=True)\n\ndef onPulse(par):\n\tif not parent.Widget.par.Valueparexec.eval():\n\t\tparexec = parent.Widget.parent().create(parameterexecuteDAT, 'valueParExec')\n\t\tparexec.nodeY = parent.Widget.nodeY\n\t\tparexec.nodeX = parent.Widget.nodeX - 200\n\t\tparexec.dock = parent.Widget\n\t\tparexec.par.op.expr = 'me.dock'\n\t\tparexec.par.pars = 'Value?'\n\t\tparexec.par.builtin = False\n\t\tparent.Widget.par.Valueparexec = parexec.name\n\t\tparent.Widget.par.Valueparexec.enable = True\n\t\tparent.Widget.par.Valueparexec.readOnly = True\n\t\top('valueParOPExec').cook(force=True)\n\tparent.Widget.par.Valueparexec.eval().par.edit.pulse()"
              dat_content_format: text
            - name: valueParOPExec
              type: opexecuteDAT
              parameters:
                op: =parent.Widget.par.Valueparexec.eval() if parent.Widget.par.Valueparexec.eval() else ''
              flags:
              - viewer
              position: [200, -775]
              color: [0.75, 0.75, 0.75]
              dat_content: "def onOPdelete():\n\tparent.Widget.par.Valueparexec = ''\n\tparent.Widget.par.Valueparexec.enable = False\t"
              dat_content_format: text
          - name: overlay
            type: containerCOMP
