          size: [93, 155]
          color: [0.5, 0.2, 0.05]
          tags:
          - TDSubComp
        - name: valueOut
          type: outCHOP
          parameters:
            label: =me.name
            autoexportroot: =parent()
          position: [400, 0]
          inputs:
          - output
      - name: B14
        type: widgetCOMP
        parameters:
          x: 3
          y: 3
          w: 100
          h: 50
          hmode: fill
          vmode: fill
          enable: =me.par.Value0.bindMaster.enable if hasattr(me.par, 'Value0') and me.par.Value0.bindMaster and isinstance(me.par.Value0.bindMaster, Par) else True
          bgcolorr: 0.2
          bgcolorg: 0.2
          bgcolorb: 0.2
          bgalpha: 1
          borderar: 0
          borderag: 0
          borderab: 0
          borderaalpha: 0
          borderover: false
          align: horizlr
          spacing: 1
          marginl: 3
          marginr: 3
          marginb: 3
          margint: 3
          justifyh: left
          justifyv: top
          clone: =op.TDBasicWidgets.op('buttonMomentary') if hasattr(op, 'TDBasicWidgets') else ''
        sequences:
          ext:
          - promote: true
        custom_pars:
          Values:
            $t: values_17
            Value0: ~op('control_ui').par.B14
            Valname0: =me.name
          Label:
            $t: label_7
            Labeldisplay: false
            Labelalignx: center
          Button:
            $t: button_2
            Buttonofflabel: =me.name
            Buttononlabel: =me.name
            Buttonfont: Open Sans
            Buttonfontsizemode: fract
            Buttonfontsize: 50
            Buttonfontfraction: 0.4
            Buttonscaletofit: onlyshrink
            Buttonofffacecolor: [0.3, 0.3, 0.3, 1]
            Buttonofffontcolor: [0.8, 0.2, 0.2, 1]
            Buttononfontcolor: [0.8, 0.2, 0.2, 1]
            Buttonborder: true
