          parameters:
            w: =parent.Widget.par.Numericfieldwidth
            h: =parent.Widget.par.Numericfieldheight
            hmode: =parent.Widget.par.Numericfieldhorizontalmode
            hfillweight: =parent.Widget.par.Numericfieldhfillweight
            vmode: =parent.Widget.par.Numericfieldverticalmode
