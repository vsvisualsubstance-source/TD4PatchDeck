                  fontcolorg: =parent.Widget.par.Menubuttononfontcolorg if int(op('../menuStatus')['openButton']) == parent().digits else (parent.Widget.par.Menudisablefontcolorg if not parent().par.enable else parent.Widget.par.Menubuttonfontcolorg)
                  fontcolorb: =parent.Widget.par.Menubuttononfontcolorb if int(op('../menuStatus')['openButton']) == parent().digits else (parent.Widget.par.Menudisablefontcolorb if not parent().par.enable else parent.Widget.par.Menubuttonfontcolorb)
                  fontalpha: =parent.Widget.par.Menubuttononfontcolora if int(op('../menuStatus')['openButton']) == parent().digits else (parent.Widget.par.Menudisablefontcolora if not parent().par.enable else parent.Widget.par.Menubuttonfontcolora)
                  w: 28
                  h: 28
                  hmode: fill
                  clickthrough: true
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  borderover: false
                position: [0, -200]
              - name: rollover
                type: containerCOMP
                parameters:
