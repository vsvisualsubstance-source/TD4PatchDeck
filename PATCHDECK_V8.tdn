          custom_pars:
            Values:
            - name: Value0
              style: Int
              label: Value 0
              value: 1
            - name: Value1
              style: Int
              label: Value 1
              value: 1
            - name: Value2
              style: Int
              label: Value 2
              value: 1
            - name: Valname0
