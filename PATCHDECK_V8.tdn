            - name: Labelbgcolor
              style: RGBA
              label: Bg Color
              startSection: true
              default: [0.2, 0.2, 0.2, 1]
              clampMin: true
              clampMax: true
            - name: Labelfontcolor
              style: RGBA
              label: Font Color
              default: [0.65, 0.65, 0.65, 1]
              clampMin: true
              clampMax: true
            - name: Labelhorizontalmode
              style: Menu
              label: Horizontal Mode
              startSection: true
              default: fixed
              menuNames:
              - fixed
              - fill
              menuLabels:
              - Fixed Width
              - Fill
            - name: Labelwidth
              style: Int
              label: Width
              default: 120
              min: 1.0
              max: 300.0
