          dat_content: "def onFrameStart(frame):\n\n\n\n\tif parent(2).digits == op('/PATCHDECK/UI/MAIN_INTERFACE/MIDI_status')[1,0]:\t\t\t\t\t\n\t\top('index')[0,0] = 1\n\n\telse:\n\t\top('index')[0,0] = 0\n\t\t\n\tif parent(2).digits == op('/PATCHDECK/UI/MAIN_INTERFACE/MIDI_status')[1,1]:\t\t\t\t\t\n\t\top('index')[0,0] = 2\n\t\n\t\n\treturn\n\n"
          dat_content_format: text
