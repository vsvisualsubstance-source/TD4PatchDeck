              normal: none
            position: [-2650, -25]
          - name: attribute1
            type: attributePOP
            parameters:
              deletepoint: BndN Div Flag ForcesIn Press Press_tmp Temp Temp_tmp U U_tmp ijk
            position: [-1750, -25]
            size: [130, 90]
            inputs:
            - attrib_select
          - name: attribute5
            type: attributePOP
