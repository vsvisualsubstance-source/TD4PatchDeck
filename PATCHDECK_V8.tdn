          - name: sndviz
            type: selectTOP
            parameters:
              top: =op.Sndviz.op('point_cloud/out1')
              outputresolution: custom
              resolutionw: 1920
              resolutionh: 1080
              fillmode: useinput
              filtertype: useinput
            flags:
            - viewer
            size: [130, 105]
          - name: rgbkey1
            type: rgbkeyTOP
            flags:
            - viewer
            position: [1100, 275]
            size: [130, 90]
            color: [0.67, 0.67, 0.67]
            inputs:
            - glslmulti1
          - name: analyze1
            type: analyzeTOP
            parameters:
              scope: columns
              inputfiltertype: nearest
              filtertype: nearest
            position: [500, 200]
            size: [130, 48]
            inputs:
            - flip1
          - name: constant2
            type: constantTOP
            parameters:
              alpha: 0
              operand: over
            flags:
            - viewer
            position: [300, 0]
            size: [130, 105]
          - name: feedback1
            type: feedbackTOP
            parameters:
              top: analyze1
            flags:
            - viewer
            position: [500, 0]
            size: [130, 48]
            inputs:
            - constant2
          - name: glslmulti1
            type: glslmultiTOP
            parameters:
              pixeldat: glslmulti1_pixel
              computedat: glslmulti1_compute
              numcolorbufs: 2
              outputresolution: custom
              resolutionw: 1920
              resolutionh: 1080
              filtertype: nearest
            sequences:
              vec:
              - name: uRes
                valuex: =me.par.resolutionw
                valuey: =me.par.resolutionh
            flags:
            - render
            - viewer
            position: [800, 200]
            size: [130, 67]
            inputs:
            - analyze1
            - feedback1
          - name: glslmulti1_info
            type: infoDAT
            parameters:
              op: glslmulti1
              language: input
            flags:
            - viewer
            position: [950, 75]
            size: [130, 90]
            dock: glslmulti1
            dat_read_only: true
          - name: glslmulti1_pixel
            type: textDAT
            parameters:
              defaultreadencoding: cp1252
              language: glsl
              extension: glsl
            flags:
            - viewer
            position: [800, 75]
            size: [130, 90]
            dock: glslmulti1
            dat_content: "uniform vec2 uRes;\n\nout vec4 fragColor;\nvoid main()\n{\n\t//vec2 onePixel = vec2(1.0, 1.0) / uRes;\n\n\tvec2 cUV = vec2(vUV.s, vUV.t);\n\tvec4 color = texture(sTD2DInputs[0], cUV);\n\n\tvec2 fUV = vec2(vUV.s, vUV.t * (vUV.t / (0.1 * (color.r + color.g + color.b))));\n\tvec4 feedback = texture(sTD2DInputs[1], fUV);\n\tvec4 feedbackFull = texture(sTD2DInputs[1], vUV.st);\n\n\tvec4 matte = feedback / color;\n\tvec4 comp = vec4(matte.a) * (color + feedbackFull);\n\n\tcomp.a = matte.a;\n\n\tfragColor = TDOutputSwizzle(comp);\n}"
            dat_content_format: text
          - name: glslmulti1_compute
            type: textDAT
            parameters:
              defaultreadencoding: cp1252
              language: glsl
              extension: glsl
            flags:
            - viewer
            - -showDocked
            position: [1100, 75]
            size: [130, 90]
            dock: glslmulti1
            dat_content: "// Example Compute Shader\n\n// uniform float exampleUniform;\n\nlayout (local_size_x = 8, local_size_y = 8) in;\nvoid main()\n{\n\tvec4 color;\n\tcolor = texelFetch(sTD2DInputs[0], ivec2(gl_GlobalInvocationID.xy), 0);\n\timageStore(mTDComputeOutputs[0], ivec2(gl_GlobalInvocationID.xy), TDOutputSwizzle(color));\n}\n"
            dat_content_format: text
