              display: false
              resizecomp: =me
              topsmoothness: mipmap
              borderover: false
              parentshortcut: DocsHelper
              clone: =op.TDResources.op('docsHelper')
              reloadbuiltin: true
              relpath: inherit
            sequences:
              ext:
              - object: op('./DocsHelper').module.DocsHelper(me)
                promote: true
            custom_pars:
              Docs Helper:
