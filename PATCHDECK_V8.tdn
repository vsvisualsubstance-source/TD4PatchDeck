                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: eval2
              type: evaluateDAT
              parameters:
                rowindexend: =me.inputTable.numRows - 1
                colindexend: =me.inputTable.numCols - 1
              position: [-200, 400]
              inputs:
              - insert1
              - indexer
              dat_read_only: true
            - name: noNone
              type: selectDAT
              parameters:
                extractrows: =6 if parent.Widget.par.Foldernonenotab else 0
                rowindexend: =me.inputTable.numRows - 1
                rowexpr: =me.inputCell.val != 'None'
                colindexend: =me.inputTable.numCols - 1
              flags:
              - viewer
              position: [-50, 400]
              size: [130, 90]
              inputs:
              - eval2
              dat_read_only: true
            - name: indexer
              type: tableDAT
              parameters:
                rows: 2
                cols: 3
              flags:
              - viewer
              position: [-400, 300]
              size: [130, 90]
              dat_content:
              - - ''
                - ''
                - '''index'''
              - - ''
                - ''
                - me.inputRow - 1
              dat_content_format: table
            - name: insert1
              type: insertDAT
              parameters:
                insert: col
                at: end
              position: [-400, 400]
              inputs:
              - rawMenuOptions
              dat_read_only: true
            - name: FolderExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-1100, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "SubWidgetExt = mod.SubWidgetExt.SubWidgetExt\nTDF = op.TDModules.mod.TDFunctions\n\nclass FolderExt(SubWidgetExt):\n\t\"\"\"\n\tFolderExt description\n\t\"\"\"\n\tdef __init__(self, ownerComp):\n\t\t# The component to which this extension is attached\n\t\tself.parPrefix = 'Folder'\n\t\tself.baseTab = ownerComp.op('replicator1').par.master.eval()\n\t\tself.baseText = self.baseTab.op('on')\n\t\tself.menuOptions = ownerComp.op('menuOptions')\n\t\tSubWidgetExt.__init__(self, ownerComp)\n\t\tTDF.createProperty(self, 'TabWidths', [])\n\t\tTDF.createProperty(self, 'MinTextWidths', [], dependable='deep')\n\t\tTDF.createProperty(self, 'VisibleTabs', [], dependable='deep')\n\t\tTDF.createProperty(self, 'HiddenTabInfo', [], dependable='deep')\n\t\tself.lastTab = None # last tab on left when hidden tabs\n\t\tself.lastSelectedTab = None # previously selected tab\n\t\trun('args[0].CalculateSizes()', self, delayFrames=1, delayRef=op.TDResources)\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tif panelValue.owner.name == 'buttonTabDropDown':\n\t\t\t\tpopMenu = parent.Widget.par.Folderpopmenu.eval()\n\t\t\t\tpopMenu.par.Buttoncomp = panelValue.owner\n\t\t\t\tpopMenu.par.Horizontalalign = 'Left'\n\t\t\t\tpopMenu.par.Verticalalign = 'Top'\n\t\t\t\tpopMenu.Open(items=[h for h in self.Labels], \n\t\t\t\t\t\t\thighlightedItems=[self.Labels[self.SelectedTab]]\\\n\t\t\t\t\t\t\t\t\tif self.SelectedTab is not None else [],\n\t\t\t\t\t\t\tcallback=self.onDropDown)\n\t\t\telif panelValue.owner.name == 'buttonTabsLeft':\n\t\t\t\tself.CalculateSizes(-1)\n\t\t\telif panelValue.owner.name == 'buttonTabsRight':\n\t\t\t\tself.CalculateSizes(1)\n\t\t\telif panelValue.owner.name == 'buttonAddTab':\n\t\t\t\tif parent.Widget.par.Folderaddscript:\n\t\t\t\t\texec(parent.Widget.par.Folderaddscript.eval())\n\t\t\t\telse:\n\t\t\t\t\traise Exception('Missing Add Script')\n\t\t\telse:\n\t\t\t\t# tab click\n\t\t\t\tif parent.Widget.par.Value0.menuIndex \\\n\t\t\t\t\t\t\t\t\t\t\t\t== panelValue.owner.par.Index:\n\t\t\t\t\treturn\n\t\t\t\tselectedTab = self.SelectedTab\n\t\t\t\tif selectedTab is not None and \\\n\t\t\t\t\t\t\t\t\tpanelValue.owner.par.Index > selectedTab:\n\t\t\t\t\tself.lastSelectedTab = selectedTab\n\t\t\t\tparent.Widget.par.Value0.menuIndex = panelValue.owner.par.Index\n\t\t\t\tif parent.Widget.par.Folderselectedtabfullsize:\n\t\t\t\t\tself.CalculateSizes()\n\t\t\n\tdef onDropDown(self, info):\n\t\t#tabIndex self.menuOptions.findCell(str(info['index']), cols=['index'])\n\t\t#tabIndex = info['index']self.HiddenTabInfo[info['index']][1]\n\t\tparent.Widget.par.Value0.menuIndex = \\\n\t\t\t\t\t\t\t\tint(self.menuOptions[info['index'] + 1, 2].val)\n\t\tself.CalculateSizes()\n\n\tdef makePanelExecute(self):\n\t\tSubWidgetExt.makePanelExecute(self, self.getDockExpressionToOwner()\n\t\t\t\t\t\t\t\t\t+ \".ops('tab*') +[\" \\\n\t\t\t\t\t\t\t\t\t+ self.getDockExpressionToOwner() + ']')\n\n\tdef HelpString(self, tabIndex):\n\t\tif parent.Widget.par.Folderhelplabelwhenshrunk.eval() and \\\n\t\t\t\tself.ownerComp.op('tab' + str(tabIndex)).par.Shrunken:\n\t\t\ttry:\n\t\t\t\treturn self.menuOptions[tabIndex + 1, 'label']\n\t\t\texcept:\n\t\t\t\tpass\n\n\t\thelpStrings = tdu.split(parent.Widget.par.Folderhelpstrings)\n\t\tif tabIndex < len(helpStrings):\n\t\t\treturn helpStrings[tabIndex]\n\t\treturn (parent.Widget.op('code/help').text or \\\n\t\t\t\t\t\t\t\tparent.Widget.op('help').text).strip()\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tself.CalculateSizes()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == 'Foldercustomizeinteraction':\n\t\t\tSubWidgetExt.onParSettingsPulse(self, par)\n\t\telse:\n\t\t\tself.CalculateSizes()\n\n\tdef CalculateSizes(self, offset=None):\n\t\tlabels = self.Labels\n\t\tself.HiddenTabInfo = []\n\t\tself.MinTextWidths = []\n\t\tminSize = parent.Widget.par.Foldertabwidthrange1.eval()\n\t\tmaxSize = parent.Widget.par.Foldertabwidthrange2.eval()\n\t\tmargin
                = parent.Widget.par.Foldertabmargin.eval()\n\t\tlabelMargin = parent.Widget.par.Foldertablabelmargin.eval()\n\t\tmarginWidth = margin * (len(labels) - 1) if labels else 0\n\t\townerWidth = self.ownerComp.width\n\t\ttabsWidth = 0\n\t\twidths = []\n\t\tshrinkRoom = []\n\t\tselectedTab = self.SelectedTab \n\t\t# figure out base sizes of tabs (at full size)\n\t\tneedsMenu = False\n\t\tfor i, label in enumerate(labels):\n\t\t\ttextWidth = math.ceil(\n\t\t\t\t\tself.baseText.evalTextSize(label)[0] + labelMargin)\n\t\t\tbaseWidth = tdu.clamp(textWidth, minSize, maxSize)\n\t\t\ttabsWidth += baseWidth\n\t\t\twidths.append(baseWidth)\n\t\t\tif parent.Widget.par.Folderselectedtabfullsize and selectedTab == i:\n\t\t\t\t# keep selected tab full if possible\n\t\t\t\ttabMin = max(baseWidth, textWidth)\n\t\t\t# elif parent.Widget.par.Folderselectedtabfullsize and \\\n\t\t\t# \t\t\t\t\tself.lastSelectedTab == i:\n\t\t\t# \t# keep last selected tab if it would shift tabs\n\t\t\t# \ttabMin = textWidth\t\t\t\n\t\t\telif parent.Widget.par.Foldermintextwidth:\n\t\t\t\ttabMin = max(minSize, textWidth)\n\t\t\telse:\n\t\t\t\ttabMin = minSize\n\t\t\tif textWidth > tabMin:\n\t\t\t\tneedsMenu = True\n\t\t\tself.MinTextWidths.append(textWidth)\n\t\t\t# store amount that this can shrink\n\t\t\tshrinkRoom.append(max(0, baseWidth - tabMin))\n\t\toverlap = (marginWidth + tabsWidth + self.menuWidth * needsMenu) \\\n\t\t\t\t\t\t- ownerWidth\n\t\tif overlap <= 0:\n\t\t\tself.VisibleTabs = list(range(len(labels)))\n\t\t\tif parent.Widget.par.Foldertabsfillavailablespace and overlap < 0:\n\t\t\t\tquotient, remainder = divmod(-overlap, len(widths))\n\t\t\t\tquotient = int(quotient)\n\t\t\t\tremainder = int(remainder)\n\t\t\t\twidths = [w + quotient for w in widths]\n\t\t\t\tfor i in range(remainder):\n\t\t\t\t\twidths[i] += 1\n\t\telse:\n\t\t\t# try shrinking tabs down \n\t\t\ttotalShrinkRoom = sum(shrinkRoom)\n\t\t\ttoShrink = int(overlap + (0 if needsMenu else self.menuWidth))\n\t\t\tif totalShrinkRoom >= toShrink:\n\t\t\t\tself.VisibleTabs = list(range(len(labels)))\n\t\t\t\t# fancy shrinky math starting with biggest\n\t\t\t\tshrinkData = []\n\t\t\t\t# secondShrinkData = []\n\t\t\t\tfinalShrinkData = []\n\t\t\t\tfor i in range(len(widths)):\n\t\t\t\t\tshrinkData.append([i, int(widths[i]), int(shrinkRoom[i])])\n\t\t\t\tif parent.Widget.par.Folderselectedtabfullsize:\n\t\t\t\t\tif selectedTab is not None:\n\t\t\t\t\t\t# pull out selected tab\n\t\t\t\t\t\tfinalShrinkData.append(shrinkData.pop(selectedTab))\n\t\t\t\tshrunkData = []\n\t\t\t\t# sort by shrinkRoom then by width\n\t\t\t\tdef shrinkByWidth(data):\n\t\t\t\t\tnonlocal toShrink, shrunkData\n\t\t\t\t\tsanity = 0\n\t\t\t\t\tdata.sort(key=lambda x:(-x[1],x[2]))\n\t\t\t\t\t# shrink largest tabs first\n\t\t\t\t\twhile data and toShrink and \\\n\t\t\t\t\t\t\t\tsum([d[1] for d in data]) and sanity < 10000:\n\t\t\t\t\t\tsanity += 1\n\t\t\t\t\t\twhile data[0][2] == 0 and data:\n\t\t\t\t\t\t\tshrunkData.append(data.pop(0))\n\t\t\t\t\t\t\tif not data:\n\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tshrinkers = [d for d in data if d[1] == data[0][1]]\n\t\t\t\t\t\tif len(shrinkers) == len(data):\n\t\t\t\t\t\t\tif data:\n\t\t\t\t\t\t\t\tshrinkMax = data[0][2]\n\t\t\t\t\t\t\telse:\n\t\t\t\t\t\t\t\treturn\n\t\t\t\t\t\telse:\n\t\t\t\t\t\t\tshrinkMax = min(data[0][2], data[0][1] - \n\t\t\t\t\t\t\t\t\t\t\t\t\tdata[len(shrinkers)][1])\n\t\t\t\t\t\tif shrinkMax * len(shrinkers) <= toShrink:\n\t\t\t\t\t\t\t# shrink everyone down then get next shrinkable\n\t\t\t\t\t\t\tfor s in shrinkers:\n\t\t\t\t\t\t\t\ts[1] -= shrinkMax\n\t\t\t\t\t\t\t\ts[2] -= shrinkMax\n\t\t\t\t\t\t\ttoShrink -= shrinkMax * len(shrinkers)\n\t\t\t\t\t\telse:\n\t\t\t\t\t\t\t# divide up shrinkers evenly\n\t\t\t\t\t\t\tamount = int(toShrink/len(shrinkers))\n\t\t\t\t\t\t\tfor s in shrinkers:\n\t\t\t\t\t\t\t\ts[1] -= amount\n\t\t\t\t\t\t\t\ttoShrink -= amount\n\t\t\t\t\t\t\t# use up remainder\n\t\t\t\t\t\t\tfor i in range(toShrink):\n\t\t\t\t\t\t\t\tshrinkers[i][1] -= 1\n\t\t\t\t\t\t\t\ttoShrink -= 1\n\t\t\t\tshrinkByWidth(shrinkData)\n\t\t\t\t# shrinkByWidth(secondShrinkData)\n\t\t\t\tif
                toShrink and finalShrinkData:\n\t\t\t\t\t# deal with final shrink data\n\t\t\t\t\tselectedData = finalShrinkData[0]\n\t\t\t\t\tif selectedData[2] < toShrink:\n\t\t\t\t\t\tselectedData[1] -= selectedData[2]\n\t\t\t\t\t\ttoShrink -= selectedData[2]\n\t\t\t\t\t\tselectedData[2] = 0\n\t\t\t\t\telse:\n\t\t\t\t\t\tselectedData[2] -= toShrink\n\t\t\t\t\t\tselectedData[1] -= toShrink\n\t\t\t\t\t\ttoShrink = 0\n\t\t\t\t\t\t\t\n\t\t\t\tfor d in shrinkData + shrunkData + finalShrinkData:\n\t\t\t\t\twidths[d[0]] = d[1]\n\t\t\telse:\n\t\t\t\tfor i, w in enumerate(widths):\n\t\t\t\t\twidths[i] -= shrinkRoom[i]\n\t\t\t\t# tried shrinking, now add drop down if necessary\n\t\t\t\tif parent.Widget.par.Folderdropdown.eval() \\\n\t\t\t\t\t\tand sum(widths) + marginWidth + self.addButtonWidth \\\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t> ownerWidth:\n\t\t\t\t\ttestWidth = ownerWidth - self.arrowsPlusMenuWidth \\\n\t\t\t\t\t\t\t\t- (self.addButtonWidth if \\\n\t\t\t\t\t\t\t\tparent.Widget.par.Folderaddbutton.eval() else 0) \n\t\t\t\t\ttabsWidth = 0\n\t\t\t\t\tselectedTab = self.SelectedTab or 0\n\t\t\t\t\tnumTabs = 0\n\t\t\t\t\tvisibleLeft = None # must be visible after shift\n\t\t\t\t\tif offset is None:\n\t\t\t\t\t\tstartTab = selectedTab\n\t\t\t\t\telif self.VisibleTabs:\n\t\t\t\t\t\tstartTab = offset + self.VisibleTabs[-1]\n\t\t\t\t\t\tif offset < 0:\n\t\t\t\t\t\t\tvisibleLeft = max(0, self.VisibleTabs[0] + offset)\n\t\t\t\t\telse:\n\t\t\t\t\t\tstartTab = offset + self.lastTab\n\t\t\t\t\tbaseStartTab = startTab\n\t\t\t\t\twhile visibleLeft is not True:\n\t\t\t\t\t\tfor i in range(startTab, -1, -1):\n\t\t\t\t\t\t\tw = widths[i]\n\t\t\t\t\t\t\tif tabsWidth + w + (margin if numTabs else 0) \\\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t> testWidth:\n\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\telse:\n\t\t\t\t\t\t\t\tstartTab = i\n\t\t\t\t\t\t\t\tnumTabs += 1\n\t\t\t\t\t\t\t\ttabsWidth += w + (margin if numTabs else 0)\n\t\t\t\t\t\tif visibleLeft is None \\\n\t\t\t\t\t\t\t\tor (startTab <= visibleLeft and numTabs) \\\n\t\t\t\t\t\t\t\tor startTab == 0:\n\t\t\t\t\t\t\tvisibleLeft = True\n\t\t\t\t\t\telse:\n\t\t\t\t\t\t\tstartTab = baseStartTab -1\n\t\t\t\t\t\t\tnumTabs = 0\n\t\t\t\t\t\t\ttabsWidth = 0\n\t\t\t\t\tif i == 0:\n\t\t\t\t\t\tforwardTestRange = range(startTab + numTabs, \n\t\t\t\t\t\t\t\t\t\t\t\t\tlen(widths))\n\t\t\t\t\telse:\n\t\t\t\t\t\tforwardTestRange = []\n\t\t\t\t\tfor i in forwardTestRange:\n\t\t\t\t\t\tw = widths[i]\n\t\t\t\t\t\tif tabsWidth + w + (margin \n\t\t\t\t\t\t\t\t\t\t\tif i < len(widths) - 1 else 0) \\\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t> testWidth:\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\telse:\n\t\t\t\t\t\t\tnumTabs += 1\n\t\t\t\t\t\t\ttabsWidth += w + \\\n\t\t\t\t\t\t\t\t\t\t(margin if i < len(widths) - 1 else 0)\n\t\t\t\t\tself.VisibleTabs = list(range(startTab, startTab + numTabs))\n\t\t\t\t\tif not self.VisibleTabs:\n\t\t\t\t\t\tself.lastTab = startTab\n\t\t\t\t\tfor i in range(len(widths)):\n\t\t\t\t\t\tif i not in self.VisibleTabs:\n\t\t\t\t\t\t\tself.HiddenTabInfo.append([labels[i], i] )\n\t\t\t\telse:\n\t\t\t\t\tself.VisibleTabs = list(range(len(labels)))\n\t\tself.TabWidths = widths\n\t\tself.lastSelectedTab = None\n\n\t@property\n\tdef arrowsPlusMenuWidth(self):\n\t\treturn (sum([self.ownerComp.op(tool).width for tool in \n\t\t\t\t\t['buttonTabsLeft', 'buttonTabsRight']]) + self.menuWidth) \\\n\t\t\t\tif parent.Widget.par.Folderdropdown.eval() else 0\n\t@property\n\tdef menuWidth(self):\n\t\treturn self.ownerComp.op('buttonTabDropDown').width \n\t\t\t\t\t\t#\tif parent.Widget.par.Folderdropdown.eval() else 0\n\n\t@property\n\tdef addButtonWidth(self):\n\t\treturn self.ownerComp.op('buttonAddTab').width \n\t\t\t\t\t\t#\tif parent.Widget.par.Folderaddbutton.eval() else 0\n\n\t@property\n\tdef Labels(self):\n\t\treturn [c.val for c in self.menuOptions.col('label')[1:]\n\t\t\t\t\tif not parent.Widget.par.Foldernonenotab \n\t\t\t\t\t\tor c.offset(0,-1).val != 'None']\n\n\t@property\n\tdef SelectedTab(self):\n\t\tif parent.Widget.par.Foldernonenotab:\n\t\t\ttabNum = -1\n\t\t\tindex = parent.Widget.par.Value0.menuIndex\n\t\t\tcell
                = self.menuOptions.findCell(str(index), cols=['index'])\n\t\t\treturn cell.row-1 if cell is not None else None\n\n\t\telse:\n\t\t\treturn parent.Widget.par.Value0.menuIndex\n\n\tdef TabToLabel(self, tabNum):\n\t\t\"\"\"\n\t\tReturn label index given tab num\n\t\t\"\"\"\n\t\treturn int(self.menuOptions[tabNum + 1, 'index'].val)\n\n\t@property\n\tdef RightButtonEnable(self):\n\t\treturn (not len(self.TabWidths) - 1 in self.VisibleTabs \\\n\t\t\t\tif self.VisibleTabs else \\\n\t\t\t\t\t\t\tself.lastTab != len(self.TabWidths) - 1)"
              dat_content_format: text
            - name: widthTools
              type: containerCOMP
              parameters:
                y: =1-(me.digits == parent.Widget.par.Value0.eval())
                w: =sum([c.par.w for c in me.outputCOMPs if c.par.display])
                h: 50
                layer: 10
                leftanchor: 1
                horigin: 1
                vmode: fill
                topoffset: =- (0 if me.digits == parent.Widget.par.Value0.menuIndex else parent.Widget.par.Foldertabopenmargin) if parent.Widget.extensionsReady else 0
                alignallow: ignore
                alignorder: 1
                helpdat: ''
                resizecomp: =me
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                borderover: false
                align: horizlr
              flags:
              - viewer
              position: [700, -300]
              size: [160, 130]
            - name: menuOptions
              type: nullDAT
              flags:
              - viewer
              position: [100, 400]
              inputs:
              - noNone
              dat_read_only: true
            - name: parentWidth
              type: evaluateDAT
              parameters:
                expr: parent().width
                rowindexend: =me.inputTable.numRows - 1
                colindexend: =me.inputTable.numCols - 1
              position: [-1100, -300]
              dat_read_only: true
            - name: replicator1
              type: replicatorCOMP
              parameters:
                method: bynum
                numreplicants: =op('menuOptions').numRows - 2
                opprefix: tab
                master: tab0
                destination: =me.parent()
                layout: vertical
                layoutorigin1: =me.nodeX
                layoutorigin2: =me.nodeY - 200
              position: [-275, 0]
            - name: SubWidgetExt
              type: textDAT
              parameters:
                defaultreadencoding: cp1252
                language: input
              flags:
              - viewer
              position: [-900, 400]
              size: [130, 90]
              tags:
              - TDExtension
              dat_content: "TDF = op.TDModules.mod.TDFunctions\ndropCallbacks = ['onHoverStartGetAccept', 'onHoverEnd', 'onDropGetResults']\ndragCallbacks = ['onDragStartGetItems', 'onDragEnd']\n\nclass SubWidgetExt:\n\t\"\"\"\n\tRockerExt description\n\t\"\"\"\n\n\tdef __init__(self, ownerComp, indexComp=None):\n\t\t# The component to which this extension is attached\n\t\tself.ownerComp = ownerComp\n\t\tif indexComp:\n\t\t\tself.indexComp = indexComp\n\t\telse:\n\t\t\tself.indexComp = self.ownerComp\n\n\tdef onPanelEvent(self, event, panelValue):\n\t\t\"\"\"\n\t\tPanel exec events from widget\n\t\t\"\"\"\n\t\tpass\n\n\tdef onParSettingsChange(self, par, prev):\n\t\t\"\"\"\n\t\tManages value changes widget settings parameters\n\t\t\"\"\"\n\t\tval = par.eval()\n\t\tif par.name == self.parPrefix + 'runcommand':\n\t\t\tenable = par.eval()\n\t\t\tfor suffix in ['commandon', 'commandoff', 'commandonvaluechange']:\n\t\t\t\tp = self.prefixPar(suffix)\n\t\t\t\tif p is not None:\n\t\t\t\t\tp.enable = enable\n\t\telif par.name == self.parPrefix + 'horizontalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('hfillweight').enable = fill\n\t\t\tself.prefixPar('width').enable = not fill\n\t\telif par.name == self.parPrefix + 'verticalmode':\n\t\t\tfill = True if val == 'fill' else False\n\t\t\tself.prefixPar('vfillweight').enable = fill\n\t\t\tself.prefixPar('height').enable = not fill\n\t\telif par.name in [self.parPrefix + 'bordera',\n\t\t\t\t\t\t  self.parPrefix + 'borderb',\n\t\t\t\t\t\t  self.parPrefix + 'border']:\n\t\t\tgetattr(parent.Widget.par, par.name + 'colorr').enable = par.eval()\n\n\tdef onParSettingsPulse(self, par):\n\t\t\"\"\"\n\t\tManages pulse events for widget settings parameters\n\t\t\"\"\"\n\t\tif par.name == self.parPrefix + 'customizeinteraction':\n\t\t\tself.makePanelExecute()\n\n\tdef onToggleEvent(self, event, panelValue):\n\t\tif event == 'offToOn':\n\t\t\tself.toggle()\n\n\tdef toggle(self):\n\t\tindex = self.indexComp.digits\n\t\tvaluePar = getattr(parent.Widget.par, 'Value' + str(index))\n\t\tvaluePar.val = 1 - valuePar.eval()\n\n\tdef prefixPar(self, suffix):\n\t\t\"\"\"\n\t\tReturn a parameter prefixed by parPrefix\n\t\t:param suffix: the par name after parPrefix (string)\n\t\t:return: the parameter or None if not found\n\t\t\"\"\"\n\t\treturn getattr(self.ownerComp.parent.Widget.par,\n\t\t\t\t\t   self.parPrefix + suffix, None)\n\n\tdef getDockExpressionToOwner(self):\n\t\tpage = TDF.getCustomPage(self.ownerComp.parent.Widget, 'OPs')\n\t\texpr = \"me.dock.op('\" + self.ownerComp.name + \"')\"\n\t\tfor p in page.pars:\n\t\t\tif p.eval() == self.ownerComp:\n\t\t\t\texpr = \"me.dock.par.\" + p.name + \".eval()\"\n\t\t\t\tbreak\n\t\treturn expr\n\n\tdef makePanelExecute(self, panelExpr=None):\n\t\t\"\"\"\n\t\tCreates a panel execute DAT for running external code from the\n\t\twidget that is connected to the button interaction receiver - which\n\t\tis the ownerComp of this class\n\n\t\tpanelExpr: will be used as the expression in the panel parameter of the\n\t\t\tpanelExec. Defaults to \"me.dock.op('\" + self.ownerComp.name +\"')\"\n\t\t\"\"\"\n\t\tpanelExecPar = self.PanelExecPar\n\t\tpeDat = panelExecPar.eval()\n\t\texpr = self.getDockExpressionToOwner() \\\n\t\t\t\t\t\t\t\t\t\t\tif panelExpr is None else panelExpr\n\t\tif not peDat:\n\t\t\tpeDat = self.ownerComp.parent.Widget.parent().create(\n\t\t\t\tpanelexecuteDAT, self.parPrefix + 'PanelExec')\n\t\t\tpeDat.nodeX = self.ownerComp.parent.Widget.nodeX - 200\n\t\t\tpeDat.nodeY = self.ownerComp.parent.Widget.nodeY\n\t\t\tpeDat.dock = self.ownerComp.parent.Widget\n\t\t\tpeDat.par.panel.expr = expr\n\t\t\tpeDat.par.ontooff = True\n\t\t\tpeDat.viewer = True\n\t\t\tpanelExecPar.val = peDat.name\n\t\t\tpanelExecPar.enable = True\n\t\t\tpanelExecPar.readOnly = True\n\t\t\tself.ownerComp.op('panelExecOPExec').cook(force=True)\n\t\telse:\n\t\t\tif expr not in peDat.par.panel.expr:\n\t\t\t\tpeDat.par.panel.expr += ', ' + expr\n\t\tpanelExecPar.eval().par.edit.pulse()\n  \n\tdef RaiseDragDrop(self, *args, **kwargs):\n\t\t\"\"\"\n\t\tPass the
                callback to parent widget. The name of the callback is \n\t\tdetermined automatically, so this must be called from the original \n\t\tcallback.\n\n\t\tArgs:\n\t\t\tcomp: component to send it to\n\t\t\targs, kwargs: passed to other callback\n\t\tReturns:\n\t\t\tThe return value of that callback. If that callback is invalid for comp,\n\t\t\treturn None.\n\t\t\"\"\"\n\t\tcallbackName = inspect.stack()[1][3]\n\t\twidget = parent.Widget\n\t\tif widget.par.dragdropcallbacks.eval():\n\t\t\tcallback = getattr(widget.par.dragdropcallbacks.eval().module,\n                \t\t\t\t\t\t\t\t\t\t\tcallbackName, None) \n\t\t\tif callback and (callbackName in dragCallbacks \\\n                    \t\t\tand widget.par.drag == 'usecallbacks' \\\n\t\t\t\t\t\t\tor callbackName in dropCallbacks \\\n\t\t\t\t\t\t\t\tand widget.par.drop == 'usecallbacks'):\n\t\t\t\treturn callback(*args, **kwargs)\n    \n\t@property\n\tdef PanelExecPar(self):\n\t\treturn getattr(parent.Widget.par, self.parPrefix + 'panelexec', None)\n\n"
              dat_content_format: text
            - name: buttonAddTab
              type: buttonCOMP
              parameters:
                scaletofit: onlyshrink
                w: =max(me.height, op('./off').evalTextSize(op('./off').par.value)[0] + 8)
                h: =max(parent().height/2, op('./off').evalTextSize(op('./off').par.value)[1] + 6)
                leftanchor: 1
                horigin: 1
                topoffset: =- (0 if me.digits == parent.Widget.par.Value0.menuIndex else parent.Widget.par.Foldertabopenmargin) if parent.Widget.extensionsReady else 0
                alignorder: 3
                postoffsety: =(parent().height - me.height)/2
                display: =parent.Widget.par.Folderaddbutton
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                enablecloning: true
                relpath: inherit
              position: [600, -700]
              size: [160, 130]
              children:
              - name: 'off'
                type: textCOMP
                parameters:
                  text: =chr(0xF11EC)
                  callbacks: off_textCOMP_callbacks
                  legacyfontselection: true
                  font: Material Design Icons
                  fontsize: =parent.Widget.par.Foldertabfontsize.eval() * 1.3
                  fontsizeunits: points
                  fontcolorr: =parent.Widget.par.Foldertabofffontcolorr.eval()
                  fontcolorg: =parent.Widget.par.Foldertabofffontcolorg.eval()
                  fontcolorb: =parent.Widget.par.Foldertabofffontcolorb.eval()
                  fontalpha: =parent.Widget.par.Foldertabofffontcolora.eval()
                  alignxmode: bbox
                  alignymode: bbox
                  w: =parent().width
                  h: =parent().height
                  hmode: fill
                  vmode: fill
                  clickthrough: true
                  bgcolorr: =parent.Widget.par.Foldertabofffacecolorr.eval()
                  bgcolorg: =parent.Widget.par.Foldertabofffacecolorg.eval()
                  bgcolorb: =parent.Widget.par.Foldertabofffacecolorb.eval()
                  bgalpha: =parent.Widget.par.Foldertabofffacecolora.eval()
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  borderover: false
                flags:
                - viewer
                size: [160, 130]
              - name: help
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                position: [-200, 0]
                size: [130, 90]
                dat_content: New tab
                dat_content_format: text
              - name: rollover
                type: containerCOMP
                parameters:
                  layer: 7
                  hmode: fill
                  vmode: fill
                  alignallow: ignore
                  display: =parent().panel.rollover or parent().panel.lselect
                  clickthrough: true
                  resizecomp: =me
                  bgcolorr: =parent.Widget.par.Foldertabrollcolorr.eval()
                  bgcolorg: =parent.Widget.par.Foldertabrollcolorg.eval()
                  bgcolorb: =parent.Widget.par.Foldertabrollcolorb.eval()
                  bgalpha: =parent.Widget.par.Foldertabrollcolora.eval()
                  borderover: false
                  composite: add
                  enablecloning: false
                flags:
                - viewer
                position: [0, 200]
                size: [160, 130]
              - name: insideParent
                type: tableDAT
                parameters:
                  defaultreadencoding: cp1252
                  rows: 2
                flags:
                - viewer
                position: [-200, 200]
                size: [130, 90]
                dat_content:
                - - '''path'''
                  - '''parameter'''
                  - '''value'''
                  - '''enable'''
                - - '''rollover/panel'''
                  - '''component'''
                  - '''"'' + parent().path + ''"'''
                  - '1'
                dat_content_format: table
              - name: off_textCOMP_callbacks
                type: textDAT
                parameters:
                  language: input
                flags:
                - viewer
                position: [0, -375]
                size: [160, 130]
                dock: 'off'
                dat_content: "# Text Component callbacks\n\ndef onValueChange(comp, value, prevValue):\n\t\"\"\"\n\tCalled whenever the text component's value parameter changes for any reason including typing\n\tin the text window or changing the parameter directly. The callback is equivalent to the\n\tonValueChange in the parameter exectute DAT.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonValueChange comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\ndef onFocus(comp):\n\t\"\"\"\n\tCalled when one of the text components viewers gets keyboard focus. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonFocus comp:', comp.path)\n\treturn\n\ndef onFocusEnd(comp, info):\n\t\"\"\"\n\tCalled when one of the text component's viewers loses keyboard focus. In regular editing mode\n\tthis is right after the contents are saved back to the value parameter. This function is called\n\teverytime the viewer loses focus, even if the text does not change.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tinfo: a dictionary containing information about the event including:\n\t\t\treason: a string indicating what caused the viewer to lose focus e.g. 'enter', 'escape', 'tab', 'unknown'\n\t\n\t\"\"\"\n\t#debug('\\nonFocusEnd comp:', comp.path, '- info:\\n', info)\n\treturn\n\t\ndef onTextEdit(comp):\n\t\"\"\"\n\tCalled each time the contents of the text component viewer change i.e. when typing a character,\n\tdeleting text, cutting or pasting. \n\t\n\tArgs:\n\t\tcomp: the text component\n\t\"\"\"\n\t#debug('\\nonTextEdit comp:', comp.path, '- text: ', comp.editText)\n\treturn\n\t\ndef onTextEditEnd(comp, value, prevValue):\n\t\"\"\"\n\tCalled when the user finishes editing and the value has been changed. Not called in 'Continuous Edit' mode. Use\n\tonTextEdit and onFocusEnd when using continuous editing.\n\t\n\tArgs:\n\t\tcomp: the text component\n\t\tvalue: the new value\n\t\tprevValue: the previous value\n\t\"\"\"\n\t#debug('\\nonTextEditEnd comp:', comp.path, '- new value: ', value, ', prev value: ', prevValue )\n\treturn\n\t\n\t"
                dat_content_format: text
            - name: kbTabControl
              type: keyboardinDAT
              parameters:
                active: =parent.Widget.panel.inside
                keys: tab
                callbacks: keyboardin1_callbacks
                fromop: =parent()
              flags:
              - viewer
              position: [-1075, -600]
              dat_read_only: true
            - name: spacerCustom
              type: containerCOMP
              parameters:
                w: 3
                vmode: fill
                alignorder: 2
                resizecomp: =me
                borderover: false
              flags:
              - viewer
              position: [300, -700]
              size: [160, 130]
            - name: widthRefresh
              type: datexecuteDAT
              parameters:
                dat: parentWidth
                language: input
              position: [-900, -300]
              size: [130, 90]
              color: [0.05, 0.5, 0.05]
              dat_content: "# me - this DAT.\n# \n# dat - the changed DAT\n# rows - a list of row indices\n# cols - a list of column indices\n# cells - the list of cells that have changed content\n# prev - the list of previous string contents of the changed cells\n# \n# Make sure the corresponding toggle is enabled in the DAT Execute DAT.\n# \n# If rows or columns are deleted, sizeChange will be called instead of row/col/cellChange.\n\n\ndef onTableChange(dat):\n\tparent().CalculateSizes()\n\ndef onRowChange(dat, rows):\n\treturn\n\ndef onColChange(dat, cols):\n\treturn\n\ndef onCellChange(dat, cells, prev):\n\treturn\n\ndef onSizeChange(dat):\n\treturn\n\t"
              dat_content_format: text
            - name: buttonTabsLeft
              type: buttonCOMP
              parameters:
                scaletofit: onlyshrink
                y: =1-(me.digits == parent.Widget.par.Value0.eval())
                w: '=op(''./on'').evalTextSize(op(''./on'').par.value)[0] '
                h: 50
                vmode: fill
                topoffset: =- (0 if me.digits == parent.Widget.par.Value0.menuIndex else parent.Widget.par.Foldertabopenmargin) if parent.Widget.extensionsReady else 0
                alignorder: -1
                display: =len(parent().HiddenTabInfo) if parent().extensionsReady else False
                enable: =(not 0 in ext.FolderExt.VisibleTabs if ext.FolderExt.VisibleTabs else ext.FolderExt.lastTab) != 0 if parent().extensionsReady else False
                helpdat: '=None # ./help'
                borderar: 0
                borderag: 0
                borderab: 0
                borderaalpha: 0
                borderbalpha: 0
                enablecloning: true
                relpath: inherit
              position: [600, -500]
              size: [160, 130]
              comp_inputs:
              - widthTools
              children:
              - name: 'on'
                type: textCOMP
                parameters:
                  text: =chr(0xF035E)
                  callbacks: on_textCOMP_callbacks
                  legacyfontselection: true
                  font: Material Design Icons
                  fontsize: =parent.Widget.par.Foldertabfontsize.eval() * 1.5
                  fontsizeunits: points
                  fontcolorr: =parent.Widget.par.Foldertabonfontcolorr.eval()
                  fontcolorg: =parent.Widget.par.Foldertabonfontcolorg.eval()
                  fontcolorb: =parent.Widget.par.Foldertabonfontcolorb.eval()
                  fontalpha: =parent.Widget.par.Foldertabonfontcolora.eval()
                  alignxmode: bbox
                  alignymode: bbox
                  w: 75
                  h: 26
                  hmode: fill
                  vmode: fill
