              - Fixed Width
              - Fill
            - name: Labelwidth
              style: Int
              label: Width
              default: 120
              min: 1.0
              max: 300.0
              clampMin: true
              normMin: 1.0
              normMax: 300.0
            - name: Labelhfillweight
              style: Float
              label: Horizontal Fill Weight
              default: 0.5
              clampMin: true
              enable: false
            - name: Labelverticalmode
              style: Menu
              label: Vertical Mode
              default: fill
              menuNames:
