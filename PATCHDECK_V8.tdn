        - name: bg
          type: nullTOP
          flags:
          - bypass
          position: [1750, 225]
          size: [130, 90]
          inputs:
          - level2
        - name: in1
          type: inCHOP
          parameters:
            label: =me.name
            exporttable: in1_export
