                - =op('./info2')['resy']
              - name: Pixelsize
                style: XYZW
                label: pixel size
                size: 2
                readOnly: true
                values:
                - =1/me.par.Gridsizex
                - =1/me.par.Gridsizey
              - name: Hardwaremanualgradients
                style: Toggle
                label: hardware / manual gradients
                value: true
              - name: Samplingtype
                style: Menu
                label: sampling type
                default: NearestPixel
                menuNames:
                - NearestPixel
                - Interpolate Pixels
                - MipMap Pixels
                menuLabels:
                - Nearest Pixel
                - Interpolate Pixels
                - MipMap Pixels
                value: MipMap Pixels
              - name: Pixelformat
                style: Menu
                label: pixel format
                default: 16_bit_float
                menuNames:
                - 16_bit_float
                - 32_bit_float
                menuLabels:
                - 16 bit float
                - 32 bit float
                value: 32_bit_float
              - name: Passes
                style: Int
                label: passes
                normMin: 1.0
                normMax: 3.0
                value: 2
              - name: Timestep
                style: Float
                label: time step
                value: =1/me.time.rate
              - name: Reset
                style: Pulse
                label: reset
              parameters:
              - name: Boundaries
                style: Header
                label: boundaries
              - name: Reflectiveboundary
                style: Toggle
                label: reflective boundary
                value: true
              - name: Dampingfactor
                style: Float
                label: damping factor
                clampMin: true
                clampMax: true
                enableExpr: me.par.Reflectiveboundary
              - name: Velocity
                style: Header
                label: velocity
              - name: Inputvelocityfactor
                style: Float
                label: input velocity factor
                value: 6
              - name: Vorticityscale
                style: Float
                label: vorticity scale
                clampMin: true
                normMax: 15.0
                value: 8.87
              - name: Velocitydecay
                style: Float
                label: velocity decay
                value: 0.502
              - name: Viscosity
                style: Float
                label: viscosity
                clampMin: true
              - name: Smargov
                style: Float
                label: small scale turbulence
                value: 2
              - name: Pressure
                style: Float
                label: pressure
                clampMin: true
                value: 0.999
            position: [75, 550]
            size: [291, 215]
            inputs:
            - rectangle1
            - noise2
            children:
            - name: init
              type: nullTOP
              parameters:
                inputfiltertype: nearest
                format: rg32float
              flags:
              - viewer
              position: [-725, 25]
              size: [130, 90]
              inputs:
              - init_vel_in
            - name: glsl2
              type: glslTOP
              parameters:
                pixeldat: glsl2_pixel
                computedat: glsl2_compute
                numcolorbufs: 2
              sequences:
                vec:
                - name: u_delta_time
                  valuex: =parent().par.Timestep
                - name: u_passes
                  valuex: ~parent().par.Passes
                  valuey: 1
                  valuez: 1
                  valuew: 1
              flags:
              - viewer
              position: [750, 0]
              size: [130, 90]
              inputs:
              - select2
            - name: info2
              type: infoCHOP
              parameters:
                op: init
                iscope: resx resy
              flags:
              - viewer
              position: [-1200, 175]
            - name: null2
              type: nullDAT
              flags:
              - viewer
              position: [193, -405]
              inputs:
              - switch1
              dat_read_only: true
            - name: bounds
              type: nullTOP
              parameters:
                format: rg32float
              flags:
              - viewer
              position: [-550, -275]
              size: [130, 90]
              inputs:
              - boundary_in
            - name: circle1
              type: circleTOP
              parameters:
                centery: 0.2
                fillcolorr: 0
                fillcolorg: -5
                fillcolorb: 0
                softness: =me.par.radiusx*0.3
                resolutionw: 720
                resolutionh: 720
                format: rg32float
              position: [-1100, 25]
            - name: select2
              type: selectTOP
              parameters:
                top: fb_end_null
              flags:
              - viewer
              position: [600, 0]
              size: [130, 90]
            - name: switch1
              type: switchDAT
              parameters:
                index: ~parent().par.Hardwaremanualgradients
              position: [50, -400]
              size: [123, 85]
              inputs:
              - with_hardware_derivatives
              - manual_derivatives
              dat_read_only: true
            - name: feedback2
              type: feedbackTOP
              parameters:
                top: fb_end_null
                format: rgba32float
              flags:
              - viewer
              position: [-525, -25]
              size: [130, 90]
              inputs:
              - init
            - name: glsl2_info
              type: infoDAT
              parameters:
                op: glsl2
              flags:
              - viewer
              - -showDocked
              position: [910, -120]
              size: [130, 90]
              dock: glsl2
              dat_read_only: true
            - name: glsl4_info
              type: infoDAT
              parameters:
                op: curl_vort_press
              flags:
              - viewer
              - -showDocked
              position: [225, -75]
              size: [130, 90]
              dock: curl_vort_press
              dat_read_only: true
            - name: glsl6_info
              type: infoDAT
              parameters:
                op: rk4_advect
              flags:
              - viewer
              - -showDocked
              position: [-25, -125]
              size: [145, 88]
              dock: rk4_advect
              dat_read_only: true
            - name: rectangle1
              type: rectangleTOP
              parameters:
                sizex: 0.99
                sizey: 0.99
                sizeunit: fraction
                fillalpha: 0
                borderalpha: 0
                bgcolorr: 1
                bgcolorg: 1
                bgcolorb: 1
                bgalpha: 1
                softness: 0.03
                combineinput: res
                resolutionw: =op('info2')['resx']
                resolutionh: =op('info2')['resy']
                inputfiltertype: nearest
                format: mono32float
              flags:
              - viewer
              position: [-875, -275]
              size: [130, 90]
            - name: rk4_advect
              type: glslTOP
              parameters:
                pixeldat: glsl6_pixel
                computedat: glsl2_compute
                inputfiltertype: ~parent().par.Samplingtype
                filtertype: nearest
                npasses: ~parent().par.Passes
                format: rgba32float
              sequences:
                vec:
                - name: u_time_step
                  valuex: ~parent().par.Timestep
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: u_damping
                  valuex: ~parent().par.Dampingfactor
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: u_reflective
                  valuex: ~parent().par.Reflectiveboundary
                  valuey: 1
                  valuez: 1
                  valuew: 1
              flags:
              - viewer
              position: [-175, 0]
              size: [130, 105]
              inputs:
              - add_input_velocities
              - bounds
            - name: boundary_in
              type: inTOP
              parameters:
                label: =me.name
                inputfiltertype: nearest
                filtertype: nearest
                format: rg32float
              flags:
              - viewer
              position: [-700, -275]
              size: [130, 90]
              inputs:
              - rectangle1
            - name: fb_end_null
              type: nullTOP
              parameters:
                inputfiltertype: nearest
                filtertype: nearest
                format: rg32float
              flags:
              - viewer
              position: [350, 25]
              size: [101, 76]
              inputs:
              - curl_vort_press
            - name: glsl1_info3
              type: infoDAT
              parameters:
                op: add_input_velocities
              flags:
              - viewer
              - -showDocked
              position: [-190, -120]
              size: [130, 90]
              dock: add_input_velocities
              dat_read_only: true
            - name: glsl2_pixel
              type: textDAT
              parameters:
                language: glsl
                extension: frag
              flags:
              - viewer
              - -showDocked
              position: [750, -120]
              size: [130, 90]
              dock: glsl2
              dat_content: "uniform float u_delta_time, u_passes;\n\n\nlayout(location = 0) out vec4 fragColor;\nlayout(location = 1) out vec4 fragColor2;\n\nvoid main()\n{\n\tvec3 vel = texture(sTD2DInputs[0], vUV.st).xyw;\n\t//vel *= uTD2DInfos[0].res.xy * u_delta_time * u_passes;\n\tvec4 disp_vel = vec4(vel.xy * uTD2DInfos[0].res.xy * u_delta_time * u_passes, 0.0,1.0);\n\tvec4 col_vel =  vec4(vel * u_delta_time,1.0);\n\tfragColor = TDOutputSwizzle(disp_vel);\n\tfragColor2 = TDOutputSwizzle(col_vel);\n\tvec4 color = vec4(1.0);\n\n}\n"
              dat_content_format: text
            - name: glsl6_pixel
              type: textDAT
              parameters:
                language: glsl
                extension: frag
              flags:
              - viewer
              position: [-175, -125]
              size: [130, 94]
              dock: rk4_advect
              dat_content: "uniform float u_time_step;\nuniform float u_damping;\nuniform bool u_reflective;\n\nvec2 pixel_size=uTD2DInfos[0].res.xy;\n\nvec2 safe_norm(vec2 v)\n{\n\tv=normalize(v);return any(isinf(v))||any(isnan(v))?vec2(0):v;\n}\n\nvec2 boundary_gradient(vec2 uv){\n\tvec2 c_diff=vec2(dFdx(texture(sTD2DInputs[1],uv).x),\n\tdFdy(texture(sTD2DInputs[1],uv).x));\n\t\n\treturn c_diff;\n}\n\nout vec4 fragColor;\nvoid main()\n{\n//advection\n    vec2 uv=vUV.xy;\n    \n    vec2 k1=texture(sTD2DInputs[0],(uv)).xy;\n    \n    vec2 pos2=uv-.5*u_time_step*k1*pixel_size;\n    vec2 k2=texture(sTD2DInputs[0],(pos2)).xy;\n    \n    vec2 pos3=uv-.5*u_time_step*k2*pixel_size;\n    vec2 k3=texture(sTD2DInputs[0],(pos3)).xy;\n    \n    vec2 pos4=uv-u_time_step*k3*pixel_size;\n    vec2 k4=texture(sTD2DInputs[0],(pos4)).xy;\n    \n    vec2 final_p=uv-(u_time_step/6.)*(k1+2.*k2+2.*k3+k4)*pixel_size;\n    \n    vec2 vel=texture(sTD2DInputs[0],final_p).xy;\n \n\n//boundary\n\tfloat bounds = texture(sTD2DInputs[1],uv).x;\n    \n    if(u_reflective==true)\n\t{\n\t\tvec2 n=safe_norm(boundary_gradient(uv));\n\t\t//float d = dot(vel, n);\n\t\tvec2 r_vel=reflect(vel,n);\n\t\tr_vel*=u_damping;\n\t\tvel=mix(vel,vec2(r_vel),bounds);\n\t}\n\telse\n\t{\n\t\tvel=mix(vel,vec2(0.),bounds);\n\t}\n    \n    \n    \n    \n    float alpha=texture(sTD2DInputs[0],vUV.xy).w;//passing the pressure through\n    vec4 color=vec4(vel,0.,alpha);\n    fragColor=TDOutputSwizzle(color);\n}"
              dat_content_format: text
            - name: init_vel_in
              type: inTOP
              parameters:
                label: =me.name
                inputfiltertype: nearest
              flags:
              - viewer
              position: [-875, 25]
              size: [130, 90]
              inputs:
              - circle1
            - name: glsl1_pixel3
              type: textDAT
              parameters:
                language: glsl
                extension: frag
              flags:
              - viewer
              position: [-350, -120]
              size: [130, 90]
              dock: add_input_velocities
              dat_content: "uniform float u_inp_vel;\nout vec4 fragColor;\n\nvoid main()\n{\n    vec2 input_vel = texture(sTD2DInputs[0], vUV.st).xy * u_inp_vel;\n    vec2 fb_vel = texture(sTD2DInputs[1], vUV.st).xy;\n    float bounds = 1.0-(texture(sTD2DInputs[2], vUV.st).x);\n\tvec2 vel = (input_vel * bounds) + fb_vel;\n    \n    \n     float alpha = texture(sTD2DInputs[1], vUV.st).w;\n\tvec4 color = vec4(vel, 0.0, alpha);\n    fragColor = TDOutputSwizzle(color);\n}"
              dat_content_format: text
            - name: renderselect1
              type: renderselectTOP
              position: [900, 25]
            - name: renderselect2
              type: renderselectTOP
              parameters:
                bufferindex: 1
              position: [900, -100]
            - name: curl_vort_press
              type: glslTOP
              parameters:
                glslversion: glsl460
                pixeldat: null2
                computedat: glsl1_compute
                inputfiltertype: ~parent().par.Samplingtype
                filtertype: nearest
                npasses: ~parent().par.Passes
                format: rgba32float
              sequences:
                vec:
                - name: u_time_step
                  valuex: ~parent().par.Timestep
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: u_vorticity
                  valuex: ~parent().par.Vorticityscale
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: u_pressure
                  valuex: =4.0-parent().par.Pressure*4.0
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: u_decay
                  valuex: =parent().par.Velocitydecay
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: u_smagorinsky
                  valuex: =0.08 + tdu.clamp(parent().par.Smargov*0.12, 0.0, 0.6)
                  valuey: 1
                  valuez: 1
                  valuew: 1
                - name: u_viscosity
                  valuex: =parent().par.Viscosity
                  valuey: 1
                  valuez: 1
                  valuew: 1
              flags:
              - viewer
              position: [-25, 0]
              size: [130, 105]
              inputs:
              - rk4_advect
            - name: manual_derivatives
              type: textDAT
              parameters:
                language: glsl
                extension: frag
              flags:
              - viewer
              position: [-114, -485]
              size: [141, 90]
              dat_content: "uniform float u_vorticity,u_time_step,u_pressure,u_decay,u_smagorinsky,u_viscosity;\n\nvec2 pixel_size=uTD2DInfos[0].res.xy;\nvec2 pixel_hori=vec2(pixel_size.x,0.);\nvec2 pixel_verti=vec2(0.,pixel_size.y);\n\nfloat curl(vec2 uv)\n{\n    float r=texture(sTD2DInputs[0],uv+pixel_hori).y;\n    float l=texture(sTD2DInputs[0],uv-pixel_hori).y;\n    float t=texture(sTD2DInputs[0],uv+pixel_verti).x;\n    float b=texture(sTD2DInputs[0],uv-pixel_verti).x;\n    \n    return(l-r-b+t)*.5;\n}\n\nvec2 curl_slope(vec2 uv)\n{\n    float curl_r=curl(uv+pixel_hori);\n    float curl_l=curl(uv-pixel_hori);\n    float curl_t=curl(uv+pixel_verti);\n    float curl_b=curl(uv-pixel_verti);\n    \n    return vec2(abs(curl_r)-abs(curl_l),abs(curl_t)-abs(curl_b))*.5;// abs becuase sign gets added at vorticity stage\n}\n\n// https://www.shadertoy.com/view/cdGfzz\nvec2 safe_norm(vec2 v)\n{\n    v=normalize(v);\n    return any(isinf(v))||any(isnan(v))?vec2(0):v;\n}\n\nfloat divergence(vec2 uv)\n{\n    float left=texture(sTD2DInputs[0],uv-pixel_hori).x;\n    float right=texture(sTD2DInputs[0],uv+pixel_hori).x;\n    float top=texture(sTD2DInputs[0],uv+pixel_verti).y;\n    float bottom=texture(sTD2DInputs[0],uv-pixel_verti).y;\n    \n    return((right-left)+(top-bottom))*.5;\n}\n\nfloat pressure(vec2 uv)\n{\n    float left=texture(sTD2DInputs[0],uv-pixel_hori).w;\n    float right=texture(sTD2DInputs[0],uv+pixel_hori).w;\n    float top=texture(sTD2DInputs[0],uv+pixel_verti).w;\n    float bottom=texture(sTD2DInputs[0],uv-pixel_verti).w;\n    \n    float pressure=(left+right+top+bottom-divergence(uv))*.25;\n    \n    return pressure;\n}\n\nvec2 pressure_grad(vec2 uv)\n{\n    \n    float p_left=pressure(uv-pixel_hori);\n    float p_right=pressure(uv+pixel_hori);\n    float p_top=pressure(uv+pixel_verti);\n    float p_bottom=pressure(uv-pixel_verti);\n    \n    vec2 grad=vec2(p_right-p_left,p_top-p_bottom);\n    return grad;\n    }\n    \n    out vec4 fragColor;\n    void main()\n    {\n        vec2 uv=vUV.xy;\n        vec2 velocity=texture(sTD2DInputs[0],uv).xy;\n        \n        // vorticity and curl\n        float curl_val=curl(uv);\n        vec2 curl_grad=curl_slope(uv);\n        curl_grad=safe_norm(curl_grad);\n        \n        vec2 force=vec2(-curl_grad.y,curl_grad.x);\n        force*=u_vorticity*(curl_val);\n        \n        force*=u_time_step;\n        velocity+=force;\n        // pressure\n        vec2 adv=velocity*pixel_size*u_time_step;\n        float clear_press=pressure(uv)*clamp(1.-u_pressure*u_time_step,0.,1.);\n        \n        velocity.xy-=pressure_grad(uv);\n        //------------------//\n        \n        vec2 ul=texture(sTD2DInputs[0],uv-pixel_hori).xy;\n        vec2 ur=texture(sTD2DInputs[0],uv+pixel_hori).xy;\n        vec2 ub=texture(sTD2DInputs[0],uv-pixel_verti).xy;\n        vec2 ut=texture(sTD2DInputs[0],uv+pixel_verti).xy;\n        \n        // central‐difference gradients\n        float du_dx=(ur.x-ul.x)*.5;\n        float du_dy=(ut.x-ub.x)*.5;\n        float dv_dx=(ur.y-ul.y)*.5;\n        float dv_dy=(ut.y-ub.y)*.5;\n        \n        // strain components\n        float Sxx=du_dx;\n        float Syy=dv_dy;\n        float Sxy=.5*(du_dy+dv_dx);\n        \n        float Cs=u_smagorinsky;\n        float delta=pixel_size.y;\n        float magS=sqrt(2.*(Sxx*Sxx+2.*Sxy*Sxy+Syy*Syy));\n        float nu_t=Cs*Cs*delta*delta*magS;\n        \n        vec2 lap=\n        (ul+ur+ub+ut-4.*velocity)/(delta*delta);\n        \n        // molecular viscosity (if any)\n        float nu=u_viscosity*u_time_step*pixel_size.y;\n        \n        // add eddy-diffusion\n        velocity+=(nu+nu_t)*u_time_step*lap;\n        \n        velocity*=clamp(1.-u_decay*u_time_step,0.,1.);\n        \n        vec4 color=vec4(velocity,0.,clear_press);\n        fragColor=TDOutputSwizzle(color);\n    }\n    "
              dat_content_format: text
            - name: pre_multiplied_vel
              type: outTOP
              parameters:
                label: =me.name
                inputfiltertype: nearest
              flags:
              - viewer
              position: [1125, 25]
              size: [130, 90]
              inputs:
              - renderselect1
            - name: add_input_velocities
              type: glslTOP
              parameters:
                pixeldat: glsl1_pixel3
                computedat: glsl1_compute3
                inputfiltertype: ~parent().par.Samplingtype
                filtertype: nearest
                format: rgba32float
              sequences:
                vec:
                - name: u_damping
                  valuex: ~parent().par.Dampingfactor
                - name: u_inp_vel
                  valuex: ~parent().par.Inputvelocityfactor
                  valuey: 1
                  valuez: 1
                  valuew: 1
              flags:
              - viewer
              position: [-350, 0]
              size: [130, 105]
              inputs:
              - init
              - feedback2
              - bounds
            - name: clean_vel_and_pressure
              type: outTOP
              parameters:
                label: =me.name
                inputfiltertype: nearest
              flags:
              - display
              - viewer
              position: [1125, -100]
              size: [130, 90]
              inputs:
              - renderselect2
            - name: with_hardware_derivatives
              type: textDAT
              parameters:
                language: glsl
                extension: frag
              flags:
              - viewer
              position: [-132, -355]
              size: [141, 90]
              dock: curl_vort_press
              dat_content: "uniform float u_vorticity,u_time_step,u_pressure,u_decay,u_smagorinsky,u_viscosity;\n\nvec2 pixel_size=uTD2DInfos[0].res.xy;\nvec2 pixel_hori=vec2(pixel_size.x,0.);\nvec2 pixel_verti=vec2(0.,pixel_size.y);\n\nfloat curl(vec2 uv)\n{\n    float r=texture(sTD2DInputs[0],uv+pixel_hori).y;\n    float l=texture(sTD2DInputs[0],uv-pixel_hori).y;\n    float t=texture(sTD2DInputs[0],uv+pixel_verti).x;\n    float b=texture(sTD2DInputs[0],uv-pixel_verti).x;\n    \n    return(l-r-b+t)*.5;\n}\n\nvec2 curl_slope(vec2 uv)\n{\n    float curl_r=curl(uv+pixel_hori);\n    float curl_l=curl(uv-pixel_hori);\n    float curl_t=curl(uv+pixel_verti);\n    float curl_b=curl(uv-pixel_verti);\n    \n    //vec2 slope = vec2(dFdx(curl(uv)) ,  dFdy(curl(uv))); - doesn't work\n    //return abs(slope.yx) * sign(curl(uv));\n   return vec2(abs(curl_r)-abs(curl_l),abs(curl_t)-abs(curl_b));// abs becuase sign gets added at vorticity stage\n}\n\n// https://www.shadertoy.com/view/cdGfzz\nvec2 safe_norm(vec2 v)\n{\n    v=normalize(v);\n    return any(isinf(v))||any(isnan(v))?vec2(0):v;\n}\n\nfloat divergence(vec2 uv)\n{\n\n  //can't use fwidth() because we need the sign\n    float div = (dFdxFine(texture(sTD2DInputs[0],uv).x)+dFdyFine(texture(sTD2DInputs[0],uv).y)) * 0.5;\n    \n\n    return div;\n\n    \n    \n}\n\nfloat pressure(vec2 uv)\n{\n    float left=texture(sTD2DInputs[0],uv-pixel_hori).w;\n    float right=texture(sTD2DInputs[0],uv+pixel_hori).w;\n    float top=texture(sTD2DInputs[0],uv+pixel_verti).w;\n    float bottom=texture(sTD2DInputs[0],uv-pixel_verti).w;\n    \n    float pressure=(left+right+top+bottom-divergence(uv))*.25;\n    \n    return pressure;\n}\n\nvec2 pressure_grad(vec2 uv)\n{\n   /* \n    float p_left=pressure(uv-pixel_hori);\n    float p_right=pressure(uv+pixel_hori);\n    float p_top=pressure(uv+pixel_verti);\n    float p_bottom=pressure(uv-pixel_verti);\n    \n    vec2 grad=vec2(p_right-p_left,p_top-p_bottom);\n    */\n    //unfortunately looks ugly :(\n        vec2 grad_hw = vec2(\n            dFdxFine(pressure(uv)),\n            dFdyFine(pressure(uv))\n        );\n     //   */\n        return grad_hw;\n    }\n    \n    out vec4 fragColor;\n    void main()\n    {\n        vec2 uv=vUV.xy;\n        vec2 velocity=texture(sTD2DInputs[0],uv).xy;\n        \n        // vorticity and curl\n        float curl_val=curl(uv);\n        vec2 curl_grad=curl_slope(uv);\n        curl_grad=safe_norm(curl_grad);\n        \n        vec2 force=vec2(-curl_grad.y,curl_grad.x);\n        force*=u_vorticity*(curl_val);\n        \n        force*=u_time_step;\n        velocity+=force;\n        // pressure\n        vec2 adv=velocity*pixel_size*u_time_step;\n        float clear_press=pressure(uv)*clamp(1.-u_pressure*u_time_step,0.,1.);\n        \n        velocity.xy-=pressure_grad(uv);\n        //------------------//\n        \n        vec2 ul=texture(sTD2DInputs[0],uv-pixel_hori).xy;\n        vec2 ur=texture(sTD2DInputs[0],uv+pixel_hori).xy;\n        vec2 ub=texture(sTD2DInputs[0],uv-pixel_verti).xy;\n        vec2 ut=texture(sTD2DInputs[0],uv+pixel_verti).xy;\n        \n        // central‐difference gradients\n        float du_dx=(ur.x-ul.x)*.5;\n        float du_dy=(ut.x-ub.x)*.5;\n        float dv_dx=(ur.y-ul.y)*.5;\n        float dv_dy=(ut.y-ub.y)*.5;\n        \n        // strain components\n        float Sxx=du_dx;\n        float Syy=dv_dy;\n        float Sxy=.5*(du_dy+dv_dx);\n        \n        float Cs=u_smagorinsky;\n        float delta=pixel_size.y;\n        float magS=sqrt(2.*(Sxx*Sxx+2.*Sxy*Sxy+Syy*Syy));\n        float nu_t=Cs*Cs*delta*delta*magS;\n        \n        vec2 lap=\n        (ul+ur+ub+ut-4.*velocity)/(delta*delta);\n        \n        // molecular viscosity (if any)\n        float nu=u_viscosity*u_time_step*pixel_size.y;\n        \n        // add eddy-diffusion\n        velocity+=(nu+nu_t)*u_time_step*lap;\n        \n        velocity*=clamp(1.-u_decay*u_time_step,0.,1.);\n        \n        velocity = any(isinf(velocity))||any(isnan(velocity))?vec2(0):velocity; //NaN prevention\n        clear_press = (isinf(clear_press))||(isnan(clear_press))?0.0:clear_press;
                //NaN prevention\n        vec4 color=vec4(velocity,0.,clear_press);\n        fragColor=TDOutputSwizzle(color);\n    }\n    "
              dat_content_format: text
            annotations:
            - name: annotate1
              mode: annotate
              title: setting up the outputs
              position: [575, -127]
              size: [690, 285]
              color: [0.45, 0.45, 0.45]
          annotations:
          - name: annotate1
