          Slider:
            $t: slider_4
            Sliderlabelnames: =me.name
            Sliderfontsizemode: fract
            Sliderfontsize: 40
            Sliderfontfraction: 0.1
            Sliderscaletofit: onlyshrink
            Sliderfontbold: true
            Sliderknobcolor: [0, 0.366667, 0.5, 1]
            Sliderlabelfontcolor: [0.8, 0.2, 0.2, 1]
            Sliderindicatorcolor: [0.241533, 0.375286, 0.423, 1]
            Cacheabletop: =op('./slider0/bg')
          Widget:
