        type: baseCOMP
        flags:
        - viewer
        position: [-724, -118]
        size: [160, 130]
        tags:
        - clone
        children:
        - name: index
          type: tableDAT
          parameters:
            defaultreadencoding: cp1252
            rows: 1
            cols: 1
          flags:
          - viewer
          position: [-2950, 1875]
          size: [130, 90]
          tags:
          - clone
          - table
          dat_content:
          - - '1'
          dat_content_format: table
        - name: switch
          type: switchCHOP
          parameters:
            index: =op('index')[0,0]
          flags:
          - viewer
          position: [-2625, 1525]
          size: [250, 421]
          inputs:
          - select_0
          - select_A
          - select_B
        - name: select1
          type: selectDAT
          parameters:
            dat: /PATCHDECK/UI/MAIN_INTERFACE/MIDI_status
            rowindexend: =me.inputTable.numRows - 1
            rowexpr: =re.match('.*',me.inputCell.val) != None
            colindexend: =me.inputTable.numCols - 1
          flags:
          - viewer
          position: [-3100, 1875]
          size: [130, 90]
          dat_read_only: true
        - name: MIDI_OUT
          type: outCHOP
          parameters:
            label: =me.name
            autoexportroot: =parent()
          flags:
          - viewer
          position: [-2200, 1675]
          inputs:
          - switch
        - name: execute1
          type: executeDAT
          parameters:
            framestart: true
            defaultreadencoding: cp1252
            language: input
          flags:
          - viewer
          position: [-2950, 1975]
          size: [131, 90]
          tags:
          - clone
          - execute
          dat_content: "def onFrameStart(frame):\n\n\n\n\tif parent(2).digits == op('/PATCHDECK/UI/MAIN_INTERFACE/MIDI_status')[1,0]:\t\t\t\t\t\n\t\top('index')[0,0] = 1\n\n\telse:\n\t\top('index')[0,0] = 0\n\t\t\n\tif parent(2).digits == op('/PATCHDECK/UI/MAIN_INTERFACE/MIDI_status')[1,1]:\t\t\t\t\t\n\t\top('index')[0,0] = 2\n\t\n\t\n\treturn\n\n"
          dat_content_format: text
        - name: select_0
          type: constantCHOP
          parameters:
            autoexportroot: =parent()
          sequences:
            const:
            - name: r1
            - name: r2
            - name: r3
            - name: r4
            - name: b1
            - name: b2
            - name: b3
            - name: b4
            - name: b5
            - name: b6
            - name: b7
            - name: b8
            - name: s1
            - name: s2
            - name: s3
            - name: s4
            - name: reset
