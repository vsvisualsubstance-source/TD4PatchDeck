                size: [130, 45]
              - name: callbacks
                type: textDAT
                parameters:
                  defaultreadencoding: cp1252
                  language: input
                flags:
                - viewer
                position: [875, -425]
                size: [498, 173]
                dat_content: "#Shared Use License: This file is owned by Derivative Inc. (ï¿½Derivativeï¿½)\n#and can only be used, and/or modified for use, in conjunction with\n#Derivativeï¿½s TouchDesigner software, and only if you are a licensee who\n#has accepted Derivativeï¿½s TouchDesigner license or assignment agreement\n#(which also governs the use of this file).  You may share a modified version\n#of this file with another authorized licensee of Derivativeï¿½s TouchDesigner\n#software.  Otherwise, no redistribution or sharing of this file, with or\n#without modification, is permitted.\n\n\"\"\"\nPopMenu callbacks\n\nCallbacks always take a single argument, which is a dictionary\nof values relevant to the callback. Print this dictionary to see what is\nbeing passed. The keys explain what each item is.\n\nonSelect: user selects a menu option\nonMouseOver: mouse passes over a cell\nonMouseDown: left button pressed\nonMouseUp: left button released\nonClick: left button pressed then released on same cell\nonLostFocus: The popmenu focus has been lost\n\nCallbacks generally return a dict with:\n\t'cell': either cell id or -1 for no cell\n\t'label': the label in the menu list\n\t'row': the row from the wired dat input, if applicable\n\t'details': details provided by object that caused menu to open\n\"\"\"\n\n# def onSelect(info):\n#\tprint('SELECTED:', info['cell'], info['label'], info['row'], info['details']"
                dat_content_format: text
              - name: colDefine
                type: tableDAT
                parameters:
                  defaultreadencoding: cp1252
                  rows: 13
                  cols: 2
                flags:
                - viewer
                position: [875, -150]
                size: [360, 335]
                comment: this is required do not delete
                dat_content:
                - - column
                  - Symbol
                - - columnLabel
                  - ''
                - - sourceData
                  - ''
                - - sourceDataMode
                  - constant
                - - cellLook
                  - button
                - - topPath
                  - ''
                - - help
                  - ''
                - - width
                  - '20'
                - - stretch
                  - ''
                - - editable
                  - '0'
                - - draggable
                  - '0'
                - - selectRow
                  - '1'
                - - justify
                  - CENTER
                dat_content_format: table
              - name: textSizer
                type: textTOP
                parameters:
                  text: WX|gj
                  legacyfontselection: true
                  font: =parent.Widget.par.Font
                  fontsizex: =parent.Widget.par.Menufontsize
                flags:
                - viewer
                position: [100, -200]
                size: [130, 90]
                comment: Need this to calculate size to avoid recursion error
              - name: buttonRoll
                type: textTOP
                parameters:
                  text: XXWWWWWWW
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =parent.Widget.par.Font
                  fontsizex: =op('master').par.fontsizex
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menufontoffcolorr
                  fontcolorg: =parent.Widget.par.Menufontoffcolorg
                  fontcolorb: =parent.Widget.par.Menufontoffcolorb
                  fontalpha: =parent.Widget.par.Menufontoffcolora
                  bgcolorr: =parent.Widget.par.Menurollcolorr
                  bgcolorg: =parent.Widget.par.Menurollcolorg
                  bgcolorb: =parent.Widget.par.Menurollcolorb
                  bgalpha: =parent.Widget.par.Menurollcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -300]
                size: [130, 48]
              - name: buttonPress
                type: textTOP
                parameters:
                  text: G
                  legacyparsing: true
                  chopvaluereplace: true
                  legacyfontselection: true
                  font: =parent.Widget.par.Font
                  fontsizex: =op('master').par.fontsizex
                  positionx: =op('master').par.position1
                  positiony: =op('master').par.position2
                  alignx: left
                  fontcolorr: =parent.Widget.par.Menufontoncolorr
                  fontcolorg: =parent.Widget.par.Menufontoncolorg
                  fontcolorb: =parent.Widget.par.Menufontoncolorb
                  fontalpha: =parent.Widget.par.Menufontoncolora
                  bgcolorr: =parent.Widget.par.Menuselectcolorr
                  bgcolorg: =parent.Widget.par.Menuselectcolorg
                  bgcolorb: =parent.Widget.par.Menuselectcolorb
                  bgalpha: =parent.Widget.par.Menuselectcolora
                  borderar: 0
                  borderag: 0
                  borderab: 0
                  borderaalpha: 0
                  borderbalpha: 0
                  resolutionw: =op('master').par.resolutionw
                  resolutionh: =op('master').par.resolutionh
                flags:
                - viewer
                position: [500, -400]
                size: [130, 48]
              - name: buttonDisabled
                type: textTOP
                parameters:
                  text: XXWWWWWWW
                  legacyparsing: true
